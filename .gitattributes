* text=auto

# Archivos de texto con fin de línea LF en el repositorio
*.md text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

# Scripts de Windows que requieren CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.ico binary

# Merge driver para grafo de dependencias
graphify-out/graph.json merge=graphify
