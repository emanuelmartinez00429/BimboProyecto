<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Supabase" Version="1.1.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.5" />
    <!-- DPAPI: cifra el correo de «Recordar usuario» (PreferenciasInicioSesionService). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
    <!--
      P-067: PDFsharp y PDFsharp-MigraDoc 6.2.4 arrastran System.Security.Cryptography.Pkcs
      8.0.1 con GHSA-846f-f764-76mx (alta) y GHSA-2fmv-rv2c-59x7 (moderada). El paquete no
      tiene referencia directa, así que se fija acá la versión parcheada para pisar el
      transitivo. Verificado el 2026-11-08: PDFsharp 6.5.0 (última estable) sigue pidiendo
      8.0.1, por eso actualizar el padre no resuelve nada. Quitar cuando lo actualicen.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BimboProyecto.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapaDominio\CapaDominio.csproj" />
    <ProjectReference Include="..\CapaAplicacion4\CapaAplicacion.csproj" />
  </ItemGroup>

</Project>
