<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="SUPABASE_URL" value="https://bzmmrifjgzlvsphctais.supabase.co" />
    <add key="SUPABASE_KEY" value="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ6bW1yaWZqZ3psdnNwaGN0YWlzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM4MDIwNjUsImV4cCI6MjA4OTM3ODA2NX0.Ah6AYyb5UlLi2ihvsM_NfoYVFWe1aEHvYkVMQiADEpk"/>

    <!-- Nivel mínimo del log (Verbose|Debug|Information|Warning|Error|Fatal). Default: Warning.
         Poner en Debug para ver el cronometraje por llamada al backend que emite RepositorioBase
         y así medir la latencia real de cada round trip a Supabase. -->
    <add key="LOG_LEVEL" value="Warning" />

    <!-- Fuerza el factor de escala de la UI (0.70 a 1.30, en pasos de 0.05), por encima de
         la preferencia guardada del usuario. Vacío o ausente = se usa la preferencia.
         Sirve para ver la app a un tamaño puntual sin pasar por la pantalla de preferencias.
         Mientras esté activo, la app no deja guardar un factor nuevo.
         También se puede pasar como variable de entorno UI_ESCALA. -->
    <add key="UI_ESCALA" value="" />

    <!-- Monitor de conexión (ping ICMP). Valores opcionales; si faltan se usan los defaults del código. -->
    <add key="CONEXION_PING_TARGETS"          value="1.1.1.1,8.8.8.8" />
    <add key="CONEXION_PING_TIMEOUT_MS"       value="1500" />
    <add key="CONEXION_INTERVALO_OK_MS"       value="5000" />
    <add key="CONEXION_INTERVALO_DEGRADADO_MS" value="3000" />
    <add key="CONEXION_HISTERESIS"            value="2" />
  </appSettings>
</configuration>
