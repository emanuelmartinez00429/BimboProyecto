<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:controls="clr-namespace:CapaUI.Core.Controls"
                    xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
                    xmlns:converters="clr-namespace:CapaUI.Converters">

    <!-- ── Colores de marca ─────────────────────────────────────────────── -->
    <Color x:Key="BrandDarkColor">#1E2D5E</Color>
    <Color x:Key="BrandLightColor">#3B5BD6</Color>
    <Color x:Key="AccentColor">#10B981</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="BorderColor">#D8DCE4</Color>
    <Color x:Key="TextPrimaryColor">#1F2937</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="SurfaceColor">#F9FAFB</Color>

    <SolidColorBrush x:Key="BrandBrush"          Color="{DynamicResource EmpresaPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandDarkBrush"      Color="{StaticResource BrandDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BrandLightBrush"     Color="{StaticResource BrandLightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorBrush"          Color="{StaticResource ErrorColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}" po:Freeze="True"/>

    <!-- ── Conversores Compartidos ──────────────────────────────────────── -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConv"/>
    <converters:TextoVacioConverter x:Key="TextoVacioConverter"/>
    <converters:NumeroFilaConverter x:Key="NumeroFilaConverter"/>

