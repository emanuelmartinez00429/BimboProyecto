    <Style x:Key="LupaBtnCompartido" TargetType="Button">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Path Data="{StaticResource IconSearchShared}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.2" Width="17" Height="17" Stretch="Uniform"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Misma lupa que LupaBtnCompartido, variante para fondos oscuros
         (modales con marco degradado: ProductoModal, ProcesoDescargaModal):
         borde translúcido blanco en vez de gris sólido, si no queda invisible
         contra el degradado. Antes estaba copiada localmente en cada modal
         que la necesitaba. -->
    <Style x:Key="LupaBtnOscuro" TargetType="Button">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Path Data="{StaticResource IconSearchShared}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.2"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ── Botón primario ───────────────────────────────────────────────── -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Height"          Value="44"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource BrandLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Botón sidebar ────────────────────────────────────────────────── -->
    <Style x:Key="BtnSidebar" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#BFD0F5"/>
        <Setter Property="FontSize"        Value="13.5"/>
        <Setter Property="Height"          Value="46"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"         Value="20,0,0,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}"
                            CornerRadius="6" Margin="8,2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="#2A4A9A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Botón sidebar activo ─────────────────────────────────────────── -->
    <Style x:Key="BtnSidebarActivo" TargetType="Button" BasedOn="{StaticResource BtnSidebar}">
        <Setter Property="Background" Value="#2A4A9A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ── TextBox ──────────────────────────────────────────────────────── -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Height"           Value="44"/>
        <Setter Property="FontSize"         Value="13.5"/>
        <Setter Property="Padding"          Value="12,0"/>
        <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                        <!-- P-047: Borde rojo en error de validación -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Input de Celda (P-042 / P-047) ──────────────────────────────── -->
    <Style x:Key="CeldaInput" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <!-- El marcador comparte el MISMO Margin/VerticalAlignment que el
                                 PART_ContentHost, así que cae exactamente donde arranca el
                                 texto y donde se para el cursor. Ver controls:Placeholder. -->
                            <TextBlock x:Name="Marcador" Visibility="Collapsed"
                                       Text="{Binding Path=(controls:Placeholder.Texto), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="#9CA3AF" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Vacío Y sin foco: apenas entra el cursor el marcador se va, así
                             no queda texto gris debajo del cursor. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Marcador" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <!-- Después del foco: con error se ve rojo aunque esté enfocado -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Tabla editable dentro de un modal oscuro ═══════════════════════════
         La familia que acompaña a CeldaInput: el basurero de fila, el encabezado
         de columna y el botón de agregar fila. Nacieron locales en
         RegistroCamionesModal; se centralizan acá al aparecer el segundo consumidor
         (ProductosCargaModal) en vez de copiarlos — misma regla que cerró P-031 G11
         y que pide [[Anatomia compartida de los modales]]. -->

    <PathGeometry x:Key="IcoTrashFila" po:Freeze="True"
                  Figures="M3,6 h18 M8,6 V4 a1,1 0 0 1,1,-1 h6 a1,1 0 0 1,1,1 v2 m2,0 v14 a2,2 0 0 1,-2,2 H7 a2,2 0 0 1,-2,-2 V6"/>
    <PathGeometry x:Key="IcoMasFila" po:Freeze="True" Figures="M12,5 v14 M5,12 h14"/>

    <!-- Basurero de fila: el cuadradito rojo pálido que ya usa BotonQuitarFila en
         PesajeView.xaml — el patrón de "quitar una fila de una lista" del módulo.
         El trigger de IsEnabled=False existe porque hay filas que NO se pueden
         quitar (un producto con pesajes registrados) y el botón tiene que decirlo
         sin desaparecer. -->
    <Style x:Key="BasureroCelda" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="#FEF2F2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6">
                        <Path x:Name="Ico" Data="{StaticResource IcoTrashFila}" Stroke="#DC2626" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"  Value="#F3F4F6"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter TargetName="Ico" Property="Stroke"     Value="#9CA3AF"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encabezado de columna de la tabla (sobre la banda del color de empresa) -->
    <Style x:Key="CabeceraColTabla" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Botón de agregar fila al pie de la tarjeta: sólido en el azul de la
         empresa, para no competir con el verde del botón de guardar. -->
    <Style x:Key="BtnAgregarFilaTabla" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
