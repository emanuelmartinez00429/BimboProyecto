<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CapaUI.Core.Controls"
                    xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
                    xmlns:converters="clr-namespace:CapaUI.Converters">

    <!-- ── Colores de marca ─────────────────────────────────────────────── -->
    <Color x:Key="BrandDarkColor">#1E2D5E</Color>
    <Color x:Key="BrandLightColor">#3B5BD6</Color>
    <Color x:Key="AccentColor">#10B981</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="BorderColor">#D8DCE4</Color>
    <Color x:Key="TextPrimaryColor">#1F2937</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="SurfaceColor">#F9FAFB</Color>

    <SolidColorBrush x:Key="BrandBrush"          Color="{DynamicResource EmpresaPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandDarkBrush"      Color="{StaticResource BrandDarkColor}"/>
    <SolidColorBrush x:Key="BrandLightBrush"     Color="{StaticResource BrandLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"          Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>

    <!-- ── Conversores Compartidos ──────────────────────────────────────── -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConv"/>
    <converters:TextoVacioConverter x:Key="TextoVacioConverter"/>
    <converters:NumeroFilaConverter x:Key="NumeroFilaConverter"/>

    <Geometry x:Key="IconSearchShared">M11,4 a7,7 0 1 1 0,14 a7,7 0 0 1 0,-14 z M20,20 l-4.3,-4.3</Geometry>
    <Style x:Key="LupaBtnCompartido" TargetType="Button">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Path Data="{StaticResource IconSearchShared}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.2" Width="17" Height="17" Stretch="Uniform"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Misma lupa que LupaBtnCompartido, variante para fondos oscuros
         (modales con marco degradado: ProductoModal, ProcesoDescargaModal):
         borde translúcido blanco en vez de gris sólido, si no queda invisible
         contra el degradado. Antes estaba copiada localmente en cada modal
         que la necesitaba. -->
    <Style x:Key="LupaBtnOscuro" TargetType="Button">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#7FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Path Data="{StaticResource IconSearchShared}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.2"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ── Botón primario ───────────────────────────────────────────────── -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Height"          Value="44"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource BrandLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Botón sidebar ────────────────────────────────────────────────── -->
    <Style x:Key="BtnSidebar" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#BFD0F5"/>
        <Setter Property="FontSize"        Value="13.5"/>
        <Setter Property="Height"          Value="46"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"         Value="20,0,0,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}"
                            CornerRadius="6" Margin="8,2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="#2A4A9A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Botón sidebar activo ─────────────────────────────────────────── -->
    <Style x:Key="BtnSidebarActivo" TargetType="Button" BasedOn="{StaticResource BtnSidebar}">
        <Setter Property="Background" Value="#2A4A9A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ── TextBox ──────────────────────────────────────────────────────── -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Height"           Value="44"/>
        <Setter Property="FontSize"         Value="13.5"/>
        <Setter Property="Padding"          Value="12,0"/>
        <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                        <!-- P-047: Borde rojo en error de validación -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Input de Celda (P-042 / P-047) ──────────────────────────────── -->
    <Style x:Key="CeldaInput" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <!-- Después del foco: con error se ve rojo aunque esté enfocado -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Botones de Paginación (P-037) ────────────────────────────────── -->
    <Style x:Key="PageBtn" TargetType="Button">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActivePageBtn" TargetType="Button" BasedOn="{StaticResource PageBtn}">
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
    </Style>

    <!-- ── Modal ComboBox ──────────────────────────────────────────────── -->
    <Style x:Key="ModalCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- Sin template propio: el ComboBox usa el suyo por defecto, cuyo borde
             ya está atado a BorderBrush/BorderThickness por TemplateBinding, así
             que alcanza con un Style.Trigger — no hace falta reescribir el
             template completo del combo solo para el foco. IsKeyboardFocusWithin
             en vez de IsFocused: el foco real cae en una parte interna del
             control (el ToggleButton/editor), no en el ComboBox en sí. -->
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#34D399"/>
                <Setter Property="BorderThickness" Value="3"/>
            </Trigger>
            <!-- Después del foco: con error se ve rojo aunque esté enfocado. -->
            <Trigger Property="validacion:Validacion.TieneError" Value="True">
                <Setter Property="BorderBrush" Value="#EF4444"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Foco de los campos de modal ─────────────────────────────────────
         Compartido entre ModalInput y ModalCombo: antes el foco solo cambiaba
         el borde de "#7FFFFFFF" (blanco translúcido, 1px) a blanco sólido —
         contra el fondo blanco del propio campo esa diferencia es casi
         imperceptible, que era justamente la queja ("casi no se nota lo que
         está seleccionado"). El verde es el mismo #34D399 de la barra
         indicadora de fila seleccionada en las tablas (y #C2F2E0 el mismo
         relleno de esa misma selección) — mismo lenguaje visual de "esto es
         lo elegido" que ya conoce el usuario, no un color inventado. -->
    <!-- ── Modal TextBox ───────────────────────────────────────────────── -->
    <Style x:Key="ModalInput" TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- Todo modal es responsive (Width/MaxWidth atados al tamaño real de
             la ventana) y estos campos pueden angostarse hasta que un valor
             largo (nombre de fabricante, de proveedor…) deje de entrar.
             TextoResponsivo cubre los dos casos con un solo Setter, heredado
             por todo lo BasedOn en esto (ModalInputAuditoria incluida):
             - Solo lectura (campos de catálogo elegidos por lupa): recorta
               con "…" y deja el texto completo en el ToolTip.
             - Editable: no toca el texto (le comería el input), solo agrega
               el ToolTip cuando lo tipeado no entra.
             Ver [[TextoResponsivo]] / CapaUI/Core/Controls/TextoResponsivo.cs. -->
        <Setter Property="controls:TextoResponsivo.Activo" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="Disabled"/>
                            <!-- Recorte visual "…" para los campos EDITABLES (Nombre,
                                 Código…): acá no se puede tocar TextBox.Text como hace
                                 TextoResponsivo con los de solo lectura — eso le comería
                                 al usuario lo que está tipeando. En cambio, este
                                 TextBlock se superpone tapando el ScrollViewer y usa
                                 TextTrimming="CharacterEllipsis" nativo (WPF lo calcula
                                 solo, sin medir nada a mano); solo se ve cuando el campo
                                 no tiene foco, así que mientras se escribe el usuario ve
                                 el TextBox real con su scroll y su cursor normales. -->
                            <TextBlock Text="{TemplateBinding Text}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       x:Name="PART_Recorte"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Background="{TemplateBinding Background}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Borde grueso (3px) en el verde #34D399 de "fila seleccionada"
                             de las tablas: mismo lenguaje visual, perceptible tanto sobre
                             el blanco del campo como sobre el azul del modal.
                             Solo el BORDE, sin relleno: el #C2F2E0 que se pintaba adentro
                             tenia dos problemas — tapaba el contraste del texto que se esta
                             escribiendo, y hacia que el campo enfocado se leyera como un
                             estado del dato (verde = valido/activo) y no como "aca esta el
                             cursor". El aro alcanza para ubicar el foco. -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="PART_Recorte" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Error de validación. Va DESPUÉS del trigger de foco a
                             propósito: cuando dos triggers pisan la misma propiedad
                             gana el último, así que un campo con error se ve rojo
                             aunque tenga el cursor adentro. Al revés, el verde de
                             foco taparía el error justo mientras el usuario intenta
                             corregirlo, que es cuando más necesita verlo. -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Anatomía compartida de los modales ════════════════════════════════
         Estos cinco estilos estaban duplicados archivo por archivo (EtiquetaCampo
         y CampoModal en PresentacionModal y ProductoModal con Margin distinto;
         ModalSegBtn en SEIS modales, y solo la copia de Presentación tenía el
         trigger de foco). Centralizarlos es lo que permite que un cambio de
         tipografía, de espaciado o de foco se aplique a todos los modales de una
         vez, en vez de tener que repetirlo siete veces y que se desincronicen.
         Todo modal nuevo debe usarlos en vez de redefinirlos localmente. -->

    <!-- Etiqueta ARRIBA del campo (no a la par): deja al input usar todo el ancho
         de la tarjeta en vez de perder 120-150px en una columna de rótulos. -->
    <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E0FFFFFF"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <!-- Contenedor etiqueta+input. La variante ...EnGrid agrega la separación
         lateral que necesitan los modales de varias columnas (ProductoModal);
         es un BasedOn y no una segunda copia, así el resto de las propiedades
         sigue saliendo de un solo lugar. -->
    <Style x:Key="CampoModal" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="CampoModalEnGrid" TargetType="StackPanel" BasedOn="{StaticResource CampoModal}">
        <Setter Property="Margin" Value="0,0,20,16"/>
    </Style>

    <!-- Campo de auditoría (Creado / Actualizado): solo lectura, apagado. -->
    <Style x:Key="ModalInputAuditoria" TargetType="TextBox" BasedOn="{StaticResource ModalInput}">
        <Setter Property="Background" Value="#C7D2E3"/>
        <Setter Property="Foreground" Value="#5B6B85"/>
        <Setter Property="BorderBrush" Value="#3FFFFFFF"/>
    </Style>

    <!-- Toggle segmentado (Activo / Inactivo). -->
    <Style x:Key="ModalSegBtn" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- Foco por borde, igual que ModalInput. Antes esto pintaba el
                             relleno #C2F2E0, que acá era el ÚNICO indicador de foco: al
                             sacar el relleno del resto de los campos había que reemplazarlo
                             por el aro, no simplemente quitarlo, o el toggle quedaba sin
                             ninguna señal al navegar con Tab. El BorderThickness ya viene
                             en 2 con BorderBrush transparente, así que encender el color
                             no mueve el layout. -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox de modal. No puede heredar de ModalInput: WPF no comparte
         ControlTemplate entre TextBox y PasswordBox (PART_ContentHost espera tipos
         distintos), así que la apariencia se replica a mano. Sin PART_Recorte ni
         TextoResponsivo — el contenido va enmascarado, no hay nada que recortar
         ni que mostrar en un ToolTip. -->
    <Style x:Key="ModalPassword" TargetType="PasswordBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                        </Trigger>
                        <!-- Después del foco: con error se ve rojo aunque esté enfocado. -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Título del modal ("Editar categoría"). Antes iba inline en cada archivo,
         con seis valores distintos de FontSize entre modales. -->
    <Style x:Key="ModalTitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Cinta de contexto sobre el título ("EDICIÓN" / "NUEVO"). -->
    <Style x:Key="ModalContexto" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#A6FFFFFF"/>
    </Style>

    <!-- ── PasswordBox ──────────────────────────────────────────────────── -->
    <Style x:Key="InputPassword" TargetType="PasswordBox">
        <Setter Property="Height"     Value="44"/>
        <Setter Property="FontSize"   Value="13.5"/>
        <Setter Property="Padding"    Value="12,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Borde"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Tabla blanca sobre modal oscuro ═════════════════════════════════
         Antes vivían solo dentro de SelectorCatalogoModal.xaml. Cualquier
         modal que necesite una tabla (no solo un selector de catálogo) usa
         estos tres en vez de copiarlos — mismo criterio que LupaBtnOscuro. -->
    <Style x:Key="TablaCatalogoFila" TargetType="DataGridRow">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#EEF2F8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="SelIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="#34D399"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="1"/>
                            <DataGridCellsPresenter/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C8D8F0"/>
                        </Trigger>
                        <!-- La fila alterna necesita su propio hover: si no, el
                             #E8F0FA del Style.Trigger le gana al del template. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#C8D8F0"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C2F2E0"/>
                            <Setter TargetName="SelIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#C2F2E0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#E8F0FA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TablaCatalogoCelda" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TablaCatalogoHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="#22449B" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="#E8EEFB"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Padding="12,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Encabezados de DataGrid (Compartidos) ══ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{DynamicResource EmpresaPrimaryBrush}" BorderBrush="#1EFFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Padding="10,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderCentrado" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{DynamicResource EmpresaPrimaryBrush}" BorderBrush="#1EFFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="8,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderDerecho" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{DynamicResource EmpresaPrimaryBrush}" BorderBrush="#1EFFFFFF" BorderThickness="0,0,1,0">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Padding="10,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Fila estándar de DataGrid (Compartida) ══ -->
    <Style x:Key="ProductRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#EEF2F8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="SelIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="#34D399"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="1"/>
                            <DataGridCellsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                        </Trigger>
                        <!-- Hover en fila alterna: color más oscuro para distinguirse de #E8F0FA -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                            <Setter TargetName="SelIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#E8F0FA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Barras de scroll discretas ══
         Barra fina sin flechas ni fondo de riel: solo el thumb gris. Estaban
         definidas localmente en ProductosView; se promovieron acá al necesitarlas
         también en Pesaje, para no mantener una tercera copia. Las vistas que
         todavía las declaran en sus propios Resources siguen usando las suyas
         (el recurso local gana), así que promoverlas no cambia nada de lo que ya
         estaba funcionando. -->
    <ControlTemplate x:Key="ModernScrollBarTemplateVertical" TargetType="ScrollBar">
        <Grid x:Name="GridRoot" Width="8">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Height="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#94A3B8" CornerRadius="4" Margin="2,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Height="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ModernScrollBarTemplateHorizontal" TargetType="ScrollBar">
        <Grid x:Name="GridRoot" Height="10">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Width="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#94A3B8" CornerRadius="4" Margin="0,2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Width="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Elige plantilla según la orientación: sirve para el vertical y el
         horizontal del mismo DataGrid con un solo Style. -->
    <Style x:Key="ModernScrollBarAny" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="#F3F4F6"/>
        <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplateVertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplateHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Celdas de DataGrid (Compartidas) ══
         Celda sin borde ni padding, fondo transparente (la fila pinta el suyo) y
         contenido centrado vertical. Lo único que las diferencia es la alineación
         horizontal, y por eso son DOS estilos y no uno: el patrón es la primera
         columna y ESTADO centradas, el resto a la izquierda.

         Vivían copiadas en 10 vistas bajo cuatro nombres distintos —
         ProductCellStyle/ProductCellStyle1 (incluso en Categorías y Proveedores,
         residuo de copiar y pegar), BitacoraCellStyle/…Left, EmpleadoCellStyle/…Left
         y UserCellStyle— todas con el mismo contenido. Acá quedan una sola vez y con
         un nombre que dice qué hacen. -->
    <Style x:Key="CeldaCentrada" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CeldaIzquierda" TargetType="DataGridCell" BasedOn="{StaticResource CeldaCentrada}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CeldaDerecha" TargetType="DataGridCell" BasedOn="{StaticResource CeldaCentrada}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Texto de celda con atenuación para guion vacío (—) o textos de fallback ══ -->
    <Style x:Key="TextoCeldaConFallback" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="—">
                <Setter Property="Foreground" Value="#9CA3AF"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin descripción">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin dirección">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin proveedor">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin fabricante">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin país">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin teléfono">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin correo">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin RTN">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin identidad">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin presentación">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin tara">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin contenido">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin categoría">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin registros">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin campo">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
            <Trigger Property="Text" Value="Sin detalle">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Columna # (número de fila) para las tablas de lista ══
         El número es una posición visual, NO un dato de la base ni un identificador
         estable: si cambia el orden, el filtro o la página, el mismo registro recibe
         otro número. El identificador estable sigue siendo la columna CÓDIGO/Id.
         Numeración global: sigue entre páginas (página 2 arranca en 51).
         Uso en cada vista, como primera columna del DataGrid:
           <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False"
                                   CanUserReorder="False"
                                   CellStyle="{StaticResource CeldaCentrada}"
                                   CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/> -->
    <Style x:Key="TextoNumeroFila" TargetType="TextBlock" BasedOn="{StaticResource TextoCeldaConFallback}">
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <DataTemplate x:Key="PlantillaCeldaNumeroFila">
        <TextBlock Style="{StaticResource TextoNumeroFila}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource NumeroFilaConverter}">
                    <Binding/>
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                    <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <!-- ══ Botones de barra de herramientas / Acciones (Compartidos) ══
         Estilos normalizados para botones de acción en formularios, tablas y modales.
         Garantizan colores sólidos, estados desactivados uniformes y hover coherente. -->

    <!-- Botón estándar (Outline / Blanco) -->
    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón primario sólido (Azul de marca dinámico) -->
    <Style x:Key="ToolPrimary" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de éxito sólido (Verde #16A34A) -->
    <Style x:Key="ToolSuccess" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#16A34A"/>
        <Setter Property="BorderBrush" Value="#16A34A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
