<!--
    Recursos que existen SOLO en el diseñador de Visual Studio / Blend.

    Por qué hace falta y por qué acá y no en Styles.xaml
    ────────────────────────────────────────────────────
    El diseñador no ejecuta App.xaml, así que en el lienzo no existen las claves
    que App.xaml define directamente: los colores Empresa* y los converters.
    Sin los colores, el marco degradado de los modales sale transparente y todo
    su texto —que es blanco, porque está diseñado sobre ese marco— queda blanco
    sobre blanco: el lienzo se ve vacío aunque el control haya cargado bien.

    Estas claves NO pueden ir en Styles.xaml. EmpresaThemeService.Aplicar()
    escribe el tema de cada empresa directamente en Application.Current.Resources,
    y {DynamicResource} busca elemento → ancestros → Application: si Styles.xaml
    las definiera, el diccionario que cada control mergea localmente le ganaría a
    Application y el modal quedaría con el azul por defecto ignorando el color de
    la empresa, en runtime y sin error. Ver ADR-028 y ADR-019 en contexto/.

    Este archivo es el único lugar sano para ellas: vive en el ámbito Application,
    que es donde pertenecen. La marca ContainsDesignTimeResources del CapaUI.csproj
    hace que SOLO el diseñador lo mergee. El BAML igual queda dentro del ensamblado
    (~1 KB), pero es inerte: App.xaml no lo referencia y nadie lo carga en runtime,
    así que no puede pisar el tema por empresa. El cableado está a la vista en
    CapaUI.csproj, junto con el porqué de que vaya sin Condition.

    Los valores son los mismos que App.xaml usa como predeterminados. Si cambian
    allá, actualizalos acá — son la vista previa, no la fuente de verdad.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CapaUI.Converters">

    <!-- Paleta de empresa por defecto (misma que App.xaml). -->
    <Color x:Key="EmpresaPrimaryColor">#1E3A8A</Color>
    <Color x:Key="EmpresaPrimaryDarkColor">#1E40AF</Color>
    <Color x:Key="EmpresaPrimaryDarkerColor">#172554</Color>
    <Color x:Key="EmpresaPrimaryBrightColor">#2563EB</Color>
    <Color x:Key="EmpresaPrimaryLightColor">#3B82F6</Color>
    <Color x:Key="EmpresaPrimaryLighterColor">#60A5FA</Color>

    <SolidColorBrush x:Key="EmpresaPrimaryBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="EmpresaPrimaryDarkBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="EmpresaPrimaryDarkerBrush" Color="#172554"/>
    <SolidColorBrush x:Key="EmpresaPrimaryBrightBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="EmpresaPrimaryLightBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="EmpresaPrimaryLighterBrush" Color="#60A5FA"/>
    <LinearGradientBrush x:Key="EmpresaPrimaryGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#1E3A8A" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Converters de App.xaml. Las vistas que los usan en contenido interno
         (ReporteriaView, UniversalSearchView) fallan sin esto. -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <conv:RestarMargenConverter x:Key="RestarMargen"/>
    <conv:AnchoMinimoAVisibilidadConverter x:Key="AnchoMinimoAVisibilidad"/>
    <conv:VacioAVisibilidadConverter x:Key="VacioAVisibilidad"/>
    <conv:TextoVacioConverter x:Key="TextoVacioConverter"/>

</ResourceDictionary>
