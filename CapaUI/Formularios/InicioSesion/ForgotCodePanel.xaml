<UserControl x:Class="CapaUI.Formularios.InicioSesion.ForgotCodePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/InicioSesion/LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="56,32,56,24">

            <!-- Back -->
            <Button Content="← Volver" Style="{StaticResource BackLinkButton}" Click="BtnBack_Click"/>

            <!-- Hero icon -->
            <Border Width="48" Height="48" CornerRadius="12"
                    Background="{StaticResource BrandPrimarySoft}"
                    HorizontalAlignment="Left" Margin="0,0,0,16">
                <Viewbox Width="26" Height="26">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L6 13L7.41 11.59L10 14.17L16.59 7.58L18 9L10 17Z"
                              Fill="#1E3A8A"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- Title -->
            <TextBlock Text="Verifica tu identidad" FontFamily="Segoe UI" FontSize="26"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

            <!-- Subtitle with email -->
            <TextBlock x:Name="SubtitleBlock" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="14"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,24"/>

            <!-- 6-digit PIN -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBox x:Name="D1" Style="{StaticResource PinDigitBox}" Margin="0,0,10,0"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="0"/>
                <TextBox x:Name="D2" Style="{StaticResource PinDigitBox}" Margin="0,0,10,0"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="1"/>
                <TextBox x:Name="D3" Style="{StaticResource PinDigitBox}" Margin="0,0,10,0"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="2"/>
                <TextBox x:Name="D4" Style="{StaticResource PinDigitBox}" Margin="0,0,10,0"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="3"/>
                <TextBox x:Name="D5" Style="{StaticResource PinDigitBox}" Margin="0,0,10,0"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="4"/>
                <TextBox x:Name="D6" Style="{StaticResource PinDigitBox}"
                         PreviewTextInput="Digit_PreviewTextInput" KeyDown="Digit_KeyDown"
                         PreviewKeyDown="Digit_PreviewKeyDown" TextChanged="Digit_TextChanged"
                         DataObject.Pasting="Digit_Pasting" Tag="5"/>
            </StackPanel>

            <!-- Resend row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="¿No recibiste el código?  "
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="TxtCountdown" Text="Reenviar en 0:45"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextDisabled}"/>
                <Button x:Name="BtnResend" Content="Reenviar código"
                        Style="{StaticResource LinkButton}"
                        Visibility="Collapsed" Click="BtnResend_Click"/>
            </StackPanel>

            <!-- Error -->
            <Border x:Name="ErrorContainer" CornerRadius="6" Background="#FEE2E2"
                    Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="LblError" FontFamily="Segoe UI" FontSize="13"
                           Foreground="#B91C1C" TextWrapping="Wrap"/>
            </Border>

            <!-- Verify button -->
            <Button x:Name="BtnVerify" Content="Verificar código"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="BtnVerify_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
