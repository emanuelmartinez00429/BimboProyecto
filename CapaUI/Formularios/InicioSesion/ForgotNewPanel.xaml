<UserControl x:Class="CapaUI.Formularios.InicioSesion.ForgotNewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/InicioSesion/LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>

        <!-- ══════ FORM STATE ══════ -->
        <StackPanel x:Name="FormPanel" Margin="56,32,56,24">

            <!-- Back -->
            <Button Content="← Volver" Style="{StaticResource BackLinkButton}" Click="BtnBack_Click"/>

            <!-- Title -->
            <TextBlock Text="Crea una nueva contraseña" FontFamily="Segoe UI" FontSize="24"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Text="Asegúrate de que sea diferente a las anteriores."
                       FontFamily="Segoe UI" FontSize="14"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,22"/>

            <!-- Nueva contraseña -->
            <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
            <Border x:Name="Pass1Border" CornerRadius="8" BorderThickness="1.5"
                    BorderBrush="{StaticResource BorderDefault}" Background="White"
                    Height="44" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z"
                                  Fill="#9CA3AF"/>
                        </Canvas>
                    </Viewbox>
                    <PasswordBox x:Name="TxtNew" Grid.Column="1"
                                 Style="{StaticResource InputPasswordBox}"
                                 MaxLength="72"
                                 GotFocus="Pass_GotFocus" LostFocus="Pass_LostFocus"
                                 PasswordChanged="TxtNew_Changed"/>
                    <TextBox x:Name="TxtNewVisible" Grid.Column="1"
                             Style="{StaticResource InputTextBox}" Visibility="Collapsed"
                             MaxLength="72"
                             GotFocus="Pass_GotFocus" LostFocus="Pass_LostFocus"/>
                    <Button Grid.Column="2" Width="40" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnToggle1_Click"
                            ToolTip="Mostrar u ocultar contraseña"
                            AutomationProperties.Name="Mostrar u ocultar contraseña">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                                      Fill="#9CA3AF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Strength meter -->
            <StackPanel x:Name="StrengthPanel" Visibility="Collapsed" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border x:Name="Bar1" Height="4" Width="62" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                    <Border x:Name="Bar2" Height="4" Width="62" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                    <Border x:Name="Bar3" Height="4" Width="62" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                    <Border x:Name="Bar4" Height="4" Width="62" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                    <Border x:Name="Bar5" Height="4" Width="62" CornerRadius="2" Background="#E5E7EB"/>
                </StackPanel>
                <TextBlock x:Name="StrengthLabel" FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <!-- Confirmar contraseña -->
            <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
            <Border x:Name="Pass2Border" CornerRadius="8" BorderThickness="1.5"
                    BorderBrush="{StaticResource BorderDefault}" Background="White"
                    Height="44" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z"
                                  Fill="#9CA3AF"/>
                        </Canvas>
                    </Viewbox>
                    <PasswordBox x:Name="TxtConfirm" Grid.Column="1"
                                 Style="{StaticResource InputPasswordBox}"
                                 MaxLength="72"
                                 GotFocus="Pass_GotFocus" LostFocus="Pass_LostFocus"
                                 PasswordChanged="TxtConfirm_Changed"/>
                    <TextBox x:Name="TxtConfirmVisible" Grid.Column="1"
                             Style="{StaticResource InputTextBox}" Visibility="Collapsed"
                             MaxLength="72"
                             GotFocus="Pass_GotFocus" LostFocus="Pass_LostFocus"/>
                    <Button Grid.Column="2" Width="40" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnToggle2_Click"
                            ToolTip="Mostrar u ocultar contraseña"
                            AutomationProperties.Name="Mostrar u ocultar contraseña">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                                      Fill="#9CA3AF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Mismatch error -->
            <TextBlock x:Name="LblMismatch" Text="Las contraseñas no coinciden."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#B91C1C"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <!-- Show passwords checkbox -->
            <CheckBox x:Name="ChkShow" Content="Mostrar contraseñas"
                      Style="{StaticResource CustomCheckBox}"
                      Margin="0,0,0,14" Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>

            <!-- Rules checklist -->
            <Border CornerRadius="8" Background="{StaticResource SurfaceAlt}"
                    Padding="16,12" Margin="0,0,0,18">
                <UniformGrid Columns="2" Rows="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="R1Icon" Width="10" Height="10" Margin="0,0,8,0"
                                 Stroke="#D1D5DB" StrokeThickness="1.5" Fill="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="R1Text" Text="Al menos 8 caracteres"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
                        <Ellipse x:Name="R2Icon" Width="10" Height="10" Margin="0,0,8,0"
                                 Stroke="#D1D5DB" StrokeThickness="1.5" Fill="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="R2Text" Text="Una letra mayúscula"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="R3Icon" Width="10" Height="10" Margin="0,0,8,0"
                                 Stroke="#D1D5DB" StrokeThickness="1.5" Fill="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="R3Text" Text="Un número"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <Ellipse x:Name="R4Icon" Width="10" Height="10" Margin="0,0,8,0"
                                 Stroke="#D1D5DB" StrokeThickness="1.5" Fill="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="R4Text" Text="Un símbolo (!, @, #…)"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource TextDisabled}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Error -->
            <Border x:Name="ErrorContainer" CornerRadius="6" Background="#FEE2E2"
                    Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="LblError" FontFamily="Segoe UI" FontSize="13"
                           Foreground="#B91C1C" TextWrapping="Wrap"/>
            </Border>

            <!-- Submit button -->
            <Button x:Name="BtnSubmit" Content="Actualizar contraseña"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="BtnSubmit_Click"/>
        </StackPanel>

        <!-- ══════ SUCCESS STATE ══════ -->
        <StackPanel x:Name="SuccessPanel" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="56,0,56,0">
            <Border Width="72" Height="72" CornerRadius="36"
                    Background="{StaticResource SuccessSoft}"
                    HorizontalAlignment="Center" Margin="0,48,0,24">
                <Viewbox Width="36" Height="36">
                    <Canvas Width="48" Height="48">
                        <Path Data="M10,24 L20,34 L38,14"
                              Stroke="#10B981" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="Contraseña actualizada"
                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimary}"
                       TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Tu contraseña fue cambiada con éxito. Ya puedes iniciar sesión con tus nuevas credenciales."
                       FontFamily="Segoe UI" FontSize="14"
                       Foreground="{StaticResource TextMuted}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,0,28"/>
            <Button x:Name="BtnGoToLogin" Content="Ir al inicio de sesión"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,48"
                    Click="BtnGoToLogin_Click"/>
        </StackPanel>

      </Grid>
    </ScrollViewer>
</UserControl>
