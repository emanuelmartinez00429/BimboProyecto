<Window x:Class="CapaUI.Formularios.InicioSesion.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CapaUI.Core.Controls"
        Title="BimboPesaje" Width="900" Height="560"
        WindowStyle="SingleBorderWindow"
        Background="#F4F5F7" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F4F5F7" BorderBrush="#C8CDD6" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: Brand Panel ══════ -->
            <Border Grid.Column="0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.35,0" EndPoint="0.65,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0"/>
                        <GradientStop Color="#152A66" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                    <!-- Grid para poder superponer el spinner chico sobre el logo mientras
                         se resuelve/descarga una versión nueva (LogoEmpresaCache). Visibility
                         del spinner se maneja SOLO desde code-behind (IniciarLogoSpinner /
                         DetenerLogoSpinner) — nunca bindeada, para no repetir el problema
                         documentado en [[WPF - Esqueleto con Shimmer (Skeleton Loading)]]. -->
                    <Grid Margin="0,0,0,28" Width="275" Height="205">
                        <Image x:Name="LogoImage"
                               Source="pack://application:,,,/CapaUI;component/Resources/bimbo_no_bg.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                        <Grid x:Name="LogoSpinner" Width="40" Height="40" Visibility="Collapsed">
                            <Ellipse StrokeThickness="3" Stroke="#33FFFFFF" Fill="Transparent"/>
                            <Canvas Width="40" Height="40">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="LogoSpinnerRotate" CenterX="20" CenterY="20"/>
                                </Canvas.RenderTransform>
                                <Path StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent" Stroke="White">
                                    <!-- Arco del spinner como StreamGeometry: el conversor del
                                         minilenguaje la devuelve ya congelada, asi que no engancha la
                                         tabla de notificacion de cambios al hilo de UI ni instancia un
                                         PathFigure y un ArcSegment por separado. El trazado es identico
                                         al PathGeometry que reemplaza — verificado con GetFlattenedPathGeometry:
                                         mismo Bounds y desvio maximo 0,000000 px. Lo que gira es el
                                         RotateTransform de arriba, no la geometria, asi que congelarla
                                         no rompe la animacion. -->
                                    <Path.Data>M20,2 A18,18 0 0 1 38,20</Path.Data>
                                </Path>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <TextBlock Text="Portal Interno"
                               FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"
                               Foreground="White" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Sistema de gestión y pesajes"
                               FontFamily="Segoe UI" FontSize="15"
                               TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.75"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════ RIGHT: Chrome + Content ══════ -->
            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Chrome bar (draggable) -->
                <Border Grid.Row="0" Background="White"
                        BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="ChromeBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="TitleBarText" Text="Iniciar sesión"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontFamily="Segoe UI" FontSize="15" Foreground="#6B7280"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource ChromeButton}" Click="BtnMinimize_Click"
                                    ToolTip="Minimizar">
                                <TextBlock Text="&#x2014;" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource ChromeCloseButton}" Click="BtnClose_Click"
                                    ToolTip="Cerrar">
                                <TextBlock Text="&#x2715;" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ LOGIN PANEL ══ -->
                <!-- Sin barra vertical: en una ventana de tamaño fijo la barra solo
                     aparecía al mostrarse el error, pegada al borde y sin recorrido útil.
                     El espacio del mensaje se reserva desde el arranque (ver ErrorContainer),
                     así que el contenido entra siempre y no hay nada que scrollear. -->
                <ScrollViewer x:Name="LoginPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- Márgenes verticales 44/24 → 28/16: los 24px que se liberan son los
                         que le hacen lugar al error sin tocar el tamaño de la ventana ni el
                         ritmo entre campos. -->
                    <StackPanel Margin="56,28,56,16" VerticalAlignment="Center">

                        <TextBlock Text="Bienvenido" FontFamily="Segoe UI" FontSize="14"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock Text="Iniciar sesión" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="Ingresa tus credenciales para continuar."
                                   FontFamily="Segoe UI" FontSize="16"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,22"/>

                        <!-- Usuario -->
                        <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="EmailBorder" CornerRadius="8" BorderThickness="1.5"
                                BorderBrush="{StaticResource BorderDefault}" Background="White"
                                Height="44" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z"
                                              Fill="#9CA3AF"/>
                                    </Canvas>
                                </Viewbox>
                                <controls:GhostTextBox x:Name="TxtEmail" Grid.Column="1"
                                         InnerGotFocus="Input_GotFocus" InnerLostFocus="Input_LostFocus"
                                         TextChanged="Fields_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Contraseña -->
                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="PassBorder" CornerRadius="8" BorderThickness="1.5"
                                BorderBrush="{StaticResource BorderDefault}" Background="White"
                                Height="44" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z"
                                              Fill="#9CA3AF"/>
                                    </Canvas>
                                </Viewbox>
                                <PasswordBox x:Name="TxtPassword" Grid.Column="1"
                                             Style="{StaticResource InputPasswordBox}"
                                             FontSize="15"
                                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                             KeyDown="Field_KeyDown" PasswordChanged="Fields_Changed"/>
                                <TextBox x:Name="TxtPasswordVisible" Grid.Column="1"
                                         Style="{StaticResource InputTextBox}"
                                         Visibility="Collapsed"
                                         GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                         KeyDown="Field_KeyDown" TextChanged="Fields_Changed"/>
                                <Button x:Name="BtnTogglePwd" Grid.Column="2" Width="40"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Click="BtnTogglePwd_Click">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="EyePath"
                                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                                                  Fill="#9CA3AF"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Recordar / Olvidaste -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Recordar mi usuario"
                                      IsChecked="{Binding RecordarUsuario, Mode=TwoWay}"
                                      Style="{StaticResource CustomCheckBox}"/>
                            <Button Grid.Column="1" Content="¿Olvidaste tu contraseña?"
                                    Style="{StaticResource LinkButton}"
                                    Click="BtnForgot_Click"/>
                        </Grid>

                        <!-- Error -->
                        <!-- Hidden y no Collapsed: ocupa su lugar aunque no se vea, así el
                             formulario no salta ni empuja al botón cuando aparece el mensaje. -->
                        <Border x:Name="ErrorContainer" CornerRadius="6" Background="#FEE2E2"
                                Padding="12,8" Margin="0,0,0,10" MinHeight="34" Visibility="Hidden">
                            <TextBlock x:Name="LblError" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#B91C1C" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Botón ingresar -->
                        <Button x:Name="BtnIngresar" Content="Entrar"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="BtnIngresar_Click" Margin="0,0,0,12"/>

                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="14"
                                   Foreground="{StaticResource TextDisabled}">
                            <Run Text="Presiona "/>
                            <Run Text="[Enter]" FontFamily="Consolas" FontWeight="SemiBold"/>
                            <Run Text=" para iniciar sesión"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock Text="🛡 Conexión segura · PROD" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextDisabled}"/>
                            <TextBlock Text="   ·   " FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextDisabled}"/>
                            <TextBlock Text="v1.0.0" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextDisabled}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══ FORGOT PANEL (host para navegación recuperar contraseña) ══ -->
                <ContentControl x:Name="ForgotContent" Grid.Row="1" Visibility="Collapsed"/>

                <!-- ══ LOADING PANEL ══ -->
                <Grid x:Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid VerticalAlignment="Center" Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Spinner -->
                        <Grid Grid.Row="0" Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse StrokeThickness="4" Stroke="#E5E7EB" Fill="Transparent"/>
                            <Canvas Width="72" Height="72">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" CenterX="36" CenterY="36"/>
                                </Canvas.RenderTransform>
                                <Path StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent">
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource EmpresaPrimaryColor}"/>
                                    </Path.Stroke>
                                    <!-- Mismo caso que el spinner del logo: StreamGeometry congelada,
                                         trazado identico (desvio 0,000000 px). El Stroke SI queda vivo
                                         — usa {DynamicResource EmpresaPrimaryColor} y cambia con el tema. -->
                                    <Path.Data>M36,4 A32,32 0 0 1 68,36</Path.Data>
                                </Path>
                            </Canvas>
                            <TextBlock x:Name="TxtProgress" Text="0%"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimary}"/>
                        </Grid>

                        <!-- Título -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                            <TextBlock Text="Iniciando sesión" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Esto tomará solo un momento."
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Progress bar -->
                        <Border Grid.Row="4" x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#E5E7EB">
                            <Border x:Name="ProgressBar" CornerRadius="2" Background="{DynamicResource EmpresaPrimaryBrush}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Border>

                        <!-- Steps -->
                        <Border Grid.Row="6" Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="S1Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent">
                                        <TextBlock x:Name="S1Check" Text="✓" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock x:Name="S1Text" Grid.Column="1" Text="Verificando credenciales" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="S2Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent">
                                        <TextBlock x:Name="S2Check" Text="✓" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock x:Name="S2Text" Grid.Column="1" Text="Cargando perfil de usuario" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="S3Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent">
                                        <TextBlock x:Name="S3Check" Text="✓" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock x:Name="S3Text" Grid.Column="1" Text="Sincronizando módulos" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="S4Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent">
                                        <TextBlock x:Name="S4Check" Text="✓" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock x:Name="S4Text" Grid.Column="1" Text="Preparando espacio de trabajo" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
