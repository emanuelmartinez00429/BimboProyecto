<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.PesajeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Pesaje"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             Background="#EAF1F8"
             DataContext="{x:Null}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos/geometrias compartidos viven en Styles.xaml; el disenador
                     de VS no ejecuta App.xaml y no los ve sin este merge. Ver ADR-028 / P-057. -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- ── Iconos ── -->
        <Geometry x:Key="IcoScale">M12,3 v18 M5,7 h14 M5,7 L3,12 a3,3 0 0 0 6,0 L7,7 M19,7 l-2,5 a3,3 0 0 0 6,0 l-2,-5 M8,21 h8</Geometry>
        <Geometry x:Key="IcoTruck">M1,7 h15 v10 h-15 z M16,10 h3.5 l3,3.5 V17 h-6.5 z</Geometry>
        <Geometry x:Key="IcoPack">M21,8 l-9,-5 -9,5 9,5 9,-5 z M3,8 v8 l9,5 9,-5 V8 M12,13 v8</Geometry>
        <Geometry x:Key="IcoPlus">M12,5 v14 M5,12 h14</Geometry>
        <Geometry x:Key="IcoPencil">M11,4 H4 a2,2 0 0 0,-2,2 v14 a2,2 0 0 0,2,2 h14 a2,2 0 0 0,2,-2 v-7 M18.5,2.5 a2.12,2.12 0 0 1,3,3 L12,15 l-4,1 1,-4 z</Geometry>
        <Geometry x:Key="IcoTrash">M3,6 h18 M8,6 V4 a1,1 0 0 1,1,-1 h6 a1,1 0 0 1,1,1 v2 m2,0 v14 a2,2 0 0 1,-2,2 H7 a2,2 0 0 1,-2,-2 V6</Geometry>
        <Geometry x:Key="IcoDownload">M12,3 v12 m0,0 l-4,-4 m4,4 l4,-4 M4,19 h16</Geometry>
        <Geometry x:Key="IcoCheck">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IcoCheckDbl">M9,11 l3,3 L22,4 M21,12 v7 a2,2 0 0 1,-2,2 H5 a2,2 0 0 1,-2,-2 V5 a2,2 0 0 1,2,-2 h11</Geometry>

        <!-- ── Card header de panel ── -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Toolbar buttons (small) ── -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolPrimary" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolSuccess" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolDanger" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El basurero de fila de esta pantalla es el estilo global BasureroCelda
             (Resources/Styles.xaml). El BotonQuitarFila local se eliminó al migrar
             sus dos usos (quitar camión / quitar producto) a ese estilo. -->
        <!-- Ámbar, no rojo: "cerrar/terminar" (BtnCamionCerrar y
             BtnCerrarTodos) es una acción de riesgo (no se deshace con un
             clic), pero semánticamente distinta de "eliminar" (ToolDanger,
             rojo #DC2626 — borra un registro). Comparten la misma familia
             tonal pastel para que ninguna de las dos grite más que la otra,
             pero en hues distintos así no se confunden como "dos rojos": rojo
             = quitar, ámbar = finalizar. Lo que agrega o genera se queda en
             verde (ToolSuccess/ToolPrimary).

             NO usa BasedOn="{StaticResource ToolBtn}": el ControlTemplate
             compartido de ToolBtn tiene un trigger de hover pensado para el
             botón outline (fondo blanco → celeste pálido #EFF6FF), y ese
             mismo trigger se hereda tal cual en cualquier estilo basado en
             él — en un botón SÓLIDO como este, el hover le pisaba el fondo
             ámbar por ese celeste sin tocar el texto (que sigue blanco), y
             quedaba casi invisible. Acá el hover oscurece el propio ámbar en
             vez de cambiar de paleta, así el texto blanco nunca deja de
             leerse. Copia el resto de ToolBtn (radio, padding, tipografía)
             a mano para no modificar ese estilo compartido — lo usan otros
             botones que no tienen este problema. -->
        <Style x:Key="ToolWarn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D9924A"/>
            <Setter Property="BorderBrush" Value="#DFA060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C17F3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C17F3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Segmented toggle (RadioButton) ── -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6BCC6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid header/row/cell ── -->
        <Style x:Key="PgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{DynamicResource EmpresaPrimaryBrush}" Padding="10,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Verde y no el azul de marca (EmpresaPrimaryBrush): la selección
                                     de fila es un estado propio, distinto de "Abierto" (que también
                                     usa verde) pero pedido explícitamente en verde para diferenciarse
                                     del hover (#EAF1FB, celeste) que queda como estaba. -->
                                <Border x:Name="Sel" Width="3" HorizontalAlignment="Left"
                                        Background="#16A34A" Visibility="Collapsed" Panel.ZIndex="1"/>
                                <DataGridCellsPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="B" Property="Background" Value="#F5F8FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#EAF1FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PgCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Texto de celda (Entradas) -->
        <Style x:Key="EntText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Chip código -->
        <Style x:Key="CodeChip" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido -->
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Data="{StaticResource IcoScale}" Stroke="White" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280">
                            <Run Text="Producción"/><Run Text="  /  "/><Run Text="Recepción de Materia Prima" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                        </TextBlock>
                        <TextBlock Text="Recepción de materia prima" FontFamily="Segoe UI" FontSize="21"
                                   FontWeight="Bold" Foreground="#1A1F2E" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2F8" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CAMIONES" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CamionesTexto}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVOS" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#047857" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CamionesActivos}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══ CUERPO: dos columnas ══
                 Izquierda (Camiones sobre Movimiento) y derecha (Entradas a
                 altura completa). Antes eran tres paneles apilados en filas, con
                 Entradas a todo el ancho abajo: el pesaje se lee mejor con la
                 grilla de entradas alta y a la vista todo el tiempo, al lado del
                 producto que se está pesando, en vez de relegada al pie. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.765*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Columna izquierda: Camiones + Movimiento ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                <!-- Panel Camiones -->
                <!-- Fondo estático con sombra: se rasteriza una sola vez en GPU y no se invalida al scrollear -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1">
                    <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                </Border>
                <!-- Contenido interactivo limpio (renderizado directo a pantalla sin shader intermedio) -->
                <Grid Grid.Row="0" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Camiones de Entrega" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#EFF6FF" CornerRadius="999" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CamionesCount}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Agrupada por placa: un camión que trae carga de dos proveedores
                             son dos recepciones en la base (una por proveedor, cada una con
                             su manifiesto), pero UN camión en el andén. El encabezado de
                             grupo muestra la placa una sola vez y se colapsa cuando la placa
                             tiene una sola recepción — el caso normal no paga ruido visual. -->
                        <ListBox x:Name="LstCamiones" Grid.Row="1"
                                 ItemsSource="{Binding Camiones}"
                                 AlternationCount="2"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="LstCamiones_SelectionChanged"
                                 MouseDoubleClick="LstCamiones_DoubleClick"
                                 PreviewKeyDown="LstCamiones_PreviewKeyDown">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                            </ListBox.Resources>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <!-- "Tarjeta": envuelve encabezado + filas en un bloque con
                                                             borde redondeado, sombra sutil y separación del próximo
                                                             grupo — así cada camión se lee como una unidad propia y
                                                             no como filas sueltas de una lista continua. Se desarma
                                                             (sin borde, sin sombra, sin margen) cuando ningún camión
                                                             de la lista comparte placa: ahí no hay nada que agrupar. -->
                                                        <Border x:Name="Tarjeta" Margin="0,0,0,10" CornerRadius="10"
                                                                BorderBrush="#D7E3F5" BorderThickness="1.3" ClipToBounds="True">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#1A2A44" Opacity="0.07" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <!-- Encabezado de la placa compartida: fondo claro (un bloque
                                                                     sólido de azul repetido por cada camión pesaba demasiado
                                                                     en una lista larga). Lo que se destaca es SOLO la placa,
                                                                     con su propio chip sólido — no toda la franja. -->
                                                                <Border x:Name="Cab" Grid.Row="0" Background="#EFF6FF"
                                                                        BorderBrush="#DBE7F5" BorderThickness="0,0,0,1"
                                                                        Padding="14,8">
                                                                    <Grid>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource IcoTruck}" Stroke="{DynamicResource EmpresaPrimaryBrush}"
                                                                                  StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"
                                                                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                            <Border Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="6" Padding="8,3">
                                                                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="14"
                                                                                           FontWeight="Bold" Foreground="White"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <Border Background="#DBE7F5" CornerRadius="999" Padding="8,2"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <TextBlock FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource EmpresaPrimaryBrush}"
                                                                                       Text="{Binding ItemCount, StringFormat='{}{0} recepciones'}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                                                                <Setter Property="Text" Value="1 recepción"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Barra que ata las recepciones de la misma placa -->
                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="Barra" Grid.Column="0" Width="4"
                                                                            Background="{DynamicResource EmpresaPrimaryBrush}"/>
                                                                    <ItemsPresenter Grid.Column="1"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <!-- Ningún camión de la lista comparte placa con otro: no
                                                                 hay nada que agrupar, así que la tarjeta se desarma —
                                                                 vuelve a ser una fila plana, igual que antes de tener
                                                                 grupos. -->
                                                            <DataTrigger Binding="{Binding DataContext.HayPlacaCompartida, ElementName=LstCamiones}" Value="False">
                                                                <Setter TargetName="Cab" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="Tarjeta" Property="Margin" Value="0"/>
                                                                <Setter TargetName="Tarjeta" Property="BorderThickness" Value="0"/>
                                                                <Setter TargetName="Tarjeta" Property="CornerRadius" Value="0"/>
                                                                <Setter TargetName="Tarjeta" Property="Effect" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                            <!-- Una sola recepción en ESTE grupo: no hay nada que atar,
                                                                 aunque la tarjeta y el encabezado de arriba sí se
                                                                 muestren. -->
                                                            <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                                <Setter TargetName="Barra" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="B" Background="White" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <!-- Verde y no el azul de marca: mismo criterio que PgRow
                                                             (tabla de Movimiento) — selección en verde, hover se
                                                             queda en celeste (#EAF1FB). -->
                                                        <Border x:Name="Sel" Width="3" HorizontalAlignment="Left" Background="#16A34A" Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="B" Property="Background" Value="#F5F8FC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#EAF1FB"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#DCFCE7"/>
                                                        <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Margin="14,0,14,0": mismo inset horizontal a los dos lados.
                                         La scrollbar de la lista es Auto (arriba, LstCamiones) — solo
                                         reserva su ancho cuando hace falta scrollear, así que en el
                                         caso normal (todo entra sin scroll) los dos lados quedan
                                         simétricos de verdad, sin compensar un ancho de scrollbar a mano. -->
                                    <Grid Height="46" Margin="14,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CodeChip}" Grid.Column="0">
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                        </Border>
                                        <!-- Con la placa compartida, lo que distingue a cada fila ya
                                             NO es la placa (es la misma, y está en el encabezado del
                                             grupo) sino el proveedor: se oculta la placa y el
                                             proveedor toma el estilo primario que ella tenía. -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                            <!-- El header de arriba ya muestra la placa apenas hay algún
                                                 camión agrupado en la lista (HayPlacaCompartida), así que la
                                                 fila deja de repetirla — no solo cuando ESTE camión puntual
                                                 comparte placa (PlacaCompartida), sino siempre que el header
                                                 esté visible para cualquier camión de la lista. -->
                                            <TextBlock Text="{Binding Placa}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#1A1F2E">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.HayPlacaCompartida, ElementName=LstCamiones}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Proveedor}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.HayPlacaCompartida, ElementName=LstCamiones}" Value="True">
                                                                <Setter Property="FontSize" Value="15"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#1A1F2E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                CornerRadius="999" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding Estado}" FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <!-- Basurero de la fila: reemplaza al botón "Quitar" que antes
                                             vivía aparte en la toolbar de abajo. Tag="{Binding}" lleva el
                                             camión de ESTA fila al handler, sin depender de la selección. -->
                                        <Button Grid.Column="3" Style="{StaticResource BasureroCelda}" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}" Click="QuitarCamion_Click"
                                                IsEnabled="{Binding PuedeQuitar}"
                                                ToolTip="{Binding MotivoQuitar}"
                                                ToolTipService.ShowOnDisabled="True"
                                                permisos:PermisoBehavior.Requiere="Cancelar Pesaje"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Toolbar camiones — un solo botón de edición: abre el megamodal
                             con todo el proceso (camión + productos). "Quitar" ya no vive
                             acá: es el basurero de la propia fila en la lista de arriba
                             (columna ESTADO), igual que "Quitar" en el megamodal de
                             productos — así cada fila se borra directo, sin tener que
                             seleccionarla primero.

                             Una sola fila de tres celdas iguales: con los textos cortos
                             entran holgados en el ancho de la columna, y las acciones
                             quedan a la vista sin segunda fila. UniformGrid y no WrapPanel -->
                        <WrapPanel Grid.Row="2" Margin="12,8">
                            <Button x:Name="BtnCamionAgregar" Style="{StaticResource ToolSuccess}" Margin="0,0,6,4" Click="BtnNuevoProceso_Click" permisos:PermisoBehavior.Requiere="Registrar Entrada" ToolTip="Iniciar un nuevo proceso de descarga">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPlus}" Stroke="White" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCamionEditar" Style="{StaticResource ToolPrimary}" Margin="0,0,6,4" Click="BtnEditarProceso_Click" permisos:PermisoBehavior.Requiere="Modificar Pesaje" ToolTip="Editar el proceso: camión y productos">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPencil}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCamionCerrar" Style="{StaticResource ToolWarn}" Margin="0,0,0,4" Click="BtnCamionCerrar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoCheck}" Stroke="White" StrokeThickness="2.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="TxtBtnCamionCerrar" Text="Cerrar camión" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                <!-- Panel Movimiento -->
                <!-- Fondo estático con sombra: se rasteriza una sola vez en GPU y no se invalida al scrollear -->
                <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1">
                    <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                </Border>
                <!-- Contenido interactivo limpio (renderizado directo a pantalla sin shader intermedio) -->
                <Grid Grid.Row="2" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Movimiento de Materia Prima" Style="{StaticResource PanelTitle}"/>
                                    <Border Background="#EFF6FF" CornerRadius="999" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCamion.Productos.Count}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <!-- El proveedor y no la placa: la placa ya se lee en la fila
                                     seleccionada de Camiones, justo arriba; el proveedor es el
                                     dato que la tabla de productos no repite en ninguna columna. -->
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding SelectedCamion.Proveedor}"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"
                                           TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="MovEmpty" Text="Selecciona un camión para ver sus productos"
                                       FontFamily="Segoe UI" FontSize="14.5" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            <DataGrid x:Name="DgProductos" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                                      AlternationCount="2" RowStyle="{StaticResource PgRow}" CellStyle="{StaticResource PgCell}"
                                      ColumnHeaderStyle="{StaticResource PgHeader}" RowHeight="46"
                                      ItemsSource="{Binding SelectedCamion.Productos}"
                                      SelectionChanged="DgProductos_SelectionChanged" MouseDoubleClick="DgProductos_DoubleClick"
                                      PreviewKeyDown="DgProductos_PreviewKeyDown"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.ScrollChanged="DgProductos_ScrollChanged"
                                      PreviewMouseWheel="DgProductos_PreviewMouseWheel"
                                      SizeChanged="DgProductos_SizeChanged"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Item">
                                <DataGrid.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="CÓDIGO" Width="Auto" MinWidth="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CodeChip}" HorizontalAlignment="Left" Margin="10,0">
                                                    <TextBlock Text="{Binding ProductoCodigo}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductoNombre}" FontFamily="Segoe UI" FontSize="14.5" FontWeight="SemiBold" Foreground="#1A1F2E" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="REST." Width="72" MinWidth="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BultosRestantes, StringFormat=N1}" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#1A1F2E" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="% RESTANTE" Width="120" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                                    <Border x:Name="BarraFondo" Height="5" Background="#E7EDF5" CornerRadius="2" ClipToBounds="True">
                                                        <Border CornerRadius="2" HorizontalAlignment="Left"
                                                                Background="{Binding ProgresoColor}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{x:Static conv:AnchoProporcionalConverter.Instancia}">
                                                                    <Binding Path="EscalaRecibido"/>
                                                                    <Binding Path="ActualWidth" ElementName="BarraFondo"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Text="{Binding ProgresoTexto}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ESTADO" Width="104" MinWidth="104">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,3" Margin="10,0" HorizontalAlignment="Center" Cursor="Hand"
                                                        MouseLeftButtonUp="EstadoProducto_Click" ToolTip="Clic para cambiar estado">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#9CA3AF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="{Binding Estado}" FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                            <Setter Property="Foreground" Value="#047857"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Basurero al final de la fila: la acción de quitar vive donde
                                         está la fila, no en la barra. Se deshabilita solo (gris, con
                                         el motivo en el ToolTip) cuando la regla no lo permite. -->
                                    <DataGridTemplateColumn Header="" Width="52" CanUserResize="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BasureroCelda}" Tag="{Binding}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        IsEnabled="{Binding PuedeQuitar}"
                                                        ToolTip="{Binding MotivoQuitar}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Click="QuitarProducto_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Cambiar de camión sí pega a la base (CargarProductosAsync):
                                 sin esto, la tabla se quedaba mostrando el camión anterior
                                 hasta que respondía la consulta, sin ningún indicio de que
                                 algo estaba pasando. Mismo patrón code-behind que el resto
                                 de la app (nunca Visibility bindeada en XAML). -->
                            <Border x:Name="CargandoMovimiento" Background="White" Visibility="Collapsed" Panel.ZIndex="50">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Path x:Name="SpinnerMovimiento"
                                          Data="M 12 2 A 10 10 0 1 1 2 12"
                                          Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="18" Height="18" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5" Margin="0,0,9,0">
                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="Actualizando productos..."
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="12,8">
                            <Button x:Name="BtnProdAgregar" Style="{StaticResource ToolSuccess}" Margin="0,0,6,4" Click="BtnProdAgregar_Click" ToolTip="Agregar un producto al camión">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPlus}" Stroke="White" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdEditar" Style="{StaticResource ToolPrimary}" Margin="0,0,6,4" Click="BtnProdEditar_Click" ToolTip="Editar el producto seleccionado">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPencil}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdPesar" Style="{StaticResource ToolPrimary}" Margin="0,0,6,4" Click="BtnProdPesar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoScale}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Pesar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdCerrar" Style="{StaticResource ToolWarn}" Margin="0,0,0,4" Click="BtnProdCerrar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoCheck}" Stroke="White" StrokeThickness="2.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="TxtBtnProdCerrar" Text="Cerrar producto" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <!-- ── Columna derecha: Entradas, a altura completa ── -->
                <!-- Fondo estático con sombra: se rasteriza una sola vez en GPU y no se invalida al scrollear -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1">
                    <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                </Border>
                <!-- Contenido interactivo limpio (renderizado directo a pantalla sin shader intermedio) -->
                <Grid Grid.Column="2" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Entradas de M. Prima" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#EFF6FF" CornerRadius="999" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilasEntradas.Count}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                </Border>
                                <!-- Qué producto se está viendo. Solo en modo "Producto actual":
                                     en "Todo el camión" la tabla ya trae su columna PRODUCTO y el
                                     rótulo mentiría al nombrar uno solo. Lo muestra ActualizarUI. -->
                                <TextBlock x:Name="TxtProductoEnVista" Visibility="Collapsed"
                                           FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#F7F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbVistaProducto" GroupName="VistaEntradas" Style="{StaticResource SegBtn}" Content="Producto actual" IsChecked="True" Checked="RbVista_Changed"
                                                 ToolTipService.ShowOnDisabled="True"/>
                                    <RadioButton x:Name="RbVistaCamion" GroupName="VistaEntradas" Style="{StaticResource SegBtn}" Content="Todo el camión" Checked="RbVista_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Mismo componente que las grillas CRUD (EmptyStateOverlay), con el
                             icono de balanza en vez del de documento: acá el vacío no es "no
                             hay datos", es "todavía no empezaste a pesar". Va por encima de la
                             grilla y no la reemplaza, así los encabezados siguen a la vista. -->
                        <controls:EmptyStateOverlay x:Name="EntEmpty" Panel.ZIndex="5"
                                                    HeaderOffset="44"
                                                    Icono="{StaticResource IcoScale}"
                                                    Mensaje="Aún no hay pesajes registrados"/>
                        <DataGrid x:Name="DgEntradas" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                                  AlternationCount="2" RowStyle="{StaticResource PgRow}" CellStyle="{StaticResource PgCell}"
                                  ColumnHeaderStyle="{StaticResource PgHeader}" RowHeight="40"
                                  ItemsSource="{Binding FilasEntradas}"
                                  SelectionChanged="DgEntradas_SelectionChanged"
                                  MouseDoubleClick="DgEntradas_DoubleClick"
                                  PreviewKeyDown="DgEntradas_PreviewKeyDown"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.ScrollChanged="DgEntradas_ScrollChanged"
                                  PreviewMouseWheel="DgEntradas_PreviewMouseWheel"
                                  SizeChanged="DgEntradas_SizeChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item">
                            <!-- Misma barra fina de ProductosView (ahora en Styles.xaml global). -->
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Posición visual directa ligada a NumeroFila en memoria, sin
                                     sobrecarga de ItemContainerGenerator ni triggers de string. -->
                                <DataGridTextColumn Header="#" Binding="{Binding NumeroFila}" Width="52" MinWidth="48"
                                                    CanUserResize="False" CanUserReorder="False"
                                                    CellStyle="{StaticResource CeldaCentrada}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Siempre visible, aunque se repita fila tras fila en "Producto
                                     actual" — es más fácil detectar de qué producto es cada entrada
                                     que confiar en recordar cuál está seleccionado arriba. -->
                                <DataGridTextColumn x:Name="ColEntProducto" Header="PRODUCTO" Binding="{Binding ProdNombre}" Width="3.5*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1A1F2E"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="BRUTO (KG)" Binding="{Binding Bruto, StringFormat=N2}" Width="1.1*" MinWidth="96" ElementStyle="{StaticResource EntText}"/>
                                <DataGridTextColumn Header="TARA (KG)" Binding="{Binding TaraTotal, StringFormat=N2}" Width="1*" MinWidth="90" ElementStyle="{StaticResource EntText}"/>
                                <!-- Tara extra por pesada. En chip ámbar cuando está en cero:
                                     esa pesada todavía no tiene las tarimas pesadas, que es
                                     justo lo que vuelve aproximados sus bultos. Mismo criterio
                                     que la columna BULTOS, atado a la misma propiedad. -->
                                <DataGridTemplateColumn Header="TARA EXTRA" Width="1.1*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ChipTara" CornerRadius="999" Padding="8,2" HorizontalAlignment="Center"
                                                    Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="PuntoTara" Width="5" Height="5" CornerRadius="3" Background="#D97706"
                                                            Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="TxtTara" Text="{Binding TaraExtra, StringFormat=N2}"
                                                                FontFamily="Segoe UI" FontSize="14" Foreground="#1A1F2E"
                                                                VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding BultosAproximados}" Value="True">
                                                    <Setter TargetName="ChipTara"  Property="Background" Value="#FEF3C7"/>
                                                    <Setter TargetName="ChipTara"  Property="ToolTip" Value="Esta pesada no tiene tara extra registrada"/>
                                                    <Setter TargetName="PuntoTara" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="TxtTara"   Property="Foreground" Value="#B45309"/>
                                                    <Setter TargetName="TxtTara"   Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="NETO (KG)" Binding="{Binding Neto, StringFormat=N2}" Width="1.1*" MinWidth="96">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Los bultos ya no se capturan: se estiman desde el peso. En ámbar
                                     cuando la pesada no tiene tara extra y la estimación es alta. -->
                                <DataGridTextColumn Header="BULTOS" Binding="{Binding BultosTexto}" Width="0.9*" MinWidth="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EntText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BultosAproximados}" Value="True">
                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                    <Setter Property="ToolTip" Value="Aproximado: esta pesada no tiene tara extra registrada"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Fecha y hora en una sola celda a dos líneas: se leen siempre
                                     juntas y así el ancho que ocupaban dos columnas queda libre
                                     para los pesos, que son el dato que importa. -->
                                <DataGridTemplateColumn Header="FECHA / HORA" Width="140" MinWidth="135" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Fecha}" FontFamily="Segoe UI" FontSize="13.5" Foreground="#1A1F2E"/>
                                                <TextBlock Text="{Binding Hora}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Basurero al final de la fila: usa el estilo prefabricado
                                     global BasureroCelda (con IcoTrashFila congelado en GPU) y
                                     sin bindings rotos a propiedades inexistentes. -->
                                <DataGridTemplateColumn Header="" Width="52" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BasureroCelda}" Tag="{Binding}"
                                                    ToolTip="Quitar este pesaje"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Click="QuitarEntrada_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Mismo overlay que CargandoMovimiento, scoped a este panel: cambiar
                             de camión también deja obsoleta la tabla de entradas hasta que
                             responde CargarProductosAsync. -->
                        <Border x:Name="CargandoEntradas" Background="White" Visibility="Collapsed" Panel.ZIndex="50">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Path x:Name="SpinnerEntradas"
                                      Data="M 12 2 A 10 10 0 1 1 2 12"
                                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5" Margin="0,0,9,0">
                                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Actualizando pesajes..."
                                           FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Fila TOTAL ──
                         Los anchos de columna replican EXACTAMENTE los del DataGrid de
                         arriba para que cada total caiga bajo su columna. -->
                    <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,9"
                            ClipToBounds="True">
                        <!-- El desplazamiento lo escribe DgEntradas_ScrollChanged: la fila
                             vive fuera del ScrollViewer de la grilla, así que sin esto se
                             quedaría quieta al scrollear en horizontal y los totales
                             dejarían de caer bajo su columna. -->
                        <Grid x:Name="TotalGrid" HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TotalScrollTransform"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <!-- Col 0: #  — mismo Width fijo que DgEntradas Col 0 -->
                                <ColumnDefinition x:Name="TcCol0" Width="52" MinWidth="48"/>
                                <!-- Col 1: PRODUCTO — sincronizado por código -->
                                <ColumnDefinition x:Name="TcCol1" Width="3.5*" MinWidth="180"/>
                                <!-- Col 2: BRUTO (KG) -->
                                <ColumnDefinition x:Name="TcCol2" Width="1.1*" MinWidth="96"/>
                                <!-- Col 3: TARA (KG) -->
                                <ColumnDefinition x:Name="TcCol3" Width="1*" MinWidth="90"/>
                                <!-- Col 4: TARA EXTRA -->
                                <ColumnDefinition x:Name="TcCol4" Width="1.1*" MinWidth="100"/>
                                <!-- Col 5: NETO (KG) -->
                                <ColumnDefinition x:Name="TcCol5" Width="1.1*" MinWidth="96"/>
                                <!-- Col 6: BULTOS -->
                                <ColumnDefinition x:Name="TcCol6" Width="0.9*" MinWidth="85"/>
                                <!-- Col 7: FECHA / HORA — mismo Width fijo que DgEntradas Col 7 -->
                                <ColumnDefinition x:Name="TcCol7" Width="140" MinWidth="135"/>
                                <!-- Col 8: espaciador del botón basurero — mismo Width que DgEntradas Col 8 -->
                                <ColumnDefinition x:Name="TcCol8" Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                        Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <!-- Col 1 vacía: reserva el espacio del nombre de producto -->
                            <TextBlock Grid.Column="2" Text="{Binding TotalBruto, StringFormat=N2}" FontFamily="Segoe UI" FontSize="14"
                                        FontWeight="Bold" Foreground="#1A1F2E" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalTara, StringFormat=N2}" FontFamily="Segoe UI" FontSize="14"
                                        Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding TotalTaraExtra, StringFormat=N2}" FontFamily="Segoe UI" FontSize="14"
                                        Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding TotalNeto, StringFormat=N2}" FontFamily="Segoe UI" FontSize="14"
                                        FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="6" Text="{Binding TotalBultos, StringFormat=N1}" FontFamily="Segoe UI" FontSize="14"
                                        FontWeight="Bold" Foreground="#1A1F2E" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="7" Text="{Binding TotalPesajesTexto}" FontFamily="Segoe UI" FontSize="13"
                                        Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0"/>
                            <!-- Col 8: espaciadora del basurero, no se muestra ningún texto -->
                        </Grid>
                    </Border>

                    <!-- ── Aviso de pesadas sin tara extra ──
                         El TextBlock conserva su x:Name original: ActualizarUI() le sigue
                         escribiendo texto y Visibility igual que antes. El banner cuelga
                         de esa misma Visibility para aparecer y desaparecer con él. -->
                    <Border Grid.Row="3" Background="#FEF9E7" BorderBrush="#FDE68A" BorderThickness="0,1,0,0" Padding="14,9"
                            Visibility="{Binding Visibility, ElementName=TxtAvisoTaraProducto}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAvisoTaraProducto" FontFamily="Segoe UI" FontSize="13.5"
                                           Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProducto.ProductoNombre}"
                                       FontFamily="Segoe UI" FontSize="13" Foreground="#B45309"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="180" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="4" Margin="12,9">
                        <!-- La tara extra (tarimas) se pesa aparte y se reparte entre las
                             pesadas ya registradas del producto o de todo el camión: vive
                             acá, junto a la grilla de esas pesadas. -->
                        <Button x:Name="BtnProdTaraExtra" Style="{StaticResource ToolPrimary}" Margin="0,0,8,0"
                                Click="BtnProdTaraExtra_Click"
                                permisos:PermisoBehavior.Requiere="Modificar Pesaje"
                                ToolTip="Cargar el peso de las tarimas y repartirlo entre las pesadas">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoPack}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="Tara extra" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnEntEditar" Style="{StaticResource ToolPrimary}" Margin="0,0,8,0" Click="BtnEntEditar_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoPencil}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Grid>

            <!-- ══ FOOTER: reporte + cierre masivo ══
                 "Cerrar todos los camiones" se movió acá desde el header: es una
                 acción masiva y poco frecuente (cierra TODOS los camiones abiertos
                 a la vez), no algo que necesite competir por espacio junto al
                 título en cada pantallazo. La fila "*" del cuerpo se acomoda sola
                 al alto que deja este Auto — no hace falta tocar los paneles.

                 "Imprimir reporte" (antes "Descargar", que además cerraba el
                 camión) vive acá, a la izquierda: ahora es independiente de
                 cerrarlo — se puede reimprimir en cualquier momento, esté el
                 camión abierto o cerrado. Cerrar un camión puntual sigue en su
                 propio panel de Camiones ("Cerrar camión"). -->
            <Border Grid.Row="4" BorderBrush="#D8E1EC" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnImprimirReporte" Style="{StaticResource ToolPrimary}" Height="36"
                            Margin="0,0,10,0" Click="BtnImprimirReporte_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoDownload}" Stroke="White" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Imprimir reporte" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCerrarTodos" Style="{StaticResource ToolWarn}" Height="36"
                            Click="BtnCerrarTodos_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoCheckDbl}" Stroke="White" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cerrar todos los camiones" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ CARGA INICIAL ══
             Cubre el contenido solo en la primera carga (cuando todavía no hay nada
             que mostrar). En recargas posteriores no aparece: ya hay datos en pantalla
             y parpadear sería peor. -->
        <Border x:Name="CargandoInicial" Background="#EAF1F8" Visibility="Collapsed" Panel.ZIndex="60">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <Path x:Name="SpinnerCarga"
                      Data="M 12 2 A 10 10 0 1 1 2 12"
                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="22" Height="22" Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                </Path>
                <TextBlock Text="Cargando camiones en proceso de descarga..."
                           FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ ESTADO VACÍO ══
             Cubre el contenido cuando no hay ningún camión descargándose (abierto).
             Evita que el usuario se encuentre tres paneles vacíos sin saber por dónde
             empezar: se le ofrece directamente la acción que corresponde. -->
        <Border x:Name="EstadoVacio" Background="#EAF1F8" Visibility="Collapsed" Panel.ZIndex="50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <Border Width="88" Height="88" CornerRadius="44" Background="#DCE7F5"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Path Data="{StaticResource IcoTruck}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.3"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="42" Height="42" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="Actualmente no hay camiones descargándose"
                           FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="#1A1F2E"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                <TextBlock Text="Iniciá un nuevo proceso para registrar la placa y los productos que trae el camión."
                           FontFamily="Segoe UI" FontSize="15.5" Foreground="#6B7280"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,10,0,26"/>

                <Button x:Name="BtnIniciarProceso" HorizontalAlignment="Center" Cursor="Hand" permisos:PermisoBehavior.Requiere="Registrar Entrada"
                        FocusVisualStyle="{x:Null}" Click="BtnNuevoProceso_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="9" Padding="28,14">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="14" ShadowDepth="3" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPlus}" Stroke="White" StrokeThickness="2.2"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Iniciar nuevo proceso de descarga" Foreground="White"
                                               FontFamily="Segoe UI" FontSize="16.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Los camiones cerrados no se listan acá: van a ir en la sección de históricos. -->
            </StackPanel>
        </Border>

        <!-- ══ TOAST HOST ══ -->
        <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Panel.ZIndex="90"/>

        <!-- ══ CONFIRM POPUP ══ -->
        <Popup x:Name="ConfirmPopup" AllowsTransparency="True" StaysOpen="False" Placement="Center" PlacementTarget="{Binding ElementName=DgProductos}">
            <Border Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" Padding="14" Width="240">
                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="6" Opacity="0.25"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmText" FontFamily="Segoe UI" FontSize="14.5" Foreground="#1A1F2E" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="ConfirmCancel_Click"/>
                        <Button Content="Quitar" Style="{StaticResource ToolBtn}" Background="#DC2626" Foreground="White" BorderBrush="#DC2626" Click="ConfirmOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ══ MODAL OVERLAY ══ -->
        <Border x:Name="ModalOverlay" Background="#8C0F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
