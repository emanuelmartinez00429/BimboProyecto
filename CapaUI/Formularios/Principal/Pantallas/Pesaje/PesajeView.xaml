<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.PesajeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Pesaje"
             Background="#EAF1F8"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <!-- ── Iconos ── -->
        <Geometry x:Key="IcoScale">M12,3 v18 M5,7 h14 M5,7 L3,12 a3,3 0 0 0 6,0 L7,7 M19,7 l-2,5 a3,3 0 0 0 6,0 l-2,-5 M8,21 h8</Geometry>
        <Geometry x:Key="IcoTruck">M1,7 h15 v10 h-15 z M16,10 h3.5 l3,3.5 V17 h-6.5 z</Geometry>
        <Geometry x:Key="IcoPack">M21,8 l-9,-5 -9,5 9,5 9,-5 z M3,8 v8 l9,5 9,-5 V8 M12,13 v8</Geometry>
        <Geometry x:Key="IcoPlus">M12,5 v14 M5,12 h14</Geometry>
        <Geometry x:Key="IcoPencil">M11,4 H4 a2,2 0 0 0,-2,2 v14 a2,2 0 0 0,2,2 h14 a2,2 0 0 0,2,-2 v-7 M18.5,2.5 a2.12,2.12 0 0 1,3,3 L12,15 l-4,1 1,-4 z</Geometry>
        <Geometry x:Key="IcoTrash">M3,6 h18 M8,6 V4 a1,1 0 0 1,1,-1 h6 a1,1 0 0 1,1,1 v2 m2,0 v14 a2,2 0 0 1,-2,2 H7 a2,2 0 0 1,-2,-2 V6</Geometry>
        <Geometry x:Key="IcoDownload">M12,3 v12 m0,0 l-4,-4 m4,4 l4,-4 M4,19 h16</Geometry>
        <Geometry x:Key="IcoCheck">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IcoCheckDbl">M9,11 l3,3 L22,4 M21,12 v7 a2,2 0 0 1,-2,2 H5 a2,2 0 0 1,-2,-2 V5 a2,2 0 0 1,2,-2 h11</Geometry>

        <!-- ── Card header de panel ── -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Toolbar buttons (small) ── -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EEF2F8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolPrimary" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
        </Style>
        <Style x:Key="ToolSuccess" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>
        <Style x:Key="ToolDanger" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>

        <!-- ── Segmented toggle (RadioButton) ── -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B6BCC6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid header/row/cell ── -->
        <Style x:Key="PgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#1E3A8A" Padding="10,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Sel" Width="3" HorizontalAlignment="Left"
                                        Background="#1E3A8A" Visibility="Collapsed" Panel.ZIndex="1"/>
                                <DataGridCellsPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="B" Property="Background" Value="#F5F8FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#EAF1FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#DBE7F5"/>
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PgCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Texto de celda (Entradas) -->
        <Style x:Key="EntText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Chip código -->
        <Style x:Key="CodeChip" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido -->
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="262"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#1E3A8A" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E3A8A" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Data="{StaticResource IcoScale}" Stroke="White" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#6B7280">
                            <Run Text="Producción"/><Run Text="  /  "/><Run Text="Recepción de Materia Prima" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                        </TextBlock>
                        <TextBlock Text="Recepción de materia prima" FontFamily="Segoe UI" FontSize="19"
                                   FontWeight="Bold" Foreground="#1A1F2E" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2F8" CornerRadius="999" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#1E3A8A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CAMIONES" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CamionesTexto}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="999" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVOS" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#047857" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CamionesActivos}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnCerrarTodos" Style="{StaticResource ToolBtn}" Height="36" Click="BtnCerrarTodos_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoCheckDbl}" Stroke="#1E3A8A" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cerrar todos los camiones" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══ FILA 1: Camiones + Movimiento ══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Camiones -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Camiones de Entrega" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#EFF6FF" CornerRadius="999" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CamionesCount}" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="LstCamiones" Grid.Row="1"
                                 ItemsSource="{Binding Camiones}"
                                 AlternationCount="2"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstCamiones_SelectionChanged"
                                 MouseDoubleClick="LstCamiones_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="B" Background="White" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Border x:Name="Sel" Width="3" HorizontalAlignment="Left" Background="#1E3A8A" Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="B" Property="Background" Value="#F5F8FC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#EAF1FB"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#DBE7F5"/>
                                                        <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="78"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CodeChip}" Grid.Column="0">
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Placa}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1A1F2E"/>
                                            <TextBlock Text="{Binding Proveedor}" FontFamily="Segoe UI" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                CornerRadius="999" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding Estado}" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Foreground" Value="#047857"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Toolbar camiones -->
                        <WrapPanel Grid.Row="2" Margin="12,9" >
                            <Button x:Name="BtnCamionAgregar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="BtnCamionAgregar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPlus}" Stroke="#1E3A8A" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCamionEditar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="BtnCamionEditar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPencil}" Stroke="#1E3A8A" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCamionQuitar" Style="{StaticResource ToolDanger}" Margin="0,0,8,0" Click="BtnCamionQuitar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoTrash}" Stroke="#DC2626" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Quitar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCamionDescargar" Style="{StaticResource ToolSuccess}" Click="BtnCamionDescargar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoDownload}" Stroke="White" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Descargar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Panel Movimiento -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tabla de Movimiento de Materia Prima" Style="{StaticResource PanelTitle}"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" Foreground="#6B7280">
                                    <Run Text="Camión "/><Run Text="{Binding SelectedCamion.Placa}" FontWeight="Bold" Foreground="#1A1F2E"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="MovEmpty" Text="Selecciona un camión para ver sus productos"
                                       FontFamily="Segoe UI" FontSize="12.5" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            <DataGrid x:Name="DgProductos" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                                      AlternationCount="2" RowStyle="{StaticResource PgRow}" CellStyle="{StaticResource PgCell}"
                                      ColumnHeaderStyle="{StaticResource PgHeader}" RowHeight="46"
                                      ItemsSource="{Binding SelectedCamion.Productos}"
                                      SelectionChanged="DgProductos_SelectionChanged" MouseDoubleClick="DgProductos_DoubleClick"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="CÓDIGO" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CodeChip}" HorizontalAlignment="Left" Margin="10,0">
                                                    <TextBlock Text="{Binding ProductoCodigo}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PRODUCTO" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductoNombre}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#1A1F2E" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PROVEEDOR" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProveedorNombre}" FontFamily="Segoe UI" FontSize="11.5" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ESTADO" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="8,3" HorizontalAlignment="Center" Cursor="Hand"
                                                        MouseLeftButtonUp="EstadoProducto_Click" ToolTip="Clic para cambiar estado">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#9CA3AF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="{Binding Estado}" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="Abierto">
                                                                            <Setter Property="Foreground" Value="#047857"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="BULTOS REST." Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BultosRestantes, StringFormat=N1}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1A1F2E" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="% RESTANTE" Width="96">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="10,4" VerticalAlignment="Center">
                                                    <Border Height="5" Background="#E7EDF5" CornerRadius="999" ClipToBounds="True">
                                                        <Border CornerRadius="999" HorizontalAlignment="Stretch"
                                                                Background="{Binding ProgresoColor}"
                                                                RenderTransformOrigin="0,0">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding EscalaRecibido}"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Text="{Binding ProgresoTexto}" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="12,9">
                            <Button x:Name="BtnProdAgregar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="BtnProdAgregar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPlus}" Stroke="#1E3A8A" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdPesar" Style="{StaticResource ToolPrimary}" Margin="0,0,8,0" Click="BtnProdPesar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoScale}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Pesar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdEditar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="BtnProdEditar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoPencil}" Stroke="#1E3A8A" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProdQuitar" Style="{StaticResource ToolDanger}" Click="BtnProdQuitar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoTrash}" Stroke="#DC2626" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Quitar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ FILA 2: Entradas ══ -->
            <Border Grid.Row="4" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,11" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Entradas de Materia Prima" Style="{StaticResource PanelTitle}"/>
                                <Border Background="#EFF6FF" CornerRadius="999" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilasEntradas.Count}" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                                </Border>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#F7F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbVistaProducto" GroupName="VistaEntradas" Style="{StaticResource SegBtn}" Content="Producto actual" IsChecked="True" Checked="RbVista_Changed"/>
                                    <RadioButton x:Name="RbVistaCamion" GroupName="VistaEntradas" Style="{StaticResource SegBtn}" Content="Todo el camión" Checked="RbVista_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EntEmpty" Text="Aún no hay pesajes registrados"
                                   FontFamily="Segoe UI" FontSize="12.5" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <DataGrid x:Name="DgEntradas" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                                  AlternationCount="2" RowStyle="{StaticResource PgRow}" CellStyle="{StaticResource PgCell}"
                                  ColumnHeaderStyle="{StaticResource PgHeader}" RowHeight="40"
                                  ItemsSource="{Binding FilasEntradas}"
                                  SelectionChanged="DgEntradas_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="ColEntProducto" Header="PRODUCTO" Binding="{Binding ProdNombre}" Width="1.1*" Visibility="Collapsed">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1A1F2E"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="BRUTO (KG)" Binding="{Binding Bruto, StringFormat=N2}" Width="96" ElementStyle="{StaticResource EntText}"/>
                                <DataGridTextColumn Header="TARA (KG)" Binding="{Binding TaraTotal, StringFormat=N2}" Width="96" ElementStyle="{StaticResource EntText}"/>
                                <DataGridTextColumn Header="NETO (KG)" Binding="{Binding Neto, StringFormat=N2}" Width="96">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                            <Setter Property="Margin" Value="10,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="BULTOS" Binding="{Binding Bultos}" Width="76" ElementStyle="{StaticResource EntText}"/>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="92" ElementStyle="{StaticResource EntText}"/>
                                <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="70" ElementStyle="{StaticResource EntText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="12,9">
                        <Button x:Name="BtnEntEditar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="BtnEntEditar_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoPencil}" Stroke="#1E3A8A" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnEntQuitar" Style="{StaticResource ToolDanger}" Click="BtnEntQuitar_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoTrash}" Stroke="#DC2626" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="Quitar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ TOAST HOST ══ -->
        <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Panel.ZIndex="90"/>

        <!-- ══ CONFIRM POPUP ══ -->
        <Popup x:Name="ConfirmPopup" AllowsTransparency="True" StaysOpen="False" Placement="Center" PlacementTarget="{Binding ElementName=DgProductos}">
            <Border Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" Padding="14" Width="240">
                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="6" Opacity="0.25"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmText" FontFamily="Segoe UI" FontSize="12.5" Foreground="#1A1F2E" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource ToolBtn}" Margin="0,0,8,0" Click="ConfirmCancel_Click"/>
                        <Button Content="Quitar" Style="{StaticResource ToolBtn}" Background="#DC2626" Foreground="White" BorderBrush="#DC2626" Click="ConfirmOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ══ MODAL OVERLAY ══ -->
        <Border x:Name="ModalOverlay" Background="#8C0F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
