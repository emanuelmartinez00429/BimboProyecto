<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.SelectorProductosModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             Width="820"
             MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
             MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Fila de la tabla: clara sobre el modal oscuro -->
            <Style x:Key="SelRow" TargetType="DataGridRow">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <DataGridCellsPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                                </Trigger>
                                <!-- Ya agregado: atenuado y sin cursor de mano -->
                                <DataTrigger Binding="{Binding YaAgregado}" Value="True">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor"  Value="Arrow"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F2FFFFFF"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="Transparent" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#26FFFFFF"/>
                <Setter Property="Foreground" Value="#F2FFFFFF"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="#F2FFFFFF" FontFamily="Segoe UI"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" Padding="8,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Paginación: propia del modal (los estilos de ProductosView no son visibles acá) -->
            <Style x:Key="SelPageBtn" TargetType="Button">
                <Setter Property="MinWidth" Value="28"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#F2FFFFFF"/>
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#66FFFFFF"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelPageBtnActivo" TargetType="Button" BasedOn="{StaticResource SelPageBtn}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1E3A8A"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- DockPanel (no StackPanel): header y footer quedan fijos y solo la tabla
                 se encoge cuando el modal se achica. Con StackPanel, al limitar el alto
                 se recortaba el footer. -->
            <DockPanel>
                <!-- Franja superior -->
                <Border DockPanel.Dock="Top" Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="28,18,28,14" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource MIcoPack}" Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="PASO 2 · PRODUCTOS" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock Text="Seleccionar producto" FontFamily="Segoe UI" FontSize="22"
                                       FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                                VerticalAlignment="Top" Click="Cerrar_Click"/>
                    </Grid>
                </Border>

                <!-- Instrucción -->
                <Border DockPanel.Dock="Top" Background="#14FFFFFF" Padding="28,10">
                    <TextBlock x:Name="TxtInstruccion" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#D9FFFFFF" TextWrapping="Wrap"
                               Text="Buscá por código o nombre y hacé clic en el producto que trae el camión. Los que ya agregaste aparecen atenuados."/>
                </Border>

                <!-- Buscador + alcance -->
                <Grid DockPanel.Dock="Top" Margin="28,16,28,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:SuggestionSearchBox Grid.Column="0" x:Name="SearchBox"
                        Margin="0,0,12,0"
                        Placeholder="Buscar producto por código o nombre..."/>

                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="8"
                            BorderBrush="#26FFFFFF" BorderThickness="1" Padding="3"
                            VerticalAlignment="Center" x:Name="PanelAlcance">
                        <StackPanel Orientation="Horizontal">
                            <!-- El nombre del proveedor se trunca: con nombres largos
                                 empujaba el buscador fuera del modal. -->
                            <RadioButton x:Name="RbProveedor" GroupName="Alcance"
                                         Style="{StaticResource MSegBtn}" Checked="Alcance_Changed">
                                <TextBlock x:Name="TxtRbProveedor" Text="Solo proveedor"
                                           FontFamily="Segoe UI" FontSize="13"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            </RadioButton>
                            <RadioButton x:Name="RbTodos" GroupName="Alcance"
                                         Style="{StaticResource MSegBtn}" Checked="Alcance_Changed">
                                <TextBlock Text="Todo el catálogo" FontFamily="Segoe UI" FontSize="13"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tabla — último hijo del DockPanel: ocupa el espacio que sobra.
                     MinHeight evita que se aplaste a nada en ventanas muy bajas. -->
                <Border Margin="28,0,28,0" Background="#14FFFFFF" CornerRadius="8"
                        BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
                    <Grid MinHeight="180" MaxHeight="330">
                        <!-- Vacío -->
                        <TextBlock x:Name="TxtVacio" Visibility="Collapsed"
                                   Text="Sin resultados. Probá con otro término o cambiá el alcance."
                                   FontFamily="Segoe UI" FontSize="13.5" Foreground="#A6FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Cargando -->
                        <StackPanel x:Name="PanelCargando" Visibility="Collapsed" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Cargando productos..." FontFamily="Segoe UI" FontSize="13.5"
                                       Foreground="#A6FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid x:Name="DgProductos"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="Transparent" BorderThickness="0"
                                  RowStyle="{StaticResource SelRow}"
                                  CellStyle="{StaticResource SelCell}"
                                  ColumnHeaderStyle="{StaticResource SelHeader}"
                                  MouseLeftButtonUp="Fila_Click"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="CÓDIGO" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Codigo}" FontFamily="Consolas"
                                                           FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PRODUCTO" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="Medium" Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="FABRICANTE" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Fabricante}" FontFamily="Segoe UI" FontSize="12.5"
                                                       Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CONTENIDO" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Contenido}" FontFamily="Segoe UI" FontSize="12.5"
                                                       Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EstadoTexto}" FontFamily="Segoe UI" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="#FCD34D"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Paginación -->
                <DockPanel DockPanel.Dock="Bottom" Margin="28,10,28,4">
                    <TextBlock x:Name="TxtPageInfo" DockPanel.Dock="Left" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#A6FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPrimera"  Content="&#171;"  Style="{StaticResource SelPageBtn}" Margin="0,0,3,0" Click="Primera_Click"/>
                        <Button x:Name="BtnAnterior" Content="&#8249;" Style="{StaticResource SelPageBtn}" Margin="0,0,3,0" Click="Anterior_Click"/>
                        <ItemsControl x:Name="PaginacionPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="BtnSiguiente" Content="&#8250;" Style="{StaticResource SelPageBtn}" Margin="3,0,0,0" Click="Siguiente_Click"/>
                        <Button x:Name="BtnUltima"    Content="&#187;"  Style="{StaticResource SelPageBtn}" Margin="3,0,0,0" Click="Ultima_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Error -->
                <Border x:Name="PanelError" DockPanel.Dock="Bottom" Background="#33DC2626" CornerRadius="6" Margin="28,4,28,0"
                        Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="12.5"
                               Foreground="#FECACA" TextWrapping="Wrap"/>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="28,14" Margin="0,12,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtAlcance" FontFamily="Segoe UI" FontSize="12.5"
                                   Foreground="#A6FFFFFF" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource GhostBtn}"
                                Padding="22,9" Click="Cerrar_Click"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
