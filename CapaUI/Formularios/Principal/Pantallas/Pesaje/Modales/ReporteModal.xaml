<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.ReporteModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Header -->
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CIERRE DE CAMIÓN" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock Text="Reporte generado" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>
                <!-- Body -->
                <StackPanel Margin="28,16,28,8">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#24FFFFFF" Margin="0,8,0,16" HorizontalAlignment="Center">
                        <Path Data="{StaticResource MIcoCheck}" Stroke="#4ADE80" StrokeThickness="2.4" Width="30" Height="30" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <TextBlock Text="Se generó el reporte de movimientos para:" TextAlignment="Center" TextWrapping="Wrap"
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#D9FFFFFF" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="LstCamiones">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="{Binding Placa}" FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding Proveedor}" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="12" Foreground="#B3FFFFFF"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- Footer -->
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                    <Button Style="{StaticResource SolidBtn}" HorizontalAlignment="Right" Click="Cerrar_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.6" Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Aceptar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
