<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.ReporteModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             mc:Ignorable="d"
             Width="520"
             d:DesignWidth="520"
             d:DesignHeight="500"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Botón-texto sobre el fondo oscuro del modal: "Todas" / "Ninguna". -->
            <Style x:Key="EnlaceAlcance" TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#93C5FD"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#64748B"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Header -->
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoScale}" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PESADO DE INSUMOS BES" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock Text="Generar reporte de pesaje" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>
                
                <!-- Body -->
                <StackPanel Margin="28,18,28,14">
                    <TextBlock Text="Selecciona el formato para exportar el consolidado de pesajes:" 
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#E2E8F0" Margin="0,0,0,14"/>

                    <!-- Opciones de formato PDF / Excel -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPdf" Grid.Column="0" Height="90" Click="BtnPdf_Click" Cursor="Hand"
                                Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PDF" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Listo para imprimir (A4)" FontSize="11.5" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExcel" Grid.Column="2" Height="90" Click="BtnExcel_Click" Cursor="Hand"
                                Background="#1E293B" BorderBrush="#34D399" BorderThickness="1.5" Padding="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Excel" FontSize="20" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                <TextBlock Text="Libro .xlsx con fórmulas" FontSize="11.5" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Alcance: se elige por PLACA. Marcar una placa incluye todas sus
                         recepciones (un camión con tres proveedores sale unificado); se pueden
                         combinar varias placas en un mismo archivo. -->
                    <Border Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="CAMIONES A INCLUIR" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#A6FFFFFF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnMarcarTodas" Content="Todas" Click="BtnMarcarTodas_Click" Style="{StaticResource EnlaceAlcance}" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnMarcarNinguna" Content="Ninguna" Click="BtnMarcarNinguna_Click" Style="{StaticResource EnlaceAlcance}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="LstPlacas" MaxHeight="180">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <CheckBox IsChecked="{Binding Incluida, Mode=TwoWay}" VerticalContentAlignment="Center" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Placa}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Detalle}" ToolTip="{Binding Detalle}" FontFamily="Segoe UI" FontSize="12" Foreground="#CBD5E1"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtResumenAlcance" FontFamily="Segoe UI" FontSize="12" Foreground="#A6FFFFFF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                    <Button Padding="16,8" Background="Transparent" Foreground="White" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Right" Click="Cerrar_Click" Cursor="Hand">
                        <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
