<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.ProductosCargaModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
             Width="880"
             Height="620"
             MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource RestarMargen}, ConverterParameter=48}"
             MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource RestarMargen}, ConverterParameter=48}"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sin estilos propios de tabla: BasureroCelda, CabeceraColTabla,
                 BtnAgregarFilaTabla, CeldaInput y las geometrías viven en
                 Styles.xaml, compartidos con RegistroCamionesModal. -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <!-- El marco se agranda mientras el selector de catálogo está abierto
             (AplicarMarcoSelector), mismo mecanismo que RegistroCamionesModal. -->
        <Grid x:Name="RootGrid">
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <DockPanel x:Name="ContenidoPrincipal">
                <!-- Franja superior -->
                <Border DockPanel.Dock="Top" Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="28,18,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource MIcoPack}" Stroke="White" StrokeThickness="1.6"
                                  Width="22" Height="22" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="PRODUCTOS DE LA CARGA" FontFamily="Segoe UI" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtTitulo" FontFamily="Segoe UI" FontSize="21"
                                       FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                                VerticalAlignment="Top" Click="Cerrar_Click"/>
                    </Grid>
                </Border>

                <!-- Footer (fijo abajo). DockPanel y no Grid: con un Grid de una sola
                     celda el texto del pie y la fila de botones se pisan cuando el
                     texto crece — es el bug que tenía el modal viejo de producto. -->
                <Border DockPanel.Dock="Bottom" Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14"
                        CornerRadius="10">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtPie" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="12.5" Foreground="#A6FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource GhostBtn}"
                                    Padding="22,9" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <Button x:Name="BtnGuardar" Style="{StaticResource SolidBtn}"
                                    Padding="24,9" Click="Guardar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconoGuardar" Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <!-- Guardar la carga es un viaje de red (RPC transaccional): sin el
                                         spinner la espera se lee como que el modal se congeló. -->
                                    <Path x:Name="SpinnerGuardar"
                                          Data="M 12 2 A 10 10 0 1 1 2 12"
                                          Stroke="White" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"
                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="TxtBtnGuardar" Text="Finalizar" FontFamily="Segoe UI"
                                               FontSize="14.5" FontWeight="Bold" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Error (bloqueante) -->
                <Border DockPanel.Dock="Bottom" x:Name="PanelError" Background="#33DC2626"
                        CornerRadius="6" Margin="28,0,28,10" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="12.5"
                               Foreground="#FECACA" TextWrapping="Wrap"/>
                </Border>

                <!-- Contenido -->
                <DockPanel Margin="28,16,28,10">
                    <!-- Franja de contexto: la recepción ya viene elegida de la tabla de
                         camiones de la pantalla, así que placa y proveedor son dato, no
                         campo. MInputDisplay existe exactamente para esto. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Camión" Style="{StaticResource MLabel}"/>
                            <TextBox x:Name="TxtPlaca" Style="{StaticResource MInputDisplay}"
                                     IsReadOnly="True" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Proveedor" Style="{StaticResource MLabel}"/>
                            <TextBox x:Name="TxtProveedor" Style="{StaticResource MInputDisplay}"
                                     IsReadOnly="True" IsTabStop="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="Productos de la carga"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12"
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#A6FFFFFF"
                               TextWrapping="Wrap"
                               Text="Agregá los productos que declara el manifiesto, con su peso y su cantidad de bultos. Un producto que ya tenga pesajes registrados no se puede quitar."/>

                    <!-- Tarjeta blanca con la tabla -->
                    <Border Background="White" CornerRadius="8" ClipToBounds="True">
                        <DockPanel>
                            <!-- Encabezado de columnas. Las ColumnDefinitions están
                                 duplicadas en la plantilla de fila a propósito: es lo que
                                 alinea la tabla sin pagar un DataGrid. -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource EmpresaPrimaryBrush}"
                                    Padding="14,0" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CÓDIGO"         Style="{StaticResource CabeceraColTabla}"/>
                                    <TextBlock Grid.Column="1" Text="PRODUCTO"       Style="{StaticResource CabeceraColTabla}" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="PESO MAN. (KG)" Style="{StaticResource CabeceraColTabla}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="BULTOS"         Style="{StaticResource CabeceraColTabla}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="OBSERVACIONES"  Style="{StaticResource CabeceraColTabla}" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Pie de la tarjeta -->
                            <Border DockPanel.Dock="Bottom" Background="#FAFBFC"
                                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,10">
                                <Grid>
                                    <Button x:Name="BtnAgregarProducto" Style="{StaticResource BtnAgregarFilaTabla}"
                                            HorizontalAlignment="Left" Click="AgregarProducto_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IcoMasFila}" Stroke="White" StrokeThickness="2.2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Agregar producto" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="TxtContador" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"/>
                                </Grid>
                            </Border>

                            <!-- Filas -->
                            <Grid>
                                <ScrollViewer x:Name="ScrollFilas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FilasHost">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="FondoFila" Background="Transparent"
                                                        BorderBrush="#EEF2F6" BorderThickness="0,0,0,1"
                                                        Padding="14,9" MinHeight="52">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="42"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Código: chip monoespaciado, igual que la
                                                             tabla de productos del proceso anterior. -->
                                                        <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding Codigo}" FontFamily="Consolas"
                                                                       FontSize="11.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding Nombre}" Margin="10,0,10,0"
                                                                   FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="#1A1F2E" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Nombre}"/>

                                                        <Grid Grid.Column="2" Margin="6,0,6,0">
                                                            <TextBox x:Name="CajaPeso" Style="{StaticResource CeldaInput}"
                                                                     IsEnabled="{Binding EsEditable}" ToolTip="{Binding MotivoNoEditable}"
                                                                     controls:Placeholder.Texto="   0.00"
                                                                     Loaded="CajaPeso_Loaded" TextChanged="Peso_Changed"/>
                                                        </Grid>

                                                        <Grid Grid.Column="3" Margin="6,0,6,0">
                                                            <TextBox x:Name="CajaBultos" Style="{StaticResource CeldaInput}"
                                                                     IsEnabled="{Binding EsEditable}" ToolTip="{Binding MotivoNoEditable}"
                                                                     controls:Placeholder.Texto="0"
                                                                     Loaded="CajaBultos_Loaded" TextChanged="Bultos_Changed"/>
                                                        </Grid>

                                                        <!-- Observaciones: TextBox con un TextBlock encima que
                                                             recorta con «…» al perder el foco. TextBox no tiene
                                                             TextTrimming; es el mismo apaño que usa la columna
                                                             Descripción del modal de camiones. -->
                                                        <Grid Grid.Column="4" Margin="10,0,10,0">
                                                            <TextBox x:Name="CajaObs" Style="{StaticResource CeldaInput}"
                                                                     IsEnabled="{Binding EsEditable}" ToolTip="{Binding MotivoNoEditable}"
                                                                     controls:Placeholder.Texto="Sin observaciones"
                                                                     Loaded="CajaObs_Loaded" TextChanged="Obs_Changed"
                                                                     LostFocus="Obs_LostFocus"/>
                                                            <TextBlock Text="{Binding Text, ElementName=CajaObs}"
                                                                       FontFamily="Segoe UI" FontSize="13.5" Foreground="#1A1F2E"
                                                                       Margin="11,0,11,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                                                       Background="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <!-- Con foco no se recorta: se está editando. -->
                                                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=CajaObs}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <!-- Vacío tampoco: si no, esta capa blanca tapa el marcador
                                                                                 «Sin observaciones» que dibuja la plantilla. -->
                                                                            <DataTrigger Binding="{Binding Text, ElementName=CajaObs}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Button x:Name="BtnQuitarFila" Grid.Column="5"
                                                                Style="{StaticResource BasureroCelda}"
                                                                IsEnabled="{Binding PuedeQuitar}"
                                                                ToolTip="{Binding MotivoQuitar}"
                                                                Click="QuitarFila_Click"/>
                                                    </Grid>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EsAlterna}" Value="True">
                                                        <Setter TargetName="FondoFila" Property="Background" Value="#F8FAFC"/>
                                                    </DataTrigger>
                                                    <!-- Producto recién agregado: barrita verde a la izquierda
                                                         para distinguir lo que todavía no está guardado. -->
                                                    <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                        <Setter TargetName="FondoFila" Property="BorderBrush" Value="#34D399"/>
                                                        <Setter TargetName="FondoFila" Property="BorderThickness" Value="3,0,0,1"/>
                                                        <Setter TargetName="FondoFila" Property="Padding" Value="11,9,14,9"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="PanelSinProductos" Visibility="Collapsed"
                                           Text="Todavía no hay productos en esta carga. Usá «Agregar producto» para sumarlos."
                                           FontFamily="Segoe UI" FontSize="13.5" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </DockPanel>

            <ContentControl x:Name="CatalogoSelectorHost" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
