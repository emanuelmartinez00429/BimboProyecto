<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.CamionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/><GradientStop Color="#1E3A8A" Offset="0.55"/><GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/><GradientStop Color="#60A5FA" Offset="0.5"/><GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoTruck}" Stroke="White" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEyebrow" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock x:Name="TxtTitle" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>
                <StackPanel Margin="28,18,28,6">
                    <TextBlock Text="Proveedor" Style="{StaticResource MLabel}"/>
                    <ComboBox x:Name="CmbProveedor" Style="{StaticResource MCombo}" DisplayMemberPath="Nombre" Margin="0,0,0,14" SelectionChanged="Validar"/>
                    <TextBlock Text="Placa del vehículo" Style="{StaticResource MLabel}"/>
                    <TextBox x:Name="TxtPlaca" Style="{StaticResource MInput}" Margin="0,0,0,14" TextChanged="Placa_Changed"/>
                    <TextBlock Text="Fecha de asignación" Style="{StaticResource MLabel}"/>
                    <TextBox x:Name="TxtFecha" Style="{StaticResource MInput}" IsEnabled="False" Margin="0,0,0,14"/>
                    <TextBlock Text="Observaciones" Style="{StaticResource MLabel}"/>
                    <TextBox x:Name="TxtObs" Style="{StaticResource MInput}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,4"/>
                </StackPanel>
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                    <Grid>
                        <TextBlock x:Name="TxtHint" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11.5" Foreground="#99FFFFFF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <Button x:Name="BtnGuardar" Style="{StaticResource SolidBtn}" IsEnabled="False" Click="Guardar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.6" Width="14" Height="14" Stretch="Uniform"
                                          Margin="0,0,6,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="TxtGuardar" Text="Registrar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
