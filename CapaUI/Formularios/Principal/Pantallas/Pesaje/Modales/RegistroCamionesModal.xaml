<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.RegistroCamionesModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
             mc:Ignorable="d"
             Width="880"
             Height="620"
             d:DesignWidth="880"
             d:DesignHeight="620"


             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Las geometrías IcoTrashFila e IcoMasFila también se centralizaron
                 en Styles.xaml, congeladas con po:Freeze (P-031 G11). -->



            <!-- Lupa de la celda de Proveedor: la misma idea que LupaBtnOscuro pero
                 al alto de la fila (34, no 38) y sobre fondo claro. -->
            <Style x:Key="LupaCelda" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Path Data="{StaticResource IconSearchShared}"
                                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- BasureroCelda, CabeceraColTabla y BtnAgregarFilaTabla vivían acá.
                 Se centralizaron en Styles.xaml al aparecer el segundo consumidor
                 (ProductosCargaModal): copiarlos habría sido la duplicación que
                 [[Anatomia compartida de los modales]] prohíbe explícitamente. -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <!-- Alto congelado en código (ver BuscarProveedor_Click) mientras el selector
             de proveedor está abierto, mismo mecanismo que CamionModal. -->
        <Grid x:Name="RootGrid">
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <DockPanel x:Name="ContenidoPrincipal">
                <!-- Franja superior -->
                <Border DockPanel.Dock="Top" Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="28,18,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource MIcoTruck}" Stroke="White" StrokeThickness="1.6"
                                  Width="22" Height="22" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="REGISTRO DE CAMIONES" FontFamily="Segoe UI" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock Text="Nuevo proceso de descarga" FontFamily="Segoe UI" FontSize="21"
                                       FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                                VerticalAlignment="Top" Click="Cerrar_Click"/>
                    </Grid>
                </Border>

                <!-- Footer (fijo abajo) -->
                <Border DockPanel.Dock="Bottom" Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14"
                        CornerRadius="10">
                    <Grid>
                        <TextBlock x:Name="TxtPie" VerticalAlignment="Center" FontFamily="Segoe UI"
                                   FontSize="12.5" Foreground="#A6FFFFFF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource GhostBtn}"
                                    Padding="22,9" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <Button x:Name="BtnGuardar" Style="{StaticResource SolidBtn}"
                                    Padding="24,9" Click="Guardar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconoGuardar" Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <!-- El registro es un viaje de red (RPC transaccional, P-053): sin este
                                         spinner el par de cientos de milisegundos de espera se leen como que
                                         el modal se congeló. Mismo patrón visual que CargandoInicial. -->
                                    <Path x:Name="SpinnerGuardar"
                                          Data="M 12 2 A 10 10 0 1 1 2 12"
                                          Stroke="White" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"
                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="TxtBtnGuardar" Text="Guardar camiones" FontFamily="Segoe UI"
                                               FontSize="14.5" FontWeight="Bold" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error -->
                <Border DockPanel.Dock="Bottom" x:Name="PanelError" Background="#33DC2626"
                        CornerRadius="6" Margin="28,0,28,10" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="12.5"
                               Foreground="#FECACA" TextWrapping="Wrap"/>
                </Border>

                <!-- Aviso de placa ya abierta con otro proveedor. Ámbar y no rojo: no
                     bloquea el guardado — es el caso legítimo de un camión que trae
                     carga de dos proveedores. Mismo par de colores que en CamionModal. -->
                <Border DockPanel.Dock="Bottom" x:Name="PanelAviso" Background="#33D97706"
                        CornerRadius="6" Margin="28,0,28,10" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtAviso" FontFamily="Segoe UI" FontSize="12.5"
                               Foreground="#FDE68A" TextWrapping="Wrap"/>
                </Border>

                <!-- Contenido -->
                <DockPanel Margin="28,18,28,10">
                    <TextBlock DockPanel.Dock="Top" Text="Camiones del proceso"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtInstruccion" DockPanel.Dock="Top" Margin="0,4,0,12"
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#A6FFFFFF"
                               TextWrapping="Wrap"/>

                    <!-- Tarjeta blanca con la tabla -->
                    <Border Background="White" CornerRadius="8" ClipToBounds="True">
                        <DockPanel>
                            <!-- Encabezado de columnas -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource EmpresaPrimaryBrush}"
                                    Padding="14,0" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource CabeceraColTabla}"/>
                                    <TextBlock Grid.Column="1" Text="PLACA" Style="{StaticResource CabeceraColTabla}"/>
                                    <TextBlock Grid.Column="2" Text="PROVEEDOR" Style="{StaticResource CabeceraColTabla}" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="DESCRIPCIÓN" Style="{StaticResource CabeceraColTabla}" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Pie de la tarjeta -->
                            <Border DockPanel.Dock="Bottom" Background="#FAFBFC"
                                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,10">
                                <Grid>
                                    <Button x:Name="BtnAgregarFila" Style="{StaticResource BtnAgregarFilaTabla}"
                                            HorizontalAlignment="Left" Click="AgregarFila_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IcoMasFila}" Stroke="White" StrokeThickness="2.2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Registrar otro camión" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="TxtContador" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"/>
                                </Grid>
                            </Border>

                            <!-- Filas -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FilasHost">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="FondoFila" Background="Transparent"
                                                    BorderBrush="#EEF2F6" BorderThickness="0,0,0,1"
                                                    Padding="14,9" MinHeight="52">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Número de fila -->
                                                    <!-- Margen superior de 4: centra el círculo contra el
                                                         input de 34 de alto, no contra la fila entera (que
                                                         crece cuando aparece el renglón de error). -->
                                                    <Border x:Name="Badge" Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                                                        <TextBlock x:Name="TxtNumero" Text="{Binding Numero}"
                                                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Espacio libre (fila sin ocupar) -->
                                                    <TextBlock x:Name="TxtLibre" Grid.Column="1" Grid.ColumnSpan="4"
                                                               Text="Espacio libre · usá &quot;Registrar otro camión&quot; para ocuparlo"
                                                               FontFamily="Segoe UI" FontSize="13" FontStyle="Italic"
                                                               Foreground="#B4BCC8" VerticalAlignment="Center"/>

                                                    <!-- Placa -->
                                                    <StackPanel x:Name="CeldaPlaca" Grid.Column="1" Margin="0,0,10,0" Visibility="Collapsed">
                                                        <TextBox Style="{StaticResource CeldaInput}"
                                                                 Loaded="CajaPlaca_Loaded"
                                                                 TextChanged="Placa_Changed"/>
                                                    </StackPanel>

                                                    <!-- Proveedor (solo lectura + lupa) -->
                                                    <Grid x:Name="CeldaProveedor" Grid.Column="2" Margin="0,0,10,0" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <Grid>
                                                                <TextBox x:Name="CajaProveedor" Style="{StaticResource CeldaInput}"
                                                                         IsReadOnly="True" Cursor="Hand"
                                                                         Loaded="CajaProveedor_Loaded"
                                                                         PreviewMouseDoubleClick="CajaProveedor_DobleClick"
                                                                         KeyDown="CajaProveedor_KeyDown"
                                                                         controls:Placeholder.Texto="Elegí un proveedor…"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource LupaCelda}"
                                                                Click="BuscarProveedor_Click" ToolTip="Seleccionar proveedor"/>
                                                    </Grid>

                                                    <!-- Descripción -->
                                                    <StackPanel x:Name="CeldaDescripcion" Grid.Column="3" Margin="0,0,10,0" Visibility="Collapsed">
                                                        <Grid>
                                                            <TextBox x:Name="CajaDescripcion" Style="{StaticResource CeldaInput}"
                                                                     Loaded="CajaDescripcion_Loaded"
                                                                     TextChanged="Descripcion_Changed"
                                                                     LostFocus="Descripcion_LostFocus"/>
                                                            <!-- Vista previa recortada: un TextBox no soporta TextTrimming, así
                                                                 que se tapa con un TextBlock idéntico mientras no tiene foco.
                                                                 Con foco se oculta y aparece el TextBox real para editar —
                                                                 IsHitTestVisible=False para que el click pase directo a la caja. -->
                                                            <TextBlock Text="{Binding Text, ElementName=CajaDescripcion}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontFamily="Segoe UI" FontSize="13.5" Foreground="#1A1F2E"
                                                                       Background="White" Margin="1" Padding="10,0"
                                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                                       Visibility="{Binding IsKeyboardFocusWithin, ElementName=CajaDescripcion, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Basurero -->
                                                    <Button x:Name="BtnQuitarFila" Grid.Column="4" Style="{StaticResource BasureroCelda}"
                                                            Visibility="Collapsed" Click="QuitarFila_Click"
                                                            ToolTip="Quitar este camión"/>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Activa}" Value="True">
                                                    <Setter TargetName="TxtLibre"        Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="CeldaPlaca"      Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CeldaProveedor"  Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CeldaDescripcion" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="BtnQuitarFila"   Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- Fila libre: el número también se apaga, si no parece
                                                     que hubiera 5 camiones cargados. -->
                                                <DataTrigger Binding="{Binding Activa}" Value="False">
                                                    <Setter TargetName="Badge"     Property="Background"  Value="#F1F5F9"/>
                                                    <Setter TargetName="Badge"     Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter TargetName="TxtNumero" Property="Foreground"  Value="#B4BCC8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EsAlterna}" Value="True">
                                                    <Setter TargetName="FondoFila" Property="Background" Value="#F8FAFC"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </DockPanel>

            <!-- Host del selector de catálogo (Proveedor) — reemplaza todo el
                 contenido mientras está abierto, mismo mecanismo que CamionModal. -->
            <ContentControl x:Name="CatalogoSelectorHost" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
