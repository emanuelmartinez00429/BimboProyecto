<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CapaUI.Core.Controls"
                    xmlns:validacion="clr-namespace:CapaUI.Core.Validacion">

    <!-- Iconos compartidos -->
    <Geometry x:Key="MIcoClose">M6,6 l12,12 M18,6 l-12,12</Geometry>
    <Geometry x:Key="MIcoCheck">M20,6 L9,17 l-5,-5</Geometry>
    <!-- MIcoSearch se sacó (2026-08-19): era idéntico a IconSearchShared de
         Styles.xaml (global) y quedó sin ningún uso al migrar el Proveedor de
         ProcesoDescargaModal de ComboBox a SelectorCatalogoModal (que usa
         LupaBtnOscuro, ya con su propio icono). Ver [[Anatomía compartida de
         los modales]]. -->
    <Geometry x:Key="MIcoTruck">M1,7 h15 v10 h-15 z M16,10 h3.5 l3,3.5 V17 h-6.5 z</Geometry>
    <Geometry x:Key="MIcoPack">M21,8 l-9,-5 -9,5 9,5 9,-5 z M3,8 v8 l9,5 9,-5 V8 M12,13 v8</Geometry>
    <Geometry x:Key="MIcoScale">M12,3 v18 M5,7 h14 M5,7 L3,12 a3,3 0 0 0 6,0 L7,7 M19,7 l-2,5 a3,3 0 0 0 6,0 l-2,-5 M8,21 h8</Geometry>

    <!-- Etiqueta de campo -->
    <Style x:Key="MLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- TextBox de modal -->
    <Style x:Key="MInput" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="#1A1F2E"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"
         />
        <!-- Ver el mismo Setter en ModalInput de Styles.xaml — tooltip con el
             texto completo cuando no entra por la responsividad; en campos de
             solo lectura, además recorta con "…". -->
        <Setter Property="controls:TextoResponsivo.Activo" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <!-- Atado a VerticalContentAlignment (antes "Center" fijo): un
                             campo multilínea como Observaciones necesita el cursor
                             arriba, no centrado en medio de la caja; el Setter de más
                             arriba lo sigue dejando en Center para el resto de los
                             campos de una sola línea, así que no cambia nada para
                             ellos. -->
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- El marcador comparte el MISMO Margin/VerticalAlignment que el
                                 PART_ContentHost, así que cae exactamente donde arranca el
                                 texto y donde se para el cursor. Ver controls:Placeholder. -->
                            <TextBlock x:Name="Marcador" Visibility="Collapsed"
                                       Text="{Binding Path=(controls:Placeholder.Texto), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="#9CA3AF" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Vacío Y sin foco: apenas entra el cursor el marcador se va, así
                             no queda texto gris debajo del cursor. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Marcador" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- P-042: Aro de foco verde #34D399 de 2px, consistente con ModalInput y CeldaInput -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#8CFFFFFF"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                        </Trigger>
                        <!-- Error de validación: va después de foco para prevalecer en rojo mientras se edita -->
                        <Trigger Property="validacion:Validacion.TieneError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de SOLO CONTEXTO (dato que el modal ya trae, nunca se escribe acá:
         placa, proveedor, fecha/hora, código de producto). No es el mismo caso
         que un campo editable temporalmente deshabilitado mientras guarda — por
         eso no reusa el trigger IsEnabled de MInput, que lo dejaría gris apenas
         un instante: este siempre se ve así, deshabilitado o no. Caja traslúcida
         sobre el azul del modal (mismo tono que PasoChip/CodeChip, #1AFFFFFF) y
         texto verde menta en vez del texto oscuro sobre fondo blanco de MInput —
         se lee como dato ya confirmado, no como algo pendiente de llenar. -->
    <Style x:Key="MInputDisplay" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <!-- Más margen a la izquierda que MInput (10): acá deja lugar a la
             barrita verde de acento sin que el texto le quede pegado. -->
        <Setter Property="Padding" Value="17,0,10,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#6EE7B7"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="controls:TextoResponsivo.Activo" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                        <!-- La barrita verde de acento, no un ícono — el elemento del
                             mockup de referencia que sí se pidió conservar. -->
                        <Border Width="3" Margin="2" HorizontalAlignment="Left"
                                Background="#34D399" CornerRadius="2"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MCombo (ComboBox de modal) se sacó (2026-08-19): quedó sin ningún uso
         al migrar el Proveedor de ProcesoDescargaModal de ComboBox a
         SelectorCatalogoModal. Si algún modal de Pesaje vuelve a necesitar un
         ComboBox, usar el global ModalCombo de Styles.xaml en vez de
         resucitar esta copia — ver [[Anatomía compartida de los modales]]. -->

    <!-- RadioButton segmentado sobre fondo oscuro (toggles dentro de los modales).
         Vive acá y no local en cada modal: los modales de Pesaje ya importan este
         diccionario, y los estilos "ModalSegBtn" de los modales CRUD no son visibles
         desde acá (se definen en las Resources de cada UserControl). -->
    <Style x:Key="MSegBtn" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                        <!-- P-042: Aro de foco verde #34D399 idéntico a ModalSegBtn -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón fantasma (traslúcido) -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#4CFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón sólido verde -->
    <Style x:Key="SolidBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#15803D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22C55E" Offset="0"/>
                    <GradientStop Color="#16A34A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón sólido de advertencia (rojo pálido/rosáceo) — para acciones con
         consecuencias que no son destructivas (no borran nada) pero sí
         cierran/terminan algo y conviene que no se confundan con la acción
         principal en verde. Más suave que el #DC2626 que el proyecto reserva
         para "Quitar"/eliminar (ese es plano, sin degradé; este es un tono
         apagado, no un rojo de alarma) — el ámbar de la primera versión
         chillaba demasiado contra el fondo azul del modal. -->
    <Style x:Key="WarnBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#DC7A7A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E38A8A" Offset="0"/>
                    <GradientStop Color="#D66E6E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#D66E6E" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón X de cerrar -->
    <Style x:Key="CloseBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Path Data="{StaticResource MIcoClose}" Stroke="White" StrokeThickness="2.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
