<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.ProductoCamionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="10" ClipToBounds="True">
            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
            <Grid>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2B5797" Offset="0"/><GradientStop Color="#1E3A8A" Offset="0.55"/><GradientStop Color="#1E40AF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <Border Height="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#34D399" Offset="0"/><GradientStop Color="#60A5FA" Offset="0.5"/><GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="26,18,26,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource MIcoPack}" Stroke="White" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEyebrow" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtTitle" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                    </Grid>
                    <Border Height="1" Background="#26FFFFFF"/>
                    <StackPanel Margin="28,18,28,6">
                        <TextBlock Text="Producto" Style="{StaticResource MLabel}"/>
                        <!-- Selector (modo nuevo) -->
                        <Button x:Name="BtnSeleccionar" Height="40" Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                                Background="#10FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" Foreground="White"
                                FontFamily="Segoe UI" FontSize="13.5" FocusVisualStyle="{x:Null}" Click="BtnSeleccionar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource MIcoSearch}" Stroke="White" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"
                                      Margin="0,0,10,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock x:Name="TxtSeleccion" Text="Seleccionar producto…" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <!-- Locked (modo edición) -->
                        <Border x:Name="ProdLocked" Visibility="Collapsed" Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#28FFFFFF" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLockedCod" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="TxtLockedNom" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso manifestado (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtPeso" Style="{StaticResource MInput}" TextChanged="Validar"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bultos teóricos" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtBultos" Style="{StaticResource MInput}" TextChanged="Validar"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Observaciones" Style="{StaticResource MLabel}"/>
                        <TextBox x:Name="TxtObs" Style="{StaticResource MInput}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,4"/>
                    </StackPanel>
                    <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                        <Grid>
                            <TextBlock x:Name="TxtHint" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11.5" Foreground="#99FFFFFF"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Cerrar_Click"/>
                                <Button x:Name="BtnGuardar" Style="{StaticResource SolidBtn}" IsEnabled="False" Click="Guardar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.6" Width="14" Height="14" Stretch="Uniform"
                                              Margin="0,0,6,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="TxtGuardar" Text="Agregar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sub-overlay del buscador -->
        <Border x:Name="PickerOverlay" Background="#8C0F172A" Visibility="Collapsed" Panel.ZIndex="10">
            <ContentControl x:Name="PickerHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
