<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.ProcesoDescargaModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Encabezado de sección (modo edición) -->
            <Style x:Key="SeccionTitulo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <!-- Instrucción de qué hacer en cada sección -->
            <Style x:Key="SeccionAyuda" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#A6FFFFFF"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Chip de paso del wizard -->
            <Style x:Key="PasoChip" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="BotonQuitarProd" TargetType="Button">
                <Setter Property="Background" Value="#33DC2626"/>
                <Setter Property="Foreground" Value="#FECACA"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4DDC2626"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                    <Setter Property="Foreground" Value="#66FFFFFF"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True" MaxHeight="780">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <DockPanel>
                <!-- Franja superior -->
                <Border DockPanel.Dock="Top" Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="28,18,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource MIcoTruck}" Stroke="White" StrokeThickness="1.6"
                                  Width="22" Height="22" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEyebrow" FontFamily="Segoe UI" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtTitulo" FontFamily="Segoe UI" FontSize="21"
                                       FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                                VerticalAlignment="Top" Click="Cerrar_Click"/>
                    </Grid>
                </Border>

                <!-- Footer (fijo abajo) -->
                <Border DockPanel.Dock="Bottom" Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14"
                        CornerRadius="10">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtPie" FontFamily="Segoe UI"
                                   FontSize="12.5" Foreground="#A6FFFFFF" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnAtras" Content="Atrás" Style="{StaticResource GhostBtn}"
                                    Padding="22,9" Margin="0,0,10,0" Click="Atras_Click"/>
                            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource GhostBtn}"
                                    Padding="22,9" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <Button x:Name="BtnPrincipal" Style="{StaticResource SolidBtn}"
                                    Padding="24,9" Click="Principal_Click">
                                <TextBlock x:Name="TxtBtnPrincipal" Text="Siguiente" FontFamily="Segoe UI"
                                           FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Error -->
                <Border DockPanel.Dock="Bottom" x:Name="PanelError" Background="#33DC2626"
                        CornerRadius="6" Margin="28,0,28,10" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="12.5"
                               Foreground="#FECACA" TextWrapping="Wrap"/>
                </Border>

                <!-- Contenido con scroll -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18,28,10">

                        <!-- ══ SECCIÓN 1 · CAMIÓN ══ -->
                        <StackPanel x:Name="SecCamion">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PasoChip}">
                                    <TextBlock Text="1" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Datos del camión" Style="{StaticResource SeccionTitulo}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SeccionAyuda}" Margin="34,4,0,12"
                                       Text="Registrá la placa del vehículo y el proveedor que envía la carga."/>

                            <StackPanel Margin="34,0,0,0">
                                <TextBlock Text="Proveedor" Style="{StaticResource MLabel}"/>
                                <ComboBox x:Name="CmbProveedor" Style="{StaticResource MCombo}"
                                          DisplayMemberPath="Nombre" Margin="0,0,0,14"
                                          SelectionChanged="Campo_Changed"/>

                                <TextBlock Text="Placa del vehículo" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtPlaca" Style="{StaticResource MInput}"
                                         Margin="0,0,0,14" TextChanged="Placa_Changed"/>

                                <TextBlock Text="Observaciones (opcional)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtObs" Style="{StaticResource MInput}" Height="56"
                                         Margin="0,0,0,4" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="SepCamion" Height="1" Background="#1AFFFFFF" Margin="0,20,0,20"/>

                        <!-- ══ SECCIÓN 2 · PRODUCTOS ══ -->
                        <StackPanel x:Name="SecProductos">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PasoChip}">
                                    <TextBlock Text="2" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Productos de la carga" Style="{StaticResource SeccionTitulo}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SeccionAyuda}" Margin="34,4,0,12"
                                       Text="Agregá los productos que declara el manifiesto, con su peso y su cantidad de bultos. Un producto que ya tenga pesajes registrados no se puede quitar."/>

                            <StackPanel Margin="34,0,0,0">
                                <!-- Lista de productos agregados -->
                                <ItemsControl x:Name="LstProductos">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14,12"
                                                    Margin="0,0,0,10" BorderBrush="#26FFFFFF" BorderThickness="1">
                                                <StackPanel>
                                                    <!-- Identificación -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#26FFFFFF" CornerRadius="4"
                                                                Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Codigo}" FontFamily="Consolas"
                                                                       FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nombre}"
                                                                   FontFamily="Segoe UI" FontSize="13.5" FontWeight="Medium"
                                                                   Foreground="White" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="2" Style="{StaticResource BotonQuitarProd}"
                                                                Content="Quitar" Tag="{Binding}"
                                                                IsEnabled="{Binding PuedeQuitar}"
                                                                ToolTip="{Binding MotivoNoQuitar}"
                                                                Click="QuitarProducto_Click"/>
                                                    </Grid>
                                                    <!-- Peso y bultos -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Peso manifestado (kg)" Style="{StaticResource MLabel}"/>
                                                            <TextBox Style="{StaticResource MInput}" Tag="{Binding}"
                                                                     Text="{Binding PesoManifestadoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="CampoProducto_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Bultos declarados" Style="{StaticResource MLabel}"/>
                                                            <TextBox Style="{StaticResource MInput}" Tag="{Binding}"
                                                                     Text="{Binding BultosDeclaradosTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="CampoProducto_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Vacío -->
                                <Border x:Name="PanelSinProductos" Background="#14FFFFFF" CornerRadius="8"
                                        Padding="20" Margin="0,0,0,10" BorderBrush="#26FFFFFF"
                                        BorderThickness="1" Visibility="Collapsed">
                                    <TextBlock Text="Todavía no agregaste ningún producto a esta carga."
                                               FontFamily="Segoe UI" FontSize="13" Foreground="#A6FFFFFF"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <Button x:Name="BtnAgregarProducto" Style="{StaticResource GhostBtn}"
                                        Padding="18,10" HorizontalAlignment="Left" Click="AgregarProducto_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,5 v14 M5,12 h14" Stroke="White" StrokeThickness="2.2"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="Agregar producto" FontFamily="Segoe UI" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="SepProductos" Height="1" Background="#1AFFFFFF" Margin="0,20,0,20"/>

                        <!-- ══ SECCIÓN 3 · TARA EXTRA ══ -->
                        <StackPanel x:Name="SecTaraExtra">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PasoChip}">
                                    <TextBlock Text="3" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tara extra de la carga" Style="{StaticResource SeccionTitulo}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SeccionAyuda}" Margin="34,4,0,12"
                                       Text="Pesá la tara extra (tarimas, forros, separadores) una sola vez para toda la carga. El sistema la reparte automáticamente entre los bultos declarados al registrar cada pesaje."/>

                            <StackPanel Margin="34,0,0,0">
                                <TextBlock Text="Peso de tara extra total (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtTaraExtra" Style="{StaticResource MInput}"
                                         Margin="0,0,0,12" Text="0" TextChanged="TaraExtra_Changed"/>

                                <Border Background="#14FFFFFF" CornerRadius="8" Padding="14,12"
                                        BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Bultos declarados en la carga" FontFamily="Segoe UI"
                                                       FontSize="12.5" Foreground="#D9FFFFFF"/>
                                            <TextBlock x:Name="TxtBultosTotales" HorizontalAlignment="Right"
                                                       FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Tara extra por bulto" FontFamily="Segoe UI"
                                                       FontSize="12.5" Foreground="#D9FFFFFF"/>
                                            <TextBlock x:Name="TxtTaraPorBulto" HorizontalAlignment="Right"
                                                       FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#86EFAC"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Sub-overlay: selector de productos -->
            <Border x:Name="SelectorOverlay" Background="#B30F172A"
                    Visibility="Collapsed" Panel.ZIndex="20"
                    CornerRadius="10">
                <ContentControl x:Name="SelectorHost"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
