<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.PesajeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:pesajeCtl="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Pesaje.Controles"
             mc:Ignorable="d"
             Width="980"
             d:DesignWidth="980"
             d:DesignHeight="700"


             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display"
             controls:AtajoGuardar.Boton="{x:Reference BtnSeguir}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/><GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/><GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/><GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/><GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoScale}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEyebrow" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock x:Name="TxtTitle" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

                    <!-- Formulario -->
                    <StackPanel Grid.Column="0" Margin="26,18,26,14">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Placa del vehículo" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtPlaca" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Proveedor del ítem" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtProveedor" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha / hora de entrada" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtFechaHora" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código de producto" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtCodigo" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#26FFFFFF" Margin="0,4,0,14"/>

                        <!-- Separa el contexto (arriba, solo lectura) de lo que el operador teclea. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource MIcoPack}" Stroke="#B3FFFFFF" StrokeThickness="2" Width="12" Height="12"
                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CAPTURÁ LOS PESOS AQUÍ" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso bruto (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtBruto" Style="{StaticResource MInput}" TextChanged="Recalcular"
                                         controls:Placeholder.Texto="0.00"/>
                            </StackPanel>
                            <!-- La tara extra se PESA, nunca se calcula: son las tarimas/forros que
                                 vinieron en esta pesada. Es opcional — si no se pesa acá, se puede
                                 cargar el total después con «Tara extra» y el sistema lo reparte. -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso tara extra (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtTaraExtraEntrada" Style="{StaticResource MInput}" TextChanged="Recalcular"
                                         controls:Placeholder.Texto="0 · opcional"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bultos estimados (calculado)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtBultosEstimados" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso tara individual (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtTaraInd" Style="{StaticResource MInputDisplay}" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso neto — este pesaje (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtNeto" Style="{StaticResource MInputDisplay}" IsEnabled="False" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso neto total acumulado (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtNetoTotal" Style="{StaticResource MInputDisplay}" IsEnabled="False" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Observaciones" Style="{StaticResource MLabel}"/>
                        <TextBox x:Name="TxtObs" Style="{StaticResource MInput}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                    </StackPanel>

                    <!-- Panel lateral: diferencia, acumulados, gráfico de pesadas y avisos en vivo.
                         Las cuentas y la cascada de avisos viven en CapaDominio.Reglas.ReglasPanelPesaje. -->
                    <Border Grid.Column="1" Background="#38000000" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0" Padding="18,16">
                        <Border.Resources>
                            <Style x:Key="PanelEyebrow" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#99FFFFFF"/>
                            </Style>
                            <Style x:Key="PanelNota" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#B3FFFFFF"/>
                            </Style>
                            <Style x:Key="Tarjeta" TargetType="Border">
                                <Setter Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#29FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="7"/>
                                <Setter Property="Padding" Value="10,7"/>
                            </Style>
                            <Style x:Key="TarjetaValor" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style x:Key="TarjetaKg" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#B3FFFFFF"/>
                                <Setter Property="Margin" Value="4,0,0,2"/>
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter Property="Text" Value="kg"/>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="DIFERENCIA" Style="{StaticResource PanelEyebrow}"/>
                                <TextBlock x:Name="TxtConteoPesajes" Style="{StaticResource PanelNota}" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtDif" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="kg" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDifMsg" Style="{StaticResource PanelNota}" TextWrapping="Wrap"/>

                            <!-- Tarjetas 2x2 de acumulados -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="MANIFESTADO" Style="{StaticResource PanelEyebrow}" Foreground="#CCFFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtManifestado" Style="{StaticResource TarjetaValor}"/>
                                            <TextBlock Style="{StaticResource TarjetaKg}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="NETO ACUMULADO" Style="{StaticResource PanelEyebrow}" Foreground="#CCFFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtNetoAcum" Style="{StaticResource TarjetaValor}" Foreground="#4ADE80"/>
                                            <TextBlock Style="{StaticResource TarjetaKg}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="TARA ACUMULADA" Style="{StaticResource PanelEyebrow}" Foreground="#CCFFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtTaraAcum" Style="{StaticResource TarjetaValor}"/>
                                            <TextBlock Style="{StaticResource TarjetaKg}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="TARA EXTRA ACUM." Style="{StaticResource PanelEyebrow}" Foreground="#CCFFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtTaraExtraAcum" Style="{StaticResource TarjetaValor}"/>
                                            <TextBlock Style="{StaticResource TarjetaKg}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Avance acumulado. El relleno es la columna izquierda de un Grid con
                                 pesos en estrella: el code-behind solo cambia las proporciones. -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Avance acumulado" Style="{StaticResource PanelNota}" Foreground="#D9FFFFFF"/>
                                <TextBlock x:Name="TxtAvance" Style="{StaticResource PanelNota}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="7" CornerRadius="4" Background="#660F172A">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColAvance" Width="0*"/>
                                        <ColumnDefinition x:Name="ColResto" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#22C55E" Offset="0"/><GradientStop Color="#4ADE80" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Height="1" Background="#26FFFFFF" Margin="0,14,0,10"/>

                            <Grid>
                                <TextBlock Text="PESADAS (KG NETO)" Style="{StaticResource PanelEyebrow}" Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="TxtGraficoResumen" Style="{StaticResource PanelNota}" HorizontalAlignment="Right"/>
                            </Grid>
                            <pesajeCtl:PesadasChart x:Name="Grafico" Height="128" Margin="0,4,0,0"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="tendencia de todas las pesadas" Style="{StaticResource PanelNota}" FontSize="10.5"/>
                                <TextBlock x:Name="TxtPromedio" Style="{StaticResource PanelNota}" FontSize="10.5" Foreground="#93C5FD" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#26FFFFFF" Margin="0,10,0,10"/>

                            <!-- Avisos en vivo: se llenan desde Recalcular() (máximo 2 + "+N más"). -->
                            <StackPanel x:Name="PanelAlertas"/>
                            <TextBlock x:Name="TxtAlertasExtra" Style="{StaticResource PanelNota}" FontSize="10.5" Margin="2,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                    <Grid>
                        <TextBlock x:Name="TxtHint" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11.5" Foreground="#99FFFFFF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Señal de que el pesaje se está guardando. Sin esto la pantalla
                                 quedaba idéntica durante el viaje al servidor y el operador
                                 volvía a clickear, creyendo que no había pasado nada. -->
                            <TextBlock x:Name="TxtGuardando" Text="Guardando…" Visibility="Collapsed" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,0,12,0"/>
                            <Button x:Name="BtnVolver" Content="Volver" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <!-- "Terminar de pesar" se mudó afuera del modal: ahora es
                                 "Cerrar producto"/"Reabrir producto" en la pantalla principal,
                                 al lado de "Pesar" — se activa con solo seleccionar el
                                 producto, sin necesidad de abrir este modal. -->
                            <!-- Acción principal (seguir agregando pesadas): verde, sólida y a
                                 la orilla derecha — la posición y el color que antes tenía
                                 "Cerrar camión", que es el gesto que termina/consecuencia
                                 mayor, no el que se repite más seguido. -->
                            <Button x:Name="BtnSeguir" Content="Seguir pesando" Style="{StaticResource SolidBtn}" Click="Seguir_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
