<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.PesajeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/><GradientStop Color="#1E3A8A" Offset="0.55"/><GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/><GradientStop Color="#60A5FA" Offset="0.5"/><GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoScale}" Stroke="White" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEyebrow" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock x:Name="TxtTitle" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>

                    <!-- Formulario -->
                    <StackPanel Grid.Column="0" Margin="26,18,26,10">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Placa del vehículo" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtPlaca" Style="{StaticResource MInput}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Proveedor" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtProveedor" Style="{StaticResource MInput}" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha / hora de entrada" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtFechaHora" Style="{StaticResource MInput}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código de producto" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtCodigo" Style="{StaticResource MInput}" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#26FFFFFF" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso bruto (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtBruto" Style="{StaticResource MInput}" TextChanged="Recalcular"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="No. de bultos (este pesaje)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtBultos" Style="{StaticResource MInput}" TextChanged="Recalcular"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso tara individual (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtTaraInd" Style="{StaticResource MInput}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso tara extra (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtTaraExtra" Style="{StaticResource MInput}" Text="0" TextChanged="Recalcular"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Peso neto — este pesaje (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtNeto" Style="{StaticResource MInput}" IsEnabled="False" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso neto total acumulado (kg)" Style="{StaticResource MLabel}"/>
                                <TextBox x:Name="TxtNetoTotal" Style="{StaticResource MInput}" IsEnabled="False" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Observaciones" Style="{StaticResource MLabel}"/>
                        <TextBox x:Name="TxtObs" Style="{StaticResource MInput}" Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                    </StackPanel>

                    <!-- Panel de diferencia -->
                    <Border Grid.Column="1" Background="#38000000" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0" Padding="20,22">
                        <StackPanel>
                            <TextBlock Text="DIFERENCIA" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#99FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtDif" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="kg" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDifMsg" FontFamily="Segoe UI" FontSize="11.5" Foreground="#B3FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <Border Height="1" Background="#26FFFFFF" Margin="0,10"/>
                            <TextBlock Text="MANIFESTADO" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#99FFFFFF"/>
                            <TextBlock x:Name="TxtManifestado" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="26,14">
                    <Grid>
                        <TextBlock x:Name="TxtHint" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11.5" Foreground="#99FFFFFF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Volver" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Cerrar_Click"/>
                            <Button x:Name="BtnSeguir" Content="Seguir pesando" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Seguir_Click"/>
                            <Button Style="{StaticResource SolidBtn}" Click="CerrarCamion_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource MIcoCheck}" Stroke="White" StrokeThickness="2.6" Width="14" Height="14" Stretch="Uniform"
                                          Margin="0,0,6,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="Cerrar camión" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
