<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Pesaje.Modales.SeleccionarProductoModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Pesaje/Modales/PesajeModalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/><GradientStop Color="#1E3A8A" Offset="0.55"/><GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/><GradientStop Color="#60A5FA" Offset="0.5"/><GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="26,18,26,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource MIcoPack}" Stroke="White" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CATÁLOGO" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                        <TextBlock Text="Seleccionar producto" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top" Click="Cerrar_Click"/>
                </Grid>
                <Border Height="1" Background="#26FFFFFF"/>

                <StackPanel Margin="24,16,24,20">
                    <!-- Chip de modo -->
                    <Border x:Name="ChipModo" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="999"
                            Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#4ADE80" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModo" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Búsqueda -->
                    <TextBox x:Name="TxtBuscar" Style="{StaticResource MInput}" Margin="0,0,0,10" TextChanged="Buscar_Changed"/>

                    <!-- Botón alternar alcance -->
                    <Button x:Name="BtnAlcance" Style="{StaticResource GhostBtn}" HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="BtnAlcance_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource MIcoSearch}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,7,0" VerticalAlignment="Center" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock x:Name="TxtAlcance" Text="Buscar en todos los proveedores" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Estado -->
                    <TextBlock x:Name="TxtEstado" FontFamily="Segoe UI" FontSize="12.5" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center" Margin="0,10" Visibility="Collapsed"/>

                    <!-- Resultados -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstResultados">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonUp="Item_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dup}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Background="#28FFFFFF" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Codigo}" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="White" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Meta}" FontFamily="Segoe UI" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
