<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.WelcomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F5F7">

        <!-- Dot-grid background with radial fade -->
        <Rectangle>
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,28,28" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#CBD5E1">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry RadiusX="1" RadiusY="1" Center="1,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                     RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#80000000" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Centered content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="540">

            <!-- Date -->
            <TextBlock x:Name="TxtFecha"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                       Foreground="#6B7280"
                       TextAlignment="Center" Margin="0,0,0,14"/>

            <!-- "Bienvenido, [Name]" -->
            <TextBlock FontFamily="Segoe UI" FontSize="56" FontWeight="ExtraBold"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,14" LineHeight="64">
                <Run Text="Bienvenido, " Foreground="#1A1F2E"/>
                <Run x:Name="RunNombre" Foreground="#1E3A8A"/>
            </TextBlock>

            <!-- Subtitle -->
            <TextBlock Text="Usa el menú lateral para navegar a un módulo, o haz clic en tu nombre para ver tu cuenta."
                       FontFamily="Segoe UI" FontSize="15"
                       Foreground="#6B7280"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
