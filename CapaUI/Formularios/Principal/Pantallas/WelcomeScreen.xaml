<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.WelcomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720">
    <Grid Background="#F4F5F7">

        <!-- Centered content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="540">

            <!-- Date -->
            <TextBlock x:Name="TxtFecha"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                       Foreground="#6B7280"
                       TextAlignment="Center" Margin="0,0,0,14"/>

            <!-- "Bienvenido, [Name]" -->
            <TextBlock FontFamily="Segoe UI" FontSize="56" FontWeight="ExtraBold"
                       TextOptions.TextFormattingMode="Ideal"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,14" LineHeight="64">
                <Run Text="Bienvenido, " Foreground="#1A1F2E"/>
                <Run x:Name="RunNombre" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
            </TextBlock>

            <!-- Subtitle -->
            <TextBlock Text="Usa el menú lateral para navegar a un módulo, o haz clic en tu nombre para ver tu cuenta."
                       FontFamily="Segoe UI" FontSize="15"
                       Foreground="#6B7280"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
