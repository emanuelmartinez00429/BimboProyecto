<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.ContactosFabricantes.ContactosFabricantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.ContactosFabricantes"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             Background="#EAF1F8"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>


        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnDanger" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Encabezado ───────────────────────────── -->
        <Border Grid.Row="0" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" Padding="16,14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <!-- MODO LISTA: ícono + título simple -->
                <StackPanel x:Name="HeaderListMode" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconFactory}"
                              Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CATÁLOGO" FontFamily="Segoe UI" FontSize="11.5"
                                   FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Text="Contactos · Fabricantes" FontFamily="Segoe UI"
                                   FontSize="19" FontWeight="Bold" Foreground="#1A1F2E"/>
                    </StackPanel>
                </StackPanel>

                <!-- MODO CONTACTOS: breadcrumb + título + contador -->
                <Grid x:Name="HeaderContactsMode" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Botón circular volver -->
                    <Button Grid.Column="0" Width="40" Height="40" Margin="0,0,14,0"
                            VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Background="White" Click="BtnVolver_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20"
                                        BorderBrush="#D8E1EC" BorderThickness="1">
                                    <Path Data="{StaticResource IconArrowLeft}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Breadcrumb + título -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Productos" FontFamily="Segoe UI" FontSize="14" Foreground="#9CA3AF"/>
                            <TextBlock Text="  /  " FontFamily="Segoe UI" FontSize="14" Foreground="#CBD5E1"/>
                            <TextBlock Text="Contactos Fabricantes" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EmpresaPrimaryBrightBrush}"/>
                            <TextBlock Text="  /  " FontFamily="Segoe UI" FontSize="14" Foreground="#CBD5E1"/>
                            <TextBlock x:Name="TxtCrumbNombre" FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtContactosTitulo" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="#1A1F2E"/>
                    </StackPanel>
                    <!-- Contador -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource EmpresaPrimaryBrightBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CONTACTOS" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtContactosCount" Text="0" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrightBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Toolbar SearchBox ─────────────────────── -->
        <Border x:Name="ToolbarPanel" Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" Padding="12">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <controls:SuggestionSearchBox x:Name="SearchBox"
                Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SuggestItems="{Binding SuggestItems}"
                HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                Placeholder="Buscar fabricante por nombre..."
                ItemSelected="SearchBox_ItemSelected"/>
        </Border>

        <!-- ── Toolbar modo contactos ───────────────── -->
        <Border x:Name="ContactsToolbar" Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" Padding="12" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Button x:Name="BtnVolver" Style="{StaticResource GhostBtn}" Padding="14,0"
                        HorizontalAlignment="Left" Click="BtnVolver_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}" Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Volver a fabricantes" FontFamily="Segoe UI" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNuevoContacto" Style="{StaticResource ActionBtn}" Background="#16A34A" permisos:PermisoBehavior.Requiere="Crear Fabricante"
                        Padding="14,0" HorizontalAlignment="Right" Click="BtnNuevoContacto_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Nuevo contacto" FontFamily="Segoe UI" FontSize="15"
                                   FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Contenido ─────────────────────────────── -->
        <Border Grid.Row="4" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nivel 1: Lista de fabricantes -->
                <Grid x:Name="PanelFabricantes" Grid.Row="0">
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Path x:Name="SpinnerPath"
                              Data="M 12 2 A 10 10 0 1 1 2 12"
                              Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="22" Height="22" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                        <TextBlock Text="Cargando fabricantes..." FontFamily="Segoe UI"
                                   FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280">Sin resultados.</TextBlock>
                    </StackPanel>
                    <DataGrid x:Name="DgFabricantes"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="White" BorderThickness="0" AlternationCount="2"
                              RowStyle="{StaticResource ProductRowStyle}"
                              CellStyle="{StaticResource CeldaCentrada}"
                              SelectionChanged="DgFabricantes_SelectionChanged"
                              MouseDoubleClick="DgFabricantes_MouseDoubleClick"
                              PreviewKeyDown="DgFabricantes_PreviewKeyDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False" CanUserReorder="False"
                                                    CellStyle="{StaticResource CeldaCentrada}"
                                                    CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/>
                            <DataGridTemplateColumn Header="NOMBRE" Width="*" CellStyle="{StaticResource CeldaIzquierda}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI"
                                                   FontSize="15.5" Foreground="#1A1F2E"
                                                   TextTrimming="CharacterEllipsis" Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DESCRIPCIÓN" Width="*" CellStyle="{StaticResource CeldaIzquierda}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Descripcion, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin descripción'}"
                                                   Style="{StaticResource TextoCeldaConFallback}" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PROVEEDOR" Width="180" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NombreProveedor, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin proveedor'}"
                                                   Style="{StaticResource TextoCeldaConFallback}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ESTADO" Width="70" HeaderStyle="{StaticResource HeaderCentrado}" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center">
                                            <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource EmpresaPrimaryBrush}" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                </Border.Effect>
                                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.8"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="11" Height="11" Stretch="Uniform"/>
                                            </Border>
                                            <Border Width="20" Height="20" CornerRadius="4" Background="White"
                                                    BorderBrush="#CBD5E1" BorderThickness="2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="160" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Ver contactos ›" FontFamily="Segoe UI" FontSize="14"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Pagination footer (P-037) -->
                <controls:PaginadorControl x:Name="PaginacionBar"
                                           Grid.Row="1"
                                           Page="{Binding Page, Mode=TwoWay}"
                                           TotalPages="{Binding TotalPages}"
                                           PageInfo="{Binding PageInfo}"
                                           IsLoading="{Binding IsLoading}"/>

                <!-- Nivel 2: Contactos del fabricante seleccionado -->
                <Grid x:Name="PanelContactos" Grid.RowSpan="2" Visibility="Collapsed">
                    <StackPanel x:Name="LoadingContactos" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="Cargando contactos..." FontFamily="Segoe UI"
                                   FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="EmptyContactos" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconPerson}"
                              Stroke="#CBD5E1" StrokeThickness="1.5"
                              Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sin contactos registrados" FontFamily="Segoe UI"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Haz clic en «Nuevo contacto» para agregar el primero."
                                   FontFamily="Segoe UI" FontSize="15" Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="DgContactos"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="White" BorderThickness="0" AlternationCount="2"
                              RowStyle="{StaticResource ProductRowStyle}"
                              CellStyle="{StaticResource CeldaCentrada}"
                              SelectionChanged="DgContactos_SelectionChanged"
                              MouseDoubleClick="DgContactos_MouseDoubleClick"
                              PreviewKeyDown="DgContactos_PreviewKeyDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NOMBRE" Width="*" CellStyle="{StaticResource CeldaIzquierda}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI"
                                                   FontSize="15.5" FontWeight="SemiBold" Foreground="#1A1F2E"
                                                   TextTrimming="CharacterEllipsis" Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TELÉFONO" Width="180" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Telefono, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin teléfono'}"
                                                   Style="{StaticResource TextoCeldaConFallback}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CORREO" Width="240" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Correo, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin correo'}"
                                                   Style="{StaticResource TextoCeldaConFallback}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACCIONES" Width="100" CellStyle="{StaticResource CeldaCentrada}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconBtn}"
                                                    Tag="{Binding}"
                                                    Click="BtnEditarContacto_Click" permisos:PermisoBehavior.Requiere="Modificar Fabricante"
                                                    ToolTip="Editar">
                                                <Path Data="{StaticResource IconPencil}"
                                                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource IconBtnDanger}"
                                                    Tag="{Binding}"
                                                    Click="BtnEliminarContacto_Click" permisos:PermisoBehavior.Requiere="Modificar Fabricante"
                                                    ToolTip="Eliminar">
                                                <Path Data="{StaticResource IconTrash}"
                                                      Stroke="#DC2626" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- Modal overlay -->
    </Grid>

        <!-- MODAL OVERLAY — fuera del Grid con márgenes para cubrir toda la vista -->
        <Border x:Name="ModalOverlay"
                Background="#80000000" Visibility="Collapsed"
                Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
