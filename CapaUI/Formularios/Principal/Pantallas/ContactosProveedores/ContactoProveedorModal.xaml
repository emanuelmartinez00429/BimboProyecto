<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.ContactosProveedores.ContactoProveedorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IconPersonM">M20,21 v-2 a4,4 0 0 0,-4,-4 H8 a4,4 0 0 0,-4,4 v2 M12,11 a4,4 0 1 0,0,-8 a4,4 0 0 0,0,8 z</Geometry>
        <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>
        <Geometry x:Key="IconCheckM">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IconTruckM">M1,3 h15 v13 H1 z M16,8 h4 l3,3 v5 h-7 z M5.5,19 a1.5,1.5 0 1 0,0,-3 a1.5,1.5 0 0 0,0,3 z M18.5,19 a1.5,1.5 0 1 0,0,-3 a1.5,1.5 0 0 0,0,3 z</Geometry>

        <Style x:Key="ModalInput" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" ClipToBounds="True"
            MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Padding="24,18,24,14" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPersonM}"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtModalTitle"
                                       FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="30" Height="30"
                                Background="#14FFFFFF" BorderThickness="0"
                                VerticalAlignment="Top" Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tarjeta del proveedor (solo lectura) -->
                <Border Margin="24,16,24,0" Padding="14,10" CornerRadius="8" Background="#1AFFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="#24FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTruckM}"
                                  Stroke="#A6FFFFFF" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="PROVEEDOR" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Foreground="#80FFFFFF"/>
                            <TextBlock x:Name="TxtProveedorNombre"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Formulario -->
                <StackPanel Margin="24,16,24,18">
                    <TextBlock Text="Nombre completo" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="#CCFFFFFF" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource ModalInput}" Margin="0,0,0,12"/>

                    <TextBlock Text="Teléfono" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="#CCFFFFFF" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTelefono" Style="{StaticResource ModalInput}" Margin="0,0,0,12"/>

                    <TextBlock Text="Correo electrónico" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="#CCFFFFFF" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCorreo" Style="{StaticResource ModalInput}" Margin="0,0,0,0"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Content="Cancelar"
                                Background="#1EFFFFFF" BorderThickness="0"
                                Foreground="White" FontFamily="Segoe UI" FontSize="15"
                                FontWeight="SemiBold" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnGuardar" Grid.Column="2" Height="42"
                                Background="#16A34A" BorderThickness="0"
                                Foreground="White" FontFamily="Segoe UI" FontSize="15"
                                FontWeight="SemiBold" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Tag="Agregar"
                                Click="BtnGuardar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconCheckM}"
                                                  Stroke="White" StrokeThickness="2.2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="{TemplateBinding Tag}"
                                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value><DropShadowEffect Opacity="0"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
