<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Usuarios.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Usuarios"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             Background="#EAF1F8"
             DataContext="{x:Null}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
              TextOptions.TextRenderingMode="Auto"
              TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos/geometrias compartidos viven en Styles.xaml; el disenador
                     de VS no ejecuta App.xaml y no los ve sin este merge. Ver ADR-028 / P-057. -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- ── Celda de filtro de catálogo ── -->
        <Style x:Key="CeldaFiltro" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EtiquetaFiltro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ComboFiltroBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="DisplayMemberPath" Value="Nombre"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: PAGE HEADER -->
        <controls:EncabezadoCatalogo Grid.Row="0"
            Icono="{StaticResource IcoUsuarios}" IconoEsRelleno="True"
            ModuloPadre="Usuarios" Submodulo="Gestión de Usuarios"
            Titulo="Administración de usuarios del sistema"
            Total="{Binding TotalCount}" Activos="{Binding ActivosCount}" Inactivos="{Binding InactivosCount}"/>

        <!-- ROW 2: TOOLBAR -->
        <Border Grid.Row="2" x:Name="TarjetaToolbar" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" Padding="12" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <StackPanel>
                <!-- Search + Clear -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:SuggestionSearchBox Grid.Column="0" Margin="0,0,10,0"
                        x:Name="SearchBox"
                        Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SuggestItems="{Binding SuggestItems}"
                        HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                        Placeholder="Buscar usuario por alias o nombre de empleado..."
                        ItemSelected="SearchBox_ItemSelected"/>
                    <controls:BotonLimpiarFiltros Grid.Column="1"
                                                  ReferenciaAncho="{Binding ElementName=TarjetaToolbar}"/>
                </Grid>

                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,10,0,10" SnapsToDevicePixels="True"/>

                <!-- Filters -->
                <controls:PanelFiltrosFluido EspacioHorizontal="16" EspacioVertical="12">

                    <!-- ESTADO -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ESTADO"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Omitir GroupName elimina el escaneo O(N) del árbol visual (AP-02) -->
                                <RadioButton x:Name="RbActivos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoUsuarioFilter.Activos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoUsuarioFilter.Inactivos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbTodos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoUsuarioFilter.Todos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <TextBlock Text="Todos" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ROL: Peso="1" → absorbe el ancho sobrante -->
                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rol" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbRol"
                                  Style="{StaticResource ComboFiltroBox}"/>
                    </Grid>

                </controls:PanelFiltrosFluido>
            </StackPanel>
        </Border>

        <!-- ROW 4: TABLE -->
        <Grid Grid.Row="4">
            <!-- Sombra estática desacoplada: Border hermano detrás del contenido,
                 así el scroll del DataGrid no la re-renderiza por frame.
                 Ver [[WPF - Rendimiento de Efectos y Niveles de Renderizado]]. -->
            <Border Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/>
                </Border.Effect>
            </Border>

            <Border Background="White" CornerRadius="10"
                    BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading overlay reutilizable (AP-04) -->
                <controls:LoadingOverlay Grid.Row="0"
                                         Panel.ZIndex="10"
                                         HeaderOffset="40"
                                         IsLoading="{Binding IsLoading}"
                                         Mensaje="Cargando usuarios..."/>

                <!-- DataGrid -->
                <DataGrid Grid.Row="0" x:Name="DgUsuarios"
                          ItemsSource="{Binding PageRows, Mode=OneWay}"
                          SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="White" RowBackground="White"
                          RenderOptions.ClearTypeHint="Enabled"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          BorderThickness="0" AlternationCount="2"
                          FontFamily="Segoe UI"
                          FontSize="15.5"
                          RowStyle="{StaticResource ProductRowStyle}" CellStyle="{StaticResource CeldaIzquierda}"
                          MouseDoubleClick="DgUsuarios_MouseDoubleClick"
                          PreviewKeyDown="DgUsuarios_PreviewKeyDown"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False" CanUserReorder="False"
                                                HeaderStyle="{StaticResource HeaderCentrado}"
                                                CellStyle="{StaticResource CeldaCentrada}"
                                                CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/>
                        <DataGridTemplateColumn Header="EMPLEADO" Width="*" MinWidth="220" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreEmpleado}"
                                               FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                               Foreground="#1A1F2E" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="EMAIL" Width="*" MinWidth="220" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CorreoUsuario, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin correo'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ROL" Width="Auto" MinWidth="130" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F5FB" CornerRadius="999" Padding="10,2" HorizontalAlignment="Left" Margin="8,0">
                                        <TextBlock Text="{Binding NombreRol}"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ÚLTIMO ACCESO" Width="Auto" MinWidth="160" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0">
                                        <TextBlock.Text>
                                            <Binding Path="UltimoAcceso" StringFormat="{}{0:dd/MM/yyyy HH:mm}" TargetNullValue="Sin registros"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CREADO" Width="Auto" MinWidth="150" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTUALIZADO" Width="Auto" MinWidth="150" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="70" MinWidth="70" HeaderStyle="{StaticResource HeaderCentrado}" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="{DynamicResource EmpresaPrimaryBrush}" HorizontalAlignment="Center">
                                            <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            </Border.Style>
                                            <Path Data="{StaticResource IconCheck}"
                                                  Stroke="White" StrokeThickness="2.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="11" Height="11" Stretch="Uniform"/>
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="White" BorderBrush="#CBD5E1" BorderThickness="2"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state overlay -->
                <controls:EmptyStateOverlay Grid.Row="0"
                                            x:Name="EmptyState"
                                            Panel.ZIndex="5"
                                            HeaderOffset="40"
                                            Mensaje="{Binding MensajeSinResultados}"
                                            EstaVacio="{Binding NoResults}"/>

                <!-- Pagination footer (P-037) -->
                <controls:PaginadorControl Grid.Row="1"
                                           Page="{Binding Page, Mode=TwoWay}"
                                           TotalPages="{Binding TotalPages}"
                                           PageInfo="{Binding PageInfo}"
                                           IsLoading="{Binding IsLoading}"/>
            </Grid>
            </Border>
        </Grid>

        <!-- ROW 5: ACTION BUTTONS -->
        <DockPanel Grid.Row="5" Margin="0,4,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding EditarCommand}" permisos:PermisoBehavior.Requiere="Modificar Usuario,Eliminar Usuario,Asignar Rol a Usuario" Background="{DynamicResource EmpresaPrimaryBrush}"
                        Style="{StaticResource ActionBtn}" Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPencil}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar" FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleEstadoCommand}" permisos:PermisoBehavior.Requiere="Eliminar Usuario" Background="#D97706"
                        Style="{StaticResource ActionBtn}" Padding="22,0" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconToggle}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cambiar Estado" FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" x:Name="SelectedInfo"
                        Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"
                        Visibility="{Binding HaySeleccionado, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedText" FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"
                           VerticalAlignment="Center" Text="{Binding TextoSeleccionado}"/>
            </StackPanel>

            <Border DockPanel.Dock="Left" Background="#FFFBEB" BorderBrush="#FCD34D"
                    BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="12,0,0,0"
                    Visibility="{Binding MostrarAdvertenciaAutogestion, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <TextBlock Text="No puedes cambiar tu propio rol ni deshabilitar tu cuenta desde este módulo."
                           Foreground="#92400E" FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </DockPanel>

        <!-- ROW 6: ERROR DISPLAY -->
        <Border x:Name="ErrorPanel" Grid.Row="6" Background="#FEF2F2" CornerRadius="8"
                BorderBrush="#FECACA" BorderThickness="1"
                Padding="14,10" Margin="0,0,0,4"
                Visibility="{Binding HayErrorCarga, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorCarga}"
                       FontFamily="Segoe UI" FontSize="15" FontWeight="Medium"
                       Foreground="#B91C1C" TextWrapping="Wrap"/>
        </Border>

    </Grid>

        <!-- MODAL OVERLAY -->
        <Border x:Name="ModalOverlay" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
