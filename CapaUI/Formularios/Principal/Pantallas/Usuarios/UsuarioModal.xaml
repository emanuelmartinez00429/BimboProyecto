<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Usuarios.UsuarioModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
             mc:Ignorable="d po"
             Width="560"
             d:DesignWidth="560"
             d:DesignHeight="650"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Auto"
             TextOptions.TextFormattingMode="Display"
             RenderOptions.ClearTypeHint="Enabled"
             controls:AtajoGuardar.Boton="{x:Reference BtnGuardar}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <PathGeometry x:Key="IconCloseM" Figures="M6,6 l12,12 M18,6 l-12,12" po:Freeze="True"/>
            <PathGeometry x:Key="IconEyePassword"
                          Figures="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                          po:Freeze="True"/>

            <!-- ModalSegBtn, EtiquetaCampo, CampoModal y ModalPassword vienen de Styles.xaml. -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Modal container with decoupled drop shadow (AP-06) -->
    <Grid>
        <!-- Borde hermano estático para sombra: la GPU lo rasteriza de forma independiente
             y no sufre recorte por ClipToBounds ni conflicto de shaders. -->
        <Border Background="#1E293B" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <!-- Contenedor con recorte para el gradiente y bordes redondeados limpios -->
        <Border CornerRadius="10" ClipToBounds="True">
            <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Top color stripe -->
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border Padding="28,20,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IcoUsuarios}"
                                  Fill="White"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext" Style="{StaticResource ModalContexto}"/>
                            <TextBlock x:Name="TxtModalTitle" Style="{StaticResource ModalTitulo}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="32" Height="32"
                                Background="#14FFFFFF" BorderThickness="0"
                                VerticalAlignment="Top" Cursor="Hand"
                                FocusVisualStyle="{x:Null}" Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}"
                                              Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form -->
                <StackPanel Margin="40,20,40,18">
                    <!-- Empleado (solo al crear con empleado preseleccionado). -->
                    <StackPanel x:Name="RowEmpleado" Style="{StaticResource CampoModal}">
                        <TextBlock Text="Empleado" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBlock x:Name="TxtEmpleadoNombre"
                                   FontFamily="Segoe UI" FontSize="16.5"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   Padding="10,6"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Email" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource ModalInput}"
                                 IsReadOnly="True" TabIndex="20"
                                 Padding="10,0,12,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Contraseña: solo al crear. -->
                    <StackPanel x:Name="RowPassword" Style="{StaticResource CampoModal}" Visibility="Collapsed">
                        <TextBlock Text="Contrase&#241;a" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid x:Name="PasswordInputGrid" HorizontalAlignment="Stretch">
                            <PasswordBox x:Name="TxtPassword"
                                         Style="{StaticResource ModalPassword}"
                                         Padding="10,0,42,0"
                                         HorizontalAlignment="Stretch"
                                         TabIndex="30"/>
                            <TextBox x:Name="TxtPasswordVisible"
                                     Style="{StaticResource ModalInput}"
                                     Padding="10,0,42,0"
                                     HorizontalAlignment="Stretch"
                                     Visibility="Collapsed"
                                     TabIndex="30"
                                     validacion:Validacion.TieneError="{Binding Path=(validacion:Validacion.TieneError), ElementName=TxtPassword}"
                                     validacion:Validacion.Error="{Binding Path=(validacion:Validacion.Error), ElementName=TxtPassword}"/>
                            <Button x:Name="BtnTogglePassword"
                                    Width="40" Height="36"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    ToolTip="Mostrar u ocultar contraseña"
                                    AutomationProperties.Name="Mostrar u ocultar contraseña"
                                    Click="BtnTogglePassword_Click" TabIndex="31">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconEyePassword}" Fill="#64748B"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Rol" Style="{StaticResource EtiquetaCampo}"/>
                        <ComboBox x:Name="CmbRolModal" Style="{StaticResource ModalCombo}"
                                  HorizontalAlignment="Stretch" TabIndex="40"/>
                    </StackPanel>

                    <!-- Estado: solo al editar. -->
                    <StackPanel x:Name="RowEstado" Style="{StaticResource CampoModal}" Visibility="Collapsed">
                        <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}"/>
                        <Border Background="#1AFFFFFF" CornerRadius="8"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo" GroupName="EstadoModal" IsChecked="True"
                                             Style="{StaticResource ModalSegBtn}" TabIndex="50">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo" GroupName="EstadoModal"
                                             Style="{StaticResource ModalSegBtn}" TabIndex="51">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Error message -->
                <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="14.5"
                           Foreground="#FCA5A5" TextWrapping="Wrap"
                           Margin="40,0,40,12" Visibility="Collapsed"/>

                <!-- Footer -->
                <Border Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Ctrl+Enter para guardar" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#8CFFFFFF"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancelar"
                                    Click="BtnCerrar_Click"
                                    Background="#1AFFFFFF" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1"
                                    Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" Margin="0,0,10,0" TabIndex="60">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnGuardar"
                                    Content="Guardar"
                                    Click="BtnGuardar_Click"
                                    Foreground="White" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1"
                                    Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" TabIndex="61">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Sombra"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    IsHitTestVisible="False">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                                </Border.Effect>
                                            </Border>
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M20,6 L9,17 l-5,-5"
                                                          Stroke="White" StrokeThickness="2.6"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                               FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                                               Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                                </Setter>
                                                <Setter TargetName="Sombra" Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</UserControl>

