<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Usuarios.UsuarioModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IconUserM">M20,21 v-2 a4,4 0 0 0,-4,-4 H8 a4,4 0 0 0,-4,4 v2 M12,3 a4,4 0 1 1 0,8 a4,4 0 0 1 0,-8 z</Geometry>
        <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>

        <Style x:Key="ModalSegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Top color stripe -->
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border Padding="28,20,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUserM}"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtModalTitle"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="32" Height="32"
                                Background="#14FFFFFF" BorderThickness="0"
                                VerticalAlignment="Top" Cursor="Hand"
                                FocusVisualStyle="{x:Null}" Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}"
                                              Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form -->
                <StackPanel Margin="40,20,40,18">
                    <!-- Empleado (solo al crear) -->
                    <Grid x:Name="RowEmpleado" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Empleado"
                                   FontFamily="Segoe UI" FontSize="16.5" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbEmpleado" Style="{StaticResource ModalCombo}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtEmpleadoNombre"
                                   FontFamily="Segoe UI" FontSize="16.5"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   Padding="10,6" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Email -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Email"
                                   FontFamily="Segoe UI" FontSize="16.5" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtEmail" Style="{StaticResource ModalInput}"
                                 IsReadOnly="True"/>
                    </Grid>

                    <!-- Password (solo al crear) -->
                    <Grid x:Name="RowPassword" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Contraseña"
                                   FontFamily="Segoe UI" FontSize="16.5" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <PasswordBox Grid.Column="1" x:Name="TxtPassword" Height="34"
                                     Padding="10,0" FontFamily="Segoe UI" FontSize="15.5"
                                     Foreground="#1A1F2E" Background="White"
                                     BorderBrush="#7FFFFFFF" BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     FocusVisualStyle="{x:Null}"/>
                    </Grid>

                    <!-- Rol -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rol"
                                   FontFamily="Segoe UI" FontSize="16.5" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbRolModal" Style="{StaticResource ModalCombo}"/>
                    </Grid>

                    <!-- Estado (solo al editar) -->
                    <Grid x:Name="RowEstado" Margin="0,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Estado"
                                   FontFamily="Segoe UI" FontSize="16.5" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <Border Grid.Column="1"
                                Background="#1AFFFFFF" CornerRadius="8"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo" GroupName="EstadoModal" IsChecked="True"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo" GroupName="EstadoModal"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Error message -->
                <TextBlock x:Name="TxtError" FontFamily="Segoe UI" FontSize="14.5"
                           Foreground="#FCA5A5" TextWrapping="Wrap"
                           Margin="40,0,40,12" Visibility="Collapsed"/>

                <!-- Footer -->
                <Border Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancelar"
                                    Click="BtnCerrar_Click"
                                    Background="#1AFFFFFF" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1"
                                    Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnGuardar"
                                    Content="Guardar"
                                    Click="BtnGuardar_Click"
                                    Foreground="White" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1"
                                    Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,6 L9,17 l-5,-5"
                                                      Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
