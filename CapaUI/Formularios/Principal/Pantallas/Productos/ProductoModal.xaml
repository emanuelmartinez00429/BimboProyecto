<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Productos.ProductoModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             mc:Ignorable="d"
             Width="1020"
             d:DesignWidth="1020"
             d:DesignHeight="700"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display" controls:AtajoGuardar.Boton="{x:Reference BtnGuardar}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Geometry x:Key="IconBoxM">M21,16 V8 a2,2 0 0 0,-1,-1.73 l-7,-4 a2,2 0 0 0,-2,0 l-7,4 A2,2 0 0 0,3,8 v8 a2,2 0 0 0,1,1.73 l7,4 a2,2 0 0 0,2,0 l7,-4 A2,2 0 0 0,21,16 z</Geometry>
            <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>
            <Geometry x:Key="IconCheckM">M20,6 L9,17 l-5,-5</Geometry>

            <!-- EtiquetaCampo, CampoModalEnGrid, ModalInputAuditoria, ModalSegBtn y
                 LupaBtnOscuro (la lupa de los campos de catálogo) viven en
                 CapaUI/Resources/Styles.xaml — estaban duplicados acá y en
                 PresentacionModal. Este modal usa CampoModalEnGrid (la variante con
                 separación lateral) por su layout de 3 columnas. -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Modal container with gradient background -->
    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>
        <Grid x:Name="RootGrid">
            <!-- Gradient background -->
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Alto fijado en OnLoaded (code-behind) al alto natural del
                 formulario: el marco no se redimensiona ni al cambiar a modo
                 tabla ni al filtrar dentro de ella (ver RootGrid en el .cs). -->
            <ScrollViewer x:Name="FormHost"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Top color stripe -->
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border Padding="28,20,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBoxM}"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtModalTitle"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="32" Height="32"
                                Background="#14FFFFFF"
                                BorderThickness="0"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}"
                                              Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form: 3 columnas, etiqueta arriba del campo -->
                <Grid Margin="28,22,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 1: Codigo | Nombre | Presentacion -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="C&#243;digo interno" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtCodigo" Style="{StaticResource ModalInput}" TabIndex="10"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Nombre producto" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource ModalInput}" TabIndex="20"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Presentaci&#243;n" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtPresentacion" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="30"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarPresentacion}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarPresentacion" TabIndex="31"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarPresentacion_Click"
                                    ToolTip="Seleccionar presentación"/>
                        </Grid>
                    </StackPanel>

                    <!-- Fila 2: Categoria | Proveedor (acota fabricantes) | Fabricante -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Categor&#237;a" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtCategoria" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="40"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarCategoria}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarCategoria" TabIndex="41"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarCategoria_Click"
                                    ToolTip="Seleccionar categoría"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Proveedor" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtProveedor" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="50"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarProveedor}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarProveedor" TabIndex="51"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarProveedor_Click"
                                    ToolTip="Seleccionar proveedor (acota los fabricantes)"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Fabricante" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtFabricante" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="60"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarFabricante}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarFabricante" TabIndex="61"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarFabricante_Click"
                                    ToolTip="Seleccionar fabricante"/>
                        </Grid>
                    </StackPanel>

                    <!-- Fila 3: Contenido | Unidad | Peso teorico -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Contenido" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtContenido" Style="{StaticResource ModalInput}" TabIndex="70"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Unidad" Style="{StaticResource EtiquetaCampo}"/>
                        <!-- Items poblados en OnLoaded desde unidad_medida (catálogo real), no hardcodeados -->
                        <ComboBox x:Name="CmbUnidad" Style="{StaticResource ModalCombo}" TabIndex="80"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Peso te&#243;rico" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtPesoTeorico" Style="{StaticResource ModalInput}" TabIndex="90"/>
                    </StackPanel>

                    <!-- Fila 4: Tara | Precio por kg | Pais importado -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Tara" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtTara" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="100"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarTara}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarTara" TabIndex="101"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarTara_Click"
                                    ToolTip="Seleccionar tara"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Precio por kg" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtPrecioPorKg" Style="{StaticResource ModalInput}" TabIndex="110"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Pa&#237;s importado" Style="{StaticResource EtiquetaCampo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtPais" Style="{StaticResource ModalInput}" IsReadOnly="True" TabIndex="120"
                                     Cursor="Hand" PreviewMouseDoubleClick="TxtCatalogo_PreviewMouseDoubleClick"
                             KeyDown="TxtCatalogo_KeyDown"
                                     Tag="{Binding ElementName=BtnBuscarPais}"/>
                            <Button Grid.Column="1" x:Name="BtnBuscarPais" TabIndex="121"
                                    Style="{StaticResource LupaBtnOscuro}"
                                    Click="BuscarPais_Click"
                                    ToolTip="Seleccionar país"/>
                        </Grid>
                    </StackPanel>

                    <!-- Fila 5: Creado | Actualizado | Estado -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Creado" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtCreatedAt" Style="{StaticResource ModalInputAuditoria}" IsReadOnly="True" IsTabStop="False"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Actualizado" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtUpdatedAt" Style="{StaticResource ModalInputAuditoria}" IsReadOnly="True" IsTabStop="False"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource CampoModalEnGrid}">
                        <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}"/>
                        <Border Background="#1AFFFFFF"
                                CornerRadius="8"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo"
                                             GroupName="EstadoModal"
                                             IsChecked="True"
                                             TabIndex="130"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo"
                                             GroupName="EstadoModal"
                                             TabIndex="131"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <!-- Buttons -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Volver -->
                            <Button Content="Volver"
                                    Click="BtnCerrar_Click"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1"
                                    Padding="22,9"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Guardar -->
                            <Button x:Name="BtnGuardar"
                                    Content="Guardar"
                                    Click="BtnGuardar_Click"
                                    Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1"
                                    Padding="22,9"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,6 L9,17 l-5,-5"
                                                      Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Selector de catálogo: REEMPLAZA al formulario dentro del mismo
                 marco (no se superpone). El modal muestra solo la tabla y se
                 reajusta a su alto; al elegir un item vuelve el formulario.
                 El formulario queda colapsado, no destruido: volver es
                 instantáneo y no se pierde nada de lo ya cargado. -->
            <ContentControl x:Name="SelectorHost" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
