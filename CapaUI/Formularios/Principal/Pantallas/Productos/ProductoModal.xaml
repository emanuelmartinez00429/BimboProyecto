<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Productos.ProductoModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="620"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IconBoxM">M21,16 V8 a2,2 0 0 0,-1,-1.73 l-7,-4 a2,2 0 0 0,-2,0 l-7,4 A2,2 0 0 0,3,8 v8 a2,2 0 0 0,1,1.73 l7,4 a2,2 0 0 0,2,0 l7,-4 A2,2 0 0 0,21,16 z</Geometry>
        <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>
        <Geometry x:Key="IconCheckM">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IconSearchM">M11,4 a7,7 0 1 1 0,14 a7,7 0 0 1 0,-14 z M20,20 l-4.3,-4.3</Geometry>

        <Style x:Key="ModalInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.08" Direction="270"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#7FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ModalSegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Modal container with gradient background -->
    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="100" ShadowDepth="40" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <!-- Gradient background -->
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel>
                <!-- Top color stripe -->
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header -->
                <Border Padding="28,20,28,14"
                        BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#24FFFFFF"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBoxM}"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext"
                                       FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtModalTitle"
                                       FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="32" Height="32"
                                Background="#14FFFFFF"
                                BorderThickness="0"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}"
                                              Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form -->
                <StackPanel Margin="40,20,40,18">
                    <!-- Row: Código -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="C&#243;digo interno"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtCodigo" Style="{StaticResource ModalInput}"/>
                    </Grid>
                    <!-- Row: Nombre -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre producto"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtNombre" Style="{StaticResource ModalInput}"/>
                    </Grid>
                    <!-- Row: Presentación -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Presentaci&#243;n"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtPresentacion" Style="{StaticResource ModalInput}" IsReadOnly="True"/>
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                Background="White"
                                BorderBrush="#7FFFFFFF" BorderThickness="1"
                                Cursor="Hand" Margin="4,0,0,0"
                                FocusVisualStyle="{x:Null}"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <Path Data="{StaticResource IconSearchM}"
                                              Stroke="#1E3A8A" StrokeThickness="2.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <!-- Row: Fabricante -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fabricante"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbFabricanteModal" Style="{StaticResource ModalCombo}"/>
                    </Grid>
                    <!-- Row: Categoría -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Categor&#237;a"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbCategoriaModal" Style="{StaticResource ModalCombo}"/>
                    </Grid>
                    <!-- Row: Contenido -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Contenido"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtContenido" Style="{StaticResource ModalInput}" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="2" x:Name="CmbUnidad" Style="{StaticResource ModalCombo}" Height="30">
                            <ComboBoxItem Content="g"/>
                            <ComboBoxItem Content="kg"/>
                            <ComboBoxItem Content="ml"/>
                            <ComboBoxItem Content="l"/>
                            <ComboBoxItem Content="oz"/>
                        </ComboBox>
                    </Grid>
                    <!-- Row: País -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pa&#237;s importado"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbPaisModal" Style="{StaticResource ModalCombo}">
                            <ComboBoxItem Content="Honduras"/>
                            <ComboBoxItem Content="Guatemala"/>
                            <ComboBoxItem Content="Uruguay"/>
                            <ComboBoxItem Content="Belice"/>
                            <ComboBoxItem Content="M&#233;xico"/>
                            <ComboBoxItem Content="El Salvador"/>
                            <ComboBoxItem Content="Nicaragua"/>
                            <ComboBoxItem Content="Costa Rica"/>
                        </ComboBox>
                    </Grid>
                    <!-- Row: Estado -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Estado"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2FFFFFF" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <Border Grid.Column="1"
                                Background="#1AFFFFFF"
                                CornerRadius="8"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo"
                                             GroupName="EstadoModal"
                                             IsChecked="True"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo"
                                             GroupName="EstadoModal"
                                             Style="{StaticResource ModalSegBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Footer -->
                <Border Background="#2E000000"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <!-- Logo -->
                        <Border DockPanel.Dock="Left"
                                Background="White"
                                CornerRadius="6"
                                Padding="12,4"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                            <Image x:Name="ModalLogo"
                                   Height="26"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <!-- Buttons -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Volver -->
                            <Button Content="Volver"
                                    Click="BtnCerrar_Click"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1"
                                    Padding="22,9"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Guardar -->
                            <Button x:Name="BtnGuardar"
                                    Click="BtnGuardar_Click"
                                    Foreground="White"
                                    FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1"
                                    Padding="22,9"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,6 L9,17 l-5,-5"
                                                      Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Guardar"
                                                           FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
