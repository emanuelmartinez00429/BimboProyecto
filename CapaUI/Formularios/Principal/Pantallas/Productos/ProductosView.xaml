<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Productos.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Productos"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             Background="#EAF1F8"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <!-- Geometry icons -->
        <Geometry x:Key="IconFilter">M3,6 h18 M6,12 h12 M10,18 h4</Geometry>
        <Geometry x:Key="IconCheck">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IconPlus">M12,5 v14 M5,12 h14</Geometry>
        <Geometry x:Key="IconPencil">M11,4 H4 a2,2 0 0 0,-2,2 v14 a2,2 0 0 0,2,2 h14 a2,2 0 0 0,2,-2 v-7 M18.5,2.5 a2.12,2.12 0 0 1,3,3 L12,15 l-4,1 1,-4 z</Geometry>
        <Geometry x:Key="IconLogout">M9,21 H5 a2,2 0 0 1,-2,-2 V5 a2,2 0 0 1,2,-2 h4 M16,17 l5,-5 -5,-5 M21,12 H9</Geometry>
        <Geometry x:Key="IconBox">M21,16 V8 a2,2 0 0 0,-1,-1.73 l-7,-4 a2,2 0 0 0,-2,0 l-7,4 A2,2 0 0 0,3,8 v8 a2,2 0 0 0,1,1.73 l7,4 a2,2 0 0 0,2,0 l7,-4 A2,2 0 0 0,21,16 z</Geometry>

        <!-- ── Celda de filtro de catálogo (Proveedor · Fabricante · Categoría · País) ──
             Las tres piezas viven acá una sola vez: antes cada combo repetía las
             mismas ocho propiedades inline y cada uno tenía su propio Width, que
             es lo que rompía la simetría de la barra. -->
        <Style x:Key="CeldaFiltro" TargetType="Grid">
            <!-- Sin Margin: la separación entre grupos la pone el panel
                 (EspacioHorizontal), que además la descuenta al decidir el corte
                 de línea. Un margen acá se le escaparía de esa cuenta. -->
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EtiquetaFiltro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ComboFiltroBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <!-- Sin Width: se estira con lo que el panel le reparta a su celda.
                 MinWidth es el piso de legibilidad: por debajo de esto el panel
                 baja el grupo de línea en vez de seguir achicándolo (que es lo
                 que producía los "(Todos" recortados). -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="DisplayMemberPath" Value="Nombre"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style x:Key="ProductRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="#34D399"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="1"/>
                                <DataGridCellsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                            </Trigger>
                            <!-- Hover en fila alterna: color más oscuro para distinguirse de #E8F0FA -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                                <Setter TargetName="SelIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E8F0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Element style for plain (non-templated) DataGridTextColumn cells,
             standardized to the largest body font size used in the grid (15.5) -->
        <Style x:Key="ProductCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{DynamicResource EmpresaPrimaryBrush}"
                                BorderBrush="#1EFFFFFF"
                                BorderThickness="0,0,1,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Padding="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination Button Style -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Page Button Style -->
        <Style x:Key="ActivePageBtn" TargetType="Button" BasedOn="{StaticResource PageBtn}">
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        </Style>

        <!-- Segmented Radio Button Style -->
        <Style x:Key="SegmentBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1A1F2E"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar templates -->
        <ControlTemplate x:Key="ModernScrollBarTemplateVertical" TargetType="ScrollBar">
            <Grid x:Name="GridRoot" Width="8">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Height="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#94A3B8" CornerRadius="4" Margin="2,0"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Height="0"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ModernScrollBarTemplateHorizontal" TargetType="ScrollBar">
            <Grid x:Name="GridRoot" Height="10">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Width="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#94A3B8" CornerRadius="4" Margin="0,2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Width="0"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Modern ScrollBar Style (vertical) -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplateVertical}"/>
        </Style>

        <!-- Combined ScrollBar Style: picks vertical/horizontal template by Orientation -->
        <Style x:Key="ModernScrollBarAny" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplateVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplateHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ScrollViewer Style -->
        <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ModernScrollBar}"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: PAGE HEADER -->
        <Grid Grid.Row="0" x:Name="EncabezadoPagina">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Icon + breadcrumb + title.
                 Grid y no StackPanel horizontal: ahí los hijos se miden con
                 ancho infinito, así que los TextBlock nunca se enteraban de que
                 había que recortar y la columna los cortaba a la mitad de una
                 letra. Con la columna "*" reciben un ancho real y el
                 TextTrimming los degrada con puntos suspensivos — se resuelve en
                 la misma fila, sin robarle alto a la tabla. -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="38" Height="38"
                        Background="{DynamicResource EmpresaPrimaryBrush}"
                        CornerRadius="8"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <Path Data="{StaticResource IconBox}"
                          Stroke="White" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Productos / Gestión de Productos">
                        <Run Text="Productos" FontWeight="Normal"/>
                        <Run Text=" / "/>
                        <Run Text="Gestión de Productos" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                    </TextBlock>
                    <TextBlock Text="Catálogo de productos"
                               FontFamily="Segoe UI"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#1A1F2E"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Catálogo de productos"/>
                </StackPanel>
            </Grid>

            <!-- Right: Stats chips.
                 Los rótulos se ocultan cuando el encabezado se angosta, y las
                 pastillas quedan como punto + número. Liberan ~200 px, que es de
                 donde sale el espacio para que el título no tenga que recortarse:
                 el color del punto ya distingue las tres, y el ToolTip conserva
                 el significado. El TextTrimming del título sigue puesto como
                 último recurso, pero con esto rara vez llega a activarse. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#EEF2F8"
                        CornerRadius="999"
                        BorderBrush="#D8E1EC" BorderThickness="1"
                        Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Total de productos">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TOTAL" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding ActualWidth, ElementName=EncabezadoPagina,
                                                Converter={StaticResource AnchoMinimoAVisibilidad},
                                                ConverterParameter=690}"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5"
                        CornerRadius="999"
                        BorderBrush="#D1FAE5" BorderThickness="1"
                        Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Productos activos">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ACTIVOS" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#047857" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding ActualWidth, ElementName=EncabezadoPagina,
                                                Converter={StaticResource AnchoMinimoAVisibilidad},
                                                ConverterParameter=690}"/>
                        <TextBlock Text="{Binding ActivosCount}"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="#047857" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#F3F4F6"
                        CornerRadius="999"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        Padding="12,6"
                        ToolTip="Productos inactivos">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#9CA3AF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="INACTIVOS" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding ActualWidth, ElementName=EncabezadoPagina,
                                                Converter={StaticResource AnchoMinimoAVisibilidad},
                                                ConverterParameter=690}"/>
                        <TextBlock Text="{Binding InactivosCount}"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 2: TOOLBAR CARD -->
        <!-- ClipToBounds: red de seguridad para que ningún grupo que no entre
             llegue a dibujarse fuera de la tarjeta. -->
        <Border Grid.Row="2" x:Name="TarjetaToolbar"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1"
                Padding="12"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <StackPanel>
                <!-- Sub-row A: Search + Clear filters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <controls:SuggestionSearchBox Grid.Column="0" Margin="0,0,10,0"
                        x:Name="SearchBox"
                        Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SuggestItems="{Binding SuggestItems}"
                        HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                        Placeholder="Buscar producto por código o nombre..."
                        ItemSelected="SearchBox_ItemSelected"/>

                    <!-- Limpiar Filtros button.
                         En ventana angosta el rótulo le come el ancho al
                         buscador, que es lo que sí tiene que quedar usable: bajo
                         el umbral el botón se queda con el icono solo. El
                         ToolTip queda siempre, así el icono nunca es un jeroglífico. -->
                    <Button Grid.Column="1"
                            Command="{Binding LimpiarFiltrosCommand}"
                            Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                            Style="{StaticResource ActionBtn}"
                            Padding="16,0"
                            Height="38"
                            MinWidth="0"
                            ToolTip="Limpiar filtros">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconoLimpiar"
                                  Data="{StaticResource IconFilter}"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Limpiar Filtros"
                                       FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding ActualWidth,
                                                    ElementName=TarjetaToolbar,
                                                    Converter={StaticResource AnchoMinimoAVisibilidad},
                                                    ConverterParameter=760}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Divider -->
                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,10,0,10"
                        SnapsToDevicePixels="True"/>

                <!-- Sub-row B: Filters.
                     PanelFiltrosFluido: todos los grupos van en una sola línea
                     mientras entren, los combos absorben el ancho sobrante (de
                     ahí Peso="1"), y cuando ya no caben sin achicarse por debajo
                     de su MinWidth — el punto donde el texto dejaría de leerse —
                     los que sobran bajan a una línea nueva que vuelve a repartir
                     el ancho completo, así ninguna queda con un hueco al final.

                     Las pastillas segmentadas van con Peso 0: conservan su ancho
                     natural en vez de estirarse.

                     Las etiquetas van a su ancho natural (sin SharedSizeGroup):
                     igualarlas a la más larga dejaba a "País" separada de su
                     combo por un hueco que no se explicaba solo. Los combos
                     igual terminan todos del mismo ancho, porque cada celda
                     recibe la misma porción del sobrante y su parte fija
                     (etiqueta + margen) se descuenta antes. -->
                <controls:PanelFiltrosFluido EspacioHorizontal="16" EspacioVertical="12">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ESTADO"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivos"
                                             GroupName="EstadoFiltro"
                                             IsChecked="True"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="EstadoFiltro_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivos"
                                             GroupName="EstadoFiltro"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="EstadoFiltro_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbTodos"
                                             GroupName="EstadoFiltro"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="EstadoFiltro_Changed">
                                    <TextBlock Text="Todos" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Orden alfabético. Reusa SegmentBtn, el mismo estilo del filtro de estado. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ORDEN"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbOrdenId"
                                             GroupName="OrdenProductos"
                                             IsChecked="True"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="Orden_Changed"
                                             ToolTip="Orden natural por código de registro">
                                    <TextBlock Text="Por defecto" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                                <RadioButton x:Name="RbOrdenAZ"
                                             GroupName="OrdenProductos"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="Orden_Changed"
                                             ToolTip="Nombre ascendente">
                                    <TextBlock Text="A-Z" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                                <RadioButton x:Name="RbOrdenZA"
                                             GroupName="OrdenProductos"
                                             Style="{StaticResource SegmentBtn}"
                                             Checked="Orden_Changed"
                                             ToolTip="Nombre descendente">
                                    <TextBlock Text="Z-A" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Los cuatro catálogos: Peso="1" → se reparten en partes
                         iguales todo el ancho que sobre en su línea. -->
                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Proveedor" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbProveedor"
                                  Style="{StaticResource ComboFiltroBox}"
                                  ToolTip="Acota la lista de fabricantes"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fabricante" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbFabricante"
                                  Style="{StaticResource ComboFiltroBox}"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Categor&#237;a" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbCategoria"
                                  Style="{StaticResource ComboFiltroBox}"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pa&#237;s" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbPais"
                                  Style="{StaticResource ComboFiltroBox}"/>
                    </Grid>
                </controls:PanelFiltrosFluido>
            </StackPanel>
        </Border>

        <!-- ROW 4: TABLE -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading spinner -->
                <StackPanel Grid.Row="0"
                            x:Name="LoadingPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Path x:Name="SpinnerPath"
                          Data="M 12 2 A 10 10 0 1 1 2 12"
                          Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5"
                          Margin="0,0,10,0">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Cargando productos..."
                               FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="0"
                          x:Name="DgProductos"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderThickness="0"
                          AlternationCount="2"
                          FontFamily="Segoe UI"
                          FontSize="15.5"
                          RowStyle="{StaticResource ProductRowStyle}"
                          CellStyle="{StaticResource CeldaCentrada}"
                          SelectionChanged="DgProductos_SelectionChanged"
                          MouseDoubleClick="DgProductos_MouseDoubleClick"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="C&#211;DIGO" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="8,0">
                                        <TextBlock Text="{Binding CodigoInterno}"
                                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="Auto" MinWidth="160" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PESO TEÓRICO" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PesoTeorico, StringFormat={}{0:N2}}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TARA" Width="Auto" MinWidth="110" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Tara, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="FABRICANTE" Width="Auto" MinWidth="110" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Fabricante, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PROVEEDOR" Width="Auto" MinWidth="110" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Proveedor, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PA&#205;S" Width="Auto" MinWidth="110" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pais, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CONTENIDO" Width="Auto" MinWidth="100" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Contenido, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}" FontWeight="SemiBold"
                                               HorizontalAlignment="Left"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRESENTACI&#211;N" Width="Auto" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Presentacion, Converter={StaticResource TextoVacioConverter}}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CATEGOR&#205;A" Width="Auto" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F5FB" CornerRadius="999" Padding="10,2" HorizontalAlignment="Left" Margin="8,0">
                                        <TextBlock Text="{Binding Categoria}"
                                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRECIO / KG" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrecioPorKg, StringFormat={}{0:N2}}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CREADO"
                                                Width="Auto"
                                                MinWidth="130"
                                                CellStyle="{StaticResource CeldaDerecha}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTUALIZADO"
                                                Width="Auto"
                                                MinWidth="130"
                                                CellStyle="{StaticResource CeldaDerecha}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="Auto" MinWidth="70" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="{DynamicResource EmpresaPrimaryBrush}"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Path Data="{StaticResource IconCheck}"
                                                  Stroke="White" StrokeThickness="2.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="11" Height="11" Stretch="Uniform"/>
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="White"
                                                BorderBrush="#CBD5E1" BorderThickness="2"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state overlay -->
                <controls:EmptyStateOverlay Grid.Row="0"
                                            x:Name="EmptyState"
                                            Panel.ZIndex="5"
                                            HeaderOffset="40"
                                            Mensaje="{Binding MensajeSinResultados}"
                                            EstaVacio="{Binding NoResults}"/>

                <!-- Pagination footer -->
                <Border Grid.Row="1"
                        Background="#FAFBFC"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <DockPanel>
                        <TextBlock x:Name="PageInfoText"
                                   DockPanel.Dock="Left"
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   Text="{Binding PageInfo}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#171;" Style="{StaticResource PageBtn}"
                                    Command="{Binding PrimeraPaginaCommand}" Padding="6,0" Margin="0,0,2,0"/>
                            <Button Content="&#8249;" Style="{StaticResource PageBtn}"
                                    Command="{Binding PaginaAnteriorCommand}" Padding="6,0" Margin="0,0,2,0"/>
                            <ItemsControl x:Name="PaginacionPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="&#8250;" Style="{StaticResource PageBtn}"
                                    Command="{Binding PaginaSiguienteCommand}" Padding="6,0" Margin="2,0,0,0"/>
                            <Button Content="&#187;" Style="{StaticResource PageBtn}"
                                    Command="{Binding UltimaPaginaCommand}" Padding="6,0" Margin="2,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 5: ACTION BUTTONS -->
        <DockPanel Grid.Row="5" Margin="0,4,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding NuevoCommand}" permisos:PermisoBehavior.Requiere="Crear Producto"
                        Background="#16A34A"
                        Style="{StaticResource ActionBtn}"
                        Padding="22,0"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo"
                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditarCommand}" permisos:PermisoBehavior.Requiere="Modificar Producto"
                        Background="{DynamicResource EmpresaPrimaryBrush}"
                        Style="{StaticResource ActionBtn}"
                        Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPencil}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar"
                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left"
                        x:Name="SelectedInfo"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0"
                        Visibility="Collapsed">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedText"
                           FontFamily="Segoe UI" FontSize="14"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Text="{Binding TextoSeleccionado}"/>
            </StackPanel>

        </DockPanel>

    </Grid>

        <!-- MODAL OVERLAY — fuera del Grid con márgenes para cubrir toda la vista -->
        <Border x:Name="ModalOverlay"
                Background="#990F172A"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
