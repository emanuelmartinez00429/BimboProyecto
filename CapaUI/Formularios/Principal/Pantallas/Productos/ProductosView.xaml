<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Productos.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Productos"
             xmlns:queries="clr-namespace:CapaAplicacion.Productos.Queries;assembly=CapaAplicacion"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             Background="#EAF1F8"
             DataContext="{x:Null}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Auto"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos/geometrias compartidos viven en Styles.xaml; el disenador
                     de VS no ejecuta App.xaml y no los ve sin este merge. Ver ADR-028 / P-057. -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Element style for plain (non-templated) DataGridTextColumn cells,
             standardized to the largest body font size used in the grid (15.5) -->
        <Style x:Key="ProductCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: PAGE HEADER -->
        <controls:EncabezadoCatalogo Grid.Row="0"
            Icono="{StaticResource IconBox}" IconoEsRelleno="False"
            ModuloPadre="Productos" Submodulo="Gestión de Productos"
            Titulo="Catálogo de productos"
            Total="{Binding TotalCount}" Activos="{Binding ActivosCount}" Inactivos="{Binding InactivosCount}"/>

        <!-- ROW 2: TOOLBAR CARD -->
        <Grid Grid.Row="2">
            <!-- Sombra estática desacoplada: Border hermano detrás del contenido (AP-06 Zero-Shader Layout) -->
            <Border Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
            </Border>

            <!-- ClipToBounds: red de seguridad para que ningún grupo que no entre
                 llegue a dibujarse fuera de la tarjeta. -->
            <Border x:Name="TarjetaToolbar"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#D8E1EC" BorderThickness="1"
                    Padding="12"
                    ClipToBounds="True"
                    RenderOptions.ClearTypeHint="Enabled">
            <StackPanel>
                <!-- Sub-row A: Search + Clear filters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <controls:SuggestionSearchBox Grid.Column="0" Margin="0,0,10,0"
                        x:Name="SearchBox"
                        Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SuggestItems="{Binding SuggestItems}"
                        HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                        Placeholder="Buscar producto por código o nombre..."
                        ItemSelected="SearchBox_ItemSelected"/>

                    <controls:BotonLimpiarFiltros Grid.Column="1"
                                                  ReferenciaAncho="{Binding ElementName=TarjetaToolbar}"/>
                </Grid>

                <!-- Divider -->
                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,10,0,10"
                        SnapsToDevicePixels="True"/>

                <!-- Sub-row B: Filters.
                     PanelFiltrosFluido: todos los grupos van en una sola línea
                     mientras entren, los combos absorben el ancho sobrante (de
                     ahí Peso="1"), y cuando ya no caben sin achicarse por debajo
                     de su MinWidth — el punto donde el texto dejaría de leerse —
                     los que sobran bajan a una línea nueva que vuelve a repartir
                     el ancho completo, así ninguna queda con un hueco al final.

                     Las pastillas segmentadas van con Peso 0: conservan su ancho
                     natural en vez de estirarse.

                     Las etiquetas van a su ancho natural (sin SharedSizeGroup):
                     igualarlas a la más larga dejaba a "País" separada de su
                     combo por un hueco que no se explicaba solo. Los combos
                     igual terminan todos del mismo ancho, porque cada celda
                     recibe la misma porción del sobrante y su parte fija
                     (etiqueta + margen) se descuenta antes. -->
                <controls:PanelFiltrosFluido EspacioHorizontal="16" EspacioVertical="12">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ESTADO"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Omitir GroupName elimina el escaneo O(N) del árbol visual en UpdateRadioButtonGroup() -->
                                <RadioButton x:Name="RbActivos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoFilter.Activos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoFilter.Inactivos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivos" FontFamily="Segoe UI" FontSize="15"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbTodos"
                                             IsChecked="{Binding EstadoFiltro, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static local:EstadoFilter.Todos}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}">
                                    <TextBlock Text="Todos" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Orden alfabético. Reusa SegmentBtn, el mismo estilo del filtro de estado. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ORDEN"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Border Background="#F3F4F6"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Omitir GroupName previene recálculos innecesarios en el árbol visual -->
                                <RadioButton x:Name="RbOrdenId"
                                             IsChecked="{Binding Orden, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static queries:OrdenProducto.IdAsc}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}"
                                             ToolTip="Orden natural por código de registro">
                                    <TextBlock Text="Por defecto" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                                <RadioButton x:Name="RbOrdenAZ"
                                             IsChecked="{Binding Orden, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static queries:OrdenProducto.NombreAsc}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}"
                                             ToolTip="Nombre ascendente">
                                    <TextBlock Text="A-Z" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                                <RadioButton x:Name="RbOrdenZA"
                                             IsChecked="{Binding Orden, Converter={x:Static conv:EnumToBooleanConverter.Instancia}, ConverterParameter={x:Static queries:OrdenProducto.NombreDesc}, Mode=TwoWay}"
                                             Style="{StaticResource SegmentBtn}"
                                             ToolTip="Nombre descendente">
                                    <TextBlock Text="Z-A" FontFamily="Segoe UI" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Los cuatro catálogos: Peso="1" → se reparten en partes
                         iguales todo el ancho que sobre en su línea. -->
                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Proveedor" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbProveedor"
                                  Style="{StaticResource ComboFiltroBox}"
                                  DisplayMemberPath="Nombre"
                                  ToolTip="Acota la lista de fabricantes"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fabricante" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbFabricante"
                                  Style="{StaticResource ComboFiltroBox}"
                                  DisplayMemberPath="Nombre"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Categor&#237;a" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbCategoria"
                                  Style="{StaticResource ComboFiltroBox}"
                                  DisplayMemberPath="Nombre"/>
                    </Grid>

                    <Grid Style="{StaticResource CeldaFiltro}" controls:PanelFiltrosFluido.Peso="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pa&#237;s" Style="{StaticResource EtiquetaFiltro}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbPais"
                                  Style="{StaticResource ComboFiltroBox}"
                                  DisplayMemberPath="Nombre"/>
                    </Grid>
                </controls:PanelFiltrosFluido>
            </StackPanel>
        </Border>
        </Grid>

        <!-- ROW 4: TABLE -->
        <Grid Grid.Row="4">
            <!-- Sombra estática desacoplada: Border hermano detrás del contenido.
                 La GPU la rasteriza una vez y el scroll de la tabla ya no la
                 vuelve a renderizar por frame. Antes el DropShadowEffect vivía en
                 el mismo Border que envuelve al DataGrid, así que cada micro-
                 movimiento del scroll invalidaba la textura y re-corría el shader
                 de desenfoque de toda la tarjeta.
                 Ver [[WPF - Rendimiento de Efectos y Niveles de Renderizado]]. -->
            <Border Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/>
                </Border.Effect>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#D8E1EC" BorderThickness="1"
                    ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading overlay reutilizable (AP-04) -->
                <controls:LoadingOverlay Grid.Row="0"
                                         Panel.ZIndex="10"
                                         HeaderOffset="40"
                                         IsLoading="{Binding IsLoading}"
                                         Mensaje="Cargando productos..."/>

                <!-- DataGrid -->
                <DataGrid Grid.Row="0"
                          x:Name="DgProductos"
                          ItemsSource="{Binding PageRows, Mode=OneWay}"
                          SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          RowBackground="White"
                          RenderOptions.ClearTypeHint="Enabled"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          BorderThickness="0"
                          AlternationCount="2"
                          FontFamily="Segoe UI"
                          FontSize="15.5"
                          RowStyle="{StaticResource ProductRowStyle}"
                          CellStyle="{StaticResource CeldaCentrada}"
                          MouseDoubleClick="DgProductos_MouseDoubleClick"
                          PreviewKeyDown="DgProductos_PreviewKeyDown"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False" CanUserReorder="False"
                                                HeaderStyle="{StaticResource HeaderCentrado}"
                                                CellStyle="{StaticResource CeldaCentrada}"
                                                CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/>
                        <DataGridTemplateColumn Header="C&#211;DIGO" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="8,0">
                                        <TextBlock Text="{Binding CodigoInterno}"
                                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="Auto" MinWidth="170" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PESO TEÓRICO" Width="Auto" MinWidth="100" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PesoTeorico, StringFormat={}{0:N2}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TARA" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PesoTara, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin tara'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               TextWrapping="NoWrap"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="FABRICANTE" Width="Auto" MinWidth="140" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Fabricante, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin fabricante'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PROVEEDOR" Width="Auto" MinWidth="140" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Proveedor, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin proveedor'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PA&#205;S" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pais, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin país'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CONTENIDO" Width="Auto" MinWidth="90" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Contenido, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin contenido'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRESENTACI&#211;N" Width="Auto" MinWidth="105" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Presentacion, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin presentación'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               HorizontalAlignment="Left" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CATEGOR&#205;A" Width="Auto" MinWidth="135" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F5FB" CornerRadius="999" Padding="10,2" HorizontalAlignment="Left" Margin="8,0">
                                        <TextBlock Text="{Binding Categoria}"
                                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRECIO / KG" Width="Auto" MinWidth="100" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrecioPorKg, StringFormat={}{0:N2}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CREADO"
                                                Width="1.1*"
                                                MinWidth="125"
                                                CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTUALIZADO"
                                                Width="1.1*"
                                                MinWidth="125"
                                                CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="0.55*" MinWidth="70" HeaderStyle="{StaticResource HeaderCentrado}" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="{DynamicResource EmpresaPrimaryBrush}"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="{StaticResource IconCheck}"
                                                  Stroke="White" StrokeThickness="2.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="11" Height="11" Stretch="Uniform"/>
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="4"
                                                Background="White"
                                                BorderBrush="#CBD5E1" BorderThickness="2"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state overlay -->
                <controls:EmptyStateOverlay Grid.Row="0"
                                            x:Name="EmptyState"
                                            Panel.ZIndex="5"
                                            HeaderOffset="40"
                                            Mensaje="{Binding MensajeSinResultados}"
                                            EstaVacio="{Binding NoResults}"/>

                <!-- Pagination footer (P-037) -->
                <controls:PaginadorControl Grid.Row="1"
                                           Page="{Binding Page, Mode=TwoWay}"
                                           TotalPages="{Binding TotalPages}"
                                           PageInfo="{Binding PageInfo}"
                                           IsLoading="{Binding IsLoading}"/>
            </Grid>
            </Border>
        </Grid>

        <!-- ROW 5: ACTION BUTTONS -->
        <DockPanel Grid.Row="5" Margin="0,4,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding NuevoCommand}" permisos:PermisoBehavior.Requiere="Crear Producto"
                        Background="#16A34A"
                        Style="{StaticResource ActionBtn}"
                        Padding="22,0"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo"
                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditarCommand}" permisos:PermisoBehavior.Requiere="Modificar Producto"
                        Background="{DynamicResource EmpresaPrimaryBrush}"
                        Style="{StaticResource ActionBtn}"
                        Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPencil}"
                              Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar"
                                   FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left"
                        x:Name="SelectedInfo"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0"
                        Visibility="{Binding HaySeleccionado, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedText"
                           FontFamily="Segoe UI" FontSize="14"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Text="{Binding TextoSeleccionado}"/>
            </StackPanel>

        </DockPanel>

    </Grid>

        <!-- MODAL OVERLAY — fuera del Grid con márgenes para cubrir toda la vista -->
        <Border x:Name="ModalOverlay"
                Background="#990F172A"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
