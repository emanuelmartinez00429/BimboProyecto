<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Configuracion.ConfiguracionEmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Configuracion"
             mc:Ignorable="d po"
             d:DesignWidth="1100" d:DesignHeight="780"
             Background="#EAF1F8"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos y geometrías compartidos en Styles.xaml (ADR-028 / P-057 / Convenciones UI) -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Iconos vectoriales congelados adicionales con po:Freeze="True" -->
            <StreamGeometry x:Key="IconUpload" po:Freeze="True">M 9,16 H 15 V 10 H 19 L 12,3 L 5,10 H 9 V 16 Z M 5,18 H 19 V 20 H 5 V 18 Z</StreamGeometry>
            <StreamGeometry x:Key="IconAlertTriangle" po:Freeze="True">M 12,2 L 1,21 H 23 L 12,2 Z M 11,9 H 13 V 14 H 11 V 9 Z M 11,16 H 13 V 18 H 11 V 16 Z</StreamGeometry>
            <StreamGeometry x:Key="IconInfoCircle" po:Freeze="True">M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 H 11 V 11 H 13 V 17 Z M 13,9 H 11 V 7 H 13 V 9 Z</StreamGeometry>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryUploadButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetColorButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón institucional verde con soporte para ChangeTracker y estado deshabilitado elegante -->
        <Style x:Key="BotonGuardarInstitucional" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22C55E" Offset="0"/>
                        <GradientStop Color="#16A34A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Data="{StaticResource IconCheck}"
                                      Stroke="White"
                                      StrokeThickness="2.4"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLabel"
                                           Text="Guardar cambios"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#16A34A" Offset="0"/>
                                            <GradientStop Color="#15803D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding Guardando}" Value="True">
                                <Setter TargetName="TxtLabel" Property="Text" Value="Guardando..."/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="TxtLabel" Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Encabezado y Breadcrumbs -->
                <RowDefinition Height="Auto"/> <!-- Banner de notificación Realtime -->
                <RowDefinition Height="Auto"/> <!-- Banner de éxito -->
                <RowDefinition Height="Auto"/> <!-- Banner de error -->
                <RowDefinition Height="Auto"/> <!-- Tarjeta Principal con las 2 Columnas -->
            </Grid.RowDefinitions>

            <!-- 1. Encabezado de Navegación y Título -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Ajustes  /  Configuración de empresa"
                           FontFamily="Segoe UI" FontSize="13" Foreground="#64748B"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8"
                            Background="{DynamicResource EmpresaPrimaryBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IcoConfiguracion}"
                              Fill="White" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Configuración de empresa"
                               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 2. Notificación en Realtime (si llega cambio de 'empresa' desde otra terminal) -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayNotificacionRealtime, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconInfoCircle}"
                          Fill="#2563EB" Width="18" Height="18" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding MensajeNotificacionRealtime}"
                               Foreground="#1E40AF" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="✕" Foreground="#64748B"
                            Background="Transparent" BorderThickness="0" FontSize="14"
                            Cursor="Hand" Command="{Binding DescartarNotificacionRealtimeCommand}"
                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- 3. Banner de Éxito -->
            <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayExito, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Stroke="#16A34A" StrokeThickness="2.4"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeExito}" Foreground="#166534" FontSize="13"
                               FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. Banner de Error -->
            <Border Grid.Row="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayError, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconAlertTriangle}" Fill="#DC2626"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Error}" Foreground="#991B1B" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 5. Tarjeta Principal (Zero-Shader: sin DropShadowEffect, diseño limpio con bordes nítidos) -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="14" Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA IZQUIERDA: Información de la empresa -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Información de la empresa" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1E293B" Margin="0,0,0,20"/>

                            <!-- Fila: Nombre de la empresa + RTN -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre de la empresa" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding NombreEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" MaxLength="200"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RTN" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding RtnEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" MaxLength="20"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila: Dirección -->
                            <TextBlock Text="Dirección" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DireccionEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}"
                                     MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="70" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                            <!-- Fila: Teléfono + Correo -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding TelefonoEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" MaxLength="20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Correo" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding CorreoEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" MaxLength="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila: Dominio de correo -->
                            <TextBlock Text="Dominio de correo" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DominioCorreo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" MaxLength="100" Margin="0,0,0,12"/>

                            <!-- Banner Ámbar de Advertencia del Dominio -->
                            <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconAlertTriangle}"
                                          Fill="#D97706" Width="16" Height="16" Stretch="Uniform"
                                          VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Si cambia el dominio y los usuarios aún no tienen este dominio nuevo, no podrán ingresar al sistema."
                                               Foreground="#92400E" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- COLUMNA DERECHA: Identidad visual -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Identidad visual" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1E293B" Margin="0,0,0,20"/>

                            <!-- Tarjetas paralelas: Ícono y Logo -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tarjeta 1: Ícono del menú lateral -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ícono del menú lateral" Style="{StaticResource LabelStyle}"/>
                                    <Border Height="136" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="Sin vista previa" Foreground="#94A3B8" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding TieneLogoVistaPrevia, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                                            <Image Source="{Binding LogoVistaPrevia}" Stretch="Uniform" Margin="14"
                                                   Visibility="{Binding TieneLogoVistaPrevia, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
                                        </Grid>
                                    </Border>
                                    <Button Click="SeleccionarLogo_Click"
                                            Style="{StaticResource SecondaryUploadButton}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconUpload}" Fill="#475569" Width="13" Height="13"
                                                  Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Seleccionar ícono" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Tarjeta 2: Logo -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Logo" Style="{StaticResource LabelStyle}"/>
                                    <Border Height="136" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="Sin vista previa" Foreground="#94A3B8" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding TieneIconoSidebarVistaPrevia, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                                            <Image Source="{Binding IconoSidebarVistaPrevia}" Stretch="Uniform" Margin="14"
                                                   Visibility="{Binding TieneIconoSidebarVistaPrevia, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
                                        </Grid>
                                    </Border>
                                    <Button Click="SeleccionarIconoSidebar_Click"
                                            Style="{StaticResource SecondaryUploadButton}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconUpload}" Fill="#475569" Width="13" Height="13"
                                                  Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Seleccionar PNG o JPG" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Sección: Color principal (alineada en una sola fila según media_1789625378897.png) -->
                            <TextBlock Text="Color principal" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <!-- 5 Swatches de color predeterminados -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Background="#1E3A8A" Style="{StaticResource PresetColorButton}"
                                            Command="{Binding ElegirColorCommand}" CommandParameter="#1E3A8A"/>
                                    <Button Background="#7C3AED" Style="{StaticResource PresetColorButton}"
                                            Command="{Binding ElegirColorCommand}" CommandParameter="#7C3AED"/>
                                    <Button Background="#0F766E" Style="{StaticResource PresetColorButton}"
                                            Command="{Binding ElegirColorCommand}" CommandParameter="#0F766E"/>
                                    <Button Background="#9A3412" Style="{StaticResource PresetColorButton}"
                                            Command="{Binding ElegirColorCommand}" CommandParameter="#9A3412"/>
                                    <Button Background="#991B1B" Style="{StaticResource PresetColorButton}"
                                            Command="{Binding ElegirColorCommand}" CommandParameter="#991B1B" Margin="0"/>
                                </StackPanel>

                                <!-- Input Hex -->
                                <TextBox Grid.Column="2" Text="{Binding ColorEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" CharacterCasing="Upper" MaxLength="7"
                                         Height="36" VerticalAlignment="Center"/>

                                <!-- Preview Swatch -->
                                <Border Grid.Column="3" Margin="8,0,0,0" Background="{Binding ColorVistaPrevia}"
                                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- FILA INFERIOR: Botón de Guardar cambios únicamente (sin botón Cancelar, con Dirty Tracking) -->
                    <Border Grid.Row="1" Margin="0,28,0,0" Padding="0,18,0,0"
                            BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Cargando configuración..." VerticalAlignment="Center"
                                       Foreground="#64748B" Margin="0,0,16,0"
                                       Visibility="{Binding Cargando, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>

                            <!-- Botón de Guardar cambios verde institucional reutilizado -->
                            <Button x:Name="BtnGuardar"
                                    Command="{Binding GuardarCommand}"
                                    IsEnabled="{Binding PuedeGuardar}"
                                    Style="{StaticResource BotonGuardarInstitucional}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
