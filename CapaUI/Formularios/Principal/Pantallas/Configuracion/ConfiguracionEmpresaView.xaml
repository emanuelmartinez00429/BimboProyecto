<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Configuracion.ConfiguracionEmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:validacion="clr-namespace:CapaUI.Core.Validacion"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Configuracion"
             mc:Ignorable="d po"
             d:DesignWidth="1200" d:DesignHeight="760"
             Background="#EAF1F8"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos y geometrías compartidos en Styles.xaml (ADR-028 / P-057 / Convenciones UI) -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Iconos vectoriales congelados adicionales con po:Freeze="True" -->
            <PathGeometry x:Key="IconSubir" po:Freeze="True" Figures="M12,15 V4 M7,9 l5,-5 5,5 M5,20 h14"/>
            <PathGeometry x:Key="IconEdificio" po:Freeze="True" Figures="M4,21 V4 a1,1 0 0 1 1,-1 h9 a1,1 0 0 1 1,1 v17 M15,9 h4 a1,1 0 0 1 1,1 v11 M2,21 h20 M8,7 h3 M8,11 h3 M8,15 h3"/>
            <PathGeometry x:Key="IconPaleta" po:Freeze="True" Figures="M12,2 a10,10 0 1 0 0,20 a2,2 0 0 0 2,-2 c0,-1 -1,-1.5 -1,-2.5 a1.5,1.5 0 0 1 1.5,-1.5 H17 a5,5 0 0 0 5,-5 C22,6 17.5,2 12,2 z M7.5,11 h0.01 M10.5,7.5 h0.01 M15,8 h0.01"/>
            <StreamGeometry x:Key="IconAlertTriangle" po:Freeze="True">M 12,2 L 1,21 H 23 L 12,2 Z M 11,9 H 13 V 14 H 11 V 9 Z M 11,16 H 13 V 18 H 11 V 16 Z</StreamGeometry>
            <StreamGeometry x:Key="IconInfoCircle" po:Freeze="True">M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 H 11 V 11 H 13 V 17 Z M 13,9 H 11 V 7 H 13 V 9 Z</StreamGeometry>

            <!-- Rótulo de campo: versalitas grises, estilo formulario de ajustes -->
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#8A96A8"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
            </Style>

            <!-- Tarjeta de sección (Zero-Shader: borde nítido, sin DropShadowEffect) -->
            <Style x:Key="TarjetaSeccion" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,18,20,20"/>
            </Style>

            <Style x:Key="TituloSeccion" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SubtituloSeccion" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="IconoSeccion" TargetType="Path">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Stroke" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <!-- Input con marcador (controls:Placeholder.Texto) dibujado en la misma plantilla,
                 así cae exactamente donde arranca el texto (ver Core/Controls/Placeholder.cs). -->
            <Style x:Key="InputStyle" TargetType="TextBox">
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="BorderBrush" Value="#D8DEE8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- Sin Margin: TextBoxBase ya aplica el Padding dentro del host;
                                         repetirlo aquí lo duplicaba y el texto quedaba corrido. -->
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Marcador" Visibility="Collapsed"
                                               Text="{Binding Path=(controls:Placeholder.Texto), RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="16,0,14,0"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="#A3AEBF" IsHitTestVisible="False"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Marcador" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#B6C0CF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <!-- Después del foco: con error se ve rojo aunque esté enfocado -->
                                <Trigger Property="validacion:Validacion.TieneError" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón secundario blanco con borde (Reemplazar / Seleccionar) -->
            <Style x:Key="SecondaryUploadButton" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="BorderBrush" Value="#D8DEE8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B6C0CF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#A3AEBF"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Muestra de color ancha; la activa lleva aro oscuro con separación blanca -->
            <Style x:Key="PresetColorButton" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Aro" CornerRadius="7" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="0" Padding="0">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Aro" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static conv:TextosIgualesConverter.Instancia}">
                                            <Binding Path="ColorEmpresa"/>
                                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Aro" Property="BorderBrush" Value="#0F172A"/>
                                    <Setter TargetName="Aro" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Aro" Property="Padding" Value="2"/>
                                    <Setter TargetName="Bd" Property="CornerRadius" Value="4"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón institucional verde con soporte para ChangeTracker y estado deshabilitado elegante -->
            <Style x:Key="BotonGuardarInstitucional" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="26,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="#11885F"/>
                <Setter Property="BorderBrush" Value="#0E7F58"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IconPath"
                                          Data="{StaticResource IconCheck}"
                                          Stroke="White"
                                          StrokeThickness="2.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLabel"
                                               Text="Guardar cambios"
                                               FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0E7552"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding Guardando}" Value="True">
                                    <Setter TargetName="TxtLabel" Property="Text" Value="Guardando..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter TargetName="TxtLabel" Property="Foreground" Value="#94A3B8"/>
                                    <Setter TargetName="IconPath" Property="Stroke" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Texto del botón de imagen: "Reemplazar" si ya hay imagen, "Seleccionar" si no -->
            <Style x:Key="TextoBotonLogo" TargetType="TextBlock">
                <Setter Property="Text" Value="Seleccionar"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TieneLogoVistaPrevia}" Value="True">
                        <Setter Property="Text" Value="Reemplazar"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TextoBotonIcono" TargetType="TextBlock">
                <Setter Property="Text" Value="Seleccionar"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TieneIconoSidebarVistaPrevia}" Value="True">
                        <Setter Property="Text" Value="Reemplazar"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Encabezado y Breadcrumbs -->
                <RowDefinition Height="Auto"/> <!-- Banner de notificación Realtime -->
                <RowDefinition Height="Auto"/> <!-- Banner de éxito -->
                <RowDefinition Height="Auto"/> <!-- Banner de error -->
                <RowDefinition Height="Auto"/> <!-- Tarjetas: Información + Identidad visual -->
                <RowDefinition Height="Auto"/> <!-- Barra de acciones -->
            </Grid.RowDefinitions>

            <!-- 1. Encabezado: ícono + breadcrumb + título -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                        Background="{DynamicResource EmpresaPrimaryBrush}"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcoConfiguracion}"
                          Fill="White" Width="22" Height="22" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="12.5" Margin="0,0,0,2">
                        <Run Text="Ajustes" Foreground="#64748B"/>
                        <Run Text="  /  " Foreground="#CBD5E1"/>
                        <Run Text="Configuración de empresa" Foreground="#1E293B" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Configuración de empresa"
                               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                               Foreground="#0F172A"/>
                </StackPanel>
            </Grid>

            <!-- 2. Notificación en Realtime (si llega cambio de 'empresa' desde otra terminal) -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayNotificacionRealtime, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconInfoCircle}"
                          Fill="#2563EB" Width="18" Height="18" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding MensajeNotificacionRealtime}"
                               Foreground="#1E40AF" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="✕" Foreground="#64748B"
                            Background="Transparent" BorderThickness="0" FontSize="14"
                            Cursor="Hand" Command="{Binding DescartarNotificacionRealtimeCommand}"
                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- 3. Banner de Éxito -->
            <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayExito, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Stroke="#16A34A" StrokeThickness="2.4"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeExito}" Foreground="#166534" FontSize="13"
                               FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. Banner de Error -->
            <Border Grid.Row="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HayError, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconAlertTriangle}" Fill="#DC2626"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Error}" Foreground="#991B1B" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 5. Dos tarjetas hermanas: se estiran a la misma altura por compartir fila -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TARJETA IZQUIERDA: Información de la empresa -->
                <Border Grid.Column="0" Style="{StaticResource TarjetaSeccion}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconEdificio}" Style="{StaticResource IconoSeccion}"/>
                            <TextBlock Grid.Column="1" Text="INFORMACIÓN DE LA EMPRESA" Style="{StaticResource TituloSeccion}"/>
                            <TextBlock Grid.Column="2" Text="Datos fiscales y de contacto" Style="{StaticResource SubtituloSeccion}"/>
                        </Grid>
                        <Border Height="2" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,12,0,14"/>

                        <!-- Fila: Nombre de la empresa + RTN -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NOMBRE DE LA EMPRESA" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding NombreEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" MaxLength="200"
                                         controls:Placeholder.Texto="Nombre comercial"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RTN" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding RtnEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" MaxLength="20"
                                         controls:Placeholder.Texto="0000-0000-000000"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Dirección -->
                        <TextBlock Text="DIRECCIÓN" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding DireccionEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" MaxLength="500" Margin="0,0,0,14"
                                 controls:Placeholder.Texto="Colonia, calle, ciudad y departamento"/>

                        <!-- Fila: Teléfono + Correo -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TELÉFONO" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TelefonoEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" MaxLength="20"
                                         controls:Placeholder.Texto="+504 0000-0000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CORREO" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CorreoEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" MaxLength="100"
                                         controls:Placeholder.Texto="contacto@empresa.com"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Dominio de correo -->
                        <TextBlock Text="DOMINIO DE CORREO" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TxtDominio" Text="{Binding DominioCorreo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" MaxLength="100"
                                 controls:Placeholder.Texto="@empresa.com"/>

                        <!-- Aviso del dominio: solo mientras el cursor está en el campo, que es
                             cuando el usuario puede estar por cambiarlo. Fijo a la vista distraía. -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TxtDominio}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconAlertTriangle}"
                                      Fill="#D97706" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Si cambia el dominio, los usuarios que aún no lo tengan no podrán ingresar al sistema."
                                           Foreground="#92400E" FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TARJETA DERECHA: Identidad visual -->
                <Border Grid.Column="2" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Encabezado -->
                            <RowDefinition Height="Auto"/> <!-- Rótulos -->
                            <RowDefinition Height="*" MinHeight="180"/> <!-- Vistas previas (ocupan el alto sobrante) -->
                            <RowDefinition Height="Auto"/> <!-- Botones de imagen -->
                            <RowDefinition Height="Auto"/> <!-- Color principal -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconPaleta}" Style="{StaticResource IconoSeccion}"/>
                                <TextBlock Grid.Column="1" Text="IDENTIDAD VISUAL" Style="{StaticResource TituloSeccion}"/>
                                <TextBlock Grid.Column="2" Text="Logo y color" Style="{StaticResource SubtituloSeccion}"/>
                            </Grid>
                            <Border Height="2" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,12,0,14"/>
                        </StackPanel>

                        <!-- Logo -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="LOGO" Style="{StaticResource LabelStyle}"/>
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="#F8FAFC"
                                       Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4 3"/>
                            <TextBlock Text="Sin vista previa" Foreground="#94A3B8" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding TieneLogoVistaPrevia, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                            <Image Source="{Binding LogoVistaPrevia}" Stretch="Uniform" Margin="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding TieneLogoVistaPrevia, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
                        </Grid>
                        <Button Grid.Row="3" Grid.Column="0" Click="SeleccionarLogo_Click"
                                Style="{StaticResource SecondaryUploadButton}" Margin="0,10,0,0"
                                ToolTip="PNG o JPG, máximo 2 MB">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSubir}" Stroke="#475569" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource TextoBotonLogo}"/>
                            </StackPanel>
                        </Button>

                        <!-- Ícono del menú lateral -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ÍCONO DEL MENÚ LATERAL" Style="{StaticResource LabelStyle}"/>
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="#F8FAFC"
                                       Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4 3"/>
                            <TextBlock Text="Sin vista previa" Foreground="#94A3B8" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding TieneIconoSidebarVistaPrevia, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                            <Image Source="{Binding IconoSidebarVistaPrevia}" Stretch="Uniform" Margin="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding TieneIconoSidebarVistaPrevia, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
                        </Grid>
                        <Button Grid.Row="3" Grid.Column="2" Click="SeleccionarIconoSidebar_Click"
                                Style="{StaticResource SecondaryUploadButton}" Margin="0,10,0,0"
                                ToolTip="PNG o JPG, máximo 2 MB">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSubir}" Stroke="#475569" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource TextoBotonIcono}"/>
                            </StackPanel>
                        </Button>

                        <!-- Color principal: 5 muestras anchas + hex -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,18,0,0">
                            <TextBlock Text="COLOR PRINCIPAL" Style="{StaticResource LabelStyle}"/>
                            <UniformGrid Columns="5" Margin="-4,0,-4,10">
                                <Button Background="#1E3A8A" Style="{StaticResource PresetColorButton}"
                                        Command="{Binding ElegirColorCommand}" CommandParameter="#1E3A8A"/>
                                <Button Background="#7C3AED" Style="{StaticResource PresetColorButton}"
                                        Command="{Binding ElegirColorCommand}" CommandParameter="#7C3AED"/>
                                <Button Background="#0F766E" Style="{StaticResource PresetColorButton}"
                                        Command="{Binding ElegirColorCommand}" CommandParameter="#0F766E"/>
                                <Button Background="#9A3412" Style="{StaticResource PresetColorButton}"
                                        Command="{Binding ElegirColorCommand}" CommandParameter="#9A3412"/>
                                <Button Background="#991B1B" Style="{StaticResource PresetColorButton}"
                                        Command="{Binding ElegirColorCommand}" CommandParameter="#991B1B"/>
                            </UniformGrid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ColorEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" CharacterCasing="Upper" MaxLength="7"
                                         controls:Placeholder.Texto="#000000"/>
                                <!-- Vista previa del hex escrito (útil cuando no coincide con ninguna muestra) -->
                                <Border Grid.Column="1" Width="44" Height="44" Margin="10,0,0,0"
                                        Background="{Binding ColorVistaPrevia}"
                                        BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. Barra de acciones: aviso a la izquierda, Guardar a la derecha (sin Cancelar, decisión 2026-09-17) -->
            <Border Grid.Row="5" Style="{StaticResource TarjetaSeccion}" Margin="0,16,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Los cambios se aplican a todo el sistema al guardar."
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#64748B"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Cargando, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>
                    <TextBlock Grid.Column="0" Text="Cargando configuración..."
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#64748B"
                               VerticalAlignment="Center"
                               Visibility="{Binding Cargando, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Guardar: habilitado solo con cambios (ChangeTracker) -->
                        <Button x:Name="BtnGuardar"
                                Command="{Binding GuardarCommand}"
                                IsEnabled="{Binding PuedeGuardar}"
                                Style="{StaticResource BotonGuardarInstitucional}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
