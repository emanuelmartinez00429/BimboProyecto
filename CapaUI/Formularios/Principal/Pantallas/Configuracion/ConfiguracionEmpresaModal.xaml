<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Configuracion.ConfiguracionEmpresaModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MaxWidth="940" MaxHeight="720"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="14" BorderBrush="#18000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="14,14,0,0">
                <Grid Margin="22,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Configuración de empresa" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Datos generales e identidad visual" Foreground="#D9FFFFFF" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="36" Height="36" Content="✕"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            FontSize="16" Cursor="Hand" Command="{Binding CancelarCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Información de la empresa" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,0,18"/>

                        <TextBlock Text="Nombre de la empresa" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding NombreEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="RTN" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RtnEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="Dirección" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding DireccionEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TelefonoEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CorreoEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dominio de correo" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding DominioCorreo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                        <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                CornerRadius="7" Padding="10" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Foreground="#B45309" FontSize="15"
                                           VerticalAlignment="Top" Margin="0,0,8,0"/>
                                <TextBlock Text="Si cambia el dominio y los usuarios aún no tienen este dominio nuevo, no podrán ingresar al sistema."
                                           Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Identidad visual" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,0,18"/>

                        <TextBlock Text="Logo" Style="{StaticResource LabelStyle}"/>
                        <Border Height="154" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="Sin vista previa" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding RutaLogoVistaPrevia}" Stretch="Uniform" Margin="12"/>
                            </Grid>
                        </Border>
                        <Button Content="Seleccionar PNG o JPG" Click="SeleccionarLogo_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,10,0,20"/>

                        <TextBlock Text="Ícono del menú lateral" Style="{StaticResource LabelStyle}"/>
                        <Border Height="92" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="Sin vista previa" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding RutaIconoSidebarVistaPrevia}" Stretch="Uniform" Margin="12"/>
                            </Grid>
                        </Border>
                        <Button Content="Seleccionar ícono PNG o JPG" Click="SeleccionarIconoSidebar_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,10,0,20"/>

                        <TextBlock Text="Color principal" Style="{StaticResource LabelStyle}"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="#1E3A8A" BorderThickness="0" Command="{Binding ElegirColorCommand}" CommandParameter="#1E3A8A"/>
                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="#7C3AED" BorderThickness="0" Command="{Binding ElegirColorCommand}" CommandParameter="#7C3AED"/>
                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="#0F766E" BorderThickness="0" Command="{Binding ElegirColorCommand}" CommandParameter="#0F766E"/>
                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="#9A3412" BorderThickness="0" Command="{Binding ElegirColorCommand}" CommandParameter="#9A3412"/>
                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="#991B1B" BorderThickness="0" Command="{Binding ElegirColorCommand}" CommandParameter="#991B1B"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ColorEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" CharacterCasing="Upper"/>
                            <Border Grid.Column="1" Margin="8,0,0,0" Background="{Binding ColorVistaPrevia}"
                                    BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"/>
                        </Grid>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="El color se aplicará en toda la interfaz al guardar. Los colores de estado se conservarán."
                                       TextWrapping="Wrap" Foreground="#475569" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="7" Padding="10" Margin="0,18,0,0"
                            Visibility="{Binding HayError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" Foreground="#B91C1C" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Cargando configuración..." VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,16,0"
                               Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Command="{Binding GuardarCommand}" Height="38" Padding="22,0" BorderThickness="0" Cursor="Hand"
                            Background="{DynamicResource EmpresaPrimaryBrush}" Foreground="White" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Guardar cambios"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Guardando}" Value="True">
                                        <Setter Property="Content" Value="Guardando..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cargando}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
