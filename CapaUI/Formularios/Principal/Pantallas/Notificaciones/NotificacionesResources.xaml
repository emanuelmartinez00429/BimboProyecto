<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Notificaciones"
                    xmlns:conv="clr-namespace:CapaUI.Converters">

    <conv:BoolToVisibilityConverter x:Key="NotifBoolToVisibility"/>
    <conv:InverseBoolToVisibilityConverter x:Key="NotifInverseBoolToVisibility"/>
    <local:SoportaNavegacionNotificacionConverter x:Key="NotifSoportaNavegacion"/>

    <SolidColorBrush x:Key="NotifTexto" Color="#1A1F2E"/>
    <SolidColorBrush x:Key="NotifTextoSecundario" Color="#64748B"/>
    <SolidColorBrush x:Key="NotifTextoTenue" Color="#94A3B8"/>
    <SolidColorBrush x:Key="NotifSuperficie" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NotifBorde" Color="#D8E1EC"/>
    <SolidColorBrush x:Key="NotifNoLeida" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="NotifHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="NotifPresion" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="NotifInformativa" Color="#3B82F6"/>
    <SolidColorBrush x:Key="NotifAdvertencia" Color="#F59E0B"/>
    <SolidColorBrush x:Key="NotifCritica" Color="#DC2626"/>

    <Style x:Key="NotifBotonTextoPrimario" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#0F172A"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#93C5FD"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotifBotonTextoSecundario" TargetType="Button" BasedOn="{StaticResource NotifBotonTextoPrimario}">
        <Setter Property="Foreground" Value="{StaticResource NotifTextoSecundario}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource NotifHover}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#94A3B8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource NotifPresion}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource NotifInformativa}"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotifBotonIcono" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Foreground" Value="{StaticResource NotifTextoSecundario}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource NotifHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource NotifPresion}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource NotifInformativa}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotifTarjetaPresionable" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NotifSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NotifBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tarjeta" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EstaLeida}" Value="False">
                            <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource NotifNoLeida}"/>
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="#BFDBFE"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EstaArchivada}" Value="True">
                            <Setter TargetName="Tarjeta" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="Tarjeta" Property="Opacity" Value="0.82"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource NotifHover}"/>
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource NotifInformativa}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource NotifPresion}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource NotifInformativa}"/>
                            <Setter TargetName="Tarjeta" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotifPuntoSeveridad" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{StaticResource NotifInformativa}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severidad}" Value="advertencia"><Setter Property="Fill" Value="{StaticResource NotifAdvertencia}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severidad}" Value="critica"><Setter Property="Fill" Value="{StaticResource NotifCritica}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotifEtiquetaSeveridad" TargetType="TextBlock">
        <Setter Property="Text" Value="Informativa"/>
        <Setter Property="Foreground" Value="{StaticResource NotifInformativa}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severidad}" Value="advertencia"><Setter Property="Text" Value="Advertencia"/><Setter Property="Foreground" Value="{StaticResource NotifAdvertencia}"/></DataTrigger>
            <DataTrigger Binding="{Binding Severidad}" Value="critica"><Setter Property="Text" Value="Crítica"/><Setter Property="Foreground" Value="{StaticResource NotifCritica}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotifEstadoLectura" TargetType="TextBlock">
        <Setter Property="Text" Value="Leída"/>
        <Setter Property="Foreground" Value="{StaticResource NotifTextoTenue}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding EstaLeida}" Value="False"><Setter Property="Text" Value="No leída"/><Setter Property="Foreground" Value="{StaticResource NotifInformativa}"/></DataTrigger>
            <DataTrigger Binding="{Binding EstaArchivada}" Value="True"><Setter Property="Text" Value="Archivada"/><Setter Property="Foreground" Value="{StaticResource NotifTextoSecundario}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotifTitulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NotifTexto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding EstaLeida}" Value="False"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="NotifTarjetaCompacta">
        <Grid Margin="8,5">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button Grid.RowSpan="2" Style="{StaticResource NotifTarjetaPresionable}"
                    Command="{Binding DataContext.AbrirDetalleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="Abrir detalle de notificación"/>
            <Grid Margin="14,12,14,8" IsHitTestVisible="False">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource NotifPuntoSeveridad}" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource NotifEtiquetaSeveridad}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource NotifTextoTenue}"/>
                    <TextBlock Style="{StaticResource NotifEstadoLectura}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Titulo}" Style="{StaticResource NotifTitulo}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding Mensaje}" Foreground="{StaticResource NotifTextoSecundario}" FontSize="12"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,3,0,0"/>
                <TextBlock Grid.Row="3" Text="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                           Foreground="{StaticResource NotifTextoTenue}" FontSize="11" Margin="0,5,0,0"/>
            </Grid>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="14,0,14,12">
                <Button Content="Abrir registro" Style="{StaticResource NotifBotonTextoSecundario}" Margin="0,0,6,0"
                        Command="{Binding DataContext.EjecutarAccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding Converter={StaticResource NotifSoportaNavegacion}}"/>
                <Button Content="Marcar leída" Style="{StaticResource NotifBotonTextoSecundario}" Margin="0,0,6,0"
                        Command="{Binding DataContext.MarcarLeidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaLeida, Converter={StaticResource NotifInverseBoolToVisibility}}"/>
                <Button Content="Archivar" Style="{StaticResource NotifBotonTextoSecundario}"
                        Command="{Binding DataContext.ArchivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaArchivada, Converter={StaticResource NotifInverseBoolToVisibility}}"/>
                <Button Content="Restaurar" Style="{StaticResource NotifBotonTextoSecundario}"
                        Command="{Binding DataContext.ArchivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaArchivada, Converter={StaticResource NotifBoolToVisibility}}"/>
            </WrapPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NotifTarjetaCompleta">
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button Grid.RowSpan="2" Style="{StaticResource NotifTarjetaPresionable}"
                    Command="{Binding DataContext.AbrirDetalleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="Abrir detalle de notificación"/>
            <Grid Margin="18,15,18,8" IsHitTestVisible="False">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource NotifPuntoSeveridad}" Margin="0,0,7,0"/>
                    <TextBlock Style="{StaticResource NotifEtiquetaSeveridad}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource NotifTextoTenue}"/>
                    <TextBlock Style="{StaticResource NotifEstadoLectura}"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource NotifTextoTenue}"/>
                    <TextBlock Text="{Binding NombreTipo}" Foreground="{StaticResource NotifTextoSecundario}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Titulo}" Style="{StaticResource NotifTitulo}" FontSize="15" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding Mensaje}" Foreground="#475569" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource NotifTextoTenue}" FontSize="11"/>
                    <TextBlock Text="  ·  Actor: " Foreground="{StaticResource NotifTextoTenue}" FontSize="11"/>
                    <TextBlock Text="{Binding Actor}" Foreground="{StaticResource NotifTextoSecundario}" FontSize="11"/>
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="18,0,18,14">
                <Button Content="Abrir registro" Style="{StaticResource NotifBotonTextoSecundario}" Margin="0,0,8,0"
                        Command="{Binding DataContext.EjecutarAccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding Converter={StaticResource NotifSoportaNavegacion}}"/>
                <Button Content="Marcar leída" Style="{StaticResource NotifBotonTextoSecundario}" Margin="0,0,8,0"
                        Command="{Binding DataContext.MarcarLeidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaLeida, Converter={StaticResource NotifInverseBoolToVisibility}}"/>
                <Button Content="Archivar" Style="{StaticResource NotifBotonTextoSecundario}"
                        Command="{Binding DataContext.ArchivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaArchivada, Converter={StaticResource NotifInverseBoolToVisibility}}"/>
                <Button Content="Restaurar" Style="{StaticResource NotifBotonTextoSecundario}"
                        Command="{Binding DataContext.ArchivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding EstaArchivada, Converter={StaticResource NotifBoolToVisibility}}"/>
            </WrapPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
