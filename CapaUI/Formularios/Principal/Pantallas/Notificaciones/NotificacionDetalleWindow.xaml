<Window x:Class="CapaUI.Formularios.Principal.Pantallas.Notificaciones.NotificacionDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de notificación"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="White">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Notificaciones/NotificacionesResources.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="26,24,26,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Notificacion.Titulo}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource NotifTexto}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Notificacion.Mensaje}" Margin="0,9,0,0"
                           Foreground="{StaticResource NotifTextoSecundario}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Campos}" Margin="26,18,26,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold"
                                       Foreground="{StaticResource NotifTextoSecundario}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse x:Name="PuntoSeveridad" Margin="0,0,7,0"
                                         DataContext="{Binding DataContext.Notificacion, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource NotifPuntoSeveridad}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Valor}" Foreground="{StaticResource NotifTexto}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Etiqueta}" Value="Severidad">
                                <Setter TargetName="PuntoSeveridad" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="26,12,26,18" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Button Content="Cerrar" IsCancel="True" Click="Cerrar_Click"
                    Style="{StaticResource NotifBotonTextoSecundario}"
                    MinWidth="95" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
