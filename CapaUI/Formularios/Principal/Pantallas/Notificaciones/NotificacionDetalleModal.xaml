<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Notificaciones.NotificacionDetalleModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="720" Height="660"
             d:DesignWidth="720" d:DesignHeight="660"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Auto"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/CapaUI;component/Formularios/Principal/Pantallas/Notificaciones/NotificacionesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Sombra separada del contenido desplazable para evitar shaders anidados. -->
        <Border Background="{DynamicResource EmpresaPrimaryDarkerBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="10" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14"
                BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                BorderThickness="1"
                RenderOptions.ClearTypeHint="Enabled"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource EmpresaPrimaryDarkerColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Border Grid.Row="0" Padding="24,20,24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10"
                                    Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                                    BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                                    BorderThickness="1">
                                <Path Width="21" Height="21" Stretch="Uniform"
                                      Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,22 A2.5,2.5 0 0,0 14.45,20 H9.55 A2.5,2.5 0 0,0 12,22 Z M18,16 V11 A6,6 0 0,0 13,5.08 V4 A1,1 0 0,0 11,4 V5.08 A6,6 0 0,0 6,11 V16 L4,18 V19 H20 V18 Z"/>
                            </Border>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NOTIFICACIONES DEL SISTEMA"
                                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"/>
                                <TextBlock Text="Detalle de notificación"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Width="36" Height="36"
                                VerticalAlignment="Center" Cursor="Hand" ToolTip="Cerrar"
                                Click="Cerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BdCerrar"
                                            Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <TextBlock Text="&#x2715;" FontSize="13" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BdCerrar" Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                            <Setter TargetName="BdCerrar" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Resumen -->
                <Border Grid.Row="1" Margin="24,0,24,14"
                        Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                        BorderBrush="#10B981" BorderThickness="3.5,0,0,0"
                        CornerRadius="8" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="NOTIFICACIÓN"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"/>
                            <TextBlock Text="{Binding NumeroTexto}"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                       Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="FECHA / HORA"
                                           FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding FechaHoraTexto}"
                                           FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="{DynamicResource EmpresaPrimaryBrush}"
                                    BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" DataContext="{Binding Notificacion}">
                                    <Ellipse Style="{StaticResource NotifPuntoSeveridad}" Margin="0,0,7,0"/>
                                    <TextBlock Style="{StaticResource NotifEtiquetaSeveridad}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mensaje y campos seguros -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,0,24,8">
                    <StackPanel>
                        <Border Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                                BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18,14"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Notificacion.Titulo}"
                                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Notificacion.Mensaje}"
                                           FontFamily="Segoe UI" FontSize="13.5"
                                           Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Campos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" Padding="0,11">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{DynamicResource EmpresaPrimaryLightColor}" Opacity="0.25"/>
                                        </Border.BorderBrush>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Etiqueta}"
                                                       FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                       Foreground="White" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie -->
                <Border Grid.Row="3"
                        Background="{DynamicResource EmpresaPrimaryDarkerBrush}"
                        BorderBrush="{DynamicResource EmpresaPrimaryDarkBrush}"
                        BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource EmpresaPrimaryLighterBrush}"
                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                  Data="M12,2 A4,4 0 0,0 8,6 V8 H7 A2,2 0 0,0 5,10 V20 A2,2 0 0,0 7,22 H17 A2,2 0 0,0 19,20 V10 A2,2 0 0,0 17,8 H16 V6 A4,4 0 0,0 12,2 Z M10,6 A2,2 0 0,1 14,6 V8 H10 V6 Z M12,13 A2,2 0 0,1 14,15 C14,15.74 13.6,16.38 13,16.72 V19 H11 V16.72 C10.4,16.38 10,15.74 10,15 A2,2 0 0,1 12,13 Z"/>
                            <TextBlock Text="Información en modo de solo lectura"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource EmpresaPrimaryLighterBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Regresar" Height="38" Padding="22,0"
                                Cursor="Hand" Click="Cerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BdRegresar"
                                            Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource EmpresaPrimaryLightBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BdRegresar" Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                                            <Setter TargetName="BdRegresar" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryLighterBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
