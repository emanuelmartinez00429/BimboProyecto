<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Notificaciones.NotificacionesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F4F5F7">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="Notificaciones" FontSize="28" FontWeight="Bold" Foreground="#111827"/><TextBlock Text="Eventos internos asignados a tu usuario" Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel>
   <Button Content="Marcar todas como leídas" Command="{Binding MarcarTodasLeidasCommand}" IsEnabled="{Binding ServicioDisponible}" HorizontalAlignment="Right" Padding="14,8" Background="{DynamicResource EmpresaPrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
  </Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,18,0,14">
   <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Estado:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}" Width="130" Margin="8,0,18,0"/><TextBlock Text="Severidad:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Severidades}" SelectedItem="{Binding SeveridadSeleccionada}" Width="130" Margin="8,0"/><Button Content="Aplicar" Command="{Binding AplicarFiltrosCommand}" Padding="12,5" Margin="10,0,0,0"/></StackPanel><TextBlock Text="{Binding MensajeEstado}" Foreground="#B45309" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <ItemsControl ItemsSource="{Binding Notificaciones}">
    <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="4" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text=" • "/><TextBlock Text="{Binding NombreTipo}" Foreground="#6B7280"/></StackPanel><TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,5,20,0"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#9CA3AF"/><TextBlock Text=" · Actor: " Foreground="#9CA3AF"/><TextBlock Text="{Binding Actor}" Foreground="#6B7280"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Ver en Módulo" Command="{Binding DataContext.EjecutarAccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="10,5" Margin="0,0,8,0"/><Button Content="Leer"  Command="{Binding DataContext.MarcarLeidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="10,5" Margin="0,0,8,0"/><Button Content="Archivar / restaurar" Command="{Binding DataContext.ArchivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="10,5"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Button Grid.Row="3" Content="Cargar más" Command="{Binding CargarMasCommand}" Visibility="{Binding HayMas, Converter={StaticResource BoolToVisibilityConv}}" IsEnabled="{Binding ServicioDisponible}" HorizontalAlignment="Center" Padding="18,7" Margin="0,8,0,0" Cursor="Hand"/>
 </Grid>
</UserControl>
