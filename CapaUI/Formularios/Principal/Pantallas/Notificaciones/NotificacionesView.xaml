<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Notificaciones.NotificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Notificaciones/NotificacionesResources.xaml"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Notificaciones" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Eventos internos asignados a tu usuario" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Marcar todas como leídas y archivar"
                    Command="{Binding MarcarTodasLeidasYArchivarCommand}"
                    IsEnabled="{Binding ServicioDisponible}"
                    Style="{StaticResource NotifBotonTextoPrimario}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,18,0,14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Estado" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}"
                          DisplayMemberPath="Etiqueta" Width="145" Height="34" Margin="8,0,20,0"/>
                <TextBlock Grid.Column="2" Text="Severidad" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Severidades}" SelectedItem="{Binding SeveridadSeleccionada}"
                          DisplayMemberPath="Etiqueta" Width="145" Height="34" Margin="8,0,10,0"/>
                <Button Grid.Column="4" Content="Aplicar" Command="{Binding AplicarFiltrosCommand}"
                        Style="{StaticResource NotifBotonTextoSecundario}" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Notificaciones}"
                     ItemTemplate="{StaticResource NotifTarjetaCompleta}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarAny}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="{Binding MensajeEstado}" Foreground="#64748B" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                       IsHitTestVisible="False"/>
        </Grid>

        <Button Grid.Row="3" Content="Cargar más" Command="{Binding CargarMasCommand}"
                Visibility="{Binding HayMas, Converter={StaticResource NotifBoolToVisibility}}"
                IsEnabled="{Binding ServicioDisponible}" Style="{StaticResource NotifBotonTextoSecundario}"
                HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
