<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.MiUsuario.MiUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             mc:Ignorable="d po"
             d:DesignWidth="1200" d:DesignHeight="760"
             Background="#EAF1F8"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <PathGeometry x:Key="IconoLupaMiUsuario" po:Freeze="True"
                          Figures="M11,4 a7,7 0 1 1 0,14 a7,7 0 0 1 0,-14 z M20,20 l-4.3,-4.3 M9,11 h4 M11,9 v4"/>
            <PathGeometry x:Key="IconoCandadoMiUsuario" po:Freeze="True"
                          Figures="M5,11 h14 v10 H5 z M8,11 V7 a4,4 0 0 1 8,0 v4"/>

            <!-- Encabezado de tarjeta: ícono + título, mismo lenguaje que Configuración de empresa. -->
            <Style x:Key="MiUsuarioTarjeta" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderBrush" Value="#DCE3EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="24"/>
            </Style>

            <Style x:Key="MiUsuarioTituloSeccion" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MiUsuarioSubtitulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <Style x:Key="MiUsuarioEtiqueta" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Style>

            <Style x:Key="MiUsuarioValor" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="#172033"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Botones − / + del control de escala. -->
            <Style x:Key="MiUsuarioPaso" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MiUsuarioBotonTexto" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════ Perfil ══════════════════ -->
            <Border Style="{StaticResource MiUsuarioTarjeta}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,20,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Iniciales}" Foreground="White"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding NombreCompleto}" FontSize="24" FontWeight="Bold"
                                   Foreground="#172033" TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280"/>
                                <ColumnDefinition Width="*" MaxWidth="380"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="ROL" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                <TextBlock Text="{Binding NombreRol}" Style="{StaticResource MiUsuarioValor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CORREO" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                <TextBlock Text="{Binding Email}" Style="{StaticResource MiUsuarioValor}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ Apariencia ══════════════════ -->
            <Border Grid.Row="1" Style="{StaticResource MiUsuarioTarjeta}" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconoLupaMiUsuario}"
                              Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.8"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Apariencia" Style="{StaticResource MiUsuarioTituloSeccion}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MiUsuarioSubtitulo}"
                               Text="Ajustá el tamaño de la aplicación sin cambiar la configuración de Windows. Solo afecta a este programa, en esta pantalla y para tu usuario."/>

                    <!-- Aviso cuando UI_ESCALA impone el factor: sin esto, el usuario movería
                         los botones sin efecto y no sabría por qué. -->
                    <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                            Visibility="{Binding EstaForzado, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#92400E"
                                   Text="El tamaño está fijado por la configuración UI_ESCALA de este equipo, así que no se puede cambiar desde acá."/>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10" Padding="18" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiUsuarioPaso}" Content="−"
                                        Command="{Binding DisminuirCommand}"
                                        IsEnabled="{Binding PuedeDisminuir}"
                                        ToolTip="Achicar la aplicación"/>

                                <Border Width="108" Height="42" Margin="10,0" CornerRadius="10"
                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBlock Text="{Binding PorcentajeEscala}"
                                               FontSize="18" FontWeight="SemiBold" Foreground="#172033"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Button Style="{StaticResource MiUsuarioPaso}" Content="+"
                                        Command="{Binding AumentarCommand}"
                                        IsEnabled="{Binding PuedeAumentar}"
                                        ToolTip="Agrandar la aplicación"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MiUsuarioSubtitulo}" Margin="0">
                                    <Run Text="Windows está al"/>
                                    <Run Text="{Binding PorcentajeWindows, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="en esta pantalla. Para ese tamaño sugerimos"/>
                                    <Run Text="{Binding PorcentajeSugerido, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="."/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <!-- Se esconde cuando ya está en el sugerido: un botón que no
                                         cambiaría nada solo invita a preguntarse qué hace. -->
                                    <Button Style="{StaticResource MiUsuarioBotonTexto}"
                                            Content="Usar el sugerido"
                                            Command="{Binding UsarSugeridoCommand}"
                                            Visibility="{Binding EsSugerido, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>

                                    <Button Style="{StaticResource MiUsuarioBotonTexto}"
                                            Content="Restablecer"
                                            Command="{Binding RestablecerCommand}"
                                            ToolTip="Olvidar el tamaño elegido para esta pantalla"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                            Visibility="{Binding HayError, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="#991B1B"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════ Seguridad ══════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource MiUsuarioTarjeta}" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconoCandadoMiUsuario}"
                              Stroke="#94A3B8" StrokeThickness="1.8"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Seguridad" Style="{StaticResource MiUsuarioTituloSeccion}"
                                   Foreground="#94A3B8"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MiUsuarioSubtitulo}"
                               Text="El cambio de contraseña desde acá todavía no está disponible. Por ahora se hace desde «¿Olvidaste tu contraseña?» en la pantalla de inicio de sesión."/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
