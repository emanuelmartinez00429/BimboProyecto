<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.MiUsuario.MiUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             mc:Ignorable="d po"
             d:DesignWidth="1200" d:DesignHeight="760"
             Background="#EAF1F8"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Auto"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos/geometrias compartidos viven en Styles.xaml; el disenador
                     de VS no ejecuta App.xaml y no los ve sin este merge. Ver ADR-028 / P-057. -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <PathGeometry x:Key="IconoLupaMiUsuario" po:Freeze="True"
                          Figures="M11,4 a7,7 0 1 1 0,14 a7,7 0 0 1 0,-14 z M20,20 l-4.3,-4.3 M9,11 h4 M11,9 v4"/>
            <PathGeometry x:Key="IconoCandadoMiUsuario" po:Freeze="True"
                          Figures="M5,11 h14 v10 H5 z M8,11 V7 a4,4 0 0 1 8,0 v4"/>

            <!-- Sistema de banner compartido de la vista: mismo lenguaje para
                 información (azul), peligro (rojo), éxito (verde) y advertencia
                 (ámbar). Los cuatro reutilizan la misma anatomía Border+TextBlock. -->
            <Style x:Key="MiUsuarioBanner" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <!-- Campo apilado de Seguridad: tarjeta interior con etiqueta + input. -->
            <Style x:Key="MiUsuarioBloque" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="MinWidth" Value="340"/>
                <Setter Property="MaxWidth" Value="520"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <!-- Encabezado de tarjeta: ícono + título, mismo lenguaje que Configuración de empresa. -->
            <Style x:Key="MiUsuarioTarjeta" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BorderBrush" Value="#D8E1EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="24"/>
            </Style>

            <Style x:Key="MiUsuarioTituloSeccion" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MiUsuarioSubtitulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <Style x:Key="MiUsuarioEtiqueta" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Style>

            <Style x:Key="MiUsuarioValor" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="#172033"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Botones − / + del control de escala. -->
            <Style x:Key="MiUsuarioPaso" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MiUsuarioBotonTexto" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,18,22,0" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: encabezado de página, mismo componente que el resto de los módulos -->
            <controls:EncabezadoCatalogo Grid.Row="0"
                Icono="{StaticResource IcoMiUsuario}" IconoEsRelleno="True"
                ModuloPadre="Sistema" Submodulo="Mi Usuario"
                Titulo="Tu perfil, tu apariencia y tu seguridad"/>

            <!-- ══════════════════ Perfil ══════════════════ -->
            <Border Grid.Row="2" Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource MiUsuarioTarjeta}" ClipToBounds="True"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,20,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Iniciales}" Foreground="White"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <!-- Encabezado de la tarjeta, repite el lenguaje de Apariencia/Seguridad -->
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoMiUsuario}"
                                  Fill="{DynamicResource EmpresaPrimaryBrush}"
                                  Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Perfil" Style="{StaticResource MiUsuarioTituloSeccion}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MiUsuarioSubtitulo}"
                                   Text="Tus datos de cuenta. Lo que podés editar es solo tu apodo de saludo; el resto viene del registro de empleados."/>

                        <TextBlock Text="{Binding NombreCompleto}" FontSize="24" FontWeight="Bold"
                                   Foreground="#172033" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280"/>
                                <ColumnDefinition Width="*" MaxWidth="380"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="ROL" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                <TextBlock Text="{Binding NombreRol}" Style="{StaticResource MiUsuarioValor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CORREO" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                <TextBlock Text="{Binding Email}" Style="{StaticResource MiUsuarioValor}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Apodo personal: cómo te saluda el menú principal.
                             Preferencia propia (usuario_preferencias, clave 'apodo'):
                             vaciar el campo borra el apodo y vuelve al nombre real. -->
                        <TextBlock Text="APODO DE SALUDO" Style="{StaticResource MiUsuarioEtiqueta}"
                                   Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource MiUsuarioSubtitulo}" Margin="0"
                                   Text="Con este nombre te saluda el menú principal. Vaciarlo vuelve a tu nombre completo real. Solo cambia cómo te llama el sistema, no tus datos."/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="420"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource MiUsuarioBloque}" Padding="10,6">
                                <TextBox BorderThickness="0" Background="Transparent"
                                         FontFamily="Segoe UI" FontSize="14" Foreground="#172033"
                                         MaxLength="64" VerticalContentAlignment="Center"
                                         Text="{Binding ApodoEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Escribe cómo te saluda el sistema (opcional)"/>
                            </Border>

                            <Button Grid.Column="1" Content="Guardar apodo"
                                    Style="{StaticResource MiUsuarioBotonTexto}"
                                    Background="{DynamicResource EmpresaPrimaryBrush}" Foreground="White"
                                    Command="{Binding GuardarApodoCommand}"
                                    IsEnabled="{Binding HayCambioApodo}"
                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                    ToolTip="Guarda el apodo o borra la preferencia si lo dejaste vacío"/>
                        </Grid>

                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="#6B7280">
                            <Run Text="Así te saluda el sistema: "/>
                            <Run FontWeight="Bold" Foreground="#172033"
                                 Text="{Binding ApodoPreview, Mode=OneWay}"/>
                        </TextBlock>

                        <Border Style="{StaticResource MiUsuarioBanner}" Background="#FEF3C7" BorderBrush="#FCD34D"
                                Margin="0,10,0,0"
                                Visibility="{Binding HayApodoMensaje, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                            <TextBlock Text="{Binding ApodoMensaje}" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="#92400E"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ Apariencia ══════════════════ -->
            <Border Grid.Row="4" Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource MiUsuarioTarjeta}" ClipToBounds="True"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconoLupaMiUsuario}"
                              Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.8"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Apariencia" Style="{StaticResource MiUsuarioTituloSeccion}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MiUsuarioSubtitulo}"
                               Text="Ajustá el tamaño de la aplicación sin cambiar la configuración de Windows. Solo afecta a este programa, en esta pantalla y para tu usuario."/>

                    <!-- Aviso cuando UI_ESCALA impone el factor: sin esto, el usuario movería
                         los botones sin efecto y no sabría por qué. -->
                    <Border Style="{StaticResource MiUsuarioBanner}" Background="#FEF3C7" BorderBrush="#FCD34D"
                            Margin="0,16,0,0"
                            Visibility="{Binding EstaForzado, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#92400E"
                                   Text="El tamaño está fijado por la configuración UI_ESCALA de este equipo, así que no se puede cambiar desde acá."/>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10" Padding="18" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiUsuarioPaso}" Content="−"
                                        Command="{Binding DisminuirCommand}"
                                        IsEnabled="{Binding PuedeDisminuir}"
                                        ToolTip="Achicar la aplicación"/>

                                <Border Width="108" Height="42" Margin="10,0" CornerRadius="10"
                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBlock Text="{Binding PorcentajeEscala}"
                                               FontSize="18" FontWeight="SemiBold" Foreground="#172033"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Button Style="{StaticResource MiUsuarioPaso}" Content="+"
                                        Command="{Binding AumentarCommand}"
                                        IsEnabled="{Binding PuedeAumentar}"
                                        ToolTip="Agrandar la aplicación"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MiUsuarioSubtitulo}" Margin="0">
                                    <Run Text="Windows está al"/>
                                    <Run Text="{Binding PorcentajeWindows, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="en esta pantalla. Para ese tamaño sugerimos"/>
                                    <Run Text="{Binding PorcentajeSugerido, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="."/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <!-- Se esconde cuando ya está en el sugerido: un botón que no
                                         cambiaría nada solo invita a preguntarse qué hace. -->
                                    <Button Style="{StaticResource MiUsuarioBotonTexto}"
                                            Content="Usar el sugerido"
                                            Command="{Binding UsarSugeridoCommand}"
                                            Visibility="{Binding EsSugerido, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instancia}}"/>

                                    <Button Style="{StaticResource MiUsuarioBotonTexto}"
                                            Content="Restablecer"
                                            Command="{Binding RestablecerCommand}"
                                            ToolTip="Olvidar el tamaño elegido para esta pantalla"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MiUsuarioBanner}" Background="#FEE2E2" BorderBrush="#FCA5A5"
                            Margin="0,14,0,0"
                            Visibility="{Binding HayError, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="#991B1B"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════ Seguridad ══════════════════
                 El botón valida la forma con las reglas del dominio
                 (ReglasContrasena) y sostiene el estado visual; el cableado a
                 RecuperacionPasswordService/auth.users es el paso siguiente. -->
            <Border Grid.Row="6" Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
            </Border>
            <Border Grid.Row="6" Style="{StaticResource MiUsuarioTarjeta}" ClipToBounds="True"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconoCandadoMiUsuario}"
                              Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.8"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Seguridad" Style="{StaticResource MiUsuarioTituloSeccion}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MiUsuarioSubtitulo}"
                               Text="Actualizá tu propia contraseña acá, sin cerrar la sesión y sin permisos administrativos."/>

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna izquierda: los 3 campos apilados, ancho alineado -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <!-- Contraseña actual -->
                            <Border Style="{StaticResource MiUsuarioBloque}">
                                <StackPanel>
                                    <TextBlock Text="CONTRASEÑA ACTUAL" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                    <Grid Margin="0,8,0,0">
                                        <PasswordBox x:Name="TxtActual" Style="{StaticResource InputPassword}"
                                                     Height="40" Padding="0,0,44,0"/>
                                        <TextBox x:Name="TxtActualVisible" Style="{StaticResource InputBox}"
                                                 Visibility="Collapsed" Height="40" Padding="0,0,44,0"/>
                                        <Button x:Name="BtnVerActual"
                                                Width="40" Height="36"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                ToolTip="Mostrar u ocultar la contraseña actual"
                                                AutomationProperties.Name="Mostrar u ocultar la contraseña actual"
                                                Click="BtnVerActual_Click">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconEyePassword}" Fill="#64748B"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Confirmar -->
                            <Border Style="{StaticResource MiUsuarioBloque}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                    <Grid Margin="0,8,0,0">
                                        <PasswordBox x:Name="TxtConfirmar" Style="{StaticResource InputPassword}"
                                                     Height="40" Padding="0,0,44,0"/>
                                        <TextBox x:Name="TxtConfirmarVisible" Style="{StaticResource InputBox}"
                                                 Visibility="Collapsed" Height="40" Padding="0,0,44,0"/>
                                        <Button x:Name="BtnVerConfirmar"
                                                Width="40" Height="36"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                ToolTip="Mostrar u ocultar la confirmación"
                                                AutomationProperties.Name="Mostrar u ocultar la confirmación"
                                                Click="BtnVerConfirmar_Click">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconEyePassword}" Fill="#64748B"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="LblCoincidencia" Text="Las contraseñas no coinciden." FontSize="12"
                                               Foreground="#991B1B" Visibility="Collapsed" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Acción principal: habilita cuando la forma está completa. -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Cambiar contraseña"
                                        Style="{StaticResource MiUsuarioBotonTexto}"
                                        Background="{DynamicResource EmpresaPrimaryBrush}" Foreground="White"
                                        Command="{Binding CambiarContrasenaCommand}"
                                        IsEnabled="{Binding PuedeEnviarCambio}"
                                        ToolTip="Actualiza tu propia contraseña en Supabase"/>

                                <Button Content="Restablecer"
                                        Style="{StaticResource MiUsuarioBotonTexto}"
                                        Command="{Binding LimpiarFormularioCommand}"
                                        Margin="10,0,0,0"
                                        ToolTip="Limpiar los campos del formulario"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Columna derecha: la nueva con sus reglas, siempre visible -->
                        <Border Grid.Column="1" Style="{StaticResource MiUsuarioBloque}">
                            <StackPanel>
                                <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource MiUsuarioEtiqueta}"/>
                                <Grid Margin="0,8,0,0">
                                    <PasswordBox x:Name="TxtNueva" Style="{StaticResource InputPassword}"
                                                 Height="40" Padding="0,0,44,0"/>
                                    <TextBox x:Name="TxtNuevaVisible" Style="{StaticResource InputBox}"
                                             Visibility="Collapsed" Height="40" Padding="0,0,44,0"/>
                                    <Button x:Name="BtnVerNueva"
                                            Width="40" Height="36"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            ToolTip="Mostrar u ocultar la nueva contraseña"
                                            AutomationProperties.Name="Mostrar u ocultar la nueva contraseña"
                                            Click="BtnVerNueva_Click">
                                        <Viewbox Width="18" Height="18">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconEyePassword}" Fill="#64748B"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!-- Medidor de fortaleza: 5 barras + etiqueta, score de ReglasContrasena -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border x:Name="Bar1" Height="4" Width="52" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                                    <Border x:Name="Bar2" Height="4" Width="52" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                                    <Border x:Name="Bar3" Height="4" Width="52" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                                    <Border x:Name="Bar4" Height="4" Width="52" CornerRadius="2" Background="#E5E7EB" Margin="0,0,4,0"/>
                                    <Border x:Name="Bar5" Height="4" Width="52" CornerRadius="2" Background="#E5E7EB"/>
                                    <TextBlock x:Name="LblFortaleza" Text="" FontSize="12" Foreground="#64748B"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Requisitos del dominio, pintados por el code-behind con ReglasContrasena -->
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="R1Icon" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#E5E7EB"/>
                                        <TextBlock x:Name="R1Text" Text="Al menos 8 caracteres" FontSize="12.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="R2Icon" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#E5E7EB"/>
                                        <TextBlock x:Name="R2Text" Text="Una letra mayúscula" FontSize="12.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="R3Icon" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#E5E7EB"/>
                                        <TextBlock x:Name="R3Text" Text="Un número" FontSize="12.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="R4Icon" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#E5E7EB"/>
                                        <TextBlock x:Name="R4Text" Text="Un símbolo (!, @, #…)" FontSize="12.5" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Banner de información (lógica aún no cableada) -->
                    <Border Style="{StaticResource MiUsuarioBanner}" Background="#DBEAFE" BorderBrush="#93C5FD"
                            Margin="0,16,0,0"
                            Visibility="{Binding HayAviso, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock Text="{Binding AvisoInfo}" TextWrapping="Wrap" FontSize="12.5" Foreground="#1E40AF"/>
                    </Border>

                    <!-- Error / éxito reutilizando el lenguaje de la vista -->
                    <Border Style="{StaticResource MiUsuarioBanner}" Background="#FEE2E2" BorderBrush="#FCA5A5"
                            Margin="0,10,0,0"
                            Visibility="{Binding HayError, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12.5" Foreground="#991B1B"/>
                    </Border>

                    <Border Style="{StaticResource MiUsuarioBanner}" Background="#DCFCE7" BorderBrush="#86EFAC"
                            Margin="0,10,0,0"
                            Visibility="{Binding HayExito, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                        <TextBlock Text="{Binding Exito}" TextWrapping="Wrap" FontSize="12.5" Foreground="#166534"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
