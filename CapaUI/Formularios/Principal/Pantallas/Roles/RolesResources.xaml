<!--
    Sistema visual de la pantalla de Roles.

    Todo lo repetible vive acá una sola vez: pinceles, geometrías y plantillas.
    Los Freezable llevan po:Freeze="True" para que WPF los marque inmutables y
    los comparta entre todos los elementos visuales en vez de clonar uno por
    instancia — es la diferencia entre 6 pinceles y varios cientos.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:ctrl="clr-namespace:CapaUI.Core.Controls"
                    xmlns:conv="clr-namespace:CapaUI.Converters">

    <conv:IconoModuloConverter x:Key="IconoModulo"/>
    <conv:ColorHexABrushConverter x:Key="ColorHexABrush"/>

    <!-- Se declaran acá y no se toman de App.xaml a propósito: un
         ResourceDictionary suelto se parsea antes de colgarse del árbol, y un
         StaticResource hacia recursos de Application puede no resolverse. -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

    <!-- ══ Paleta ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="RolBrand"        Color="{DynamicResource EmpresaPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolBrandAlt"     Color="{DynamicResource EmpresaPrimaryBrightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolText"         Color="#1A1F2E" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolText2"        Color="#64748B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolMuted"        Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolSurface"      Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolBorder"       Color="#D8E1EC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolBorderSoft"   Color="#E5E9F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolBorderCard"   Color="#CBDCF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolBorderInput"  Color="#CBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolRowHover"     Color="#E8F0FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolRowOn"        Color="#F7FAFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolCheckBorder"  Color="#C3CFDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolIconBgSoft"   Color="#DFEAF9" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolIconBgOff"    Color="#EDF1F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolHeaderOff"    Color="#F7F9FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolAmber"        Color="#B45309" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolAmberBg"      Color="#FFFBEB" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolAmberBorder"  Color="#FDE68A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolAmberDot"     Color="#F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolInfo"         Color="{DynamicResource EmpresaPrimaryDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolInfoBg"       Color="#EFF6FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolInfoBorder"   Color="#BFDBFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolError"        Color="#B91C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolErrorBg"      Color="#FEF2F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolErrorBorder"  Color="#FECACA" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolFieldBg"      Color="#F7F9FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolSegmentBg"    Color="#F3F4F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RolSegmentBd"    Color="#E5E7EB" po:Freeze="True"/>

    <LinearGradientBrush x:Key="RolFondoPagina" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#EAF1F8"/>
        <GradientStop Offset="1" Color="#E0EAF4"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RolInsignia" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{DynamicResource EmpresaPrimaryColor}"/>
        <GradientStop Offset="1" Color="{DynamicResource EmpresaPrimaryBrightColor}"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RolCardHeader" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#F4F8FD"/>
        <GradientStop Offset="1" Color="#EDF3FB"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RolPie" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#F5F9FD"/>
        <GradientStop Offset="1" Color="#FFFFFF"/>
    </LinearGradientBrush>

    <!-- ══ Geometrías ═══════════════════════════════════════════════════════ -->
    <PathGeometry x:Key="GeoCheck"    Figures="M20 6L9 17l-5-5" po:Freeze="True"/>
    <PathGeometry x:Key="GeoChevron"  Figures="M6 9l6 6 6-6" po:Freeze="True"/>
    <PathGeometry x:Key="GeoBuscar"   Figures="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M21 21l-4.3-4.3" po:Freeze="True"/>
    <PathGeometry x:Key="GeoEquis"    Figures="M6 6l12 12 M18 6L6 18" po:Freeze="True"/>
    <PathGeometry x:Key="GeoFiltros"  Figures="M440-160q-17 0-28.5-11.5T400-200v-240L168-736q-15-20-4.5-42t36.5-22h560q26 0 36.5 22t-4.5 42L560-440v240q0 17-11.5 28.5T520-160h-80Zm40-308 198-252H282l198 252Zm0 0Z" po:Freeze="True"/>
    <PathGeometry x:Key="GeoGuardar"  Figures="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8" po:Freeze="True"/>
    <PathGeometry x:Key="GeoInfo"     Figures="M12 16v-4 M12 8h.01 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" po:Freeze="True"/>
    <PathGeometry x:Key="GeoAlerta"   Figures="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z M12 9v4 M12 17h.01" po:Freeze="True"/>
    <PathGeometry x:Key="GeoEscudo"   Figures="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" po:Freeze="True"/>

    <!-- ══ Ícono base ═══════════════════════════════════════════════════════ -->
    <Style x:Key="RolIcono" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══ Tipografía ═══════════════════════════════════════════════════════ -->
    <Style x:Key="RolEtiquetaSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource RolMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ Botón chico (Activar todo / Quitar todo) ═════════════════════════ -->
    <Style x:Key="RolBotonMini" TargetType="Button">
        <Setter Property="Height" Value="31"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Foreground" Value="{StaticResource RolBrand}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{StaticResource RolSurface}"
                            BorderBrush="#C6D6EA" BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RolRowHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Selector segmentado (filtro de estado / modo de vista) ═══════════
         Es un ListBox: la selección única, el foco y el teclado ya vienen
         resueltos por el control, no hace falta código ni converters. -->
    <Style x:Key="RolSegmentoItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="6" Padding="12,5" Margin="1,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Punto" Width="6" Height="6" Margin="0,0,6,0" Opacity="0.6"
                                     VerticalAlignment="Center"
                                     Fill="{Binding ColorPunto, Converter={StaticResource ColorHexABrush}}"/>
                            <TextBlock x:Name="Texto" Text="{Binding Etiqueta}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ColorPunto}" Value="{x:Null}">
                            <Setter TargetName="Punto" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RolSurface}"/>
                            <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource RolText}"/>
                            <Setter TargetName="Punto" Property="Opacity" Value="1"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#D7DCE5"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource RolText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RolSegmento" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource RolSegmentoItem}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{StaticResource RolSegmentBg}" BorderBrush="{StaticResource RolSegmentBd}"
                            BorderThickness="1" CornerRadius="8" Padding="3">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Fila de permiso ══════════════════════════════════════════════════
         Es un Button y no un CheckBox: el diseño hace clickeable la fila
         entera, y con Button el estado se centraliza en un comando del
         ViewModel (contadores exactos, cero suscripciones por ítem). -->
    <Style x:Key="RolFilaPermiso" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="ToolTip" Value="{Binding Descripcion}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="7" Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Casilla -->
                            <Border x:Name="Casilla" Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                    Margin="0,1,9,0" VerticalAlignment="Top"
                                    Background="{StaticResource RolSurface}"
                                    BorderBrush="{StaticResource RolCheckBorder}" BorderThickness="1.5">
                                <Path x:Name="Tilde" Style="{StaticResource RolIcono}" Data="{StaticResource GeoCheck}"
                                      Stroke="White" StrokeThickness="3" Width="9" Height="9" Visibility="Collapsed"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Titulo" Text="{Binding Nombre}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource RolText2}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Border x:Name="Badge" Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                            Background="#FEF3C7" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="CRÍTICA" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource RolAmber}"/>
                                    </Border>
                                    <Border x:Name="BadgeProtegida" Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                            Background="#DBEAFE" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="🔒 PROTEGIDA" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="Descripcion" Text="{Binding Descripcion}" FontSize="11"
                                           Foreground="{StaticResource RolMuted}" TextWrapping="Wrap"
                                           Margin="0,1,0,0" LineHeight="15"/>
                            </StackPanel>
                            <TextBlock x:Name="EstadoPermiso" Grid.Column="2" Text="Inactiva" Margin="8,0,0,0"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RolMuted}"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Asignada}" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RolRowOn}"/>
                            <Setter TargetName="Casilla" Property="Background" Value="{StaticResource RolBrand}"/>
                            <Setter TargetName="Casilla" Property="BorderBrush" Value="{StaticResource RolBrand}"/>
                            <Setter TargetName="Tilde" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Titulo" Property="Foreground" Value="{StaticResource RolText}"/>
                            <Setter TargetName="EstadoPermiso" Property="Text" Value="Activa"/>
                            <Setter TargetName="EstadoPermiso" Property="Foreground" Value="#047857"/>
                        </DataTrigger>

                        <!-- Sello de criticidad: solo cuando el permiso está concedido -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding EsCritica}" Value="True"/>
                                <Condition Binding="{Binding Asignada}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding EsProtegida}" Value="True">
                            <Setter TargetName="BadgeProtegida" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Fondo" Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="ToolTip" Value="Acción obligatoria del rol Administrador; no puede retirarse."/>
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RolRowHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RolRowHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La tarjeta completa abre el detalle y conserva foco/teclado nativos de Button. -->
    <Style x:Key="RolTarjetaSeleccionable" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource RolBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tarjeta" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tarjeta" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource RolBrand}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tarjeta" Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource RolBrand}"/>
                            <Setter TargetName="Tarjeta" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Tarjeta de módulo ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="RolTarjetaModulo">
        <!-- La visibilidad se decide en el contenedor (ItemContainerStyle), no acá:
             si se colapsara solo el Border, el panel igual le reservaría la celda. -->
        <Border x:Name="Tarjeta" Background="{StaticResource RolSurface}" CornerRadius="10"
                BorderBrush="{StaticResource RolBorderCard}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Border x:Name="Encabezado" Background="{StaticResource RolCardHeader}"
                        BorderBrush="#DCE7F5" BorderThickness="0,0,0,1" Padding="13,10"
                        CornerRadius="9,9,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Insignia" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                Margin="0,0,9,0" Background="{StaticResource RolIconBgSoft}">
                            <Path x:Name="IconoModulo" Style="{StaticResource RolIcono}" Width="15" Height="15"
                                  StrokeThickness="1.8" Stroke="{StaticResource RolBrand}"
                                  Data="{Binding IconoKey, Converter={StaticResource IconoModulo}}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NombreModulo" Text="{Binding Nombre}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{StaticResource RolBrand}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DescModulo" Text="{Binding Descripcion}" FontSize="11"
                                       Foreground="{StaticResource RolMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- El contador es también el atajo para activar/quitar el módulo entero -->
                        <Button x:Name="Contador" Grid.Column="2" Margin="8,0,0,0" Cursor="Hand"
                                Command="{Binding Alternar}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding PuedeEditar}"
                                ToolTip="Activar o quitar todos los permisos del módulo">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pastilla" Background="{StaticResource RolBrand}" CornerRadius="999"
                                            MinWidth="26" Height="26" Padding="6,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="TextoPastilla" Text="{Binding Conteo}" FontSize="11"
                                                   FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NingunaActiva}" Value="True">
                                            <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource RolIconBgOff}"/>
                                            <Setter TargetName="TextoPastilla" Property="Foreground" Value="{StaticResource RolMuted}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pastilla" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BotonTodos" Grid.Column="3" Margin="8,0,0,0" Height="25" Padding="8,0"
                                Style="{StaticResource RolBotonMini}" FontSize="11"
                                Content="Todos"
                                Command="{Binding Alternar}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding PuedeEditar}"/>
                    </Grid>
                </Border>

                <!-- Permisos -->
                <ItemsControl Grid.Row="1" x:Name="ListaPermisos" ItemsSource="{Binding Acciones}" Padding="9" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctrl:SpanningGridPanel Columns="{Binding ColumnasInternas}" ColumnSpacing="10" RowSpacing="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding Visible, Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RolFilaPermiso}"
                                    Command="{Binding Alternar}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding PuedeAlternar}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <!-- Módulo sin ningún permiso: la tarjeta se apaga -->
            <DataTrigger Binding="{Binding NingunaActiva}" Value="True">
                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource RolBorderSoft}"/>
                <Setter TargetName="Tarjeta" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="Encabezado" Property="Background" Value="{StaticResource RolHeaderOff}"/>
                <Setter TargetName="Encabezado" Property="BorderBrush" Value="{StaticResource RolBorderSoft}"/>
                <Setter TargetName="Insignia" Property="Background" Value="{StaticResource RolIconBgOff}"/>
                <Setter TargetName="IconoModulo" Property="Stroke" Value="{StaticResource RolMuted}"/>
                <Setter TargetName="NombreModulo" Property="Foreground" Value="{StaticResource RolText2}"/>
            </DataTrigger>

            <!-- Módulo completo: la insignia se rellena -->
            <DataTrigger Binding="{Binding TodasActivas}" Value="True">
                <Setter TargetName="Insignia" Property="Background" Value="{StaticResource RolBrand}"/>
                <Setter TargetName="IconoModulo" Property="Stroke" Value="White"/>
                <Setter TargetName="BotonTodos" Property="Content" Value="Ninguno"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ══ Botones de acción del pie ════════════════════════════════════════ -->
    <Style x:Key="RolBotonPrimario" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{StaticResource RolBrand}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RolBotonFantasma" TargetType="Button" BasedOn="{StaticResource RolBotonPrimario}">
        <Setter Property="Foreground" Value="{StaticResource RolText2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="8"
                            BorderBrush="{StaticResource RolBorderInput}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#EEF2F7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Franja de aviso ══════════════════════════════════════════════════
         El tono se resuelve SOLO con triggers de Style. Si se dejaran valores
         locales en el elemento (Background="..."), ganarían por precedencia de
         WPF y los triggers no pintarían nunca. -->
    <Style x:Key="RolAlertaBorde" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource RolInfoBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RolInfoBorder}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="warn">
                <Setter Property="Background" Value="{StaticResource RolAmberBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RolAmberBorder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="error">
                <Setter Property="Background" Value="{StaticResource RolErrorBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RolErrorBorder}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RolAlertaIcono" TargetType="Path" BasedOn="{StaticResource RolIcono}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="0,1,9,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Data" Value="{StaticResource GeoInfo}"/>
        <Setter Property="Stroke" Value="{StaticResource RolInfo}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="warn">
                <Setter Property="Data" Value="{StaticResource GeoAlerta}"/>
                <Setter Property="Stroke" Value="{StaticResource RolAmber}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="error">
                <Setter Property="Data" Value="{StaticResource GeoAlerta}"/>
                <Setter Property="Stroke" Value="{StaticResource RolError}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RolAlertaTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource RolInfo}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="warn">
                <Setter Property="Foreground" Value="{StaticResource RolAmber}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TonoAlerta}" Value="error">
                <Setter Property="Foreground" Value="{StaticResource RolError}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Estado del pie ═══════════════════════════════════════════════════ -->
    <Style x:Key="RolPuntoEstado" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="#CBD5E1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HayCambios}" Value="True">
                <Setter Property="Fill" Value="{StaticResource RolAmberDot}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RolTextoEstado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource RolMuted}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HayCambios}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource RolAmber}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
