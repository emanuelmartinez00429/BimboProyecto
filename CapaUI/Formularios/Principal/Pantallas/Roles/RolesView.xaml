<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Roles.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             FontFamily="Segoe UI"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/Pantallas/Roles/RolesResources.xaml"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource RolFondoPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ Encabezado + barra de herramientas ══════════════════ -->
        <!-- Encabezado, buscador y filtros: parte fija del formulario, visibles
             desde el primer frame. Solo el area de tarjetas depende de la BD, que
             es lo unico que muestra el indicador de carga — igual que Productos,
             Usuarios y Categorias, donde lo unico que se oculta es el DataGrid. -->
        <StackPanel x:Name="EncabezadoRoles" Grid.Row="0" Margin="20,16,20,0">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource RolInsignia}"
                            Margin="0,0,13,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="{DynamicResource EmpresaPrimaryColor}"/>
                        </Border.Effect>
                        <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoEscudo}"
                              Width="20" Height="20" StrokeThickness="1.9" Stroke="White"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Usuarios" FontSize="11" Foreground="{StaticResource RolText2}"/>
                            <TextBlock Text="/" FontSize="11" Foreground="#CBD5E1" Margin="5,0"/>
                            <TextBlock Text="Gestión de Roles" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource RolText}"/>
                        </StackPanel>
                        <TextBlock Text="Roles y permisos" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource RolText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pastillas armadas a mano, igual que en Productos (ver
                     ProductosView.xaml): Text bindea directo contra el
                     DataContext, sin pasar por Content de un
                     HeaderedContentControl + TemplateBinding, que no
                     terminaba de reflejar el número en pantalla. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding MostrandoDetalle, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#EEF2F8" CornerRadius="999"
                            BorderBrush="{StaticResource RolBorder}" BorderThickness="1"
                            Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource RolBrand}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource RolBrand}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalAcciones}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource RolBrand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="999"
                            BorderBrush="#D1FAE5" BorderThickness="1"
                            Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVOS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#047857" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Activos}" FontSize="13" FontWeight="Bold"
                                       Foreground="#047857" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="999"
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#9CA3AF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="INACTIVOS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Inactivos}" FontSize="13" FontWeight="Bold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding MostrandoDetalle, Converter={StaticResource InverseBoolToVisibility}}">
                    <Border Background="#EEF2F8" CornerRadius="999" BorderBrush="{StaticResource RolBorder}"
                            BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RolBrand}" Margin="0,0,6,0"/><TextBlock Text="{Binding TotalRoles}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource RolBrand}"/></StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="999" BorderBrush="#D1FAE5" BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="ACTIVOS" FontSize="11" FontWeight="SemiBold" Foreground="#047857" Margin="0,0,6,0"/><TextBlock Text="{Binding RolesActivos}" FontSize="13" FontWeight="Bold" Foreground="#047857"/></StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="999" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="INACTIVOS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,6,0"/><TextBlock Text="{Binding RolesInactivos}" FontSize="13" FontWeight="Bold" Foreground="#6B7280"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource RolSurface}" BorderBrush="{StaticResource RolBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Panel.ZIndex="5"
                    Visibility="{Binding MostrandoDetalle, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Border Height="38" CornerRadius="8" Padding="14,0" Background="{StaticResource RolFieldBg}" BorderThickness="1" BorderBrush="{StaticResource RolBorder}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoBuscar}" Width="16" Height="16" StrokeThickness="2.5" Stroke="{StaticResource RolBrand}" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="14" VerticalContentAlignment="Center" Text="{Binding QueryRoles, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar rol por nombre"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <ListBox Style="{StaticResource RolSegmento}" ItemsSource="{Binding OpcionesEstadoRol}" SelectedItem="{Binding OpcionEstadoRol}" VerticalAlignment="Center"/>
                        <Button Content="Nuevo rol" Command="{Binding NuevoRolCommand}" IsEnabled="{Binding PuedeCrearRol}" Style="{StaticResource RolBotonPrimario}" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource RolSurface}" BorderBrush="{StaticResource RolBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Panel.ZIndex="5"
                    Visibility="{Binding MostrandoDetalle, Converter={StaticResource BoolToVisibility}}">

                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="← Volver" Command="{Binding VolverAListaCommand}" Style="{StaticResource RolBotonFantasma}" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RolSeleccionado.Nombre}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RolText}"/>
                            <TextBlock Text="{Binding RolSeleccionado.EstadoTexto}" FontSize="12" FontWeight="SemiBold" Foreground="#047857" Margin="10,2,0,0"/>
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" Background="#FEF3C7" Visibility="{Binding EsSistemaSeleccionado, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="SISTEMA" FontSize="9" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource RolText2}" Margin="16,2,0,0"><Run Text="Usuarios: "/><Run Text="{Binding RolSeleccionado.UsuariosAsignados}" FontWeight="Bold"/><Run Text="   Permisos activos: "/><Run Text="{Binding RolSeleccionado.Permisos}" FontWeight="Bold"/></TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ── Buscador + limpiar ──────────────────────────────────── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CajaBusqueda" Height="38" CornerRadius="8" Padding="14,0"
                                Background="{StaticResource RolFieldBg}" BorderThickness="1"
                                BorderBrush="{StaticResource RolBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoBuscar}"
                                      Width="16" Height="16" StrokeThickness="2.5"
                                      Stroke="{StaticResource RolBrand}" Margin="0,0,8,0"/>

                                <Grid Grid.Column="1">
                                    <TextBlock Text="Buscar permiso por nombre o descripción..." FontSize="14"
                                               Foreground="{StaticResource RolMuted}" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding HayQuery, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBox x:Name="CampoBusqueda" BorderThickness="0" Background="Transparent"
                                             FontSize="14" Foreground="{StaticResource RolText}"
                                             VerticalContentAlignment="Center" Padding="0"
                                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Button Grid.Column="2" Width="18" Height="18" Margin="6,0" Cursor="Hand"
                                        ToolTip="Limpiar búsqueda" Command="{Binding LimpiarBusquedaCommand}"
                                        Visibility="{Binding HayQuery, Converter={StaticResource BoolToVisibility}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoEquis}"
                                                      Width="11" Height="11" StrokeThickness="2.5" Stroke="#94A3B8"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border Grid.Column="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource RolText2}">
                                        <Run Text="{Binding Activos, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalAcciones, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Height="38" Margin="10,0,0,0" Padding="16,0" Cursor="Hand"
                                FontSize="13.5" FontWeight="SemiBold" Foreground="White"
                                Command="{Binding LimpiarFiltrosCommand}"
                                IsEnabled="{Binding Filtrando}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Fondo" Background="{DynamicResource EmpresaPrimaryDarkBrush}" BorderBrush="{DynamicResource EmpresaPrimaryDarkerBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoFiltros}"
                                                  Width="16" Height="16" StrokeThickness="1.9"
                                                  Stroke="{TemplateBinding Foreground}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Limpiar Filtros" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource EmpresaPrimaryDarkerBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Fondo" Property="Background" Value="#EEF2F7"/>
                                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ── Filtros y modo de vista ─────────────────────────────── -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PERMISOS" Style="{StaticResource RolEtiquetaSeccion}" Margin="0,0,8,0"/>
                                <ListBox Style="{StaticResource RolSegmento}" ItemsSource="{Binding OpcionesEstado}"
                                         SelectedItem="{Binding OpcionEstado}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Activar todo" Style="{StaticResource RolBotonMini}"
                                        Command="{Binding ActivarTodoCommand}"
                                        IsEnabled="{Binding PuedeEditarPermisosSeleccionados}" Margin="0,0,6,0"/>
                                <Button Content="Quitar todo" Style="{StaticResource RolBotonMini}"
                                        Command="{Binding QuitarTodoCommand}"
                                        IsEnabled="{Binding PuedeEditarPermisosSeleccionados}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════ Cuerpo ══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- Indicador de carga. Va FUERA del ScrollViewer para poder quedar
                 centrado: adentro se mediría con alto infinito y el centrado no
                 tendría efecto. La visibilidad la maneja el code-behind y NO un
                 binding, así no hay un instante inicial (con DataContext todavía
                 nulo) en el que el binding falle y se dibujen dos capas encimadas. -->
            <StackPanel x:Name="LoadingPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Path x:Name="SpinnerPath"
                      Data="M 12 2 A 10 10 0 1 1 2 12"
                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="22" Height="22" Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5"
                      Margin="0,0,10,0">
                    <Path.RenderTransform>
                        <RotateTransform/>
                    </Path.RenderTransform>
                </Path>
                <TextBlock Text="Cargando roles..."
                           FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Sin scroll horizontal, como las otras 12 vistas. Con Auto, el
                 ScrollViewer mide su contenido con ancho INFINITO y el panel
                 terminaba midiendo y arreglando con anchos distintos: el layout
                 no convergia y la pantalla se trababa. -->
            <ScrollViewer Margin="0,12,0,0" Padding="20,0,20,16"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Contenido real -->
                <StackPanel x:Name="ContenidoRoles" Visibility="Collapsed">

                    <!-- Franja de aviso -->
                    <Border Style="{StaticResource RolAlertaBorde}" Margin="0,0,0,12"
                            Visibility="{Binding HayAlerta, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RolAlertaIcono}"/>
                            <TextBlock Style="{StaticResource RolAlertaTexto}" Text="{Binding TextoAlerta}"
                                       MaxWidth="900" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Catálogo de roles -->
                    <StackPanel Visibility="{Binding MostrandoDetalle, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Roles}" Visibility="{Binding SinRoles, Converter={StaticResource InverseBoolToVisibility}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource BoolToVisibility}}"/></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="330" MinHeight="180" Margin="0,0,12,12">
                                        <Button Command="{Binding DataContext.AbrirDetalleRolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding IdRol}"
                                                AutomationProperties.Name="{Binding Nombre, StringFormat=Administrar permisos del rol {0}}"
                                                Style="{StaticResource RolTarjetaSeleccionable}"/>
                                        <Grid Margin="18" IsHitTestVisible="False">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource RolText}"/>
                                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" Background="#FEF3C7"
                                                                Visibility="{Binding EsSistema, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="SISTEMA" FontSize="9" FontWeight="Bold" Foreground="#92400E"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="12" Foreground="#047857" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <Path HorizontalAlignment="Right" Style="{StaticResource RolIcono}" Data="{StaticResource GeoEscudo}" Width="25" Height="25" Stroke="{StaticResource RolBrand}"/>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,16,0,14">
                                                <TextBlock FontSize="13" Foreground="{StaticResource RolText2}"><Run Text="Usuarios asignados: "/><Run Text="{Binding UsuariosAsignados}" FontWeight="Bold"/></TextBlock>
                                                <TextBlock FontSize="13" Foreground="{StaticResource RolText2}" Margin="0,5,0,0"><Run Text="Permisos activos: "/><Run Text="{Binding Permisos}" FontWeight="Bold"/></TextBlock>
                                                <TextBlock Text="Rol de sistema: nombre, estado y todos sus permisos son inmutables."
                                                           FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Visibility="{Binding EsSistema, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="18">
                                                <Button Content="Editar" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.EditarRolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RolBotonMini}"><Setter Property="IsEnabled" Value="{Binding PuedeEditarNombre}"/></Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button
                                                        Command="{Binding DataContext.AlternarEstadoRolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RolBotonMini}"><Setter Property="IsEnabled" Value="{Binding PuedeCambiarEstado}"/><Setter Property="Content" Value="Desactivar"/><Style.Triggers><DataTrigger Binding="{Binding EsActivo}" Value="False"><Setter Property="Content" Value="Activar"/></DataTrigger></Style.Triggers></Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,70" HorizontalAlignment="Center" Visibility="{Binding SinRoles, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Sin roles que coincidan con los filtros" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RolText2}"/>
                            <Button Content="Limpiar filtros" Style="{StaticResource RolBotonMini}" Command="{Binding LimpiarFiltrosRolesCommand}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding MostrandoDetalle, Converter={StaticResource BoolToVisibility}}">
                    <!-- Tarjetas de módulo -->
                    <ItemsControl ItemsSource="{Binding Modulos}"
                                  ItemTemplate="{StaticResource RolTarjetaModulo}"
                                  Focusable="False"
                                  Visibility="{Binding SinResultados, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:SpanningGridPanel Columns="{Binding ColumnasGrilla}"
                                                        ColumnSpacing="10" RowSpacing="10"
                                                        MinColumnWidth="250"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="ctrl:SpanningGridPanel.ColumnSpan" Value="{Binding Span}"/>
                                <Setter Property="Visibility"
                                        Value="{Binding Visible, Converter={StaticResource BoolToVisibility}}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- Sin coincidencias -->
                    <StackPanel Margin="0,70" HorizontalAlignment="Center"
                                Visibility="{Binding SinResultados, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoBuscar}"
                              Width="26" Height="26" StrokeThickness="1.6" Stroke="{StaticResource RolMuted}"/>
                        <TextBlock Text="Sin permisos que coincidan con los filtros" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource RolText2}" Margin="0,8,0,0"/>
                        <Button Content="Limpiar Filtros" Style="{StaticResource RolBotonMini}"
                                Command="{Binding LimpiarFiltrosCommand}" Margin="0,12,0,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════ Pie ════════════════════════════════════ -->
        <Border x:Name="PieRoles" Grid.Row="2"
                Background="{StaticResource RolPie}" BorderBrush="#C9D9EC"
                BorderThickness="0,1,0,0" Padding="20,10"
                Visibility="{Binding MostrandoDetalle, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource RolPuntoEstado}"/>
                    <TextBlock Style="{StaticResource RolTextoEstado}" Text="{Binding TextoCambios}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Descartar" Style="{StaticResource RolBotonFantasma}"
                            Command="{Binding DescartarCommand}" Margin="0,0,10,0"/>

                    <Button Style="{StaticResource RolBotonPrimario}" Command="{Binding GuardarCommand}"
                            permisos:PermisoBehavior.Requiere="Asignar Permisos a Rol">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RolIcono}" Data="{StaticResource GeoGuardar}"
                                  Width="14" Height="14" StrokeThickness="2.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Guardar permisos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Avisos efímeros -->
        <StackPanel x:Name="ToastHost" Grid.RowSpan="3" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,72" Panel.ZIndex="90"
                    IsHitTestVisible="False"/>
    </Grid>
</UserControl>
