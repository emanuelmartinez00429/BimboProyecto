<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Roles.RolModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="470" MinHeight="285"
             d:DesignWidth="470"
             d:DesignHeight="285"
             FontFamily="Segoe UI">
    <!--
        Era un Window con Width/Height fijos y ResizeMode="NoResize". Con el escalado
        propio de la app eso se rompía: el LayoutTransform escala el contenido pero no
        el marco de la ventana, así que a 1,1x el contenido no entraba y no había forma
        de agrandarla. Ahora es un UserControl sobre el overlay de RolesView, igual que
        los otros 14 modales — hereda el transform como cualquier hijo del árbol visual.

        MinHeight en vez de Height: conserva el aire del diseño original (la fila * se
        queda con la holgura) pero deja crecer si el texto envuelve más líneas.
    -->
    <!-- Modal container with decoupled drop shadow (AP-06) -->
    <Grid>
        <Border Background="White" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.22" Color="#0F172A"/>
            </Border.Effect>
        </Border>

        <Border Background="White" CornerRadius="14" BorderBrush="#DCE3EC" BorderThickness="1"
                RenderOptions.ClearTypeHint="Enabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sin arrastre: ya no es una ventana, el overlay lo mantiene centrado. -->
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TxtContexto" Text="NUEVO ROL" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                    <TextBlock x:Name="TxtTitulo" Text="Crear rol" FontSize="22" FontWeight="Bold"
                               Foreground="#172033" Margin="0,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Content="✕"
                        FontSize="14" Background="#F1F5F9" BorderThickness="0"
                        Cursor="Hand" Click="Cancelar_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="Nombre del rol" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="TxtNombre" Height="42" Margin="0,7,0,0" Padding="12,0"
                         MaxLength="50" FontSize="14" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" BorderThickness="1"/>
                <TextBlock x:Name="TxtError" Foreground="#B91C1C" FontSize="12"
                           Margin="2,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="El rol se creará activo y sin permisos. Después podrá configurarlo en la pestaña Permisos por rol."
                       TextWrapping="Wrap" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="105" Height="38" Margin="0,0,10,0"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0"
                        Cursor="Hand" Click="Cancelar_Click"/>
                <Button x:Name="BtnGuardar" Content="Guardar" Width="115" Height="38"
                        Background="{DynamicResource EmpresaPrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Guardar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</UserControl>
