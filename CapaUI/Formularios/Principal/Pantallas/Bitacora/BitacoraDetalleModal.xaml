<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Bitacora.BitacoraDetalleModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             mc:Ignorable="d"
             Width="760" Height="640"
             d:DesignWidth="760" d:DesignHeight="640"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Auto"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Sombra desacoplada del contenido desplazable. -->
        <Border Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.35"/>
            </Border.Effect>
        </Border>

        <Border Background="White" CornerRadius="12" BorderBrush="#D8E1EC" BorderThickness="1"
                RenderOptions.ClearTypeHint="Enabled" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource EmpresaPrimaryBrush}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Detalle del registro de bitácora" FontFamily="Segoe UI"
                                   FontSize="23" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Información de auditoría en modo de solo lectura"
                                   FontFamily="Segoe UI" FontSize="13.5" Foreground="#DDEBFF" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnCerrar" Grid.Column="1" Content="×" Width="36" Height="36"
                            Margin="16,0,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Cerrar" Click="BtnRegresar_Click"/>
                </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" FontFamily="Segoe UI"
                                                   FontSize="12.5" FontWeight="Bold" Foreground="#64748B"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Valor}" FontFamily="Segoe UI"
                                                   FontSize="14.5" Foreground="#1A1F2E" TextWrapping="Wrap"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F8FAFC" Padding="24,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ErrorPanel" Grid.Row="0" Background="#FEF2F2" CornerRadius="7"
                            BorderBrush="#FECACA" BorderThickness="1" Padding="12,9"
                            Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" FontFamily="Segoe UI" FontSize="13.5"
                                   Foreground="#B91C1C" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRegresar" Content="Regresar" Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                                Padding="20,0" Margin="0,0,10,0" Click="BtnRegresar_Click"/>
                        <Button x:Name="BtnImprimir" Content="Imprimir reporte" Style="{StaticResource ActionBtn}"
                                Background="#16A34A" Padding="20,0" Click="BtnImprimir_Click"
                                permisos:PermisoBehavior.Requiere="Generar Reporte"/>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
