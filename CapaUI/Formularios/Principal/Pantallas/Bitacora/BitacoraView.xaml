<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Bitacora.BitacoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Bitacora"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             Background="#EAF1F8"
             DataContext="{x:Null}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos/geometrias compartidos viven en Styles.xaml; el disenador
                     de VS no ejecuta App.xaml y no los ve sin este merge. Ver ADR-028 / P-057. -->
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        <!-- DataGrid Row Style -->
        <Style x:Key="BitacoraRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="#34D399"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="1"/>
                                <DataGridCellsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C8D8F0"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                                <Setter TargetName="SelIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="#C2F2E0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E8F0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{DynamicResource EmpresaPrimaryBrush}" BorderBrush="#1EFFFFFF" BorderThickness="0,0,1,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="White" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>





        <!-- Etiqueta de filtro -->
        <Style x:Key="FiltroLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- DatePicker de filtro — primer uso en el proyecto; se alinea con el
             look de los ComboBox de filtro (alto 26, borde #CBD5E1, Segoe UI 13). -->
        <Style x:Key="FiltroDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Page Header -->
            <RowDefinition Height="12"/>     <!-- 1: Spacing -->
            <RowDefinition Height="Auto"/>   <!-- 2: Toolbar -->
            <RowDefinition Height="10"/>     <!-- 3: Spacing -->
            <RowDefinition Height="*"/>      <!-- 4: Table -->
            <RowDefinition Height="Auto"/>   <!-- 5: Action buttons -->
            <RowDefinition Height="Auto"/>   <!-- 6: Error display -->
        </Grid.RowDefinitions>

        <!-- ROW 0: PAGE HEADER -->
        <controls:EncabezadoCatalogo Grid.Row="0"
            Icono="{StaticResource IconHistory}" IconoEsRelleno="False"
            ModuloPadre="Usuarios" Submodulo="Bitácora"
            Titulo="Registro de auditoría del sistema"
            Total="{Binding TotalCount}"/>
            <!-- Activos/Inactivos sin bindear (quedan null): solo la pastilla Total se renderiza,
                 la bitácora no tiene concepto de estado. -->

        <!-- ROW 2: TOOLBAR -->
        <Grid Grid.Row="2">
            <!-- Sombra estática desacoplada: Border hermano detrás del contenido (AP-06 Zero-Shader Layout) -->
            <Border Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
            </Border>

            <Border x:Name="TarjetaToolbar" Background="White" CornerRadius="10"
                    BorderBrush="#D8E1EC" BorderThickness="1" Padding="12" ClipToBounds="True"
                    RenderOptions.ClearTypeHint="Enabled">
            <StackPanel>
                <!-- Search + Clear -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:SuggestionSearchBox Grid.Column="0" Margin="0,0,10,0"
                        x:Name="SearchBox"
                        Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SuggestItems="{Binding SuggestItems}"
                        HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                        Placeholder="Buscar por campo, detalle o tabla afectada..."
                        ItemSelected="SearchBox_ItemSelected"/>
                    <controls:BotonLimpiarFiltros Grid.Column="1"
                                                  ReferenciaAncho="{Binding ElementName=TarjetaToolbar}"/>
                </Grid>

                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,10,0,10" SnapsToDevicePixels="True"/>

                <!-- Filtros: Módulo · Acción · Usuario · Desde · Hasta -->
                <controls:PanelFiltrosFluido EspacioHorizontal="16" EspacioVertical="12">
                    <Grid controls:PanelFiltrosFluido.Peso="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MÓDULO" Style="{StaticResource FiltroLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbModulo" Height="26" MinWidth="120"
                                  HorizontalAlignment="Stretch"
                                  FontFamily="Segoe UI" FontSize="15" BorderBrush="#CBD5E1"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbModulo_SelectionChanged"/>
                    </Grid>

                    <Grid controls:PanelFiltrosFluido.Peso="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACCIÓN" Style="{StaticResource FiltroLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbAccion" Height="26" MinWidth="120"
                                  HorizontalAlignment="Stretch"
                                  FontFamily="Segoe UI" FontSize="15" BorderBrush="#CBD5E1"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbAccion_SelectionChanged"/>
                    </Grid>

                    <Grid controls:PanelFiltrosFluido.Peso="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="USUARIO" Style="{StaticResource FiltroLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbUsuario" Height="26" MinWidth="120"
                                  HorizontalAlignment="Stretch"
                                  FontFamily="Segoe UI" FontSize="15" BorderBrush="#CBD5E1"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbUsuario_SelectionChanged"/>
                    </Grid>

                    <Grid controls:PanelFiltrosFluido.Peso="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DESDE" Style="{StaticResource FiltroLabel}"/>
                        <DatePicker Grid.Column="1" x:Name="DpDesde"
                                    Style="{StaticResource FiltroDatePicker}"
                                    HorizontalAlignment="Stretch"
                                    SelectedDateChanged="DpDesde_SelectedDateChanged"/>
                    </Grid>

                    <Grid controls:PanelFiltrosFluido.Peso="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HASTA" Style="{StaticResource FiltroLabel}"/>
                        <DatePicker Grid.Column="1" x:Name="DpHasta"
                                    Style="{StaticResource FiltroDatePicker}"
                                    HorizontalAlignment="Stretch"
                                    SelectedDateChanged="DpHasta_SelectedDateChanged"/>
                    </Grid>
                </controls:PanelFiltrosFluido>
            </StackPanel>
        </Border>
        </Grid>

        <!-- ROW 4: TABLE -->
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <!-- Sombra estática desacoplada: Border hermano detrás del contenido,
                 así el scroll del DataGrid no la re-renderiza por frame.
                 Ver [[WPF - Rendimiento de Efectos y Niveles de Renderizado]]. -->
            <Border Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/>
                </Border.Effect>
            </Border>

            <Border Background="White" CornerRadius="10"
                    BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Empty state -->
                <StackPanel Grid.Row="0" x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center">
                        Sin resultados. Ajusta los filtros o pulsa <Bold>Limpiar Filtros</Bold>.
                    </TextBlock>
                </StackPanel>

                <!-- Loading spinner -->
                <StackPanel Grid.Row="0" x:Name="LoadingPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Path x:Name="SpinnerPath"
                          Data="M 12 2 A 10 10 0 1 1 2 12"
                          Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Cargando bitácora..." FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="0" x:Name="DgBitacora"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                           SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True"
                           SelectionChanged="DgBitacora_SelectionChanged"
                           PreviewMouseLeftButtonDown="DgBitacora_PreviewMouseLeftButtonDown"
                           PreviewMouseMove="DgBitacora_PreviewMouseMove"
                           PreviewMouseLeftButtonUp="DgBitacora_PreviewMouseLeftButtonUp"
                          Background="White" BorderThickness="0" AlternationCount="2"
                          RowStyle="{StaticResource BitacoraRowStyle}" CellStyle="{StaticResource CeldaCentrada}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False" CanUserReorder="False"
                                                CellStyle="{StaticResource CeldaCentrada}"
                                                CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/>
                        <DataGridTemplateColumn Header="FECHA / HORA" Width="150" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe UI" FontSize="15" Foreground="#6B7280"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="FechaHora" StringFormat="{}{0:dd/MM/yyyy HH:mm}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USUARIO" Width="200" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AliasUsuario}"
                                               FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#1A1F2E" TextTrimming="CharacterEllipsis" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MÓDULO" Width="160" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F5FB" CornerRadius="999" Padding="10,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding NombreModulo}"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACCIÓN" Width="150" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreAccion}"
                                               FontFamily="Segoe UI" FontSize="15"
                                               Foreground="#1A1F2E" TextTrimming="CharacterEllipsis" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CAMPO AFECTADO" Width="160" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CampoAfectado, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin campo'}"
                                               Style="{StaticResource TextoCeldaConFallback}" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DETALLE" Width="*" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoActual, Converter={x:Static conv:TextoVacioConverter.Instancia}, ConverterParameter='Sin detalle'}"
                                               Style="{StaticResource TextoCeldaConFallback}"
                                               ToolTip="{Binding EstadoActual}" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination footer (P-037) -->
                <controls:PaginadorControl Grid.Row="1"
                                           Page="{Binding Page, Mode=TwoWay}"
                                           TotalPages="{Binding TotalPages}"
                                           PageInfo="{Binding PageInfo}"
                                           IsLoading="{Binding IsLoading}"/>
            </Grid>
            </Border>
        </Grid>

        <!-- ROW 5: ACTION BUTTONS -->
        <DockPanel Grid.Row="5" Margin="0,4,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BtnSeleccionarPagina"
                        Content="Seleccionar página"
                        Click="BtnSeleccionarPagina_Click"
                        IsEnabled="False"
                        Background="{DynamicResource EmpresaPrimaryDarkBrush}" Style="{StaticResource ActionBtn}"
                        Padding="16,0" Height="38" MinWidth="150" Margin="0,0,10,0"/>
                <Button Command="{Binding CrearReporteCommand}"
                        Background="#16A34A" Style="{StaticResource ActionBtn}"
                        Padding="16,0" Height="38" MinWidth="150">
                    <TextBlock FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="White">
                        <Run Text="Crear reporte"/><Run Text=" ("/><Run Text="{Binding CantidadSeleccionada, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ROW 6: ERROR DISPLAY -->
        <Border x:Name="ErrorPanel" Grid.Row="6" Background="#FEF2F2" CornerRadius="8"
                BorderBrush="#FECACA" BorderThickness="1"
                Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText"
                       FontFamily="Segoe UI" FontSize="15" FontWeight="Medium"
                       Foreground="#B91C1C" TextWrapping="Wrap"/>
        </Border>
    </Grid>

        <Border x:Name="ModalOverlay" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
