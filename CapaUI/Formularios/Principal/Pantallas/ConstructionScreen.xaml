<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.ConstructionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F5F7" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <TextBlock Grid.Row="0" Margin="0,0,0,16" FontFamily="Segoe UI" FontSize="12">
            <Run Text="Inicio" Foreground="#6B7280"/>
            <Run Text="  /  " Foreground="#CBD5E1"/>
            <Run Text="{Binding ModuloPadre, Mode=OneTime}" Foreground="#6B7280"/>
            <Run Text="  /  " Foreground="#CBD5E1"/>
            <Run Text="{Binding NombreModulo, Mode=OneTime}" Foreground="#1A1F2E" FontWeight="SemiBold"/>
        </TextBlock>

        <!-- Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                BorderBrush="#E5E7EB" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!-- Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="460" Margin="32">

                    <!-- Icon circle (dashed border approximated) -->
                    <Border Width="88" Height="88" CornerRadius="44"
                            Background="#EFF6FF"
                            BorderBrush="#93C5FD" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Viewbox Width="40" Height="40">
                            <Canvas Width="24" Height="24">
                                <!-- Warning triangle -->
                                <Path Data="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                                <Line X1="12" Y1="9" X2="12" Y2="13"
                                      Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="15.5"
                                         Width="2" Height="2" Fill="{DynamicResource EmpresaPrimaryBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- "MÓDULO" label -->
                    <TextBlock Text="MÓDULO"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource EmpresaPrimaryBrush}" TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Module name -->
                    <TextBlock Text="{Binding NombreModulo}"
                               FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                               Foreground="#1A1F2E" TextAlignment="Center"/>

                    <!-- "En construcción" badge -->
                    <Border Background="#DBEAFE" CornerRadius="999"
                            Padding="14,6" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="En construcción"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource EmpresaPrimaryDarkBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Description -->
                    <TextBlock Text="Esta sección estará disponible próximamente. Mientras tanto, puedes navegar por el menú lateral para acceder a los módulos habilitados."
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#6B7280"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
