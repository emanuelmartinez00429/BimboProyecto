<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Proveedores.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Proveedores"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
             Background="#EAF1F8"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IconFilter">M3,6 h18 M6,12 h12 M10,18 h4</Geometry>
        <Geometry x:Key="IconCheck">M20,6 L9,17 l-5,-5</Geometry>
        <Geometry x:Key="IconPlus">M12,5 v14 M5,12 h14</Geometry>
        <Geometry x:Key="IconPencil">M11,4 H4 a2,2 0 0 0,-2,2 v14 a2,2 0 0 0,2,2 h14 a2,2 0 0 0,2,-2 v-7 M18.5,2.5 a2.12,2.12 0 0 1,3,3 L12,15 l-4,1 1,-4 z</Geometry>
        <Geometry x:Key="IconTruck">M1,3 h15 v13 H1 z M16,8 h4 l3,3 v5 h-7 z M5.5,19 a1.5,1.5 0 1 0,3,0 a1.5,1.5 0 0 0,-3,0 z M17,19 a1.5,1.5 0 1 0,3,0 a1.5,1.5 0 0 0,-3,0 z</Geometry>



        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivePageBtn" TargetType="Button" BasedOn="{StaticResource PageBtn}">
            <Setter Property="Background" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EmpresaPrimaryBrush}"/>
        </Style>

        <Style x:Key="SegmentBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1A1F2E"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.08"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#94A3B8" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ModernScrollBar}" Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" Background="{DynamicResource EmpresaPrimaryBrush}" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                    <Path Data="{StaticResource IconTruck}" Stroke="White" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280">
                        <Run Text="Proveedores" FontWeight="Normal"/>
                        <Run Text=" / "/>
                        <Run Text="Gestión de Proveedores" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                    </TextBlock>
                    <TextBlock Text="Catálogo de proveedores" FontFamily="Segoe UI" FontSize="21"
                               FontWeight="Bold" Foreground="#1A1F2E" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#EEF2F8" CornerRadius="999" BorderBrush="#D8E1EC" BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TOTAL" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalCount}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" CornerRadius="999" BorderBrush="#D1FAE5" BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ACTIVOS" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ActivosCount}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#F3F4F6" CornerRadius="999" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#9CA3AF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="INACTIVOS" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding InactivosCount}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 2: TOOLBAR -->
        <Border Grid.Row="2" x:Name="TarjetaToolbar" Background="White" CornerRadius="10"
                BorderBrush="#D8E1EC" BorderThickness="1" Padding="12" ClipToBounds="True">
            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/></Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:SuggestionSearchBox Grid.Column="0" Margin="0,0,10,0"
                        x:Name="SearchBox"
                        Query="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SuggestItems="{Binding SuggestItems}"
                        HighlightIndex="{Binding HighlightIndex, Mode=TwoWay}"
                        Placeholder="Buscar proveedor por nombre o RTN..."
                        ItemSelected="SearchBox_ItemSelected"/>
                    <!-- En ventana angosta el rótulo le come el ancho al buscador,
                         que es lo que sí tiene que quedar usable: bajo el umbral
                         queda el icono solo, con el ToolTip siempre presente. -->
                    <Button Grid.Column="1" Command="{Binding LimpiarFiltrosCommand}" Background="{DynamicResource EmpresaPrimaryDarkBrush}"
                            Style="{StaticResource ActionBtn}" Padding="16,0" Height="38" MinWidth="0"
                            ToolTip="Limpiar filtros">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFilter}" Stroke="White" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Limpiar Filtros" FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding ActualWidth, ElementName=TarjetaToolbar, Converter={StaticResource AnchoMinimoAVisibilidad}, ConverterParameter=760}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,10,0,10" SnapsToDevicePixels="True"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ESTADO" FontFamily="Segoe UI" FontSize="12.5" FontWeight="Bold"
                               Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbActivos" GroupName="EstadoFiltro" IsChecked="True"
                                         Style="{StaticResource SegmentBtn}" Checked="EstadoFiltro_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Activos" FontFamily="Segoe UI" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbInactivos" GroupName="EstadoFiltro"
                                         Style="{StaticResource SegmentBtn}" Checked="EstadoFiltro_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inactivos" FontFamily="Segoe UI" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbTodos" GroupName="EstadoFiltro"
                                         Style="{StaticResource SegmentBtn}" Checked="EstadoFiltro_Changed">
                                <TextBlock Text="Todos" FontFamily="Segoe UI" FontSize="15"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 4: TABLE -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" BorderBrush="#D8E1EC" BorderThickness="1" ClipToBounds="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="4" Opacity="0.08"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center">
                        Sin resultados. Ajusta los filtros o pulsa <Bold>Limpiar Filtros</Bold>.
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="0" x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Orientation="Horizontal">
                    <Path x:Name="SpinnerPath" Data="M 12 2 A 10 10 0 1 1 2 12"
                          Stroke="{DynamicResource EmpresaPrimaryBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="22" Height="22" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Cargando proveedores..." FontFamily="Segoe UI" FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid Grid.Row="0" x:Name="DgProveedores" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0"
                          AlternationCount="2" RowStyle="{StaticResource ProductRowStyle}" CellStyle="{StaticResource CeldaIzquierda}"
                          SelectionChanged="DgProveedores_SelectionChanged" MouseDoubleClick="DgProveedores_MouseDoubleClick"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="40" CanUserResize="False" CanUserReorder="False"
                                                CellStyle="{StaticResource CeldaCentrada}"
                                                CellTemplate="{StaticResource PlantillaCeldaNumeroFila}"/>
                        <DataGridTemplateColumn Header="NOMBRE" Width="Auto" MinWidth="180" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI" FontSize="15.5"
                                               Foreground="#1A1F2E" TextTrimming="CharacterEllipsis" Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="RTN" Width="Auto" MinWidth="135" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left" Margin="10,0,0,0">
                                        <Border x:Name="BdRtn" Background="#EFF6FF" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding Rtn}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="TxtRtnVacio" Text="Sin RTN" Style="{StaticResource TextoCeldaConFallback}" Visibility="Collapsed"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rtn}" Value="">
                                            <Setter TargetName="BdRtn" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TxtRtnVacio" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rtn}" Value="{x:Null}">
                                            <Setter TargetName="BdRtn" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="TxtRtnVacio" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TELÉFONO" Width="Auto" MinWidth="125" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Telefono, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin teléfono'}"
                                               Style="{StaticResource TextoCeldaConFallback}" HorizontalAlignment="Left" Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CORREO" Width="Auto" MinWidth="200" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Correo, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin correo'}"
                                               Style="{StaticResource TextoCeldaConFallback}" Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DIRECCIÓN" Width="*" MinWidth="260" CellStyle="{StaticResource CeldaIzquierda}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Direccion, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin dirección'}"
                                               Style="{StaticResource TextoCeldaConFallback}" Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CREADO"
                                                Width="Auto"
                                                MinWidth="130"
                                                HeaderStyle="{StaticResource HeaderDerecho}"
                                                CellStyle="{StaticResource CeldaDerecha}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTUALIZADO"
                                                Width="Auto"
                                                MinWidth="130"
                                                HeaderStyle="{StaticResource HeaderDerecho}"
                                                CellStyle="{StaticResource CeldaDerecha}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='—'}"
                                               FontFamily="Segoe UI" FontSize="14" Foreground="#64748B"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" HeaderStyle="{StaticResource HeaderCentrado}" Width="70" MinWidth="70" CellStyle="{StaticResource CeldaCentrada}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource EmpresaPrimaryBrush}" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect><DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="11" Height="11" Stretch="Uniform"/>
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="4" Background="White"
                                                BorderBrush="#CBD5E1" BorderThickness="2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IdEstado}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe UI" FontSize="14" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Text="{Binding PageInfo}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#171;" Style="{StaticResource PageBtn}" Command="{Binding PrimeraPaginaCommand}" Padding="6,0" Margin="0,0,2,0"/>
                            <Button Content="&#8249;" Style="{StaticResource PageBtn}" Command="{Binding PaginaAnteriorCommand}" Padding="6,0" Margin="0,0,2,0"/>
                            <ItemsControl x:Name="PaginacionPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="&#8250;" Style="{StaticResource PageBtn}" Command="{Binding PaginaSiguienteCommand}" Padding="6,0" Margin="2,0,0,0"/>
                            <Button Content="&#187;" Style="{StaticResource PageBtn}" Command="{Binding UltimaPaginaCommand}" Padding="6,0" Margin="2,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 5: ACTION BUTTONS -->
        <DockPanel Grid.Row="5" Margin="0,4,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding NuevoCommand}" permisos:PermisoBehavior.Requiere="Crear Proveedor" Background="#16A34A" Style="{StaticResource ActionBtn}" Padding="22,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo" FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditarCommand}" permisos:PermisoBehavior.Requiere="Modificar Proveedor" Background="{DynamicResource EmpresaPrimaryBrush}" Style="{StaticResource ActionBtn}" Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPencil}" Stroke="White" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar" FontFamily="Segoe UI" FontSize="15.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" x:Name="SelectedInfo" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Visibility="Collapsed">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource EmpresaPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Text="{Binding TextoSeleccionado}"/>
            </StackPanel>
        </DockPanel>
    </Grid>

        <Border x:Name="ModalOverlay" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
