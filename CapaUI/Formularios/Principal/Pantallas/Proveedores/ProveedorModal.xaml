<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Proveedores.ProveedorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             mc:Ignorable="d"
             Width="600"
             d:DesignWidth="600"
             d:DesignHeight="600"


             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display" controls:AtajoGuardar.Boton="{x:Reference BtnGuardar}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Geometry x:Key="IconTruckM">M1,3 h15 v13 H1 z M16,8 h4 l3,3 v5 h-7 z M5.5,19 a1.5,1.5 0 1 0,3,0 a1.5,1.5 0 0 0,-3,0 z M17,19 a1.5,1.5 0 1 0,3,0 a1.5,1.5 0 0 0,-3,0 z</Geometry>
            <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>

            <!-- ModalSegBtn, EtiquetaCampo y CampoModal vienen de Styles.xaml. -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Modal container with decoupled drop shadow (AP-06) -->
    <Grid>
        <!-- Borde hermano estático para sombra: la GPU lo rasteriza de forma independiente
             y no sufre recorte por ClipToBounds ni conflicto de shaders. -->
        <Border Background="#1E293B" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <!-- Contenedor con recorte para el gradiente y bordes redondeados limpios -->
        <Border CornerRadius="10" ClipToBounds="True">
            <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLighterColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource EmpresaPrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Padding="28,20,28,14" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTruckM}" Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext" Style="{StaticResource ModalContexto}"/>
                            <TextBlock x:Name="TxtModalTitle" Style="{StaticResource ModalTitulo}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="32" Height="32" Background="#14FFFFFF" BorderThickness="0"
                                VerticalAlignment="Top" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}" Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Margin="40,20,40,18">
                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Nombre" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource ModalInput}" TabIndex="10"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="RTN" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtRtn" Style="{StaticResource ModalInput}" TabIndex="20"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Tel&#233;fono" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtTelefono" Style="{StaticResource ModalInput}" TabIndex="30"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Correo" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtCorreo" Style="{StaticResource ModalInput}" TabIndex="40"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Direcci&#243;n" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtDireccion" Style="{StaticResource ModalInput}" TabIndex="50"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}"/>
                        <Border Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo" GroupName="EstadoModal" IsChecked="True" Style="{StaticResource ModalSegBtn}" TabIndex="60">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo" GroupName="EstadoModal" Style="{StaticResource ModalSegBtn}" TabIndex="61">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Ctrl+Enter para guardar" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#8CFFFFFF"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Volver" Click="BtnCerrar_Click" Background="#1AFFFFFF" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1" Padding="22,9" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,10,0" TabIndex="70">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnGuardar" Content="Guardar" Click="BtnGuardar_Click" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1" Padding="22,9" Cursor="Hand" FocusVisualStyle="{x:Null}" TabIndex="71">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Border.Effect><DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/></Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,6 L9,17 l-5,-5" Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</UserControl>
