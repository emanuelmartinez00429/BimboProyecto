<UserControl x:Class="CapaUI.Formularios.Principal.Pantallas.Presentaciones.PresentacionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             Width="620"
             MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource RestarMargen}, ConverterParameter=48}"
             MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource RestarMargen}, ConverterParameter=48}"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display"
             controls:AtajoGuardar.Boton="{Binding ElementName=BtnGuardar}">

    <UserControl.Resources>
        <Geometry x:Key="IconBoxM">M21,16 V8 a2,2 0 0 0,-1,-1.73 l-7,-4 a2,2 0 0 0,-2,0 l-7,4 A2,2 0 0 0,3,8 v8 a2,2 0 0 0,1,1.73 l7,4 a2,2 0 0 0,2,0 l7,-4 A2,2 0 0 0,21,16 z M3.27,6.96 L12,12.01 l8.73,-5.05 M12,22.08 V12</Geometry>
        <Geometry x:Key="IconCloseM">M6,6 l12,12 M18,6 l-12,12</Geometry>

        <!-- Etiqueta ARRIBA del campo, como en ProductoModal: deja al input usar
             todo el ancho de la tarjeta en vez de perder 130px en una columna
             de rótulos. -->
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="CampoModal" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ModalInputAuditoria" TargetType="TextBox" BasedOn="{StaticResource ModalInput}">
            <Setter Property="Background" Value="#C7D2E3"/>
            <Setter Property="Foreground" Value="#5B6B85"/>
            <Setter Property="BorderBrush" Value="#3FFFFFFF"/>
        </Style>

        <Style x:Key="ModalSegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Foco visible por teclado: mismo lenguaje que ModalInput. -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C2F2E0"/>
                                <Setter Property="Foreground" Value="#1A1F2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" ClipToBounds="True"
            MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5797" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.55"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#34D399" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                            <GradientStop Color="#818CF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- HEADER -->
                <Border Padding="28,20,28,14" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBoxM}" Stroke="White" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalContext" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#A6FFFFFF"/>
                            <TextBlock x:Name="TxtModalTitle" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="32" Height="32" Background="#14FFFFFF" BorderThickness="0"
                                VerticalAlignment="Top" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                IsTabStop="False" Click="BtnCerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <Path Data="{StaticResource IconCloseM}" Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- FORMULARIO.
                     TabIndex explícito: campos de a 10 para dejar hueco por si se
                     agrega uno intermedio sin renumerar todo. -->
                <StackPanel Margin="34,22,34,18">
                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Nombre" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource ModalInput}" TabIndex="10" MaxLength="100"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Descripci&#243;n" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtDescripcion" Style="{StaticResource ModalInput}" TabIndex="20"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CampoModal}">
                        <TextBlock Text="Estado" Style="{StaticResource EtiquetaCampo}"/>
                        <Border Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbActivo" GroupName="EstadoModal" IsChecked="True" Style="{StaticResource ModalSegBtn}" TabIndex="30">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Activo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbInactivo" GroupName="EstadoModal" Style="{StaticResource ModalSegBtn}" TabIndex="31">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inactivo" FontFamily="Segoe UI" FontSize="16.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Auditoría: solo lectura y fuera del recorrido de Tab. -->
                    <Grid x:Name="FilaAuditoria" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Creado" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox x:Name="TxtCreado" Style="{StaticResource ModalInputAuditoria}" IsReadOnly="True" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Actualizado" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox x:Name="TxtActualizado" Style="{StaticResource ModalInputAuditoria}" IsReadOnly="True" IsTabStop="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- FOOTER -->
                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Ctrl+Enter para guardar" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#8CFFFFFF"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Volver" Click="BtnCerrar_Click" Background="#1AFFFFFF" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"
                                    BorderBrush="#4CFFFFFF" BorderThickness="1" Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" Margin="0,0,10,0" TabIndex="40">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/></Trigger>
                                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnGuardar" Content="Guardar" Click="BtnGuardar_Click" Foreground="White"
                                    FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                    BorderBrush="#15803D" BorderThickness="1" Padding="22,9" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}" TabIndex="41">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Border.Effect><DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/></Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,6 L9,17 l-5,-5" Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/><Setter TargetName="Bd" Property="BorderThickness" Value="3"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.6"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
