<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CapaUI.Formularios.Principal"
        xmlns:pantallas="clr-namespace:CapaUI.Formularios.Principal.Pantallas"
        xmlns:prods="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Productos"
        xmlns:provs="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Proveedores"
        xmlns:fabs="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Fabricantes"
        xmlns:cats="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Categorias"
        xmlns:pres="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Presentaciones"
        xmlns:cfabs="clr-namespace:CapaUI.Formularios.Principal.Pantallas.ContactosFabricantes"
        xmlns:cprovs="clr-namespace:CapaUI.Formularios.Principal.Pantallas.ContactosProveedores"
        xmlns:pesaje="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Pesaje"
        xmlns:usrs="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Usuarios"
        xmlns:emps="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Empleados"
        xmlns:bita="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Bitacora"
        xmlns:reportes="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Reporteria"
        xmlns:roles="clr-namespace:CapaUI.Formularios.Principal.Pantallas.Roles"
        xmlns:permisos="clr-namespace:CapaUI.Core.Permisos"
        xmlns:dash="clr-namespace:CapaUI.Formularios.Dashboard"
        xmlns:searchVm="clr-namespace:CapaUI.ViewModels.Search"
        xmlns:searchViews="clr-namespace:CapaUI.Formularios.Search"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="CapaUI.Formularios.Principal.MainWindow"
        Title="BimboPesaje"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="600" av:DesignWidth="590"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CapaUI;component/Formularios/Principal/MenuResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:WelcomeVM}">
                <pantallas:WelcomeScreen/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ConstructionVM}">
                <pantallas:ConstructionScreen/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type dash:DashboardVM}">
                <dash:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ProductosVM}">
                <prods:ProductosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ProveedoresVM}">
                <provs:ProveedoresView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:FabricantesVM}">
                <fabs:FabricantesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:CategoriasVM}">
                <cats:CategoriasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:PresentacionesVM}">
                <pres:PresentacionesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ContactosFabricantesVM}">
                <cfabs:ContactosFabricantesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ContactosProveedoresVM}">
                <cprovs:ContactosProveedoresView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:PesajesVM}">
                <pesaje:PesajeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:UsuariosScreenVM}">
                <usrs:UsuariosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:EmpleadosVM}">
                <emps:EmpleadosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:BitacoraVM}">
                <bita:BitacoraView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:RolesVM}">
                <roles:RolesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ReporteriaVM}">
                <reportes:ReporteriaView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:PlaceholderVM}">
                <Grid Background="#F4F5F7">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NombreModulo}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource EmpresaPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Módulo en construcción" FontSize="16" Foreground="#6B7280"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type searchVm:UniversalSearchViewModel}">
                <searchViews:UniversalSearchView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 TOP BAR  (56 px)
            ══════════════════════════════════════════════════════════ -->
            <!-- DockPanel y no Grid de columnas Auto/*/Auto: en un Grid, TODAS
                 las columnas Auto son igual de rígidas — ninguna cede espacio a
                 otra, sin importar el orden en que aparezcan. Si el total (marca
                 + acciones) llegaba a superar el ancho real de la ventana (una
                 ventana angosta más el sidebar expandido empujando la marca a
                 226px), lo que se salía del borde derecho eran los botones de
                 ventana — porque son lo último del Grid, no porque el layout
                 los priorizara para desaparecer.

                 En un DockPanel, en cambio, cada hijo Dock="Right" reclama su
                 porción del borde derecho EN EL ORDEN en que se declara, contra
                 el rectángulo que quedaba libre hasta ese momento — es decir,
                 el primero en la lista tiene prioridad garantizada. Por eso acá
                 los botones de ventana van primero (apenas después de la marca),
                 así se llevan su franja del borde derecho pase lo que pase con
                 el resto; "Acciones" se declara después (cede si hace falta,
                 vía sus umbrales de Visibility ya existentes) y la zona de
                 búsqueda queda última, ocupando lo que sobra — que es
                 exactamente su rol hasta ahora. -->
            <Border Grid.Row="0" Background="{DynamicResource EmpresaPrimaryBrush}"
                    BorderBrush="#20000000" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">

                    <!-- ── BRAND BLOCK (mismo ancho que sidebar, anima junto) ── -->
                    <Border x:Name="BrandBlock" DockPanel.Dock="Left" Width="226"
                            Background="{DynamicResource EmpresaPrimaryBrush}"
                            CacheMode="BitmapCache"
                            BorderBrush="#2EFFFFFF" BorderThickness="0,0,1,0">
                        <DockPanel Margin="12,0" LastChildFill="True"
                                   WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource TopBarIconButton}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Width="40" Height="40"
                                    Click="BtnHamburger_Click"
                                    ToolTip="Colapsar / expandir menú">
                                <Viewbox Width="25" Height="25">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 6 L21 6 M3 12 L21 12 M3 18 L21 18"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Border x:Name="LogoContainer"
                                    Background="Transparent" CornerRadius="8"
                                    Padding="10,4" Margin="8,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image x:Name="ImgIconoSidebar" Source="/Resources/bimbo-logo.png" Height="50"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- ── BOTONES DE VENTANA — minimizar / maximizar / cerrar ──
                         Van primero en el orden de los Dock="Right": son los que
                         SIEMPRE tienen que verse (control nativo de la ventana,
                         sin ellos no hay forma de cerrarla salvo Alt+F4), así que
                         se llevan su franja del borde derecho antes que
                         cualquier otra cosa. Nunca se ocultan ni se achican. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TopBarIconButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Minimizar" Click="BtnMinimizar_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TopBarIconButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Maximizar / Restaurar" Click="BtnMaximizar_Click">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TopBarIconButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Cerrar" Click="BtnCerrarVentana_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- ── ACCIONES DERECHA (notificaciones, configuración, cerrar sesión) ──
                         Segundo Dock="Right": se lleva lo que queda del borde
                         derecho DESPUÉS de que los botones de ventana ya
                         reclamaron el suyo. Sus propios umbrales de Visibility
                         (Notif/Config <1060, texto de Cerrar Sesión <1150) son
                         los que ceden espacio cuando la ventana se achica. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">

                        <!-- Notificaciones.
                             Se oculta junto con Configuración cuando la ventana
                             se pone chica: entre las cuatro cosas de la barra,
                             el buscador y el estado de red son las que hacen
                             falta a mano, y estas dos son las que pueden
                             esperar a que se agrande la ventana.

                             El umbral mira el ancho de la VENTANA, no el de la
                             zona del buscador: estos botones viven en la columna
                             Auto de la derecha, así que ocultarlos ensancha esa
                             zona — atarlo a ella se realimentaría y los botones
                             parpadearían al aparecer y desaparecer solos. -->
                        <Grid VerticalAlignment="Center"
                              Visibility="{Binding ActualWidth,
                                           RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                           Converter={StaticResource AnchoMinimoAVisibilidad},
                                           ConverterParameter=1060}">
                            <Button x:Name="BtnNotif"
                                    Style="{StaticResource TopBarIconButton}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Width="42" Height="42"
                                    ToolTip="Notificaciones"
                                    Click="BtnNotif_Click">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6 8a6 6 0 0 1 12 0c0 7 2 9 2 9H4s2-2 2-9"
                                              Stroke="White" StrokeThickness="1.9"
                                              Fill="Transparent" StrokeLineJoin="Round"/>
                                        <Path Data="M10 21a2 2 0 0 0 4 0"
                                              Stroke="White" StrokeThickness="1.9"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Badge rojo "3" -->
                            <Border Background="#EF4444" CornerRadius="7"
                                    MinWidth="13" Height="13" Padding="2,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,5,4,0"
                                    BorderBrush="{DynamicResource EmpresaPrimaryBrush}" BorderThickness="1.5"
                                    IsHitTestVisible="False">
                                <TextBlock Text="3" Foreground="White"
                                           FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Popup de notificaciones -->
                            <Popup x:Name="NotifPopup"
                                   PlacementTarget="{Binding ElementName=BtnNotif}"
                                   Placement="Bottom" VerticalOffset="4"
                                   HorizontalOffset="-316"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Width="360" Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB" BorderThickness="1"
                                        ClipToBounds="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="8"
                                                          Direction="270" Opacity="0.18"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Header -->
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                                                Padding="16,13">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Notificaciones"
                                                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                                               Foreground="#1A1F2E" VerticalAlignment="Center"/>
                                                    <Border Background="#EF4444" CornerRadius="999"
                                                            Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="3 nuevas" Foreground="White"
                                                                   FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Content="Marcar todas" HorizontalAlignment="Right"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource EmpresaPrimaryBrush}" FontFamily="Segoe UI"
                                                        FontSize="12" FontWeight="SemiBold"
                                                        Cursor="Hand" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Notif 1 — azul / unread -->
                                        <Border Background="#FAFBFF" BorderBrush="#F9FAFB"
                                                BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="#EFF6FF" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Nuevo pesaje registrado"
                                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#1A1F2E"/>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                                                 VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Lote #2841 — 1,240 kg en línea 3."
                                                               FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="hace 5 min"
                                                               FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Notif 2 — rojo / unread -->
                                        <Border Background="#FAFBFF" BorderBrush="#F9FAFB"
                                                BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="#FEF2F2" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Ellipse Width="8" Height="8" Fill="#EF4444"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Stock bajo de proveedor"
                                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#1A1F2E"/>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                                                 VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Harina integral por debajo del mínimo."
                                                               FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="hace 1 h"
                                                               FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Notif 3 — azul / unread -->
                                        <Border Background="#FAFBFF" BorderBrush="#F9FAFB"
                                                BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="#EFF6FF" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Aprobación pendiente"
                                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#1A1F2E"/>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource EmpresaPrimaryLightBrush}"
                                                                 VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Usuario &quot;j.ramos&quot; solicita acceso a Reportería."
                                                               FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="hace 3 h"
                                                               FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Notif 4 — verde / read -->
                                        <Border Background="White" BorderBrush="#F9FAFB"
                                                BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="#ECFDF5" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Ellipse Width="8" Height="8" Fill="#10B981"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Bitácora generada"
                                                               FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                                               Foreground="#1A1F2E"/>
                                                    <TextBlock Text="Reporte semanal disponible para descarga."
                                                               FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="ayer"
                                                               FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Footer -->
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Padding="16,10">
                                            <Button Content="Ver todas las notificaciones"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource EmpresaPrimaryBrush}" FontFamily="Segoe UI"
                                                    FontSize="13" FontWeight="SemiBold"
                                                    Cursor="Hand" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Configuración. Mismo umbral que Notificaciones. -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Width="42" Height="42"
                                permisos:PermisoBehavior.Requiere="Modificar Configuración"
                                Click="BtnConfiguracion_Click"
                                ToolTip="Configuración"
                                Visibility="{Binding ActualWidth,
                                             RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                             Converter={StaticResource AnchoMinimoAVisibilidad},
                                             ConverterParameter=1060}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                                          Stroke="White" StrokeThickness="1.7" Fill="Transparent"/>
                                    <Path Data="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                                          Stroke="White" StrokeThickness="1.7" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Border Width="1" Height="24" Background="#26FFFFFF" Margin="8,0"/>

                        <!-- Cerrar sesión. En ventana angosta el rótulo se lleva
                             ~95 px que le hacen falta al buscador, así que bajo
                             el umbral queda el icono solo; el ToolTip cubre la
                             pérdida del texto. -->
                        <Button Style="{StaticResource LogoutButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding CerrarSesionCommand}"
                                ToolTip="Cerrar sesión">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="15" Height="24">
                                        <Path Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M16 17l5-5-5-5 M21 12H9"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Cerrar Sesión"
                                           Margin="11,5,5,5"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    Visibility="{Binding ActualWidth,
                                                 RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                                 Converter={StaticResource AnchoMinimoAVisibilidad},
                                                 ConverterParameter=1150}"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- ── ESTADO DE CONEXIÓN + SEARCH BAR ──
                         Último hijo del DockPanel, sin Dock: es el que llena lo
                         que sobra después de que la marca y los dos grupos de la
                         derecha reclamaron lo suyo — el mismo rol que cumplía la
                         columna "*" antes. Adentro sigue siendo un Grid (no un
                         StackPanel): en un StackPanel horizontal los hijos se
                         miden con ancho infinito, así que el buscador nunca se
                         enteraba de que sobraba espacio y terminaba recortado en
                         vez de achicarse. La píldora recibe un ancho real
                         (columna "*") y el semáforo de conexión toma solo lo
                         suyo. -->
                    <Grid x:Name="ZonaBusqueda" VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.ColumnDefinitions>
                            <!-- "*" con MaxWidth, no "Auto" con MaxWidth: son dos
                                 cosas distintas y esa fue la causa del corte.
                                 "Auto" siempre toma el ancho natural de su
                                 contenido — MaxWidth solo le baja el TECHO, nunca
                                 le da un PISO que se adapte al espacio real. Con
                                 la ventana angosta, la columna Auto seguía
                                 pidiendo su ancho natural (~350px) aunque a
                                 ZonaBusqueda solo le quedaran ~200: como ninguna
                                 otra columna Auto puede prestarle ese faltante
                                 (así funciona Grid — ninguna Auto cede a otra),
                                 el sobrante se dibujaba fuera del borde real de
                                 la ventana. "*" sí participa del algoritmo de
                                 achique: pide todo lo que el MaxWidth le permite,
                                 pero cede de verdad cuando no hay tanto. El
                                 espaciador ya no hace falta — de sobrar ancho por
                                 encima del MaxWidth, ese resto queda sin usar
                                 dentro del propio Grid (incoloro, mismo azul de
                                 fondo), efecto idéntico al que cumplía antes. -->
                            <ColumnDefinition Width="*" MaxWidth="720"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Visibility atada al ancho de esta zona, no al de la
                             ventana: así contempla de una sola vez los dos casos
                             que la achican — ventana chica y sidebar expandido
                             (BrandBlock ocupa 226 px y se los quita a esta
                             columna). Al colapsar el menú el buscador vuelve
                             solo. El semáforo de conexión no se oculta: es la
                             señal de que la app sigue viva.

                             HorizontalAlignment="Stretch", no "Left": con "*" la
                             columna ya calcula el ancho real disponible: Stretch
                             deja que la píldora lo ocupe entero (por eso ahora sí
                             se achica de verdad) en vez de quedarse en su tamaño
                             natural aunque le sobre o falte espacio. -->
                        <Border x:Name="SearchPill" Grid.Column="0"
                                Background="#1FFFFFFF"
                                BorderBrush="#15FFFFFF" BorderThickness="1"
                                CornerRadius="22" Height="38"
                                HorizontalAlignment="Stretch"
                                Margin="16,0" Padding="14,0"
                                Visibility="{Binding ActualWidth, ElementName=ZonaBusqueda,
                                             Converter={StaticResource AnchoMinimoAVisibilidad},
                                             ConverterParameter=200}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- "*" con MinWidth en vez de 300 fijo: el campo se
                                         encoge con la ventana pero nunca por debajo de
                                         donde deja de poder escribirse. 45, no 70: con
                                         la píldora ahora sí achicándose de verdad (ver
                                         columna "*" de ZonaBusqueda), conviene que
                                         aguante más antes de tener que ocultarse entera. -->
                                    <ColumnDefinition Width="*" MinWidth="45"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- lupa -->
                                <Viewbox Grid.Column="0" Width="15" Height="15"
                                         VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5"
                                                 Width="13" Height="13"
                                                 Stroke="White" StrokeThickness="2.2"/>
                                        <Line X1="14.5" Y1="14.5" X2="21" Y2="21"
                                              Stroke="White" StrokeThickness="2.2"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- input -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <!-- TextTrimming como red de seguridad: el texto
                                         natural del placeholder pide más ancho del que
                                         a veces hay disponible; sin esto se dibujaba
                                         igual, más allá del borde de su propia celda. -->
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Padding="1"
                                               Text="Buscar módulo o ajustes…"
                                               Foreground="#8CFFFFFF"
                                               FontFamily="Segoe UI" FontSize="15"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtSearch"
                                             Background="Transparent" BorderThickness="0"
                                             FontFamily="Segoe UI" FontSize="15"
                                             Foreground="White" CaretBrush="White"
                                             SelectionBrush="#4CFFFFFF"
                                             VerticalAlignment="Center"
                                             WindowChrome.IsHitTestVisibleInChrome="True"
                                             TextChanged="TxtSearch_Changed"
                                             GotFocus="TxtSearch_GotFocus"
                                             LostFocus="TxtSearch_LostFocus"
                                             KeyDown="TxtSearch_KeyDown"/>
                                </Grid>

                                <!-- Ctrl+K hint. Es lo primero que se va al
                                     apretarse el espacio: es una ayuda, no una
                                     función, y libera ~60 px para el campo. -->
                                <Border Grid.Column="2" Background="#15FFFFFF"
                                        BorderBrush="#20FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="5,1"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding ActualWidth, ElementName=ZonaBusqueda,
                                                     Converter={StaticResource AnchoMinimoAVisibilidad},
                                                     ConverterParameter=480}">
                                    <TextBlock Text="Ctrl+K" Foreground="#D9FFFFFF"
                                               FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- El ToolTip lleva el estado real (no un rótulo fijo):
                             cuando la palabra se oculta, pasar el mouse sigue
                             siendo la forma de leerlo. -->
                        <Border x:Name="ConnPill" Grid.Column="1"
                            Background="#1FFFFFFF"
                            BorderBrush="#15FFFFFF" BorderThickness="1"
                            CornerRadius="14" Height="28"
                            Margin="2,0,0,0" Padding="10,0"
