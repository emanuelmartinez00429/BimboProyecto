                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="SubReportes" MaxHeight="0" ClipToBounds="True"
                                            Background="#2E000000">
                                        <StackPanel Margin="0,4">
                                            <Button Style="{StaticResource SidebarSubButton}" Tag="dashboard"
                                                    permisos:PermisoBehavior.Requiere="Consultar Reporte"
                                                    Padding="48,10,16,10" Click="BtnSub_Click">
                                                <Grid>
                                                    <Border x:Name="DotDashboard" Width="4" Height="4" CornerRadius="2"
                                                            Background="{StaticResource AccentGreen}"
                                                            HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="LblDashboard" Text="Dashboard"
                                                               Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="15"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource SidebarSubButton}" Tag="crear-reportes"
                                                    permisos:PermisoBehavior.Requiere="Consultar Reporte"
                                                    Padding="48,10,16,10" Click="BtnSub_Click">
                                                <Grid>
                                                    <Border x:Name="DotCrearReportes" Width="4" Height="4" CornerRadius="2"
                                                            Background="{StaticResource AccentGreen}"
                                                            HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="LblCrearReportes" Text="Crear Reportes"
                                                               Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="15"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ← Volver a inicio -->
                        <Border x:Name="HomeButtonContainer" Grid.Row="2"
                                BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                                Padding="16">
                            <Button x:Name="BtnHome"
                                    Background="Transparent"
                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Foreground="#D9FFFFFF"
                                    FontFamily="Segoe UI" FontSize="12"
                                    Padding="8,7" Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnHome_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="← Volver a inicio"
                                           FontFamily="Segoe UI" FontSize="16"
                                           Foreground="#D9FFFFFF" TextAlignment="Center"/>
                            </Button>
                        </Border>

                        <!-- Tarjeta de usuario — expandida -->
                        <Border x:Name="UserCardButton" Grid.Row="3"
                                BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                                Padding="14,12" Cursor="Hand"
                                MouseLeftButtonUp="UserCard_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{StaticResource AvatarGradient}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Iniciales}"
                                                   Foreground="White" FontFamily="Segoe UI"
                                                   FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NombreUsuario}"
                                                   Foreground="White" FontFamily="Segoe UI"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{StaticResource AccentGreen}"
                                                    Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding NombreRol}"
                                                       Foreground="#B3FFFFFF" FontFamily="Segoe UI" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"
                                        Margin="0,10,0,0" Padding="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="v1.0.0" Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Text="© 2026"  Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta de usuario — compacta (colapsado) -->
                        <Border x:Name="CompactUserCard" Grid.Row="4"
                                Visibility="Collapsed"
                                BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                                Padding="0,12" Cursor="Hand"
                                MouseLeftButtonUp="UserCard_Click">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{StaticResource AvatarGradient}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Iniciales}"
                                           Foreground="White" FontFamily="Segoe UI"
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                    </Grid>
                </Border>

                <!-- ══ CONTENIDO CENTRAL ═══════════════════════════════ -->
                <!-- Telón detrás del contenido: transparente siempre, salvo el instante en que
                     ContentAreaBorder se oculta durante la animación del sidebar con un modal abierto
                     (evita el flash blanco — ver CollapseSidebar/ExpandSidebar). -->
                <Border x:Name="ContentBackdrop" Grid.Column="1" Background="Transparent"/>

                <Border x:Name="ContentAreaBorder" Grid.Column="1">
                    <ContentControl x:Name="ContentArea" Content="{Binding VistaActual}"/>
                </Border>

            </Grid>

            <Border x:Name="ConfiguracionOverlay" Grid.RowSpan="2"
                    Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="500">
                <ContentControl x:Name="ConfiguracionContent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24"/>
            </Border>
        </Grid>
    </Border>
</Window>
