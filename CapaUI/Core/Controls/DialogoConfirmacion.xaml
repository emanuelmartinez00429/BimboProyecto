<Window x:Class="CapaUI.Core.Controls.DialogoConfirmacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Geometry x:Key="IconAlerta">M12,9 v4 M12,17 h.01 M10.29,3.86 L1.82,18 a2,2 0 0 0,1.71,3 h16.94 a2,2 0 0 0,1.71,-3 L13.71,3.86 a2,2 0 0 0,-3.42,0 z</Geometry>

        <!-- Botones: mismo lenguaje que el pie de los modales (fantasma a la
             izquierda, sólido a la derecha), pero el sólido va en ámbar y no en
             verde — el verde de "Guardar" significa "seguí adelante", y acá el
             botón que confirma es justamente el que hace lo destructivo. -->
        <Style x:Key="DlgBtnFantasma" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#4CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgBtnPeligro" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#D97706" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" ClipToBounds="True" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryColor}" Offset="0.55"/>
                        <GradientStop Color="{DynamicResource EmpresaPrimaryDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel>
                <!-- Cinta ámbar: en los modales esta franja es verde/azul; acá el
                     ámbar la marca como advertencia desde el primer vistazo. -->
                <Border Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#FBBF24" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Padding="28,20,28,14" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="#33F59E0B" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAlerta}" Stroke="#FBBF24" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ADVERTENCIA" Style="{StaticResource ModalContexto}"/>
                            <TextBlock x:Name="TxtTitulo" Style="{StaticResource ModalTitulo}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtMensaje" Margin="40,20,40,20"
                           FontFamily="Segoe UI" FontSize="16" Foreground="#F2FFFFFF"
                           TextWrapping="Wrap" LineHeight="24"/>

                <Border Background="#2E000000" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="28,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- "Volver" es el default y arranca con el foco: ante la duda,
                             la tecla Enter no debe ejecutar lo destructivo. -->
                        <Button x:Name="BtnVolver" Content="Volver" IsCancel="True"
                                Style="{StaticResource DlgBtnFantasma}"
                                Margin="0,0,10,0" TabIndex="10" Click="BtnVolver_Click"/>
                        <Button x:Name="BtnConfirmar" Style="{StaticResource DlgBtnPeligro}"
                                TabIndex="20" Click="BtnConfirmar_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
