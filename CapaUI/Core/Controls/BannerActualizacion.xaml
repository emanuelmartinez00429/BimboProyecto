<UserControl x:Class="CapaUI.Core.Controls.BannerActualizacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CapaUI.Converters"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             Visibility="{Binding BannerVisible,
                                  Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">

    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
            Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0"
                     VerticalAlignment="Center">
                <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z"
                      Fill="#2563EB"/>
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Mensaje}"
                           FontFamily="Segoe UI" FontSize="12.5"
                           Foreground="#1E40AF"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Height="3" Margin="0,6,12,0"
                             Maximum="100" Value="{Binding Progreso}"
                             Foreground="#2563EB" Background="#DBEAFE" BorderThickness="0"
                             Visibility="{Binding Descargando,
                                                  Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ListaParaAplicar,
                                             Converter={x:Static conv:BoolToVisibilityConverter.Instancia}}">
                <Button Content="Reiniciar ahora"
                        Style="{StaticResource BtnBannerAccion}"
                        Command="{Binding ReiniciarAhoraCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Ocultar"
                        Style="{StaticResource BtnBannerOcultar}"
                        Command="{Binding OcultarCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
