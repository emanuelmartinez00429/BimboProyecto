<UserControl x:Class="CapaUI.Core.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsHitTestVisible="False"
             Focusable="False"
             Visibility="Collapsed"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel x:Name="ContenedorPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Path x:Name="SpinnerPath"
                  Data="M 12 2 A 10 10 0 1 1 2 12"
                  Stroke="{DynamicResource EmpresaPrimaryBrush}"
                  StrokeThickness="{Binding Grosor, ElementName=Root}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="{Binding Tamano, ElementName=Root}"
                  Height="{Binding Tamano, ElementName=Root}"
                  Stretch="Uniform"
                  RenderTransformOrigin="0.5,0.5"
                  Margin="0,0,10,0">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </Path.RenderTransform>
            </Path>
            <TextBlock Text="{Binding Mensaje, ElementName=Root}"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       Foreground="#6B7280"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
