<UserControl x:Class="CapaUI.Core.Controls.EncabezadoCatalogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="900" d:DesignHeight="56">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapaUI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Izquierda: badge + miga de pan + título. Grid (no StackPanel) para que el
             texto tenga un ancho real medido y TextTrimming funcione. -->
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="38" Height="38"
                    CornerRadius="8"
                    Background="{DynamicResource EmpresaPrimaryBrush}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource EmpresaPrimaryColor}" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Path x:Name="PathIcono"
                      Data="{StaticResource IconBox}"
                      Stroke="White" StrokeThickness="1.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="20" Height="20" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.ToolTip>
                        <MultiBinding StringFormat="{}{0} / {1}">
                            <Binding Path="ModuloPadre" ElementName="Root" Mode="OneWay"/>
                            <Binding Path="Submodulo" ElementName="Root" Mode="OneWay"/>
                        </MultiBinding>
                    </TextBlock.ToolTip>
                    <Run Text="{Binding ModuloPadre, ElementName=Root, Mode=OneWay}" FontWeight="Normal"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding Submodulo, ElementName=Root, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                </TextBlock>
                <TextBlock Text="{Binding Titulo, ElementName=Root, Mode=OneWay}"
                           FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="#1A1F2E"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Titulo, ElementName=Root, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- Derecha: pastillas de conteo. Visibility alternada por los callbacks
             OnTotalChanged/OnActivosChanged/OnInactivosChanged (null = oculta). -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border x:Name="PillTotal" Style="{StaticResource EncabezadoPill}"
                    Background="#EEF2F8" BorderBrush="#D8E1EC" Margin="0,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource EncabezadoPillDot}" Background="{DynamicResource EmpresaPrimaryBrush}"/>
                    <TextBlock x:Name="TxtEtiquetaTotal" Text="TOTAL" Style="{StaticResource EncabezadoPillLabel}"
                               Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                    <TextBlock Text="{Binding Total, ElementName=Root, Mode=OneWay}" Style="{StaticResource EncabezadoPillValor}"
                               Foreground="{DynamicResource EmpresaPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="PillActivos" Style="{StaticResource EncabezadoPill}"
                    Background="#ECFDF5" BorderBrush="#D1FAE5" Margin="0,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource EncabezadoPillDot}" Background="#10B981"/>
                    <TextBlock x:Name="TxtEtiquetaActivos" Text="ACTIVOS" Style="{StaticResource EncabezadoPillLabel}" Foreground="#047857"/>
                    <TextBlock Text="{Binding Activos, ElementName=Root, Mode=OneWay}" Style="{StaticResource EncabezadoPillValor}" Foreground="#047857"/>
                </StackPanel>
            </Border>
            <Border x:Name="PillInactivos" Style="{StaticResource EncabezadoPill}"
                    Background="#F3F4F6" BorderBrush="#E5E7EB" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource EncabezadoPillDot}" Background="#9CA3AF"/>
                    <TextBlock x:Name="TxtEtiquetaInactivos" Text="INACTIVOS" Style="{StaticResource EncabezadoPillLabel}" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding Inactivos, ElementName=Root, Mode=OneWay}" Style="{StaticResource EncabezadoPillValor}" Foreground="#6B7280"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
