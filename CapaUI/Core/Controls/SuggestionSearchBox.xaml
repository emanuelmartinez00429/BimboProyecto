<UserControl x:Class="CapaUI.Core.Controls.SuggestionSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CapaUI.Core.Controls">

    <UserControl.Resources>
        <Geometry x:Key="IconSearch">M11,4 a7,7 0 1 1 0,14 a7,7 0 0 1 0,-14 z M20,20 l-4.3,-4.3</Geometry>
        <Geometry x:Key="IconClose">M6,6 l12,12 M18,6 l-12,12</Geometry>
    </UserControl.Resources>

    <Grid>
        <!-- Search input row -->
        <Border x:Name="SearchBoxBorder"
                Background="#F7F9FC"
                BorderBrush="#D8E1EC" BorderThickness="1"
                CornerRadius="8"
                Height="38">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{StaticResource IconSearch}"
                      Stroke="#1E3A8A" StrokeThickness="2.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="16" Height="16" Stretch="Uniform"
                      Margin="0,0,8,0" VerticalAlignment="Center"/>

                <TextBox Grid.Column="1"
                         x:Name="TxtBusqueda"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Segoe UI" FontSize="14"
                         Foreground="#1A1F2E"
                         CaretBrush="#1A1F2E"
                         VerticalAlignment="Center"
                         FocusVisualStyle="{x:Null}"
                         Tag="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=local:SuggestionSearchBox}}"
                         GotFocus="TxtBusqueda_GotFocus"
                         LostFocus="TxtBusqueda_LostFocus"
                         TextChanged="TxtBusqueda_TextChanged"
                         PreviewKeyDown="TxtBusqueda_PreviewKeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <TextBlock x:Name="Ph"
                                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Foreground="#9CA3AF"
                                                       FontFamily="Segoe UI" FontSize="14"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="Collapsed"/>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="Ph" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="2"
                        x:Name="BtnClearSearch"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="BtnClearSearch_Click"
                        FocusVisualStyle="{x:Null}"
                        Margin="4,0">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="#9CA3AF" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>

                <Border Grid.Column="3"
                        Background="#EEF2F8" CornerRadius="3" Padding="5,2" Margin="4,0,0,0">
                    <TextBlock Text="&#x2191;&#x2193; Enter"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="#9CA3AF" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Suggestions Popup -->
        <Popup x:Name="SuggestionsPopup"
               PlacementTarget="{Binding ElementName=SearchBoxBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border Background="White"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#D8E1EC" BorderThickness="1,0,1,1"
                    MinWidth="{Binding ActualWidth, ElementName=SearchBoxBorder}"
                    MaxHeight="400">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="8" Opacity="0.18"/>
                </Border.Effect>

                <!-- DockPanel: header fijo + lista con scroll -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFBFC" Padding="16,6">
                        <Grid>
                            <TextBlock Text="SUGERENCIAS"
                                       FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SugCountLabel"
                                       HorizontalAlignment="Right"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Medium"
                                       Foreground="#9CA3AF"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="SuggestionsList"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBd" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#EEF2F8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#D1DCF5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SuggestionItemData}">
                                <Border Background="Transparent"
                                        BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SuggestionItem_Click"
                                        MouseEnter="SuggestionItem_MouseEnter"
                                        Tag="{Binding}">
                                    <Grid Margin="16,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Código (visible sólo si no es vacío) -->
                                        <Border Grid.Column="0"
                                                Background="#EFF6FF"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Codigo}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Codigo}"
                                                       FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="#1E3A8A"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Medium"
                                                       Foreground="#1A1F2E"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}"
                                                       FontFamily="Segoe UI" FontSize="11"
                                                       Foreground="#6B7280"
                                                       Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Meta}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="CornerRadius" Value="999"/>
                                                    <Setter Property="Padding" Value="8,2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Activo"/>
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                <Setter Property="Text" Value="Inactivo"/>
                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
