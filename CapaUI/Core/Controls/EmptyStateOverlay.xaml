<UserControl x:Class="CapaUI.Core.Controls.EmptyStateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsHitTestVisible="False"
             Focusable="False"
             Visibility="Collapsed"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid x:Name="ContenedorPrincipal"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Icono circular minimalista -->
            <Border Width="56" Height="56"
                    CornerRadius="28"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <Path Data="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z M13 2v7h7 M9 13h6 M9 17h4"
                      Stroke="#94A3B8"
                      StrokeThickness="1.8"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="22" Height="22"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>

            <!-- Mensaje principal -->
            <TextBlock x:Name="TxtMensaje"
                       Text="{Binding Mensaje, ElementName=Root}"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- Submensaje opcional -->
            <TextBlock x:Name="TxtSubmensaje"
                       Text="{Binding Submensaje, ElementName=Root}"
                       FontFamily="Segoe UI"
                       FontSize="13.5"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
