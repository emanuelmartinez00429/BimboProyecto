<UserControl x:Class="CapaUI.Core.Controls.SelectorCatalogoModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             UseLayoutRounding="True"
             PreviewKeyDown="OnPreviewKeyDown"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IcoClose">M6,6 l12,12 M18,6 l-12,12</Geometry>
        <Geometry x:Key="IcoBox">M21,16 V8 a2,2 0 0 0,-1,-1.73 l-7,-4 a2,2 0 0 0,-2,0 l-7,4 A2,2 0 0 0,3,8 v8 a2,2 0 0 0,1,1.73 l7,4 a2,2 0 0 0,2,0 l7,-4 A2,2 0 0 0,21,16 z</Geometry>
        <Geometry x:Key="IcoCheck">M20,6 L9,17 l-5,-5</Geometry>

        <!-- CatRow/CatCell/CatHeader se promovieron a Styles.xaml (global) como
             TablaCatalogoFila/TablaCatalogoCelda/TablaCatalogoHeader — cualquier
             modal con una tabla blanca sobre fondo oscuro los usa, no solo este
             selector. Mismos colores que la grilla de Productos: alternas
             #E8F0FA, hover #C8D8F0 y selección verde #C2F2E0 con barra #34D399. -->

        <!-- Extiende la fila global con el atenuado de "ya elegido en otro
             lado" (p. ej. un producto que ya está en la carga) — es un
             concepto propio de este selector, no de la tabla en general, así
             que no se mete en el estilo compartido. IsHitTestVisible=False
             bloquea la fila del todo: ni checkbox ni doble clic la traen. -->
        <Style x:Key="FilaSelector" TargetType="DataGridRow" BasedOn="{StaticResource TablaCatalogoFila}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding YaElegido}" Value="True">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Padding" Value="12,0"/>
            <!-- El "…" ya lo pone TextTrimming, pero sin ToolTip un nombre largo
                 del catálogo quedaba cortado sin forma de leerlo completo. -->
            <Setter Property="controls:TextoResponsivo.ToolTipSiRecorta" Value="True"/>
        </Style>

        <Style x:Key="CatCellMuted" TargetType="TextBlock" BasedOn="{StaticResource CatCellText}">
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- Botón de página sobre el fondo azul -->
        <Style x:Key="CatPageBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E8EEFB"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatPageBtnActivo" TargetType="Button" BasedOn="{StaticResource CatPageBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource EmpresaPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>

        <!-- Botón secundario del pie -->
        <Style x:Key="CatGhostBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#4CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Sin chrome propio: llena el contenedor y hereda su marco y su gradiente. -->
    <Grid Background="Transparent">
        <DockPanel LastChildFill="True">

            <!-- Header: badge + antetítulo + título + cerrar -->
            <Grid DockPanel.Dock="Top" Margin="22,18,18,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9"
                            Background="#26FFFFFF"
                            BorderBrush="#40FFFFFF" BorderThickness="1"
                            Margin="0,0,13,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IcoBox}"
                              Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SELECCI&#211;N"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                   Foreground="#A8BEEA" Margin="0,0,0,1"/>
                        <TextBlock x:Name="TxtTitulo" Text="Seleccionar"
                                   FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnCerrar" Click="Cerrar_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="30" Cursor="Hand"
                        Background="#26FFFFFF" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" ToolTip="Cerrar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                <Path Data="{StaticResource IcoClose}"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#45FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Pie de acciones. Grid, no DockPanel: con DockPanel el texto del
                 hint (variable, más largo en modo múltiple) no se envolvía ni
                 cedía espacio y empujaba los botones fuera del marco visible
                 — acá la columna "*" lo achica/envuelve y "Auto" les garantiza
                 su ancho natural a los botones siempre. -->
            <Border DockPanel.Dock="Bottom" Background="#1F000000" Padding="22,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtPie"
                               Text="Doble clic en una fila para elegirla directamente"
                               FontFamily="Segoe UI" FontSize="14.5" TextWrapping="Wrap"
                               Margin="0,0,14,0"
                               Foreground="#9FB4E2" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancelar" Click="Cerrar_Click"
                                Style="{StaticResource CatGhostBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnElegir" Click="Elegir_Click" IsEnabled="False"
                                Background="#16A34A" BorderThickness="0" Padding="20,8"
                                Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IcoCheck}"
                                                  Stroke="White" StrokeThickness="2.4"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Seleccionar"
                                                       FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#15A048"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Paginación (solo en modo servidor) -->
            <Border x:Name="FooterPaginacion" DockPanel.Dock="Bottom"
                    Padding="22,0,22,12" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="TxtPageInfo" DockPanel.Dock="Left"
                               FontFamily="Segoe UI" FontSize="14.5" Foreground="#9FB4E2"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPrimera"  Content="&#171;"  Style="{StaticResource CatPageBtn}" Click="Primera_Click"  Margin="0,0,3,0"/>
                        <Button x:Name="BtnAnterior" Content="&#8249;" Style="{StaticResource CatPageBtn}" Click="Anterior_Click" Margin="0,0,3,0"/>
                        <ItemsControl x:Name="PaginacionPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="BtnSiguiente" Content="&#8250;" Style="{StaticResource CatPageBtn}" Click="Siguiente_Click" Margin="3,0,0,0"/>
                        <Button x:Name="BtnUltima"    Content="&#187;"  Style="{StaticResource CatPageBtn}" Click="Ultima_Click"    Margin="3,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Buscador + contador + tabla -->
            <Grid Margin="22,0,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filtra la tabla directamente; el popup de sugerencias no se usa. -->
                <controls:SuggestionSearchBox Grid.Row="0" x:Name="SearchBox"
                                              Placeholder="Buscar..."
                                              MostrarPistaTeclado="False"/>

                <TextBlock Grid.Row="1" x:Name="TxtContador"
                           FontFamily="Segoe UI" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="#A8BEEA" Margin="2,10,0,8"/>

                <!-- Tarjeta blanca de la tabla, sobre el azul. Sin Min/MaxHeight:
                     el renglón "*" del Grid padre ya recibe una altura fija de
                     verdad (ProductoModal.RootGrid la congela en OnLoaded), así
                     que esta Border la hereda tal cual y no se mueve al buscar. -->
                <Border Grid.Row="2" CornerRadius="8" Background="White" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="Dg"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="White"
                                  BorderThickness="0"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource FilaSelector}"
                                  CellStyle="{StaticResource TablaCatalogoCelda}"
                                  ColumnHeaderStyle="{StaticResource TablaCatalogoHeader}"
                                  SelectionChanged="Dg_SelectionChanged"
                                  MouseDoubleClick="Dg_DoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <!-- Indicador: círculo (selección única), checkbox (multi) o
                                     "✓ ya" (fila bloqueada) — las tres comparten la columna,
                                     una tapa a las otras según el estado de la fila. -->
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock x:Name="TxtYa" Text="Ya" FontFamily="Segoe UI" FontSize="10"
                                                           FontWeight="Bold" Foreground="#9CA3AF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed"
                                                           ToolTip="Ya está agregado"/>
                                                <CheckBox x:Name="ChkMulti" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="Collapsed"
                                                          IsChecked="{Binding Marcado, Mode=TwoWay}"
                                                          Checked="Marcado_Changed" Unchecked="Marcado_Changed"/>
                                                <Border x:Name="Circulo" Width="16" Height="16" CornerRadius="8"
                                                        Background="White"
                                                        BorderBrush="#CBD5E1" BorderThickness="2"
                                                        HorizontalAlignment="Center">
                                                    <Ellipse x:Name="Punto" Width="7" Height="7" Fill="#16A34A"
                                                             Visibility="Collapsed"/>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                                    <Setter TargetName="Punto" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PermiteMultiple}" Value="True">
                                                    <Setter TargetName="ChkMulti" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Circulo" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- Ya elegido gana: tapa tanto el círculo como el checkbox. -->
                                                <DataTrigger Binding="{Binding YaElegido}" Value="True">
                                                    <Setter TargetName="TxtYa" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ChkMulti" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Circulo" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="ColNombre" Header="NOMBRE" Width="*"
                                                    Binding="{Binding Nombre}"
                                                    ElementStyle="{StaticResource CatCellText}"/>
                                <DataGridTextColumn x:Name="ColDescripcion" Header="DESCRIPCI&#211;N" Width="*"
                                                    Binding="{Binding Descripcion}"
                                                    ElementStyle="{StaticResource CatCellMuted}"/>
                                <DataGridTextColumn x:Name="ColEstado" Header="ESTADO" Width="86"
                                                    Binding="{Binding EstadoTexto}"
                                                    ElementStyle="{StaticResource CatCellMuted}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TxtVacio" Text="Sin resultados."
                                   Visibility="Collapsed"
                                   FontFamily="Segoe UI" FontSize="16.5" Foreground="#6B7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel x:Name="PanelCargando" Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Cargando..."
                                       FontFamily="Segoe UI" FontSize="16.5" Foreground="#6B7280"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtError" Visibility="Collapsed"
                                   FontFamily="Segoe UI" FontSize="15" Foreground="#B91C1C"
                                   TextWrapping="Wrap" MaxWidth="420"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
