<UserControl x:Class="CapaUI.Core.Controls.SelectorCatalogoModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CapaUI.Core.Controls"
             UseLayoutRounding="True"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Geometry x:Key="IcoClose">M6,6 l12,12 M18,6 l-12,12</Geometry>

        <!-- Fila -->
        <Style x:Key="CatRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8D8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F5F8FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Celda: siempre alineada a la izquierda -->
        <Style x:Key="CatCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#1E3A8A" BorderBrush="#1EFFFFFF" BorderThickness="0,0,1,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="White"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Padding="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- Botón de página -->
        <Style x:Key="CatPageBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1F2E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatPageBtnActivo" TargetType="Button" BasedOn="{StaticResource CatPageBtn}">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
        </Style>
    </UserControl.Resources>

    <!-- Sin chrome propio (ni tarjeta, ni sombra, ni esquinas): el control llena
         el contenedor que lo hospeda y hereda su marco. Así el modal anfitrión
         intercambia su contenido en vez de quedar con dos tarjetas encimadas. -->
    <Grid Background="White">

        <!-- DockPanel, no StackPanel: con StackPanel el footer se recorta -->
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#1E3A8A" Padding="18,12">
                <Grid>
                    <TextBlock x:Name="TxtTitulo"
                               Text="Seleccionar"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCerrar" Click="Cerrar_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            FocusVisualStyle="{x:Null}" ToolTip="Cerrar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <Path Data="{StaticResource IcoClose}"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Buscador -->
            <Border DockPanel.Dock="Top" Padding="14,12,14,10" Background="#FAFBFC"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <controls:SuggestionSearchBox x:Name="SearchBox" Placeholder="Buscar..."/>
            </Border>

            <!-- Footer de paginación: colapsado cuando todo entra en memoria -->
            <Border x:Name="FooterPaginacion" DockPanel.Dock="Bottom"
                    Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                    Padding="12,8" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="TxtPageInfo" DockPanel.Dock="Left"
                               FontFamily="Segoe UI" FontSize="13" Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPrimera"  Content="&#171;"   Style="{StaticResource CatPageBtn}" Click="Primera_Click"  Margin="0,0,3,0"/>
                        <Button x:Name="BtnAnterior" Content="&#8249;"  Style="{StaticResource CatPageBtn}" Click="Anterior_Click" Margin="0,0,3,0"/>
                        <ItemsControl x:Name="PaginacionPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="BtnSiguiente" Content="&#8250;" Style="{StaticResource CatPageBtn}" Click="Siguiente_Click" Margin="3,0,0,0"/>
                        <Button x:Name="BtnUltima"    Content="&#187;"  Style="{StaticResource CatPageBtn}" Click="Ultima_Click"    Margin="3,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tabla -->
            <Grid MinHeight="180" MaxHeight="340">
                <DataGrid x:Name="Dg"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderThickness="0"
                          AlternationCount="2"
                          RowStyle="{StaticResource CatRow}"
                          CellStyle="{StaticResource CatCell}"
                          ColumnHeaderStyle="{StaticResource CatHeader}"
                          MouseLeftButtonUp="Fila_Click"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColNombre" Header="NOMBRE" Width="*"
                                            Binding="{Binding Nombre}"
                                            ElementStyle="{StaticResource CatCellText}"/>
                        <DataGridTextColumn x:Name="ColDescripcion" Header="DESCRIPCI&#211;N" Width="*"
                                            Binding="{Binding Descripcion}"
                                            ElementStyle="{StaticResource CatCellText}"/>
                        <DataGridTextColumn x:Name="ColEstado" Header="ESTADO" Width="90"
                                            Binding="{Binding EstadoTexto}"
                                            ElementStyle="{StaticResource CatCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtVacio" Text="Sin resultados."
                           Visibility="Collapsed"
                           FontFamily="Segoe UI" FontSize="15" Foreground="#6B7280"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel x:Name="PanelCargando" Orientation="Horizontal"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Cargando..."
                               FontFamily="Segoe UI" FontSize="15" Foreground="#6B7280"/>
                </StackPanel>

                <TextBlock x:Name="TxtError" Visibility="Collapsed"
                           FontFamily="Segoe UI" FontSize="14" Foreground="#B91C1C"
                           TextWrapping="Wrap" MaxWidth="420"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
