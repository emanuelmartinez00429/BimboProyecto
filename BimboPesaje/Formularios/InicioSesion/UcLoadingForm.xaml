<UserControl x:Class="BimboPesaje.Formularios.InicioSesion.UcLoadingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/InicioSesion/LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid VerticalAlignment="Center" Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Spinner ── -->
        <Grid Grid.Row="0" Width="72" Height="72" HorizontalAlignment="Center">
            <!-- Track ring -->
            <Ellipse StrokeThickness="4" Stroke="#E5E7EB" Fill="Transparent"/>
            <!-- Spinning arc -->
            <Canvas Width="72" Height="72">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" CenterX="36" CenterY="36"/>
                </Canvas.RenderTransform>
                <Path StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent">
                    <Path.Stroke>
                        <SolidColorBrush Color="#1E3A8A"/>
                    </Path.Stroke>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="36,4" IsClosed="False">
                                <ArcSegment Point="68,36" Size="32,32"
                                            SweepDirection="Clockwise" IsLargeArc="False"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>
            <!-- Percentage label -->
            <TextBlock x:Name="TxtProgress" Text="0%"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimary}"/>
        </Grid>

        <!-- ── Title ── -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock Text="Iniciando sesión" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Esto tomará solo un momento."
                       FontFamily="Segoe UI" FontSize="13"
                       Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
        </StackPanel>

        <!-- ── Progress bar ── -->
        <Border Grid.Row="4" Height="4" CornerRadius="2" Background="#E5E7EB">
            <Border x:Name="ProgressBar" CornerRadius="2" Background="#1E3A8A"
                    HorizontalAlignment="Left" Width="0"/>
        </Border>

        <!-- ── Step list ── -->
        <Border Grid.Row="6" Background="{StaticResource SurfaceAlt}"
                CornerRadius="8" Padding="20,16">
            <StackPanel x:Name="StepList">

                <!-- Step 1 -->
                <Grid x:Name="Step1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="S1Dot" Width="18" Height="18" CornerRadius="9"
                            BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent"/>
                    <TextBlock x:Name="S1Text" Grid.Column="1" Text="Verificando credenciales"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Step 2 -->
                <Grid x:Name="Step2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="S2Dot" Width="18" Height="18" CornerRadius="9"
                            BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent"/>
                    <TextBlock x:Name="S2Text" Grid.Column="1" Text="Cargando perfil de usuario"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Step 3 -->
                <Grid x:Name="Step3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="S3Dot" Width="18" Height="18" CornerRadius="9"
                            BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent"/>
                    <TextBlock x:Name="S3Text" Grid.Column="1" Text="Sincronizando módulos"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Step 4 -->
                <Grid x:Name="Step4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="S4Dot" Width="18" Height="18" CornerRadius="9"
                            BorderThickness="1.5" BorderBrush="#D1D5DB" Background="Transparent"/>
                    <TextBlock x:Name="S4Text" Grid.Column="1" Text="Preparando espacio de trabajo"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
