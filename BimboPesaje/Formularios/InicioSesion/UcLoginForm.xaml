<UserControl x:Class="BimboPesaje.Formularios.InicioSesion.UcLoginForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/InicioSesion/LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="56,44,56,24" VerticalAlignment="Center">

            <!-- Eyebrow -->
            <TextBlock Text="Bienvenido" FontFamily="Segoe UI" FontSize="13"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>

            <!-- Title -->
            <TextBlock Text="Iniciar sesión" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>

            <!-- Subtitle -->
            <TextBlock Text="Ingresa tus credenciales para continuar."
                       FontFamily="Segoe UI" FontSize="14"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,22"/>

            <!-- ── Usuario ── -->
            <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
            <Border x:Name="EmailBorder" CornerRadius="8" BorderThickness="1.5"
                    BorderBrush="{StaticResource BorderDefault}" Background="White"
                    Height="44" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Person icon (SVG path) -->
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z"
                                  Fill="#9CA3AF"/>
                        </Canvas>
                    </Viewbox>
                    <TextBox x:Name="TxtEmail" Grid.Column="1"
                             Style="{StaticResource InputTextBox}"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                             KeyDown="Field_KeyDown"
                             TextChanged="Fields_Changed"/>
                </Grid>
            </Border>

            <!-- ── Contraseña ── -->
            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
            <Border x:Name="PassBorder" CornerRadius="8" BorderThickness="1.5"
                    BorderBrush="{StaticResource BorderDefault}" Background="White"
                    Height="44" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Lock icon -->
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="13,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z"
                                  Fill="#9CA3AF"/>
                        </Canvas>
                    </Viewbox>
                    <!-- Password box (hidden) / visible text -->
                    <PasswordBox x:Name="TxtPassword" Grid.Column="1"
                                 Style="{StaticResource InputPasswordBox}"
                                 GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                 KeyDown="Field_KeyDown"
                                 PasswordChanged="Fields_Changed"/>
                    <TextBox x:Name="TxtPasswordVisible" Grid.Column="1"
                             Style="{StaticResource InputTextBox}"
                             Visibility="Collapsed"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                             KeyDown="Field_KeyDown"
                             TextChanged="Fields_Changed"/>
                    <!-- Eye toggle -->
                    <Button x:Name="BtnTogglePwd" Grid.Column="2" Width="40"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnTogglePwd_Click"
                            ToolTip="Mostrar / ocultar contraseña">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="EyePath"
                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z"
                                      Fill="#9CA3AF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Recordar / Olvidaste ── -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkRemember" Grid.Column="0"
                          Content="Recordar usuario"
                          Style="{StaticResource CustomCheckBox}"/>
                <Button Grid.Column="1" Content="¿Olvidaste tu contraseña?"
                        Style="{StaticResource LinkButton}"
                        Click="BtnForgot_Click"/>
            </Grid>

            <!-- Error message -->
            <Border x:Name="ErrorContainer" CornerRadius="6" Background="#FEE2E2"
                    Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="LblError" FontFamily="Segoe UI" FontSize="13"
                           Foreground="#B91C1C" TextWrapping="Wrap"/>
            </Border>

            <!-- Login button -->
            <Button x:Name="BtnIngresar" Content="Entrar"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Click="BtnIngresar_Click"
                    Margin="0,0,0,12"/>

            <!-- Enter hint -->
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="11"
                       Foreground="{StaticResource TextDisabled}">
                <Run Text="Presiona "/>
                <Run Text="[Enter]" FontFamily="Consolas" FontWeight="SemiBold"/>
                <Run Text=" para iniciar sesión"/>
            </TextBlock>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="🛡 Conexión segura · PROD"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource TextDisabled}"/>
                <TextBlock Text="   ·   "
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="{StaticResource TextDisabled}"/>
                <TextBlock Text="v1.0.0" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource TextDisabled}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
