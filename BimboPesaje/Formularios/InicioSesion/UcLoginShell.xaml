<UserControl x:Class="BimboPesaje.Formularios.InicioSesion.UcLoginShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900" Height="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/InicioSesion/LoginResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#F4F5F7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: Brand Panel ══════ -->
            <Border Grid.Column="0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.35,0" EndPoint="0.65,1">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#152A66" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                    <Image x:Name="LogoImage"
                           Source="pack://application:,,,/BimboPesaje;component/Resources/bimbo_no_bg.png"
                           Width="140" Height="140" Stretch="Uniform" Margin="0,0,0,28"/>
                    <TextBlock Text="Portal Interno"
                               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                               Foreground="White" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Sistema de gestión y pesajes"
                               FontFamily="Segoe UI" FontSize="13"
                               TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White" Opacity="0.75"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════ RIGHT: Shell + Chrome ══════ -->
            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Chrome bar (draggable) -->
                <Border Grid.Row="0" Background="White"
                        BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="ChromeBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="TitleBarText" Text="Iniciar sesión"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#6B7280"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ChromeButton}"
                                    Click="BtnMinimize_Click">
                                <TextBlock Text="&#x2014;" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource ChromeCloseButton}"
                                    Click="BtnClose_Click">
                                <TextBlock Text="&#x2715;" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active view content -->
                <ContentControl x:Name="MainContent" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
