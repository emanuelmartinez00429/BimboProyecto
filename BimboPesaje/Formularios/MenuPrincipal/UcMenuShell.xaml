<UserControl x:Class="BimboPesaje.Formularios.MenuPrincipal.UcMenuShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/MenuPrincipal/MenuResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ TOP BAR ══════ -->
        <Border Grid.Row="0"
                Background="{StaticResource TopBarBrush}"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Bug fix: Width="Auto" → sigue el ancho del sidebar automáticamente -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger + Logo (se sincroniza con sidebar por Width="Auto") -->
                <Border Grid.Column="0"
                        BorderBrush="#2DFFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Hamburger: siempre visible, TextBlock Segoe MDL2 (confiable) -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                Margin="8,0,4,0"
                                Click="BtnHamburger_Click"
                                ToolTip="Colapsar / expandir menú">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Logo (se oculta al colapsar) -->
                        <Border x:Name="LogoContainer"
                                Background="White" CornerRadius="8"
                                Padding="8,4" Margin="4,0,12,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>
                            <Image x:Name="TopLogoImage"
                                   Source="pack://application:,,,/BimboPesaje;component/Resources/bimbo_no_bg.png"
                                   Height="32" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Column="1"
                        x:Name="SearchBorder"
                        Background="#1FFFFFFF"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        CornerRadius="22"
                        Margin="24,10,24,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="14,8">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtSearch"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" CaretBrush="White"
                                 FontFamily="Segoe UI" FontSize="14"
                                 VerticalAlignment="Center" MinWidth="200"
                                 GotFocus="TxtSearch_GotFocus"
                                 LostFocus="TxtSearch_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock x:Name="Ph" Text="Buscar módulo…"
                                                               Foreground="#88FFFFFF"
                                                               FontFamily="Segoe UI" FontSize="14"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Ph" Property="Visibility" Value="Hidden"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Border Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                            <TextBlock Text="Ctrl K" FontFamily="Consolas" FontSize="10"
                                       Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Acciones derecha -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">

                    <!-- Bell con badge -->
                    <Grid>
                        <Button Style="{StaticResource TopBarIconButton}" ToolTip="Notificaciones">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Border Background="#EF4444" CornerRadius="7"
                                MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                BorderBrush="{StaticResource TopBarBrush}" BorderThickness="1.5">
                            <TextBlock Text="3" Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Settings -->
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="Configuración">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Separador -->
                    <Border Width="1" Height="24" Background="#26FFFFFF" Margin="6,0"/>

                    <!-- Chrome: Minimize / Maximize / Close -->
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="Minimizar"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="Maximizar / Restaurar"
                            Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="Cerrar"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Separador -->
                    <Border Width="1" Height="24" Background="#26FFFFFF" Margin="6,0"/>

                    <!-- Logout -->
                    <Button Style="{StaticResource LogoutButton}" Click="BtnLogout_Click" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Cerrar sesión" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ BODY ══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ SIDEBAR ══════ -->
            <Border x:Name="Sidebar" Grid.Column="0"
                    Width="226"
                    Background="{StaticResource SidebarGradient}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- "NAVEGACIÓN" label -->
                    <TextBlock x:Name="NavLabel" Grid.Row="0"
                               Text="NAVEGACIÓN"
                               Foreground="#80FFFFFF"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                               Margin="16,20,16,10"/>

                    <!-- Módulos -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Hidden">
                        <StackPanel>

                            <!-- ── USUARIOS ── -->
                            <StackPanel>
                                <Button x:Name="BtnUsuarios" Tag="usuarios"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click">
                                    <Grid>
                                        <!-- Indicador activo -->
                                        <Border x:Name="IndUsuarios"
                                                Width="3" HorizontalAlignment="Left"
                                                Margin="-12,0,0,0"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0"
                                                Visibility="Collapsed"/>
                                        <!-- Estado expandido (icono + label + chevron) -->
                                        <DockPanel x:Name="ExpUsuarios" HorizontalAlignment="Stretch">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChevUsuarios" DockPanel.Dock="Right"
                                                       Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="ChevUsuariosRot" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="LblUsuarios" DockPanel.Dock="Left"
                                                       Text="Usuarios" Foreground="White"
                                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <!-- Estado colapsado (solo icono centrado) -->
                                        <TextBlock x:Name="IcoUsuarios"
                                                   Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Border x:Name="SubUsuarios" MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="empleados"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotEmpleados" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblEmpleados" Text="Gestión de Empleados"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="usuarios-sub"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotUsuariosSub" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblUsuariosSub" Text="Gestión de Usuarios"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="roles"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotRoles" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblRoles" Text="Gestión de Roles"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="bitacora"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotBitacora" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblBitacora" Text="Bitácora"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── PRODUCTOS ── -->
                            <StackPanel>
                                <Button x:Name="BtnProductos" Tag="productos"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click">
                                    <Grid>
                                        <Border x:Name="IndProductos"
                                                Width="3" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                                        <DockPanel x:Name="ExpProductos" HorizontalAlignment="Stretch">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChevProductos" DockPanel.Dock="Right"
                                                       Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="ChevProductosRot" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="LblProductos" DockPanel.Dock="Left"
                                                       Text="Productos" Foreground="White"
                                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock x:Name="IcoProductos"
                                                   Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Border x:Name="SubProductos" MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-productos"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdProductos" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdProductos" Text="Gestión de Productos"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-proveedores"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdProveedores" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdProveedores" Text="Gestión de Proveedores"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-fabricantes"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdFabricantes" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdFabricantes" Text="Gestión de Fabricantes"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-categorias"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdCategorias" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdCategorias" Text="Gestión de Categorías"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── PESAJES ── -->
                            <StackPanel>
                                <Button x:Name="BtnPesajes" Tag="pesajes"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click">
                                    <Grid>
                                        <Border x:Name="IndPesajes"
                                                Width="3" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                                        <DockPanel x:Name="ExpPesajes" HorizontalAlignment="Stretch">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChevPesajes" DockPanel.Dock="Right"
                                                       Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="ChevPesajesRot" Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="LblPesajes" DockPanel.Dock="Left"
                                                       Text="Pesajes" Foreground="White"
                                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock x:Name="IcoPesajes"
                                                   Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Border x:Name="SubPesajes" MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="pes-movs"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotPesMov" Width="4" Height="4" CornerRadius="2"
                                                        Background="{StaticResource AccentGreen}"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblPesMov" Text="Movimientos y Entradas"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── REPORTERÍA (directo) ── -->
                            <Button x:Name="BtnReporteria" Tag="reporteria"
                                    Style="{StaticResource SidebarModuleButton}"
                                    Click="BtnModuloDirect_Click">
                                <Grid>
                                    <Border x:Name="IndReporteria"
                                            Width="3" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                            Background="{StaticResource AccentGreen}"
                                            CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                                    <DockPanel x:Name="ExpReporteria" HorizontalAlignment="Stretch">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblReporteria" DockPanel.Dock="Left"
                                                   Text="Reportería" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="IcoReporteria"
                                               Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- Volver a inicio -->
                            <Border x:Name="HomeButtonContainer"
                                    Padding="16" Margin="0,16,0,0"
                                    BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                                <Button Background="Transparent"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Padding="12,8" Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        FocusVisualStyle="{x:Null}"
                                        Click="BtnHome_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="← Volver a inicio"
                                               Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Button>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Card (expanded) -->
                    <Button x:Name="UserCardButton" Grid.Row="2"
                            Background="Transparent"
                            BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                            Padding="14,12"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Click="BtnMiUsuario_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Border x:Name="IndMiUsuario"
                                                Width="3" HorizontalAlignment="Left" Margin="-14,12,0,12"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                                        <ContentPresenter/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource AvatarGradient}" Margin="0,0,10,0">
                                    <TextBlock x:Name="AvatarInitials" Text="??"
                                               Foreground="White" FontFamily="Segoe UI"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="UserCardName" Text="Cargando…"
                                               Foreground="White" FontFamily="Segoe UI"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Width="5" Height="5" CornerRadius="3"
                                                Background="{StaticResource AccentGreen}"
                                                Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UserCardRole" Text="—"
                                                   Foreground="#B3FFFFFF" FontFamily="Segoe UI" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="v1.0.0" Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock Text="© 2026" Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Avatar compacto (sidebar colapsado) -->
                    <Border x:Name="CompactUserCard" Grid.Row="2"
                            Visibility="Collapsed"
                            BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                            Padding="0,12">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AvatarGradient}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="CompactInitials" Text="??"
                                       Foreground="White" FontFamily="Segoe UI"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════ CONTENIDO CENTRAL ══════ -->
            <Grid Grid.Column="1">
                <wfi:WindowsFormsHost x:Name="WfHost"/>
                <ContentControl x:Name="WpfContent" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
