<UserControl x:Class="BimboPesaje.Formularios.MenuPrincipal.UcMenuShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/MenuPrincipal/MenuResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource TopBarBrush}"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Col0: hamburger + logo, sincronizado con sidebar -->
                    <ColumnDefinition x:Name="TopLeftCol" Width="226"/>
                    <!-- Col1: search -->
                    <ColumnDefinition Width="*"/>
                    <!-- Col2: acciones derecha -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger + Logo -->
                <Border Grid.Column="0"
                        BorderBrush="#2DFFFFFF" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource TopBarIconButton}"
                                Margin="8,0,4,0"
                                Click="BtnHamburger_Click"
                                ToolTip="Colapsar menú">
                            <Path Data="{StaticResource MenuIcon}"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Button>

                        <!-- Logo (se oculta al colapsar sidebar) -->
                        <Border x:Name="LogoContainer"
                                Grid.Column="1"
                                Background="White" CornerRadius="8"
                                Padding="8,4"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Visible">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                            <Image x:Name="TopLogoImage"
                                   Source="pack://application:,,,/BimboPesaje;component/Resources/bimbo_no_bg.png"
                                   Height="32" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Search Box -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <Border x:Name="SearchBorder"
                            Background="#1FFFFFFF"
                            BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="22" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource SearchIcon}"
                                  Stroke="#D9FFFFFF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtSearch"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="White"
                                     FontFamily="Segoe UI" FontSize="14"
                                     VerticalAlignment="Center"
                                     Text=""
                                     GotFocus="TxtSearch_GotFocus"
                                     LostFocus="TxtSearch_LostFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock x:Name="Placeholder"
                                                                   Text="Buscar módulo o ajuste…"
                                                                   Foreground="#AAFFFFFF"
                                                                   FontFamily="Segoe UI" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   IsHitTestVisible="False"/>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="Text" Value=""/>
                                                                <Condition Property="IsFocused" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Border Grid.Column="2"
                                    Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Ctrl K"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Acciones derecha -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">

                    <!-- Bell -->
                    <Grid>
                        <Button Style="{StaticResource TopBarIconButton}" ToolTip="Notificaciones">
                            <Path Data="{StaticResource BellIcon}"
                                  Stroke="White" StrokeThickness="1.9"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <!-- Badge -->
                        <Border Background="#EF4444" CornerRadius="7"
                                MinWidth="14" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0" Padding="3,0"
                                BorderBrush="{StaticResource TopBarBrush}" BorderThickness="1.5">
                            <TextBlock Text="3" Foreground="White"
                                       FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Settings -->
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="Configuración">
                        <Path Data="{StaticResource SettingsIcon}"
                              Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Separador -->
                    <Border Width="1" Height="24" Background="#26FFFFFF" Margin="8,0"/>

                    <!-- Min / Max / Close (chrome) -->
                    <Button Style="{StaticResource TopBarIconButton}"
                            ToolTip="Minimizar" Click="BtnMinimize_Click">
                        <TextBlock Text="&#x2014;" FontSize="11" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}"
                            ToolTip="Maximizar/Restaurar" Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaxIcon" Text="&#x26F6;" FontSize="10" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}"
                            ToolTip="Cerrar" Click="BtnClose_Click">
                        <TextBlock Text="&#x2715;" FontSize="11" Foreground="White"/>
                    </Button>

                    <!-- Separador -->
                    <Border Width="1" Height="24" Background="#26FFFFFF" Margin="8,0"/>

                    <!-- Cerrar sesión -->
                    <Button Style="{StaticResource LogoutButton}"
                            Click="BtnLogout_Click" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource LogoutIcon}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Cerrar sesión"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             BODY: SIDEBAR + CONTENIDO
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ SIDEBAR ══════ -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Width="226"
                    Background="{StaticResource SidebarGradient}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sección label "NAVEGACIÓN" -->
                    <TextBlock x:Name="NavLabel"
                               Grid.Row="0"
                               Text="NAVEGACIÓN"
                               Foreground="#80FFFFFF"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                              
                               Margin="16,20,16,10"
                               Visibility="Visible"/>

                    <!-- Módulos -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource HiddenScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel">

                            <!-- ── USUARIOS ── -->
                            <StackPanel>
                                <Button x:Name="BtnUsuarios"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click" Tag="usuarios">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Indicador activo -->
                                        <Border x:Name="IndUsuarios"
                                                Grid.Column="0" Grid.ColumnSpan="3"
                                                HorizontalAlignment="Left"
                                                Width="3" Margin="-12,8,0,8"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0"
                                                Visibility="Collapsed"/>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource UsersIcon}"
                                              Stroke="White" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="20" Height="20" Stretch="Uniform"/>
                                        <TextBlock x:Name="LblUsuarios"
                                                   Grid.Column="1"
                                                   Text="Usuarios"
                                                   Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <Path x:Name="ChevronUsuarios"
                                              Grid.Column="2"
                                              Data="{StaticResource ChevronDownIcon}"
                                              Stroke="#B3FFFFFF" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ChevronUsuariosRot" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                                <!-- Submenú Usuarios -->
                                <Border x:Name="SubUsuarios"
                                        MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4,0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="empleados"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotEmpleados" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}"
                                                        CornerRadius="2" HorizontalAlignment="Left"
                                                        Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblEmpleados" Text="Gestión de Empleados"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="usuarios-sub"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotUsuariosSub" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}"
                                                        CornerRadius="2" HorizontalAlignment="Left"
                                                        Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblUsuariosSub" Text="Gestión de Usuarios"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="roles"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotRoles" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}"
                                                        CornerRadius="2" HorizontalAlignment="Left"
                                                        Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblRoles" Text="Gestión de Roles"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="bitacora"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotBitacora" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}"
                                                        CornerRadius="2" HorizontalAlignment="Left"
                                                        Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblBitacora" Text="Bitácora"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── PRODUCTOS ── -->
                            <StackPanel>
                                <Button x:Name="BtnProductos"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click" Tag="productos">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IndProductos"
                                                Grid.Column="0" Grid.ColumnSpan="3"
                                                HorizontalAlignment="Left"
                                                Width="3" Margin="-12,8,0,8"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0"
                                                Visibility="Collapsed"/>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource BoxIcon}"
                                              Stroke="White" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="20" Height="20" Stretch="Uniform"/>
                                        <TextBlock x:Name="LblProductos"
                                                   Grid.Column="1"
                                                   Text="Productos"
                                                   Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <Path x:Name="ChevronProductos"
                                              Grid.Column="2"
                                              Data="{StaticResource ChevronDownIcon}"
                                              Stroke="#B3FFFFFF" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ChevronProductosRot" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                                <Border x:Name="SubProductos"
                                        MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4,0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-productos"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdProductos" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdProductos" Text="Gestión de Productos"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-proveedores"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdProveedores" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdProveedores" Text="Gestión de Proveedores"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-fabricantes"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdFabricantes" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdFabricantes" Text="Gestión de Fabricantes"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="prod-categorias"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotProdCategorias" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblProdCategorias" Text="Gestión de Categorías"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── PESAJES ── -->
                            <StackPanel>
                                <Button x:Name="BtnPesajes"
                                        Style="{StaticResource SidebarModuleButton}"
                                        Click="BtnModulo_Click" Tag="pesajes">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IndPesajes"
                                                Grid.Column="0" Grid.ColumnSpan="3"
                                                HorizontalAlignment="Left"
                                                Width="3" Margin="-12,8,0,8"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0"
                                                Visibility="Collapsed"/>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource ScaleIcon}"
                                              Stroke="White" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="20" Height="20" Stretch="Uniform"/>
                                        <TextBlock x:Name="LblPesajes"
                                                   Grid.Column="1"
                                                   Text="Pesajes"
                                                   Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <Path x:Name="ChevronPesajes"
                                              Grid.Column="2"
                                              Data="{StaticResource ChevronDownIcon}"
                                              Stroke="#B3FFFFFF" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ChevronPesajesRot" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                                <Border x:Name="SubPesajes"
                                        MaxHeight="0" ClipToBounds="True"
                                        Background="#2E000000">
                                    <StackPanel Margin="0,4,0,4">
                                        <Button Style="{StaticResource SidebarSubButton}" Tag="pes-movs"
                                                Padding="48,10,16,10" Click="BtnSub_Click">
                                            <Grid>
                                                <Border x:Name="DotPesMov" Width="4" Height="4"
                                                        Background="{StaticResource AccentGreen}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblPesMov" Text="Movimientos y Entradas"
                                                           Foreground="#D9FFFFFF" FontFamily="Segoe UI" FontSize="13"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── REPORTERÍA (directo) ── -->
                            <Button x:Name="BtnReporteria"
                                    Style="{StaticResource SidebarModuleButton}"
                                    Click="BtnModuloDirect_Click" Tag="reporteria">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="IndReporteria"
                                            Grid.Column="0" Grid.ColumnSpan="2"
                                            HorizontalAlignment="Left"
                                            Width="3" Margin="-12,8,0,8"
                                            Background="{StaticResource AccentGreen}"
                                            CornerRadius="0,2,2,0"
                                            Visibility="Collapsed"/>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource ChartIcon}"
                                          Stroke="White" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="20" Height="20" Stretch="Uniform"/>
                                    <TextBlock x:Name="LblReporteria"
                                               Grid.Column="1"
                                               Text="Reportería"
                                               Foreground="White"
                                               FontFamily="Segoe UI" FontSize="14" FontWeight="Medium"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Volver a inicio -->
                            <Border x:Name="HomeButtonContainer"
                                    Padding="16" Margin="0,16,0,0"
                                    BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                                <Button Background="Transparent"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Foreground="#D9FFFFFF"
                                        FontFamily="Segoe UI" FontSize="12"
                                        Padding="12,8" Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        FocusVisualStyle="{x:Null}"
                                        Click="BtnHome_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="← Volver a inicio" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="12" Foreground="#D9FFFFFF"/>
                                </Button>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Card (bottom) -->
                    <Button x:Name="UserCardButton"
                            Grid.Row="2"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch"
                            Padding="14,12"
                            BorderThickness="0,1,0,0" BorderBrush="#1FFFFFFF"
                            Click="BtnMiUsuario_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <!-- Indicador activo Mi Usuario -->
                                        <Border x:Name="IndMiUsuario"
                                                HorizontalAlignment="Left"
                                                Width="3" Margin="-14,12,0,12"
                                                Background="{StaticResource AccentGreen}"
                                                CornerRadius="0,2,2,0"
                                                Visibility="Collapsed"/>
                                        <ContentPresenter/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource AvatarGradient}"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="AvatarInitials"
                                               Text="??"
                                               Foreground="White"
                                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Nombre + Rol -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserCardName"
                                               Text="Cargando…"
                                               Foreground="White"
                                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Width="5" Height="5" CornerRadius="3"
                                                Background="{StaticResource AccentGreen}"
                                                Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UserCardRole"
                                                   Text="—"
                                                   Foreground="#B3FFFFFF"
                                                   FontFamily="Segoe UI" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Footer version -->
                            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="v1.0.0" Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock Text="© 2026"  Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Avatar compacto (solo sidebar colapsado) -->
                    <Border x:Name="CompactUserCard"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                            Padding="0,12">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AvatarGradient}"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="CompactInitials"
                                       Text="??"
                                       Foreground="White"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════ CONTENIDO CENTRAL ══════ -->
            <Grid Grid.Column="1">
                <!-- Capa 1: WindowsFormsHost para formularios WinForms existentes -->
                <wfi:WindowsFormsHost x:Name="WfHost" Visibility="Visible"/>

                <!-- Capa 2: Pantalla WPF "Mi Usuario" -->
                <ContentControl x:Name="WpfContent" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
