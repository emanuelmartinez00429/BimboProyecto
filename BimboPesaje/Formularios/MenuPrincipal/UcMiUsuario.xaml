<UserControl x:Class="BimboPesaje.Formularios.MenuPrincipal.UcMiUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimboPesaje;component/Formularios/MenuPrincipal/MenuResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource SurfaceGray}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24">

            <!-- Breadcrumb -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Inicio" Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI" FontSize="12"/>
                <TextBlock Text=" / " Foreground="#CBD5E1"
                           FontFamily="Segoe UI" FontSize="12"/>
                <TextBlock Text="Mi Usuario" Foreground="{StaticResource TextPrimary}"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- ── Tarjeta principal ── -->
            <Border Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header band -->
                    <Border CornerRadius="12,12,0,0" Padding="24,14" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E3A8A" Offset="0"/>
                                <GradientStop Color="#1E40AF" Offset="0.6"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Dot pattern background -->
                        <Grid>
                            <Rectangle Opacity="0.12">
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel>
                                <TextBlock Text="MI CUENTA"
                                           Foreground="#B3FFFFFF"
                                           FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                                          />
                                <TextBlock Text="Mi Usuario"
                                           Foreground="White"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Body: identidad + acciones -->
                    <Grid Margin="24,18,24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna izquierda -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">

                            <!-- Avatar + nombre + rol -->
                            <StackPanel Orientation="Horizontal">
                                <Border Width="64" Height="64" CornerRadius="32"
                                        Margin="0,0,14,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#60A5FA" Offset="0"/>
                                            <GradientStop Color="#1E40AF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="BigAvatar"
                                               Text="??"
                                               Foreground="White"
                                               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FullName"
                                               Text="Cargando…"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                              />
                                    <Border Background="{StaticResource BrandSoft}"
                                            CornerRadius="5" Padding="8,2" Margin="0,4,0,0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{StaticResource BrandPrimary}"
                                                    Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RoleTag"
                                                       Text="—"
                                                       Foreground="{StaticResource BrandPrimary}"
                                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Grid de datos -->
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource BorderLight}"
                                        Margin="0,0,0,12"/>

                                <!-- Empleado -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Data="{StaticResource BadgeIcon}"
                                              Stroke="#9CA3AF" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="EMPLEADO"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DataNombre"
                                               Grid.Column="1"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="13.5" FontWeight="Medium"/>
                                </Grid>

                                <!-- Usuario / alias -->
                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Data="{StaticResource UserIcon}"
                                              Stroke="#9CA3AF" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="USUARIO"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DataUsuario"
                                               Grid.Column="1"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="13.5" FontWeight="Medium"/>
                                </Grid>

                                <!-- Correo -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Data="{StaticResource MailIcon}"
                                              Stroke="#9CA3AF" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="CORREO"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DataCorreo"
                                               Grid.Column="1"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="13.5" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- Columna derecha: acciones -->
                        <StackPanel Grid.Column="1"
                                    MinWidth="140"
                                    Margin="0">
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1,0,0,0"
                                    Padding="24,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ACCIONES"
                                               Foreground="{StaticResource TextFaint}"
                                               FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <Button x:Name="BtnCambiarFoto"
                                            Style="{StaticResource GhostButton}"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            Padding="12,8" Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Foreground="{StaticResource TextPrimary}"
                                            FontFamily="Segoe UI" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource UserIcon}"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Cambiar foto"
                                                       FontFamily="Segoe UI" FontSize="12"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCambiarPassword"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            Padding="12,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Foreground="{StaticResource TextPrimary}"
                                            FontFamily="Segoe UI" FontSize="12"
                                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            Click="BtnCambiarPassword_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource LockIcon}"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Cambiar contraseña"
                                                       FontFamily="Segoe UI" FontSize="12"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Cambiar contraseña ── -->
            <Border x:Name="PanelPassword"
                    Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    Margin="0,16,0,0" Padding="28,24"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="{StaticResource BrandSoft}"
                                Margin="0,0,16,0">
                            <Path Data="{StaticResource LockIcon}"
                                  Stroke="{StaticResource BrandPrimary}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cambiar contraseña"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="PwdSubtitle"
                                       Text="Recibirás una confirmación al correo registrado."
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CONTRASEÑA ACTUAL"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#D8DCE4" BorderThickness="1.5"
                                    CornerRadius="7" Padding="10,0">
                                <PasswordBox x:Name="TxtPwdActual"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0,9"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="NUEVA CONTRASEÑA"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#D8DCE4" BorderThickness="1.5"
                                    CornerRadius="7" Padding="10,0">
                                <PasswordBox x:Name="TxtPwdNueva"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0,9"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="CONFIRMAR NUEVA"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#D8DCE4" BorderThickness="1.5"
                                    CornerRadius="7" Padding="10,0">
                                <PasswordBox x:Name="TxtPwdConfirm"
                                             FontFamily="Segoe UI" FontSize="13"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0,9"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Info + guardar -->
                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource MailIcon}"
                                      Stroke="#0284C7" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Recibirás una confirmación de seguridad por correo electrónico."
                                           Foreground="#0369A1" FontFamily="Segoe UI" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnGuardarPassword"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource BrandPrimary}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Click="BtnGuardarPassword_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#152A66"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Guardar nueva contraseña" Foreground="White"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
