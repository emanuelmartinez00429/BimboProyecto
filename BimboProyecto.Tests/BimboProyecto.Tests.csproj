<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Lo necesita LoginViewModel, enlazado abajo desde CapaUI. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CapaAplicacion4\CapaAplicacion.csproj" />
    <ProjectReference Include="..\CapaDatos\CapaDatos.csproj" />
    <ProjectReference Include="..\CapaDominio\CapaDominio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CapaUI\Core\Permisos\Permiso.cs" Link="Core\Permisos\Permiso.cs" />
    <Compile Include="..\CapaUI\Core\Controls\Paginacion.cs" Link="Core\Controls\Paginacion.cs" />
    <Compile Include="..\CapaUI\Formularios\Principal\Pantallas\Notificaciones\NotificacionMetadataRenderer.cs"
             Link="Notificaciones\NotificacionMetadataRenderer.cs" />
    <!--
      LoginViewModel se enlaza en vez de referenciar CapaUI porque este proyecto apunta
      a net8.0 y CapaUI a net8.0-windows. Que compile acá es justamente la prueba de que
      el ViewModel no arrastra tipos de WPF: si alguien le mete un Visibility o un Brush,
      esta línea deja de compilar y el test falla antes que la revisión humana.
    -->
    <Compile Include="..\CapaUI\Formularios\InicioSesion\LoginViewModel.cs"
             Link="Auth\LoginViewModel.cs" />
    <Compile Include="..\CapaUI\Formularios\InicioSesion\RecuperacionPasswordViewModels.cs"
             Link="Auth\RecuperacionPasswordViewModels.cs" />
  </ItemGroup>
</Project>
