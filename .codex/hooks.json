{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/session-context.js' 2>/dev/null || true",
            "statusMessage": "Cargando contexto de arranque (handshake + INDEX)..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/vault-trigger.js' 2>/dev/null || true",
            "statusMessage": "Verificando handshake de la bóveda..."
          },
          {
            "type": "command",
            "command": "node '.codex/hooks/diagram-auto-suggest.js' 2>/dev/null || true",
            "statusMessage": "Detectando solicitudes de diagramas..."
          }
        ]
      }
    ]
  }
}
